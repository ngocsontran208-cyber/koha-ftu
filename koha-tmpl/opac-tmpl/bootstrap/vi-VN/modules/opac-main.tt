[% USE raw %]
[% USE Koha %]
[% USE KohaDates %]
[% USE Branches %]
[% USE Categories %]
[% USE Price %]
[% USE AdditionalContents %]
[% USE AuthClient %]
[% PROCESS 'i18n.inc' %]
[% PROCESS 'html_helpers.inc' %]
[% SET OpacNav = AdditionalContents.get( location => "OpacNav", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% SET OpacNavBottom = AdditionalContents.get( location => "OpacNavBottom", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% SET OpacNavRight = AdditionalContents.get( location => "OpacNavRight", lang => lang, library => logged_in_user.branchcode || default_branch ) %]
[% SET OpacMainUserBlock = AdditionalContents.get( location => "OpacMainUserBlock", lang => lang, library => logged_in_user.branchcode || default_branch ) %]
[% SET OpacLoginInstructions = AdditionalContents.get( location => "OpacLoginInstructions", lang => lang, library => branchcode || default_branch ) %]
[% SET AllPublicBranches = Branches.all(  search_params => { public => 1 }, selected => branchcode, unfiltered => 1 ) %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [% PROCESS 'library_name_title' %]
    [% END %]</title
>
<link rel="canonical" href="[% OPACBaseURL | url %]/" />
[% INCLUDE 'doc-head-close.inc' %]
[% BLOCK cssinclude %]
[% END %]
</head>
[% INCLUDE 'bodytag.inc' bodyid='opac-main' %]
[% INCLUDE 'masthead.inc' %]

<main class="main">
    [% WRAPPER breadcrumbs %]
        [% IF news_item %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                [% news_item.title | html %]
            [% END %]
        [% ELSE %]

        [% END %]
    [% END #/ WRAPPER breadcrumbs %]

    <!-- ========================================================================= -->
    <!-- FTU FULL-WIDTH HERO SECTION, SHORTCUTS, AND NEWS -->
    <!-- ========================================================================= -->
    [% IF ( opac_name == 'opac-main' || !opac_name ) && !news_id && !advsearch %]
    <section class="ftu-hero-section">
        <div class="ftu-hero-content">
            <!-- FTU Master Banner Carousel (Auto-Slider) -->
            <div class="ftu-banner-carousel-container" id="ftuBannerCarousel">
                <div class="ftu-banner-slider-track" id="ftuBannerTrack">
                    <!-- Slides are loaded dynamically via portal-posts.pl?type=banner -->
                    <div class="ftu-banner-slide slide-center" data-index="0">
                        <a href="/cgi-bin/koha/opac-search.pl" class="ftu-banner-link">
                            <div class="ftu-banner-bg" style="background-image: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(185, 28, 28, 0.65) 100%), url('/opac-tmpl/bootstrap/images/ftu-library-hero.jpg');"></div>
                            <div class="ftu-banner-content">
                                <span class="ftu-banner-tag"><i class="fa fa-university"></i> [% FTU_BRAND.library_name_full | upper %]</span>
                                <h2 class="ftu-banner-title" style="color: #ffffff !important; text-shadow: 0 2px 10px rgba(0,0,0,0.9);">CHÀO MỪNG BẠN ĐỌC ĐẾN VỚI [% FTU_BRAND.library_name_short | upper %]</h2>
                                <p class="ftu-banner-desc" style="color: #f8fafc !important; text-shadow: 0 1px 6px rgba(0,0,0,0.9);">[% FTU_BRAND.library_slogan %]</p>
                                <span class="ftu-banner-btn">Khám phá ngay <i class="fa fa-arrow-right"></i></span>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Navigation Arrows -->
                <button type="button" class="ftu-banner-arrow ftu-banner-prev" aria-label="Banner trước" id="ftuBannerPrev">
                    <i class="fa fa-chevron-left"></i>
                </button>
                <button type="button" class="ftu-banner-arrow ftu-banner-next" aria-label="Banner kế tiếp" id="ftuBannerNext">
                    <i class="fa fa-chevron-right"></i>
                </button>

                <!-- Pagination Dots -->
                <div class="ftu-banner-dots" id="ftuBannerDots">
                    <button type="button" class="ftu-banner-dot active" data-slide="0" aria-label="Slide 1"></button>
                </div>
            </div>
            
            <!-- Modern Integrated Search Bar & Quick Filter Chips -->
            <div class="ftu-search-container-modern">
                <form name="searchform" method="get" action="/cgi-bin/koha/opac-search.pl" id="searchform" role="search" class="ftu-unified-search-bar">
                    <div class="ftu-search-input-wrap">
                        <i class="fa fa-search ftu-search-lens" aria-hidden="true"></i>
                        <input type="text" name="q" class="ftu-unified-search-input" placeholder="Tìm tên sách, tác giả, giáo trình, ISBN..." autocomplete="off" />
                        <input type="hidden" name="idx" value="kw" />
                    </div>
                    <button type="submit" class="ftu-unified-search-btn" aria-label="Tìm kiếm">
                        <span class="ftu-btn-text">Tìm kiếm</span>
                        <i class="fa fa-arrow-right ftu-btn-icon" aria-hidden="true"></i>
                    </button>
                </form>

                <div class="ftu-search-chips-scroll">
                    <a href="/cgi-bin/koha/opac-search.pl" class="ftu-chip-modern ftu-chip-accent"><i class="fa fa-sliders"></i> Tìm nâng cao</a>
                    <a href="/cgi-bin/koha/opac-course-reserves.pl" class="ftu-chip-modern"><i class="fa fa-graduation-cap"></i> Giáo trình FTU</a>
                    <a href="/cgi-bin/koha/opac-databases.pl" class="ftu-chip-modern"><i class="fa fa-database"></i> Cơ sở dữ liệu</a>
                    <a href="/cgi-bin/koha/opac-collections.pl" class="ftu-chip-modern"><i class="fa fa-cubes"></i> 7 Bộ sưu tập</a>
                </div>
            </div>
        </div>
    </section>

    <!-- MODERN APP-STYLE QUICK SHORTCUTS (Cực kỳ tinh gọn, thẩm mỹ cao cấp) -->
    <div class="ftu-section-container ftu-shortcuts-section">
       <div class="ftu-app-shortcuts-bar">
           <a href="/cgi-bin/koha/opac-search.pl?q=*" class="ftu-app-shortcut-item">
               <div class="ftu-app-squircle icon-rose">
                   <i class="fa fa-book-open"></i>
                   <span class="ftu-squircle-badge">Mới</span>
               </div>
               <span class="ftu-app-label">Sách mới</span>
           </a>
           <a href="/cgi-bin/koha/opac-readingrecord.pl" class="ftu-app-shortcut-item">
               <div class="ftu-app-squircle icon-emerald">
                   <i class="fa fa-history"></i>
               </div>
               <span class="ftu-app-label">Lịch sử</span>
           </a>
           <a href="/cgi-bin/koha/opac-user.pl" class="ftu-app-shortcut-item">
               <div class="ftu-app-squircle icon-amber">
                   <i class="fa fa-id-card"></i>
                   [% IF logged_in_user && logged_in_user.checkouts.count > 0 %]
                   <span class="ftu-squircle-count">[% logged_in_user.checkouts.count %]</span>
                   [% END %]
               </div>
               <span class="ftu-app-label">Tài khoản</span>
           </a>
           <a href="/cgi-bin/koha/opac-shelves.pl" class="ftu-app-shortcut-item">
               <div class="ftu-app-squircle icon-blue">
                   <i class="fa fa-bookmark"></i>
               </div>
               <span class="ftu-app-label">Giá sách</span>
           </a>
       </div>
    </div>

    <!-- DANH MỤC SÁCH MỚI (Real Data & Auto-Scroll) -->
    <div class="ftu-section-container ftu-new-arrivals-section">
        <div class="ftu-section-header">
            <div class="ftu-section-title-wrap">
                <span class="ftu-title-accent-pill"></span>
                <h3 class="ftu-section-title">SÁCH MỚI CẬP NHẬT</h3>
            </div>
            <a href="/cgi-bin/koha/opac-search.pl?q=*" class="ftu-view-all">Xem tất cả <i class="fa fa-arrow-right"></i></a>
        </div>
        
        <style>
            .ftu-books-scroller-wrap {
                overflow-x: auto;
                width: 100%;
                position: relative;
                padding: 10px 0;
                scrollbar-width: thin;
            }
            .ftu-books-grid-dynamic {
                display: flex;
                gap: 1.5rem;
                flex-wrap: nowrap;
                white-space: nowrap;
            }
            .ftu-books-grid-dynamic.has-marquee {
                animation: marquee 30s linear infinite;
            }
            .ftu-books-grid-dynamic.has-marquee:hover {
                animation-play-state: paused;
            }
            .ftu-books-grid-dynamic .ftu-book-card {
                flex: 0 0 220px;
                min-width: 220px;
                white-space: normal; /* Restore text wrapping inside card */
            }
            @keyframes marquee {
                0% { transform: translateX(0); }
                100% { transform: translateX(-50%); }
            }
            /* Loading State */
            .ftu-loading-books {
                text-align: center;
                padding: 2rem;
                color: var(--ftu-text-muted);
                font-size: 1.1rem;
            }
            .ftu-loading-books i { margin-right: 8px; color: var(--ftu-red); }

            /* Khi không có sự kiện: Cột tin tức mở rộng 100% và danh sách tin chia thành 2 cột (mỗi cột 2 tin) */
            .ftu-news-grid.no-events {
                grid-template-columns: 1fr;
            }
            .ftu-news-grid.no-events .ftu-news-list {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 1.25rem;
            }
            .ftu-news-grid.no-events .ftu-news-item {
                height: 100%;
                margin: 0;
            }
            .ftu-news-grid.no-events .ftu-news-content {
                flex: 1;
                display: flex;
                flex-direction: column;
            }
            .ftu-news-grid.no-events .ftu-news-content > div:last-child {
                margin-top: auto;
            }
            @media (max-width: 900px) {
                .ftu-news-grid.no-events .ftu-news-list {
                    grid-template-columns: 1fr;
                }
            }
        </style>

        <div class="ftu-books-scroller-wrap">
            <div id="ftu-dynamic-books" class="ftu-books-grid-dynamic">
                <div class="ftu-loading-books"><i class="fa fa-spinner fa-spin"></i> Đang tải dữ liệu sách mới nhất...</div>
            </div>
        </div>
    </div>

    <!-- TIN TỨC VÀ SỰ KIỆN (DYNAMIC CMS) -->
    <div class="ftu-section-container" id="news-section" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h3 style="font-weight: 800; color: var(--ftu-red); margin: 0;">TIN TỨC & SỰ KIỆN</h3>
            <a href="/cgi-bin/koha/opac-news.pl" style="color: var(--ftu-red); font-weight: 600; text-decoration: none;">Xem tất cả bài viết &rarr;</a>
        </div>
        <div class="ftu-news-grid">
            <!-- Cột Tin tức -->
            <div>
                <h4 style="font-weight: 700; color: var(--ftu-text-dark); margin-bottom: 1rem; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-newspaper" style="color: var(--ftu-red);"></i> Bảng tin Thư viện mới nhất
                </h4>
                <div class="ftu-news-list" id="ftu-dynamic-news-list">
                    <div class="ftu-loading-books"><i class="fa fa-spinner fa-spin"></i> Đang tải tin tức...</div>
                </div>
            </div>

            <!-- Cột Sự kiện & Workshop -->
            <div>
                <h4 style="font-weight: 700; color: var(--ftu-text-dark); margin-bottom: 1rem; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-calendar-alt" style="color: var(--ftu-red);"></i> Sự kiện & Workshop nổi bật
                </h4>
                <div id="ftu-dynamic-events-container">
                    <div class="ftu-loading-books"><i class="fa fa-spinner fa-spin"></i> Đang tải sự kiện...</div>
                </div>
            </div>
        </div>
    </div>
    [% END %]
    <!-- ========================================================================= -->

    [% UNLESS ( opac_name == 'opac-main' || !opac_name ) && !news_id && !advsearch %]
    [% IF loggedinusername || OpacNav || OpacNavBottom || OpacNavRight || OpacMainUserBlock || news_id || (koha_news && koha_news.size) %]
    [% SET container_id = "notloggedin" %]
    [% IF Koha.Preference( 'opacuserlogin' ) == 1 && loggedinusername %]
        [% container_id = "loggedin" %]
    [% END %]
    <div id="[% container_id | html %]" class="container-fluid">
        <div class="row">
            [% IF ( OpacNav ||  OpacNavBottom ) %]
                <div class="col-12 col-lg-2 order-3 order-lg-1">
                    <div id="navigation"> [% INCLUDE 'navigation.inc' %] </div>
                </div>
            [% END %]

            [% SET column_class = "col order-md-1 maincontent" %]
            [% IF ( OpacNav ||  OpacNavBottom  ) && ( (Koha.Preference( 'opacuserlogin' ) == 1 && loggedinusername) || OpacNavRight) %]
                [%#  Three-column layout with right and left sidebars %]
                [% column_class = "col-12 col-lg-7 order-md-1 maincontent" %]
            [% ELSIF ((Koha.Preference( 'opacuserlogin' ) == 1 && loggedinusername) || OpacNavRight) %]
                [%#  Two-column layout with right sidebar %]
                [% column_class = "col-12 col-lg-9 order-md-1 maincontent" %]
            [% ELSIF ( OpacNav ||  OpacNavBottom  ) %]
                [% column_class = "col-12 col-lg-10 order-md-1 maincontent" %]
            [% ELSE %]
                [% column_class = "col-12 order-md-1 maincontent" %]
            [% END %]
            <div class="[% column_class | html %]">
                <h1 class="visually-hidden">Koha home</h1>

                [% IF Koha.Preference( 'OpacNewsLibrarySelect' ) && AllPublicBranches.size > 1 %]
                    [% UNLESS news_id %]
                        <form id="news-branch-select" class="form-inline" name="news-branch-select" method="get" action="/cgi-bin/ftu/opac-main.pl">
                            <legend class="visually-hidden">News</legend>
                            <label for="news-branch">Display news for: </label>
                            <select id="news-branch" name="branch">
                                [% IF ( branchcode == "" ) %]
                                    <option value="" selected="selected">System-wide only</option>
                                [% ELSE %]
                                    <option value="">System-wide only</option>
                                [% END %]
                                [% PROCESS options_for_libraries libraries => AllPublicBranches %]
                            </select>
                        </form>
                    [% END %]
                [% END %]

                [% IF news_id %]
                    [% SET koha_news = AdditionalContents.get( category => 'news', location => ['opac_only', 'staff_and_opac'], lang => lang, id => news_id ) %]
                [% ELSE %]
                    [% SET koha_news = AdditionalContents.get( category => 'news', location => ['opac_only', 'staff_and_opac'], lang => lang, library => branchcode ) %]
                [% END %]
                [% IF koha_news.content.count %]
                    <div id="news" class="newscontainer">
                        [% SET show_author = Koha.Preference('NewsAuthorDisplay') == 'opac' || Koha.Preference('NewsAuthorDisplay') == 'both' %]
                        [% FOREACH koha_new IN koha_news.content %]
                            <div class="newsitem">
                                <h2 class="newsheader">
                                    [% IF ( news_item ) %]
                                        [% koha_new.title | html %]
                                    [% ELSE %]
                                        <a id="newsitem[% koha_new.additional_content.id | html %]" href="/cgi-bin/ftu/opac-main.pl?news_id=[% koha_new.additional_content.id | uri %]">[% koha_new.title | html %]</a>
                                    [% END %]
                                </h2>
                                <div class="newsbody">[% koha_new.content | $raw %]</div>
                                <div class="newsfooter">
                                    Published on [% koha_new.published_on | $KohaDates %]
                                    [% IF ( show_author && koha_new.author ) %]
                                        by <span class="newsauthor">[% INCLUDE 'patron-title.inc' patron=koha_new.author %]</span>
                                    [% END %]
                                    [% IF ( news_id ) %]
                                        &bull; <a href="/cgi-bin/ftu/opac-main.pl">Show all news</a>
                                    [% END %]
                                </div>
                            </div>
                        [% END %]

                        [% UNLESS news_id %]
                            <div id="rssnews-container">
                                <!-- Logged in users have a branch code or it could be explicitly set -->
                                <a href="[% OPACBaseURL | url %]/cgi-bin/koha/opac-news-rss.pl?branchcode=[% branchcode | uri %]">
                                    <i class="fa fa-rss" aria-hidden="true"></i>
                                    [% IF Branches.all.size == 1 %]
                                        [% IF branchcode %]
                                            <span>RSS feed for [% Branches.GetName( branchcode ) | html %] library news</span>
                                        [% ELSE %]
                                            <span>RSS feed for library news</span>
                                        [% END %]
                                    [% ELSE %]
                                        [% IF branchcode %]
                                            <span>RSS feed for [% Branches.GetName( branchcode ) | html %] and system-wide library news</span>
                                        [% ELSE %]
                                            <span>RSS feed for system-wide library news</span>
                                        [% END %]
                                    [% END %]
                                </a>
                            </div>
                        [% END %]
                    </div>
                [% ELSIF news_id %]
                    <!-- news_id but no koha_news.content -->
                    <div class="alert alert-error"> This news item does not exist. </div>
                [% ELSE %]
                    <!-- koha news -->
                    [% IF Koha.Preference( 'OpacNewsLibrarySelect' ) %]
                        <div id="news" class="newscontainer">
                            <div class="newsitem">
                                <div class="newsbody">No news to display.</div>
                                <div class="newsfooter"></div>
                            </div>
                        </div>
                    [% END %]
                [% END # IF koha_news %]

                [% UNLESS news_item # Don't show under single news item %]
                    [% IF ( daily_quote ) %]
                        <div id="daily-quote">
                            <h2>Quote of the day</h2>
                            <div> <span id="daily-quote-text">[% daily_quote.text | html %]</span><span id="daily-quote-sep"> ~ </span><span id="daily-quote-source">[% daily_quote.source | html %]</span> </div>
                        </div>
                    [% END %]

                    [% IF ( OpacMainUserBlock ) %]
                        [% PROCESS koha_news_block news => OpacMainUserBlock %]
                    [% END %]
                [% END %]
            </div>
            <!-- / .col 6/8 -->

            [% IF ( ( Koha.Preference( 'opacuserlogin' ) == 1 && loggedinusername ) || OpacNavRight ) %]
                <div class="col-12 col-lg-3 order-md-2">
                    [% IF Koha.Preference( 'opacuserlogin' ) == 1 && loggedinusername %]
                        [% IF Koha.Preference('OPACUserSummary') && dashboard_info %]
                            <div id="user_summary">
                                <h2>User summary</h2>
                                <p
                                    >Welcome, <a href="/cgi-bin/koha/opac-user.pl"><span class="loggedinusername">[% INCLUDE 'patron-title.inc' patron = logged_in_user %]</span></a></p
                                >
                                <ul id="user_summary_shortcuts">
                                    [% IF checkouts && checkouts > 0 %]
                                        <li>
                                            <a href="/cgi-bin/koha/opac-user.pl?tab=opac-user-checkouts">
                                                <span class="user_checkouts_count count_label">[% checkouts | html %]</span>
                                                [% tn('checkout', 'checkouts', checkouts ) | html %]
                                            </a>
                                        </li>
                                    [% END %]
                                    [% IF overdues && overdues > 0 %]
                                        <li>
                                            <a href="/cgi-bin/koha/opac-user.pl?tab=opac-user-overdues">
                                                <span class="user_overdues_count count_label">[% overdues | html %]</span>
                                                [% tn('overdue', 'overdues', overdues ) | html %]
                                            </a>
                                        </li>
                                    [% END %]
                                    [% IF holds_pending && holds_pending > 0 %]
                                        <li>
                                            <a href="/cgi-bin/koha/opac-user.pl?tab=opac-user-holds">
                                                <span class="user_holds_pending_count count_label">[% holds_pending | html %]</span>
                                                [% tn('hold pending', 'holds pending', holds_pending ) | html %]
                                            </a>
                                        </li>
                                    [% END %]
                                    [% IF holds_waiting && holds_waiting > 0 %]
                                        <li>
                                            <a href="/cgi-bin/koha/opac-user.pl?tab=opac-user-holds">
                                                <span class="user_holds_waiting_count count_label">[% holds_waiting | html %]</span>
                                                [% tn('hold waiting', 'holds waiting', holds_waiting ) | html %]
                                            </a>
                                        </li>
                                    [% END %]
                                    [% IF total_owing && total_owing > 0 %]
                                        <li>
                                            <a href="/cgi-bin/koha/opac-account.pl">
                                                <span class="user_fines_count count_label">[% total_owing | $Price with_symbol => 1 %]</span>
                                                due in fines and charges
                                            </a>
                                        </li>
                                    [% END %]
                                    [% IF patron_messages && patron_messages.filter_by_unread.count > 0 || opacnote %]
                                        [% IF opacnote %]
                                            <li>
                                                <a href="/cgi-bin/koha/opac-user.pl">
                                                    <span class="count_label">[% patron_messages.filter_by_unread.count + 1 | html %]</span>
                                                    [% tn('message', 'messages', patron_messages.filter_by_unread.count + 1 ) | html %]
                                                </a>
                                            </li>
                                        [% ELSE %]
                                            <li>
                                                <a href="/cgi-bin/koha/opac-user.pl">
                                                    <span class="count_label">[% patron_messages.filter_by_unread.count | html %]</span>
                                                    [% tn('message', 'messages', patron_messages.filter_by_unread.count ) | html %]
                                                </a>
                                            </li>
                                        [% END %]
                                    [% END %]
                                    [% IF savings %]
                                        <li>
                                            <a href="/cgi-bin/koha/opac-user.pl">
                                                <span class="count_label">[% savings | $Price with_symbol => 1 %]</span>
                                                total savings
                                            </a>
                                        </li>
                                    [% END %]
                                </ul>
                            </div>
                        [% END %]
                    [% END # /opacuserlogin %]
                    [% PROCESS koha_news_block news => OpacNavRight %]
                </div>
                <!-- / .col -->
            [% END # /opacuserlogin || OpacNavRight %]
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
    [% END # /IF loggedinusername || OpacNav || OpacNavBottom || OpacNavRight || OpacMainUserBlock %]
    [% END # /UNLESS custom homepage %]
</main>
<!-- /.main -->

[% INCLUDE 'opac-bottom.inc' %]
[% BLOCK jsinclude %]
<script>
$(document).ready(function() {
    var $grid = $('#ftu-dynamic-books, #ftu-dynamic-new-arrivals');
    if ($grid.length) {
        var fallbackSvg = "data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='300' height='420' viewBox='0 0 300 420'%3E%3Crect width='100%25' height='100%25' fill='%23b91c1c'/%3E%3Crect x='15' y='15' width='270' height='390' fill='none' stroke='%23fca5a5' stroke-width='2'/%3E%3Ctext x='50%25' y='45%25' font-family='sans-serif' font-size='18' font-weight='bold' fill='%23ffffff' text-anchor='middle'%3ETHƯ VIỆN FTU%3C/text%3E%3Ctext x='50%25' y='55%25' font-family='sans-serif' font-size='14' fill='%23fecaca' text-anchor='middle'%3ETài liệu học tập%3C/text%3E%3C/svg%3E";

        function renderBooks(items) {
            if (!items || items.length === 0) {
                $grid.html('<div class="ftu-loading-books">Chưa có tài liệu mới.</div>');
                return;
            }
            
            var htmlContent = '';
            var renderedCount = 0;
            
            var seenBibs = new Set();
            items.forEach(function(item) {
                if (renderedCount >= 10) return;
                
                var bibNum = item.biblionumber || item.id;
                if (!bibNum || seenBibs.has(bibNum)) return;
                seenBibs.add(bibNum);

                var title = (item.title || 'Chưa có tiêu đề').replace(/\s*[\/:]\s*$/, '').trim();
                var author = (item.author || '[% FTU_BRAND.library_name_short %]').replace(/\s*[\/,]\s*$/, '').trim();
                var link = item.link || ('/cgi-bin/koha/opac-detail.pl?biblionumber=' + bibNum);
                var coverUrl = '/cgi-bin/koha/opac-image.pl?biblionumber=' + bibNum + '&v=' + (item.cover_ts || '1');
                
                htmlContent += `
                    <a href="${link}" class="ftu-book-card">
                        <div class="ftu-book-cover">
                            <img src="${coverUrl}" alt="${title}" onload="if(this.naturalWidth<=1){this.src='${fallbackSvg}';}" onerror="this.onerror=null;this.src='${fallbackSvg}';" />
                            <span class="ftu-book-badge">${bibNum == 445 ? 'DIGITAL' : 'MỚI'}</span>
                        </div>
                        <div class="ftu-book-details">
                            <h4 class="ftu-book-title" title="${title}">${title}</h4>
                            <p class="ftu-book-author">${author}</p>
                            <div class="ftu-book-meta"><i class="fa fa-check-circle" style="margin-right: 4px;"></i> Sẵn sàng</div>
                        </div>
                    </a>
                `;
                renderedCount++;
            });
            
            if (renderedCount > 0) {
                if (renderedCount >= 6) {
                    $grid.addClass('has-marquee');
                } else {
                    $grid.removeClass('has-marquee');
                }
                $grid.html(htmlContent);
            } else {
                $grid.html('<div class="ftu-loading-books">Chưa có tài liệu mới.</div>');
            }
        }

        function fetchBooksFallback() {
            $.ajax({
                url: '/cgi-bin/koha/portal-posts.pl?type=books&limit=10&_t=' + Date.now(),
                method: 'GET',
                dataType: 'json',
                success: function(items) {
                    if (items && items.length > 0) {
                        renderBooks(items);
                    } else {
                        $grid.html('<div class="ftu-loading-books">Chưa có tài liệu mới.</div>');
                    }
                },
                error: function() {
                    $grid.html('<div class="ftu-loading-books">Chưa có tài liệu mới.</div>');
                }
            });
        }

        $.ajax({
            url: '/cgi-bin/koha/svc/report?id=1&annotated=1&_t=' + Date.now(),
            method: 'GET',
            dataType: 'json',
            success: function(items) {
                if (items && items.length > 0) {
                    renderBooks(items);
                } else {
                    fetchBooksFallback();
                }
            },
            error: function() {
                fetchBooksFallback();
            }
        });
    }

        // Trạng thái tải dữ liệu Tin tức & Sự kiện
        var newsLoaded = false;
        var eventsLoaded = false;
        var hasNews = false;
        var hasEvents = false;

        function checkNewsEventsDisplay() {
            if (!newsLoaded || !eventsLoaded) return;

            var $newsGrid = $('.ftu-news-grid');
            var $newsList = $('#ftu-dynamic-news-list');
            var $eventContainer = $('#ftu-dynamic-events-container');
            var $newsCol = $newsList.closest('.ftu-news-grid > div');
            var $eventCol = $eventContainer.closest('.ftu-news-grid > div');

            if (!hasNews && !hasEvents) {
                $('#news-section').hide();
                return;
            }

            $('#news-section').show();

            if (!hasEvents) {
                // KHÔNG CÓ SỰ KIỆN: Ẩn cột sự kiện, mở rộng cột tin tức và chia thành 2 cột (mỗi cột 2 tin)
                $eventCol.hide();
                $newsCol.show();
                $newsGrid.addClass('no-events');
            } else if (!hasNews) {
                // KHÔNG CÓ TIN TỨC: Ẩn cột tin tức, hiển thị sự kiện
                $newsCol.hide();
                $eventCol.show();
                $newsGrid.removeClass('no-events');
            } else {
                // CÓ CẢ TIN TỨC VÀ SỰ KIỆN: Hiển thị 2 cột như ban đầu
                $newsCol.show();
                $eventCol.show();
                $newsGrid.removeClass('no-events');
            }
        }

        // Load News from Portal CMS
        $.ajax({
            url: '/cgi-bin/koha/portal-posts.pl?type=news&limit=4&_t=' + Date.now(),
            method: 'GET',
            dataType: 'json',
            success: function(newsItems) {
                newsLoaded = true;
                var $newsList = $('#ftu-dynamic-news-list');
                if (!newsItems || newsItems.length === 0) {
                    hasNews = false;
                    $newsList.empty();
                } else {
                    hasNews = true;
                    var newsHtml = '';
                    newsItems.forEach(function(item) {
                        var link = '/cgi-bin/koha/opac-news-detail.pl?id=' + item.id;
                        newsHtml += `
                            <a href="${link}" class="ftu-news-item">
                                <div class="ftu-news-date">
                                    <span class="day">${item.created_day || '01'}</span>
                                    <span class="month">${item.created_month || 'Thg 9'}</span>
                                </div>
                                <div class="ftu-news-content">
                                    <h4>${item.title}</h4>
                                    <p>${item.excerpt || ''}</p>
                                    <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 6px; display: flex; align-items: center; gap: 12px;">
                                        <span><i class="fa fa-eye" style="color: #0284c7;"></i> ${item.views_count || 0} lượt xem</span>
                                        <span><i class="fa fa-user-edit" style="color: #64748b;"></i> ${item.author_name || 'Thư viện Phân hiệu'}</span>
                                    </div>
                                </div>
                            </a>
                        `;
                    });
                    $newsList.html(newsHtml);
                }
                checkNewsEventsDisplay();
            },
            error: function() {
                newsLoaded = true;
                hasNews = false;
                checkNewsEventsDisplay();
            }
        });

        // Load Events from Portal CMS
        $.ajax({
            url: '/cgi-bin/koha/portal-posts.pl?type=event&limit=1&_t=' + Date.now(),
            method: 'GET',
            dataType: 'json',
            success: function(events) {
                eventsLoaded = true;
                var $eventContainer = $('#ftu-dynamic-events-container');
                if (!events || events.length === 0) {
                    hasEvents = false;
                    $eventContainer.empty();
                } else {
                    hasEvents = true;
                    var evt = events[0];
                    var link = '/cgi-bin/koha/opac-news-detail.pl?id=' + evt.id;
                    var eventHtml = `
                        <a href="${link}" class="ftu-event-card" style="display: block; text-decoration: none;">
                            <div class="ftu-event-img">
                                <img src="${evt.featured_image || 'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?auto=format&fit=crop&q=80&w=600'}" alt="${evt.title}">
                                <div class="ftu-event-tag">${evt.event_tag || 'Sắp diễn ra'}</div>
                            </div>
                            <div class="ftu-event-details">
                                <h3>${evt.title}</h3>
                                <p><i class="fa fa-calendar-alt"></i> ${evt.formatted_event_date || ''} • ${evt.event_time || ''}</p>
                                <p><i class="fa fa-map-marker-alt"></i> ${evt.event_location || '[% FTU_BRAND.library_name_short %]'}</p>
                                <p style="font-size: 0.85rem; color: #64748b; margin-top: 4px;"><i class="fa fa-eye" style="color: #0284c7;"></i> ${evt.views_count || 0} lượt xem</p>
                                ${evt.event_reg_link ? `<div style="margin-top: 1rem;"><span class="btn btn-sm btn-outline-danger" style="border-radius: 20px; font-weight: 600;"><i class="fa fa-user-plus"></i> Đăng ký tham gia</span></div>` : ''}
                            </div>
                        </a>
                    `;
                    $eventContainer.html(eventHtml);
                }
                checkNewsEventsDisplay();
            },
            error: function() {
                eventsLoaded = true;
                hasEvents = false;
                checkNewsEventsDisplay();
            }
        });
        // Load & Initialize Hero Banners Carousel (Auto-Slider)
        function initBannerCarousel() {
            var $carousel = $('#ftuBannerCarousel');
            if (!$carousel.length) return;

            var $track = $('#ftuBannerTrack');
            var $dotsContainer = $('#ftuBannerDots');
            var $prevBtn = $('#ftuBannerPrev');
            var $nextBtn = $('#ftuBannerNext');
            var currentIndex = 0;
            var slideTimer = null;
            var slideInterval = 5000; // 5 giây tự động chuyển slide

            $.ajax({
                url: '/cgi-bin/koha/portal-posts.pl?type=banner&limit=10&_t=' + Date.now(),
                method: 'GET',
                dataType: 'json',
                success: function(banners) {
                    if (banners && banners.length > 0) {
                        var trackHtml = '';
                        var dotsHtml = '';
                        banners.forEach(function(b, idx) {
                            var link = b.support_link || '/cgi-bin/koha/opac-search.pl';
                            var isExternal = /^https?:\/\//i.test(link) && !link.includes(window.location.hostname);
                            var targetAttr = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
                            var bgImg = b.featured_image || '/opac-tmpl/bootstrap/images/ftu-library-hero.jpg';
                            var tag = (b.classification || 'THƯ VIỆN FTU').trim();
                            var title = (b.title || '').trim();
                            var desc = (b.excerpt || '').trim();
                            var showOverlay = (b.content === 'show_text' || b.show_text == 1 || (b.is_featured == 1 && b.content !== '' && b.content !== 'hide_text')) && title !== '.';

                            trackHtml += `
                                <div class="ftu-banner-slide" data-index="${idx}">
                                    <a href="${link}" class="ftu-banner-link"${targetAttr}>
                                        <div class="ftu-banner-bg" style="background-image: ${showOverlay ? 'linear-gradient(135deg, rgba(15, 23, 42, 0.78) 0%, rgba(185, 28, 28, 0.55) 100%), ' : ''}url('${bgImg}');"></div>
                                        ${showOverlay ? `
                                        <div class="ftu-banner-content">
                                            ${tag ? `<span class="ftu-banner-tag"><i class="fa fa-sparkles"></i> ${tag}</span>` : ''}
                                            ${title ? `<h2 class="ftu-banner-title" style="color: #ffffff !important; text-shadow: 0 2px 10px rgba(0,0,0,0.9);">${title}</h2>` : ''}
                                            ${desc ? `<p class="ftu-banner-desc" style="color: #f8fafc !important; text-shadow: 0 1px 6px rgba(0,0,0,0.9);">${desc}</p>` : ''}
                                            <span class="ftu-banner-btn">Khám phá ngay <i class="fa fa-arrow-right"></i></span>
                                        </div>
                                        ` : ''}
                                    </a>
                                </div>
                            `;

                            dotsHtml += `<button type="button" class="ftu-banner-dot${idx === 0 ? ' active' : ''}" data-slide="${idx}" aria-label="Slide ${idx + 1}"></button>`;
                        });

                        $track.html(trackHtml);
                        $dotsContainer.html(dotsHtml);
                    }
                    startSlider();
                },
                error: function() {
                    startSlider();
                }
            });

            function startSlider() {
                var $slides = $track.find('.ftu-banner-slide');
                var total = $slides.length;
                if (total <= 0) return;

                if (total === 1) {
                    $slides.removeClass('slide-left slide-right slide-hidden').addClass('slide-center active');
                    $prevBtn.hide();
                    $nextBtn.hide();
                    $dotsContainer.hide();
                    return;
                }

                function updateSlidePositions(centerIdx) {
                    currentIndex = ((centerIdx % total) + total) % total;

                    if (total === 2) {
                        var otherIdx = (currentIndex + 1) % 2;
                        $slides.eq(currentIndex).removeClass('slide-left slide-right slide-hidden').addClass('slide-center active');
                        $slides.eq(otherIdx).removeClass('slide-center active slide-hidden').addClass('slide-right');
                    } else {
                        var leftIdx = (currentIndex - 1 + total) % total;
                        var rightIdx = (currentIndex + 1) % total;

                        $slides.each(function(idx) {
                            var $el = $(this);
                            $el.removeClass('slide-center slide-left slide-right slide-hidden active');
                            if (idx === currentIndex) {
                                $el.addClass('slide-center active');
                            } else if (idx === leftIdx) {
                                $el.addClass('slide-left');
                            } else if (idx === rightIdx) {
                                $el.addClass('slide-right');
                            } else {
                                $el.addClass('slide-hidden');
                            }
                        });
                    }

                    $dotsContainer.find('.ftu-banner-dot').removeClass('active');
                    $dotsContainer.find('.ftu-banner-dot').eq(currentIndex).addClass('active');
                }

                function nextSlide() {
                    updateSlidePositions(currentIndex + 1);
                }

                function prevSlide() {
                    updateSlidePositions(currentIndex - 1);
                }

                function resetTimer() {
                    clearInterval(slideTimer);
                    slideTimer = setInterval(nextSlide, slideInterval);
                }

                // Cập nhật vị trí 3 lớp ban đầu
                updateSlidePositions(0);

                // Nhấp vào nút mũi tên điều hướng
                $nextBtn.off('click').on('click', function(e) {
                    e.preventDefault();
                    nextSlide();
                    resetTimer();
                });

                $prevBtn.off('click').on('click', function(e) {
                    e.preventDefault();
                    prevSlide();
                    resetTimer();
                });

                // Nhấp vào lớp bên trái -> xoay slide trái vào giữa
                $track.off('click', '.ftu-banner-slide.slide-left').on('click', '.ftu-banner-slide.slide-left', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    prevSlide();
                    resetTimer();
                });

                // Nhấp vào lớp bên phải -> xoay slide phải vào giữa
                $track.off('click', '.ftu-banner-slide.slide-right').on('click', '.ftu-banner-slide.slide-right', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    nextSlide();
                    resetTimer();
                });

                // Nhấp vào dấu chấm chỉ mục
                $dotsContainer.off('click', '.ftu-banner-dot').on('click', '.ftu-banner-dot', function(e) {
                    e.preventDefault();
                    var slideIdx = parseInt($(this).data('slide'), 10);
                    updateSlidePositions(slideIdx);
                    resetTimer();
                });

                // Tạm dừng chạy khi rê chuột vào banner (Pause on hover)
                $carousel.off('mouseenter mouseleave').on('mouseenter', function() {
                    clearInterval(slideTimer);
                }).on('mouseleave', function() {
                    resetTimer();
                });

                // Vuốt chuyển slide trên màn hình cảm ứng điện thoại / máy tính bảng
                var touchStartX = 0;
                var touchEndX = 0;
                $carousel.off('touchstart touchend').on('touchstart', function(e) {
                    touchStartX = e.originalEvent.touches[0].clientX;
                }).on('touchend', function(e) {
                    touchEndX = e.originalEvent.changedTouches[0].clientX;
                    if (touchStartX - touchEndX > 50) {
                        nextSlide();
                        resetTimer();
                    } else if (touchEndX - touchStartX > 50) {
                        prevSlide();
                        resetTimer();
                    }
                });

                resetTimer();
            }
        }
        initBannerCarousel();
    });
</script>
[% END %]

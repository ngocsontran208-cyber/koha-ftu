[% USE raw %]
[% USE Asset %]
[% USE AuthorisedValues %]
[% USE Categories %]
[% USE Koha %]
[% USE Branches %]
[% USE KohaDates %]
[% USE Math %]
[% USE AdditionalContents %]
[% PROCESS 'i18n.inc' %]
[% PROCESS 'html_helpers.inc' %]
[% SET OpacNav = AdditionalContents.get( location => "OpacNav", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% SET OpacNavBottom = AdditionalContents.get( location => "OpacNavBottom", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% SET userupdateview = 1 %]
[% BLOCK streetnumber %]
 [% UNLESS hidden.defined('streetnumber') %]
 <li>
 <label for="borrower_streetnumber" class="[% required.streetnumber | html %]">Số nhà:</label>

 <input type="text" id="borrower_streetnumber" name="borrower_streetnumber" value="[% borrower.streetnumber | html %]" class="[% required.streetnumber | html %]" />
 <div class="required_label [% required.streetnumber | html %]">Bắt buộc</div>
 </li>
 [% END %]
[% END %]
[% BLOCK B_streetnumber %]
 [% UNLESS hidden.defined('B_streetnumber') %]
 <li>
 <label for="borrower_B_streetnumber" class="[% required.B_streetnumber | html %]">Số nhà:</label>

 <input type="text" id="borrower_B_streetnumber" name="borrower_B_streetnumber" value="[% borrower.B_streetnumber | html %]" class="[% required.B_streetnumber | html %]" />
 <div class="required_label [% required.B_streetnumber | html %]">Bắt buộc</div>
 </li>
 [% END %]
[% END %]

[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% IF op == 'edit' %]
 [% t("Update your personal details") | html %]
 [% ELSE %]
 [% t("Register a new account") | html %]
 [% END %]
 &rsaquo; [% PROCESS 'library_name_title' %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% BLOCK cssinclude %]
[% END %]
</head>

[% IF op == 'edit' %]
 [% INCLUDE 'bodytag.inc' bodyid='opac-patron-update' %]
[% ELSE %]
 <body id="opac-patron-registration" class="opac">
[% END %]
[% INCLUDE 'masthead.inc' %]

<main class="main">
 [% WRAPPER breadcrumbs %]
 [% IF op == 'edit' %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/opac-user.pl">[% INCLUDE 'patron-title.inc' patron = logged_in_user %]</a>
 [% END %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Thông tin cá nhân của bạn</span>
 [% END %]
 [% ELSE %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Đăng ký tài khoản mới</span>
 [% END %]
 [% END %]
 [% END #/ WRAPPER breadcrumbs %]

 <div class="container-fluid">
 <div class="row">
 <div class="col col-lg-2 order-2 order-lg-1">
 <div id="navigation"> [% INCLUDE 'navigation.inc' IsPatronPage=1 %] </div>
 </div>
 <div class="col-md-12 col-lg-10 order-1">
 <h1>Thông tin cá nhân của bạn</h1>

 [% SET container_id = "add-content" %]
 [% IF op == 'edit' %]
 [% container_id = "update-account" %]
 [% END %]
 <div id="[% container_id | html %]" class="maincontent">
 [% IF op == 'edit' %]
 [% UNLESS OPACPatronDetails %]
 <div class="alert alert-info">Để thực hiện thay đổi cho hồ sơ của bạn, vui lòng liên hệ với thư viện.</div>
 [% END %]
 [% IF nochanges %]
 <div class="alert alert-error">Không có thay đổi nào được thực hiện.</div>
 [% END %]
 [% IF self_renewal %]
 <div class="alert alert-info">Please verify your details to proceed with your self-renewal.</div>
 [% END %]
 [% END %]

 [% IF empty_mandatory_fields %]
 <div class="alert alert-warning">Bạn chưa điền đầy đủ tất cả các trường bắt buộc. Vui lòng điền vào các trường còn thiếu và gửi lại.</div>
 [% END %]

 [% IF invalid_form_fields %]
 <div class="alert alert-error"
                            ><strong>Các trường sau đây chứa thông tin không hợp lệ:</strong>
 <ul>
 [% FOREACH field IN invalid_form_fields %]
 [% IF field == "email" %]<li>Thông tin liên hệ: <a href="#borrower_email">địa chỉ email chính</a></li>[% END %]
 [% IF field == "emailpro" %]<li>Thông tin liên hệ: <a href="#borrower_emailpro">địa chỉ email phụ</a></li>[% END %]
 [% IF field == "B_email" %]<li>Thông tin địa chỉ thay thế: <a href="#borrower_B_email">địa chỉ email</a></li>[% END %]
 [% IF field == "password_match" %]<li>Mật khẩu không trùng khớp! <a href="#password">mật khẩu</a></li>[% END %]
 [% IF field == "password_too_short" %]
 <li>Mật khẩu phải có độ dài ít nhất [% patron.category.effective_min_password_length | html %] ký tự.</li>
 [% END %]
 [% IF field == "password_too_weak" %]
 <li>Mật khẩu phải chứa ít nhất một chữ số, một ký tự thường và một ký tự viết hoa.</li>
 [% END %]
 [% IF field == "password_has_whitespaces" %]
 <li>Mật khẩu không được chứa khoảng trắng ở đầu hoặc cuối.</li>
 [% END %]
 [% IF field == "duplicate_email" %]
 <li>Địa chỉ email này đã tồn tại trong cơ sở dữ liệu của chúng tôi.</li>
 [% END %]
 [% IF field == "email_match" %]
 <li>Email không trùng khớp! <a href="#borrower_repeat_email">xác nhận địa chỉ email</a></li>
 [% END %]
 [% IF field == "ERROR_age_limitations" %]
 <li>Tuổi của bạn đọc không phù hợp với phân loại của họ.</li>
 [% END %]
 [% IF field == "ERROR_age_out_of_range" %]
 <li>Patron's age exceeds the maximum age allowed.</li>
 [% END %]
 [% END %]
 </ul>
 <span>Vui lòng sửa lại và gửi lại.</span>
 </div>
 [% END %]

 [% IF duplicate_found %]
 <div class="alert alert-error">
 <span>An existing account matching these details has been found, please contact a member of staff</span>
 </div>
 [% END %]

 [% IF cardnumber_wrong_length || cardnumber_already_exists %]
 <div class="alert alert-error">
 [% IF cardnumber_wrong_length %]
 <a href="#borrower_cardnumber"><strong>Số thẻ đã nhập có độ dài không hợp lệ.</strong></a>
 [% ELSIF cardnumber_already_exists %]
 <a href="#borrower_cardnumber"><strong>Số thẻ vừa nhập đã được sử dụng.</strong></a>
 [% END %]
 <span>Vui lòng sửa lại và gửi lại.</span>
 </div>
 [% END %]

 [% IF error_type OR error_info %]
 <div class="alert alert-error"
                            ><li>
 <p>Đã xảy ra lỗi khi xử lý đăng ký của bạn. Vui lòng liên hệ với thư viện để được hỗ trợ.</p>
 [% IF error_type == 'Koha::Exceptions::Patron::InvalidUserid' %]
 <p>Lỗi: Tên người dùng không hợp lệ</p>
 [% ELSE %]
 <p>Lỗi [% error_type | html %]: [% error_info | html %]</p>
 [% END %]
 </li></div
                        >
 [% END %]

 [% IF failed_captcha %]
 <div class="alert alert-warning">Bạn đã nhập sai các ký tự trong ô trước khi gửi. Vui lòng thử lại.</div>
 [% END %]

 [% IF patron_pending_modification %]
 <div class="alert alert-success">
 <p>You have recently submitted updates to your personal details. A librarian will review your updates before applying them.</p>
 </div>
 [% END %]

 [% IF has_guarantor_flag && !Koha.Preference('OPACPrivacy') && ( Koha.Preference('AllowPatronToSetCheckoutsVisibilityForGuarantor') || Koha.Preference('AllowPatronToSetFinesVisibilityForGuarantor') ) %]
 <div class="row">
 <div class="col">
 <h2 class="visually-hidden">Quyền riêng tư</h2>
 <fieldset class="rows" id="memberentry_privacy">
 <legend id="privacy_legend">Quyền riêng tư</legend>
 <ol>
 [% IF Koha.Preference('AllowPatronToSetCheckoutsVisibilityForGuarantor') %]
 <li>
 <label>Cho phép người bảo lãnh xem các tài liệu bạn đang mượn?</label>
 <select id="privacy_guarantor_checkouts">
 <option value="0">Không</option>
 [% IF borrower.privacy_guarantor_checkouts %]
 <option value="1" selected="selected">Có</option>
 [% ELSE %]
 <option value="1">Có</option>
 [% END %]
 </select>
 <span class="hint">
 <a id="update_privacy_guarantor_checkouts" href="#" class="btn btn-primary">Cập nhật</a>
 <span id="update_privacy_guarantor_checkouts_message" class="alert" style="display:none"></span>
 </span>
 </li>
 [% END %]

 [% IF Koha.Preference('AllowPatronToSetFinesVisibilityForGuarantor') %]
 <li>
 <label>Cho phép người bảo lãnh xem các khoản tiền phạt hiện tại của bạn?</label>
 <select id="privacy_guarantor_fines">
 <option value="0">Không</option>
 [% IF borrower.privacy_guarantor_fines %]
 <option value="1" selected="selected">Có</option>
 [% ELSE %]
 <option value="1">Có</option>
 [% END %]
 </select>
 <span class="hint">
 <a id="update_privacy_guarantor_fines" href="#" class="btn btn-primary">Cập nhật</a>
 <span id="update_privacy_guarantor_fines_message" class="alert" style="display:none"></span>
 </span>
 </li>
 [% END %]

 <li>
 <span class="hint">
 Guaranteed by
 [% FOREACH gr IN patron.guarantor_relationships %]
 [% SET g = gr.guarantor %]
 [% g.preferred_name | html %]
 [% g.middle_name | html %]
 [% g.surname | html %]
 [%- IF ! loop.last %],[% END %]
 [% END %]
 </span>
 </li>
 </ol>
 </fieldset>
 </div>
 </div>
 [% END %]

 [% IF ( extended_unique_id_failed_code ) %]
 <div class="alert" id="extended_unique_id_failed"
                            ><a href="#patron-attr-start-[% extended_unique_id_failed_code | uri %]">[% extended_unique_id_failed_description _ ': ' | html %]</a> Giá trị đã được sử dụng ([% extended_unique_id_failed_value | html %])</div
                        >
 [% END %]

 <form
                        method="post"
                        [% IF (self_renewal) %]action="/api/v1/public/patrons/[% logged_in_user.borrowernumber | uri %]/self_renewal" id="self-renewal-form"[% ELSE %]action="/cgi-bin/koha/opac-memberentry.pl" id="memberentry-form"[% END %]
                        autocomplete="off"
                    >
 [% INCLUDE 'csrf-token.inc' %]

 [% FOREACH field = ['streetnumber' 'streettype'  'cardnumber' 'branchcode' 'categorycode' 'title' 'surname' 'firstname' 'preferred_name' 'middle_name' 'sex' 'dateofbirth' 'initials' 'pronouns' 'othernames' 'address' 'address2' 'city' 'state' 'zipcode' 'country' 'phone' 'phonepro' 'mobile' 'email' 'emailpro' 'fax' 'B_streettype' 'B_streetnumber' 'B_address' 'B_address2' 'B_city' 'B_state' 'B_zipcode' 'B_country' 'B_phone' 'B_email' 'contactnote' 'altcontactsurname' 'altcontactfirstname' 'altcontactaddress1' 'altcontactaddress2' 'altcontactaddress3' 'altcontactstate' 'altcontactzipcode' 'altcontactcountry' 'altcontactphone' 'password' 'lang' ] %]
 [% IF mandatory.defined( field ) %]
 [% SET required.$field = 'required' %]
 [% END %]
 [% END %]

 [%# Following on one line for translatability %]
 [% UNLESS ( hidden.defined('cardnumber') || ( !borrower && Koha.Preference('autoMemberNum') ) ) && hidden.defined('dateexpiry') && hidden.defined('branchcode') && hidden.defined('categorycode') %]
 <div class="row">
 <div class="col">
 <h2 class="visually-hidden">Thư viện</h2>
 <fieldset class="rows" id="memberentry_library">
 <legend id="library_legend">Thư viện</legend>
 <ol>
 [% UNLESS hidden.defined('cardnumber') || ( !borrower && Koha.Preference('autoMemberNum') ) %]
 <li>
 [% IF borrower && !(cardnumber_wrong_length || cardnumber_already_exists) && op == 'edit' %]
 <span class="label">Số thẻ thư viện:</span>
 [% borrower.cardnumber | html %]
 [% ELSE %]
 <label for="borrower_cardnumber" class="[% required.cardnumber | html %]">Số thẻ thư viện:</label>
 [% IF minlength_cardnumber == maxlength_cardnumber %]
 <input
                                                                type="text"
                                                                id="borrower_cardnumber"
                                                                name="borrower_cardnumber"
                                                                size="20"
                                                                value="[% borrower.cardnumber | html %]"
                                                                minlength="[% minlength_cardnumber | html %]"
                                                                maxlength="[% maxlength_cardnumber | html %]"
                                                                class="[% required.cardnumber | html %]"
                                                            />
 <div class="required_label [% required.cardnumber | html %]">Bắt buộc</div>
 <div class="hint">Số thẻ phải có đúng [% minlength_cardnumber | html %] ký tự.</div>
 [% ELSIF minlength_cardnumber && maxlength_cardnumber %]
 <input
                                                                type="text"
                                                                id="borrower_cardnumber"
                                                                name="borrower_cardnumber"
                                                                size="20"
                                                                value="[% borrower.cardnumber | html %]"
                                                                minlength="[% minlength_cardnumber | html %]"
                                                                maxlength="[% maxlength_cardnumber | html %]"
                                                                class="[% required.cardnumber | html %]"
                                                            />
 <div class="required_label [% required.cardnumber | html %]">Bắt buộc</div>
 <div class="hint">Số thẻ phải có độ dài từ [% minlength_cardnumber | html %] đến [% maxlength_cardnumber | html %] ký tự.</div>
 [% ELSIF maxlength_cardnumber %]
 <input
                                                                type="text"
                                                                id="borrower_cardnumber"
                                                                name="borrower_cardnumber"
                                                                size="20"
                                                                value="[% borrower.cardnumber | html %]"
                                                                maxlength="[% maxlength_cardnumber | html %]"
                                                                class="[% required.cardnumber | html %]"
                                                            />
 <div class="required_label [% required.cardnumber | html %]">Bắt buộc</div>
 <div class="hint">Số thẻ có thể dài tối đa [% maxlength_cardnumber | html %] ký tự.</div>
 [% ELSE %]
 <input type="text" id="borrower_cardnumber" name="borrower_cardnumber" size="20" value="[% borrower.cardnumber | html %]" class="[% required.cardnumber | html %]" />
 <div class="required_label [% required.cardnumber | html %]">Bắt buộc</div>
 <div class="hint">Không có giới hạn độ dài tối thiểu hoặc tối đa.</div>
 [% END %]
 [% END %]
 </li>
 [% END %]

 [% IF op != 'new' %]
 [% UNLESS hidden.defined('userid') %]
 <li>
 <span class="label">Tên đăng nhập:</span>
 [% borrower.userid | html %]
 </li>
 [% END %]
 [% END %]

 [% UNLESS hidden.defined('dateexpiry') %]
 <li>
 <span class="label">Ngày hết hạn:</span>
 [% borrower.dateexpiry | $KohaDates %]
 </li>
 [% END %]

 [% UNLESS hidden.defined('branchcode') %]
 <li>
 [% IF libraries.count > 1 %]
 <label for="borrower_branchcode" class="[% required.branchcode | html %]">Thư viện quản lý:</label>

 <select id="borrower_branchcode" name="borrower_branchcode" class="[% required.branchcode | html %]">
 [% IF required.branchcode %]
 <option value=""></option>
 [% END %]
 [% FOREACH l IN libraries %]
 [% IF l.branchcode == borrower.branchcode %]
 <option value="[% l.branchcode | html %]" selected="selected">[% l.branchname | html %]</option>
 [% ELSE %]
 <option value="[% l.branchcode | html %]">[% l.branchname | html %]</option>
 [% END %]
 [% END %]
 </select>
 <div class="required_label [% required.branchcode | html %]">Bắt buộc</div>
 [% ELSE %]
 <span class="label">Thư viện quản lý:</span>
 [% FOREACH l IN libraries %]
 [% l.branchname | html %]
 <input type="hidden" name="borrower_branchcode" value="[% l.branchcode | html %]" />
 [% END %]
 [% END %]
 </li>
 [% END %]

 [% UNLESS hidden.defined('categorycode') %]
 <li>
 [% IF borrower %]
 <span class="label">Danh mục:</span>
 [% Categories.GetName( borrower.categorycode ) | html %]
 <input type="hidden" name="borrower_categorycode" value="[% borrower.categorycode | html %]" />
 [% ELSE %]
 <label for="borrower_categorycode" class="[% required.categorycode | html %]">Danh mục:</label>
 <select id="borrower_categorycode" name="borrower_categorycode" class="[% required.categorycode | html %]">
 [% FOREACH c IN Categories.all() %]
 [% IF c.categorycode == Koha.Preference('PatronSelfRegistrationDefaultCategory') %]
 <option
                                                                        value="[% c.categorycode | html %]"
                                                                        data-pwd-length="[% c.effective_min_password_length | html %]"
                                                                        data-pwd-strong="[% c.effective_require_strong_password | html %]"
                                                                        selected="selected"
                                                                        >[% c.description | html %]</option
                                                                    >
 [% ELSE %]
 <option
                                                                        value="[% c.categorycode | html %]"
                                                                        data-pwd-length="[% c.effective_min_password_length | html %]"
                                                                        data-pwd-strong="[% c.effective_require_strong_password | html %]"
                                                                        >[% c.description | html %]</option
                                                                    >
 [% END %]
 [% END %]
 </select>
 <div class="required_label [% required.categorycode | html %]">Bắt buộc</div>
 [% END %]
 </li>
 [% END %]
 </ol>
 </fieldset>
 </div>
 <!-- /.col -->
 </div>
 <!-- /.row -->
 [% END # / defined 'branchcode' %]

 [%# Following on one line for translatability %]
 [% UNLESS hidden.defined('title') && hidden.defined('surname') && hidden.defined('firstname') && hidden.defined('preferred_name') && hidden.defined('middle_name') && hidden.defined('dateofbirth') && hidden.defined('initials') && hidden.defined('pronouns') && hidden.defined('othernames') && hidden.defined('sex') %]
 <div class="row">
 <div class="col">
 <h2 class="visually-hidden">Định danh</h2>
 <fieldset class="rows" id="memberentry_identity">
 <legend id="identity_legend">Định danh</legend>

 <ol>
 [% UNLESS hidden.defined('title') || !Koha.Preference('BorrowersTitles') %]
 <li>
 <label for="borrower_title" class="[% required.title | html %]">Xưng danh:</label>

 <select id="borrower_title" name="borrower_title" class="[% required.title | html %]">
 <option value=""></option>
 [% FOREACH mt IN Koha.Preference('BorrowersTitles').split('\|') %]
 [% IF mt == borrower.title %]
 <option value="[% mt | html %]" selected="selected">[% mt | html %]</option>
 [% ELSE %]
 <option value="[% mt | html %]">[% mt | html %]</option>
 [% END %]
 [% END %]
 </select>
 <div class="required_label [% required.title | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('surname') %]
 <li>
 <label for="borrower_surname" class="[% required.surname | html %]">Họ:</label>

 <input type="text" id="borrower_surname" name="borrower_surname" value="[% borrower.surname | html %]" class="[% required.surname | html %]" [% IF required.surname %]required[% END %] />
 <div class="required_label [% required.surname | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('firstname') %]
 <li>
 <label for="borrower_firstname" class="[% required.firstname | html %]">Tên:</label>

 <input
                                                        type="text"
                                                        id="borrower_firstname"
                                                        name="borrower_firstname"
                                                        value="[% borrower.firstname | html %]"
                                                        class="[% required.firstname | html %]"
                                                        [% IF required.firstname %]required[% END %]
                                                    />
 <div class="required_label [% required.firstname | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('middle_name') %]
 <li>
 <label for="borrower_middle_name" class="[% required.middle_name | html %]">Tên đệm:</label>

 <input
                                                        type="text"
                                                        id="borrower_middle_name"
                                                        name="borrower_middle_name"
                                                        value="[% borrower.middle_name | html %]"
                                                        class="[% required.middle_name | html %]"
                                                        [% IF required.middle_name %]required[% END %]
                                                    />
 <div class="required_label [% required.middle_name | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('preferred_name') %]
 <li>
 <label for="borrower_preferred_name" class="[% required.preferred_name | html %]">Tên gọi ưa thích:</label>

 <input
                                                        type="text"
                                                        id="borrower_preferred_name"
                                                        name="borrower_preferred_name"
                                                        value="[% borrower.preferred_name | html %]"
                                                        class="[% required.preferred_name | html %]"
                                                        [% IF required.preferred_name %]required[% END %]
                                                    />
 <div class="required_label [% required.preferred_name | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('dateofbirth') %]
 <li>
 <label for="borrower_dateofbirth" class="[% required.dateofbirth | html %]">Ngày sinh:</label>

 <input
                                                        type="text"
                                                        id="borrower_dateofbirth"
                                                        name="borrower_dateofbirth"
                                                        value="[% borrower.dateofbirth | html %]"
                                                        size="10"
                                                        class="[% required.dateofbirth | html %] flatpickr pastdate"
                                                        [% IF required.dateofbirth %]required[% END %]
                                                    />

 <div class="required_label [% required.dateofbirth | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('initials') %]
 <li>
 <label for="borrower_initials" class="[% required.initials | html %]">Tên viết tắt:</label>

 <input
                                                        type="text"
                                                        id="borrower_initials"
                                                        name="borrower_initials"
                                                        value="[% borrower.initials | html %]"
                                                        class="[% required.initials | html %]"
                                                        [% IF required.initials %]required[% END %]
                                                    />
 <div class="required_label [% required.initials | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('pronouns') %]
 <li>
 <label for="borrower_pronouns" class="[% required.pronouns | html %]">Đại từ xưng hô:</label>

 <input
                                                        type="text"
                                                        id="borrower_pronouns"
                                                        name="borrower_pronouns"
                                                        value="[% borrower.pronouns | html %]"
                                                        class="[% required.pronouns | html %]"
                                                        [% IF required.pronouns %]required[% END %]
                                                    />
 <div class="required_label [% required.pronouns | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('othernames') %]
 <li>
 <label for="borrower_othernames" class="[% required.othernames | html %]">Tên khác:</label>

 <input
                                                        type="text"
                                                        id="borrower_othernames"
                                                        name="borrower_othernames"
                                                        value="[% borrower.othernames | html %]"
                                                        class="[% required.othernames | html %]"
                                                        [% IF required.othernames %]required[% END %]
                                                    />
 <div class="required_label [% required.othernames | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('sex') %]
 <li>
 <label for="sex" class="[% required.sex | html %]">Gender:</label>

 <select id="sex" name="borrower_sex" class="[% required.sex | html %]" [% IF required.sex %]required[% END %]>
 <option value="">None specified</option>

 <option value="F" [% IF borrower.sex == 'F' %]selected="selected"[% END %]>Female</option>
 <option value="M" [% IF borrower.sex == 'M' %]selected="selected"[% END %]>Male</option>
 <option value="O" [% IF borrower.sex == 'O' %]selected="selected"[% END %]>Other</option>
 </select>
 <div class="required_label [% required.sex | html %]">Bắt buộc</div>
 </li>
 [% END %]
 </ol>
 </fieldset>
 </div>
 <!-- /.col -->
 [% IF ( display_patron_image ) %]
 <div class="col-sm-2">
 <p class="patronimage">
 <img src="/cgi-bin/koha/opac-patron-image.pl" alt="" />
 </p>
 </div>
 [% END %]
 </div>
 <!-- /.row -->
 [% END # /UNLESS fields hidden %]

 [%# Following on one line for translatability %]
 [% UNLESS hidden.defined('streetnumber') && hidden.defined('address') && hidden.defined('address2') && hidden.defined('city') && hidden.defined('state') && hidden.defined('zipcode') && hidden.defined('country') %]
 <div class="row">
 <div class="col">
 <h2 class="visually-hidden">Địa chỉ chính</h2>
 <fieldset class="rows" id="memberentry_mainaddress">
 <legend id="mainaddress_legend">Địa chỉ chính</legend>

 <ol>
 [% IF Koha.Preference('AddressFormat') != 'de' %][% INCLUDE streetnumber %][% END %]

 [% SET roadtypes = AuthorisedValues.GetAuthValueDropbox('ROADTYPE') %]
 [% IF roadtypes.count %]
 [% UNLESS hidden.defined('streettype') %]
 <li>
 <label for="borrower_streettype" class="[% required.streettype | html %]">Loại đường:</label>

 <select id="borrower_streettype" name="borrower_streettype" class="[% required.streettype | html %]" [% IF required.streettype %]required[% END %]>
 <option value=""></option>
 [% FOR roadtype IN roadtypes %]
 [% IF roadtype.authorised_value == patron.streettype %]
 <option value="[% roadtype.authorised_value | html %]" selected="selected">[% roadtype.lib_opac OR roadtype.lib | html %]</option>
 [% ELSE %]
 <option value="[% roadtype.authorised_value | html %]">[% roadtype.lib_opac OR roadtype.lib | html %]</option>
 [% END %]
 [% END %]
 </select>
 <div class="required_label [% required.streettype | html %]">Bắt buộc</div>
 </li>
 [% END %]
 [% END %]

 [% UNLESS hidden.defined('address') %]
 <li>
 <label for="borrower_address" class="[% required.address | html %]">Địa chỉ:</label>

 <input type="text" id="borrower_address" name="borrower_address" value="[% borrower.address | html %]" class="[% required.address | html %]" [% IF required.address %]required[% END %] />
 <div class="required_label [% required.address | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% IF Koha.Preference('AddressFormat') == 'de' %][% INCLUDE streetnumber %][% END %]

 [% UNLESS hidden.defined('address2') %]
 <li>
 <label for="borrower_address2" class="[% required.address2 | html %]">Địa chỉ 2:</label>

 <input
                                                        type="text"
                                                        id="borrower_address2"
                                                        name="borrower_address2"
                                                        value="[% borrower.address2 | html %]"
                                                        class="[% required.address2 | html %]"
                                                        [% IF required.address2 %]required[% END %]
                                                    />
 <div class="required_label [% required.address2 | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('city') %]
 <li>
 <label for="borrower_city" class="[% required.city | html %]">Thành phố / Tỉnh:</label>

 <input type="text" id="borrower_city" name="borrower_city" value="[% borrower.city | html %]" class="[% required.city | html %]" [% IF required.city %]required[% END %] />
 <div class="required_label [% required.city | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('state') %]
 <li>
 <label for="borrower_state" class="[% required.state | html %]">Bang / Tỉnh:</label>

 <input type="text" id="borrower_state" name="borrower_state" value="[% borrower.state | html %]" class="[% required.state | html %]" [% IF required.state %]required[% END %] />
 <div class="required_label [% required.state | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('zipcode') %]
 <li>
 <label for="borrower_zipcode" class="[% required.zipcode | html %]">Mã bưu chính:</label>

 <input type="text" id="borrower_zipcode" name="borrower_zipcode" value="[% borrower.zipcode | html %]" class="[% required.zipcode | html %]" [% IF required.zipcode %]required[% END %] />
 <div class="required_label [% required.zipcode | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('country') %]
 <li>
 <label for="borrower_country" class="[% required.country | html %]">Quốc gia:</label>

 <input type="text" id="borrower_country" name="borrower_country" value="[% borrower.country | html %]" class="[% required.country | html %]" [% IF required.country %]required[% END %] />
 <div class="required_label [% required.country | html %]">Bắt buộc</div>
 </li>
 [% END %]
 </ol>
 </fieldset>
 </div>
 <!-- /.col -->
 </div>
 <!-- /.row -->
 [% END %]

 [%# Following on one line for translatability %]
 [% UNLESS hidden.defined('phone') && hidden.defined('phonepro') && hidden.defined('mobile') && hidden.defined('email') && hidden.defined('emailpro') && hidden.defined('fax') %]
 <div class="row">
 <div class="col">
 <h2 class="visually-hidden">Thông tin liên hệ</h2>
 <fieldset class="rows" id="memberentry_contact">
 <legend id="contact_legend">Thông tin liên hệ</legend>

 <ol>
 [% UNLESS hidden.defined('phone') %]
 <li>
 <label for="borrower_phone" class="[% required.phone | html %]">Số điện thoại chính:</label>

 <input type="text" id="borrower_phone" name="borrower_phone" value="[% borrower.phone | html %]" class="[% required.phone | html %]" [% IF required.phone %]required[% END %] />
 <div class="required_label [% required.phone | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('phonepro') %]
 <li>
 <label for="borrower_phonepro" class="[% required.phonepro | html %]">Số điện thoại phụ:</label>

 <input
                                                        type="text"
                                                        id="borrower_phonepro"
                                                        name="borrower_phonepro"
                                                        value="[% borrower.phonepro | html %]"
                                                        class="[% required.phonepro | html %]"
                                                        [% IF required.phonepro %]required[% END %]
                                                    />
 <div class="required_label [% required.phonepro | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('mobile') %]
 <li>
 <label for="borrower_mobile" class="[% required.mobile | html %]">Số điện thoại khác:</label>

 <input type="text" id="borrower_mobile" name="borrower_mobile" value="[% borrower.mobile | html %]" class="[% required.mobile | html %]" [% IF required.mobile %]required[% END %] />
 <div class="required_label [% required.mobile | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('email') %]
 <li>
 <label for="borrower_email" class="[% required.email | html %]">Email chính:</label>

 <input type="text" id="borrower_email" name="borrower_email" value="[% borrower.email | html %]" class="[% required.email | html %]" [% IF required.email %]required[% END %] />
 <div class="required_label [% required.email | html %]">Bắt buộc</div>
 </li>

 [% IF op != 'edit' and Koha.Preference('PatronSelfRegistrationConfirmEmail') %]
 <li>
 <label for="borrower_repeat_email" class="[% required.email | html %]">Xác nhận email chính:</label>

 <input type="text" id="borrower_repeat_email" name="borrower_repeat_email" autocomplete="off" class="[% required.email | html %]" [% IF required.email %]required[% END %] />
 <div class="required_label [% required.email | html %]">Bắt buộc</div>
 </li>
 [% END %]
 [% END %]

 [% UNLESS hidden.defined('emailpro') %]
 <li>
 <label for="borrower_emailpro" class="[% required.emailpro | html %]">Email phụ:</label>

 <input
                                                        type="text"
                                                        id="borrower_emailpro"
                                                        name="borrower_emailpro"
                                                        value="[% borrower.emailpro | html %]"
                                                        class="[% required.emailpro | html %]"
                                                        [% IF required.emailpro %]required[% END %]
                                                    />
 <div class="required_label [% required.emailpro | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('fax') %]
 <li>
 <label for="borrower_fax" class="[% required.fax | html %]">Số Fax:</label>

 <input type="text" id="borrower_fax" name="borrower_fax" value="[% borrower.fax | html %]" class="[% required.fax | html %]" [% IF required.fax %]required[% END %] />
 <div class="required_label [% required.fax | html %]">Bắt buộc</div>
 </li>
 [% END %]

 [% UNLESS hidden.defined('primary_contact_method') %]
 <li>
 [% IF ( mandatory.defined('primary_contact_method') ) %]
 <label for="borrower_primary_contact_method" class="required">Phương thức liên hệ chính:</label>
 [% ELSE %]
 <label for="borrower_primary_contact_method">Phương thức liên hệ chính:</label>
 [% END %]

 <select id="borrower_primary_contact_method" name="borrower_primary_contact_method" [% IF ( mandatory.defined('primary_contact_method') ) %]required[% END %]>
 <option value=""></option>
 [% UNLESS hidden.defined('phone') %]
 [% IF ( borrower.primary_contact_method == 'phone' ) %]
 <option value="phone" selected="selected">Số điện thoại chính</option>
 [% ELSE %]
 <option value="phone">Số điện thoại chính</option>
 [% END %]
 [% END %]
 [% UNLESS hidden.defined('phonepro') %]
 [% IF ( borrower.primary_contact_method == 'phonepro' ) %]
 <option value="phonepro" selected="selected">Số điện thoại phụ</option>
 [% ELSE %]
 <option value="phonepro">Số điện thoại phụ</option>
 [% END %]
 [% END %]
 [% UNLESS hidden.defined('mobile') %]
 [% IF ( borrower.primary_contact_method == 'mobile' ) %]
 <option value="mobile" selected="selected">Số điện thoại khác</option>
 [% ELSE %]
 <option value="mobile">Số điện thoại khác</option>
 [% END %]
 [% END %]
 [% UNLESS hidden.defined('email') %]
 [% IF ( borrower.primary_contact_method == 'email' ) %]
 <option value="email" selected="selected">Email chính</option>
 [% ELSE %]
 <option value="email">Email chính</option>
 [% END %]
 [% END %]
 [% UNLESS hidden.defined('emailpro') %]
 [% IF ( borrower.primary_contact_method == 'emailpro' ) %]
 <option value="emailpro" selected="selected">Email phụ</option>
 [% ELSE %]
 <option value="emailpro">Email phụ</option>
 [% END %]
 [% END %]
 [% UNLESS hidden.defined('fax') %]
 [% IF ( borrower.primary_contact_method == 'fax' ) %]
 <option value="fax" selected="selected">Số Fax</option>
 [% ELSE %]
 <option value="fax">Số Fax</option>
 [% END %]
 [% END %]
 </select>
 [% IF ( mandatory.defined('primary_contact_method') ) %]<span class="required">Bắt buộc</span>[% END %]
 </li>
 [% END %]
 [% UNLESS hidden.defined('lang') %]
 <li>
 [% IF ( mandatory.defined('lang') ) %]
 <label for="borrower_lang" class="required">Ngôn ngữ ưu tiên nhận thông báo: </label>
 [% ELSE %]
 <label for="borrower_lang">Ngôn ngữ ưu tiên nhận thông báo: </label>
 [% END %]
 <select id="borrower_lang" name="borrower_lang" [% IF ( mandatory.defined('lang') ) %]required[% END %]>
 <option value="default">Mặc định</option>
 [% FOR language IN languages %]
 [% FOR sublanguage IN language.sublanguages_loop %]
 [% IF language.plural %]
 [% IF sublanguage.rfc4646_subtag == borrower.lang %]
 <option value="[% sublanguage.rfc4646_subtag | html %]" selected="selected"
                                                                            >[% sublanguage.native_description | html %] [% sublanguage.region_description | html %] ([% sublanguage.rfc4646_subtag | html %])</option
                                                                        >
 [% ELSE %]
 <option value="[% sublanguage.rfc4646_subtag | html %]"
                                                                            >[% sublanguage.native_description | html %] [% sublanguage.region_description | html %] ([% sublanguage.rfc4646_subtag | html %])</option
                                                                        >
 [% END %]
 [% ELSE %]
 [% IF sublanguage.rfc4646_subtag == borrower.lang %]
 <option value="[% sublanguage.rfc4646_subtag | html %]" selected="selected"
                                                                            >[% sublanguage.native_description | html %] ([% sublanguage.rfc4646_subtag | html %])</option
                                                                        >
 [% ELSE %]
 <option value="[% sublanguage.rfc4646_subtag | html %]">[% sublanguage.native_description | html %] ([% sublanguage.rfc4646_subtag | html %])</option>
 [% END %]
 [% END # /IF language.plural %]
 [% END # /FOR sublanguage %]
 [% END #/FOR language %]
 </select>
 <!-- /#lang -->
 [% IF ( mandatory.defined('lang') ) %]<div class="required_label required">Bắt buộc</div>[% END %]
 </li>
 [% END %]
 </ol>
 </fieldset>
 </div>
 <!-- /.col -->
 </div>
 <!-- /.row -->
 [% END %]

 [%# Following on one line for translatability %]

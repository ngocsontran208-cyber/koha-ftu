[% USE raw %]
[% USE Koha %]
[% USE AdditionalContents %]
[% PROCESS 'i18n.inc' %]
[% PROCESS 'html_helpers.inc' %]
[% SET OpacNav = AdditionalContents.get( location => "OpacNav", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% SET OpacNavBottom = AdditionalContents.get( location => "OpacNavBottom", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% PROCESS 'library_name_title' %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% BLOCK cssinclude %]
[% END %]
</head>
[% INCLUDE 'bodytag.inc' bodyid='opac-confirmation-pending' %]
[% INCLUDE 'masthead.inc' %]

<main class="main">
 [% WRAPPER breadcrumbs %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/opac-memberentry.pl">Đăng ký tài khoản mới</a>
 [% END %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Đăng ký không hợp lệ</span>
 [% END %]
 [% END #/ WRAPPER breadcrumbs %]

 <div class="container-fluid">
 <div class="row">
 [% SET column_class = "col order-first order-md-first order-lg-2" %]
 [% IF ( OpacNav ||  OpacNavBottom ) %]
 [% column_class = "col-10 order-first order-md-first order-lg-2" %]
 <div class="col-lg-2">
 <div id="navigation"> [% INCLUDE 'navigation.inc' %] </div>
 </div>
 [% END %]

 <div class="[% column_class | html %]">
 <div id="registration-confirmation-error" class="maincontent">
 <div class="alert alert-warning">
 <h1>Đăng ký không hợp lệ!</h1>

 <p>Đã xảy ra lỗi khi xử lý đăng ký của bạn. Vui lòng liên hệ với thư viện để được hỗ trợ.</p>
 [% IF error_type OR error_info %]
 [% IF error_type == 'Koha::Exceptions::Patron::InvalidUserid' %]
 <p>Lỗi: Tên người dùng không hợp lệ</p>
 [% ELSE %]
 <p>Lỗi [% error_type | html %]: [% error_info | html %]</p>
 [% END %]
 [% END %]
 </div>
 </div>
 <!-- /#registration-confirmation-error -->
 </div>
 <!-- /.col-lg-10/12 -->
 </div>
 <!-- /.row -->
 </div>
 <!-- /.container-fluid -->
</main>
<!-- /.main -->

[% INCLUDE 'opac-bottom.inc' %]
[% BLOCK jsinclude %]
[% END %]

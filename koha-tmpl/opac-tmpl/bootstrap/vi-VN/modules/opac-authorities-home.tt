[% USE raw %]
[% USE Koha %]
[% USE AdditionalContents %]
[% PROCESS 'i18n.inc' %]
[% PROCESS 'html_helpers.inc' %]
[% SET OpacNav = AdditionalContents.get( location => "OpacNav", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% SET OpacNavBottom = AdditionalContents.get( location => "OpacNavBottom", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% t("Authority search") | html %]
 &rsaquo; [% PROCESS 'library_name_title' %]
 [% END %]</title
>
<meta name="robots" content="noindex" />
[% INCLUDE 'doc-head-close.inc' %]
[% BLOCK cssinclude %]
<style>
.ftu-auth-wrapper {
    max-width: 960px;
    margin: 0 auto;
}
.ftu-auth-header {
    margin-bottom: 1.5rem;
}
.ftu-auth-title {
    font-size: 1.65rem;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
}
.ftu-auth-subtitle {
    font-size: 0.92rem;
    color: #64748b;
    margin-bottom: 0;
}
.ftu-auth-card {
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    background: #ffffff;
    padding: 2rem;
}
.ftu-chip-btn {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 500;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #475569;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    line-height: 1.4;
}
.ftu-chip-btn:hover {
    background: #fee2e2;
    border-color: #fecaca;
    color: #a31a24;
}
.ftu-chip-btn.active {
    background: #a31a24 !important;
    border-color: #a31a24 !important;
    color: #ffffff !important;
}
.ftu-search-input-group {
    display: flex;
    align-items: stretch;
    border-radius: 10px;
    border: 1.5px solid #cbd5e1;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    background: #ffffff;
    overflow: hidden;
}
.ftu-search-input-group:focus-within {
    border-color: #a31a24;
    box-shadow: 0 0 0 3px rgba(163, 26, 36, 0.1);
}
.ftu-search-input-group input {
    border: none !important;
    box-shadow: none !important;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    background: transparent;
    flex-grow: 1;
    color: #1e293b;
}
.ftu-search-input-group input:focus {
    outline: none;
}
.ftu-search-input-group .btn-search {
    background: #a31a24;
    border: none;
    color: #ffffff;
    padding: 0 1.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
}
.ftu-search-input-group .btn-search:hover {
    background: #88131d;
    color: #ffffff;
}
.ftu-filter-section {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 12px;
    padding: 1.25rem;
}
.ftu-filter-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 0.35rem;
    display: block;
}
.ftu-filter-select {
    border-radius: 8px;
    border-color: #cbd5e1;
    font-size: 0.88rem;
    padding: 0.45rem 0.75rem;
    color: #334155;
    background-color: #ffffff;
}
.ftu-filter-select:focus {
    border-color: #a31a24;
    box-shadow: 0 0 0 3px rgba(163, 26, 36, 0.1);
}
.ftu-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.5rem;
}
.ftu-btn-reset {
    color: #64748b;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 6px;
    transition: all 0.15s ease;
}
.ftu-btn-reset:hover {
    color: #1e293b;
    background: #f1f5f9;
}
.ftu-link-catalog {
    font-size: 0.88rem;
    color: #a31a24;
    text-decoration: none;
    font-weight: 500;
}
.ftu-link-catalog:hover {
    text-decoration: underline;
}
</style>
[% END %]
</head>
[% INCLUDE 'bodytag.inc' bodyid='opac-authorities' bodyclass='scrollto' %]
[% INCLUDE 'masthead.inc' %]

<main class="main">
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Tìm kiếm dữ liệu kiểm soát</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]

    <div class="container-fluid py-3">
        <div class="row justify-content-center">
            [% SET column_class = "col-12" %]
            [% IF ( OpacNav || OpacNavBottom ) %]
                [% column_class = "col-12 col-lg-10" %]
                <div class="col-12 col-lg-2 d-none d-lg-block">
                    <div id="navigation"> [% INCLUDE 'navigation.inc' %] </div>
                </div>
            [% END %]
            <div class="[% column_class | html %]">
                <div id="userauthhome" class="maincontent ftu-auth-wrapper">

                    <!-- Header -->
                    <div class="ftu-auth-header">
                        <h1 class="ftu-auth-title">Tìm kiếm dữ liệu kiểm soát</h1>
                        <p class="ftu-auth-subtitle">Tra cứu điểm truy cập chuẩn hóa cho tác giả, tổ chức và chủ đề</p>
                    </div>

                    <!-- Search Card -->
                    <div class="ftu-auth-card mb-4">
                        <form name="f" action="/cgi-bin/koha/opac-authorities-home.pl" method="get" id="ftuAuthoritySearchForm">
                            <input type="hidden" name="op" value="do_search" />
                            <input type="hidden" name="type" value="opac" />
                            <input type="hidden" name="and_or" value="and" />
                            <input type="hidden" name="excluding" value="" />

                            <!-- Quick Filter Chips -->
                            <div class="mb-3">
                                <label class="ftu-filter-label mb-2">Loại dữ liệu:</label>
                                <div class="d-flex flex-wrap gap-2" id="ftuAuthorityChipsContainer">
                                    <button type="button" class="ftu-chip-btn active" data-authtype="">
                                        Tất cả
                                    </button>
                                    [% FOREACH authority_type IN authority_types %]
                                        <button type="button" class="ftu-chip-btn [% IF authority_type.authtypecode == authtypecode %]active[% END %]" data-authtype="[% authority_type.authtypecode | html %]">
                                            [% authority_type.authtypetext | html %]
                                        </button>
                                    [% END %]
                                </div>
                            </div>

                            <!-- Search Input Box -->
                            <div class="mb-3">
                                <label for="value" class="ftu-filter-label mb-2">Từ khóa tra cứu <span class="text-danger">*</span></label>
                                <div class="ftu-search-input-group">
                                    <input type="text" name="value" id="value" value="[% value | html %]" placeholder="Nhập tên tác giả, cơ quan hoặc chủ đề cần tìm..." required autocomplete="off" autofocus />
                                    <button type="button" class="btn btn-link text-muted pe-3 text-decoration-none" id="ftuClearTermBtn" style="display: none;" title="Xóa">
                                        &times;
                                    </button>
                                    <button class="btn-search" type="submit">
                                        Tìm kiếm
                                    </button>
                                </div>
                            </div>

                            <!-- Filter Controls -->
                            <div class="ftu-filter-section mb-3">
                                <div class="row g-3">
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <label for="authtypecode" class="ftu-filter-label">Loại định danh</label>
                                        <select name="authtypecode" id="authtypecode" class="form-select ftu-filter-select">
                                            [% FOREACH authority_type IN authority_types %]
                                                [% IF authority_type.authtypecode == authtypecode %]
                                                    <option value="[% authority_type.authtypecode | html %]" selected="selected">[% authority_type.authtypetext | html %]</option>
                                                [% ELSE %]
                                                    <option value="[% authority_type.authtypecode | html %]">[% authority_type.authtypetext | html %]</option>
                                                [% END %]
                                            [% END %]
                                        </select>
                                    </div>

                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <label for="anywhere" class="ftu-filter-label">Phương thức tìm</label>
                                        <select name="operator" id="anywhere" class="form-select ftu-filter-select">
                                            <option value="contains" selected="selected">Có chứa từ khóa</option>
                                            <option value="start">Bắt đầu bằng</option>
                                            <option value="exact">Chính xác hoàn toàn</option>
                                        </select>
                                    </div>

                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <label for="marclist" class="ftu-filter-label">Phạm vi</label>
                                        <select name="marclist" id="marclist" class="form-select ftu-filter-select">
                                            <option value="all" selected="selected">Toàn bộ biểu ghi</option>
                                            <option value="match">Trong tiêu đề</option>
                                            <option value="mainentry">Điểm truy cập chính (1XX)</option>
                                        </select>
                                    </div>

                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <label for="orderby" class="ftu-filter-label">Sắp xếp</label>
                                        <select name="orderby" id="orderby" class="form-select ftu-filter-select">
                                            <option value="HeadingAsc" selected="selected">Tiêu đề (A &rarr; Z)</option>
                                            <option value="HeadingDsc">Tiêu đề (Z &rarr; A)</option>
                                            <option value="">Mặc định</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Row -->
                            <div class="ftu-actions">
                                <div class="d-flex align-items-center gap-2">
                                    <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold" style="background: #a31a24; border-color: #a31a24; border-radius: 8px;">
                                        Tìm kiếm
                                    </button>
                                    <a href="/cgi-bin/koha/opac-authorities-home.pl" class="ftu-btn-reset">
                                        Đặt lại
                                    </a>
                                </div>
                                <div>
                                    <a href="/cgi-bin/koha/opac-search.pl" class="ftu-link-catalog">
                                        Tra cứu tài liệu thông thường &rarr;
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>
                <!-- / #userauthhome -->
            </div>
            <!-- / .col -->
        </div>
        <!-- / .row -->
    </div>
    <!-- / .container-fluid -->
</main>

[% INCLUDE 'opac-bottom.inc' %]
[% BLOCK jsinclude %]
<script nonce="[% Koha.CSPNonce | $raw %]">
(function() {
    'use strict';

    document.addEventListener('DOMContentLoaded', function() {
        var inputEl = document.getElementById('value');
        var clearBtn = document.getElementById('ftuClearTermBtn');
        var authtypeSelect = document.getElementById('authtypecode');
        var chipsContainer = document.getElementById('ftuAuthorityChipsContainer');

        // Quản lý nút xóa nhanh nội dung input
        if (inputEl && clearBtn) {
            function updateClearBtn() {
                clearBtn.style.display = inputEl.value.trim().length > 0 ? 'inline-block' : 'none';
            }
            inputEl.addEventListener('input', updateClearBtn);
            updateClearBtn();

            clearBtn.addEventListener('click', function() {
                inputEl.value = '';
                inputEl.focus();
                updateClearBtn();
            });
        }

        // Đồng bộ hóa Quick Chips với Select Dropdown
        if (chipsContainer && authtypeSelect) {
            var chips = chipsContainer.querySelectorAll('.ftu-chip-btn');

            function syncActiveChip(selectedVal) {
                chips.forEach(function(chip) {
                    var chipVal = chip.getAttribute('data-authtype') || '';
                    if (chipVal === selectedVal) {
                        chip.classList.add('active');
                    } else {
                        chip.classList.remove('active');
                    }
                });
            }

            chips.forEach(function(chip) {
                chip.addEventListener('click', function() {
                    var val = this.getAttribute('data-authtype') || '';
                    authtypeSelect.value = val;
                    syncActiveChip(val);
                    if (inputEl) {
                        inputEl.focus();
                    }
                });
            });

            authtypeSelect.addEventListener('change', function() {
                syncActiveChip(this.value);
            });

            syncActiveChip(authtypeSelect.value);
        }
    });
})();
</script>
[% END %]

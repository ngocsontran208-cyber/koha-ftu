[% USE raw %]
[% USE Koha %]
[% USE AdditionalContents %]
[% PROCESS 'i18n.inc' %]
[% PROCESS 'html_helpers.inc' %]
[% SET OpacNav = AdditionalContents.get( location => "OpacNav", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% SET OpacNavBottom = AdditionalContents.get( location => "OpacNavBottom", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% IF op == 'show' || op == 'invited' %]
 [% t("Share a list") | html %]
 [% ELSIF op == 'accept' %]
 [% t("Accept a shared list") | html %]
 [% END %]
 &rsaquo; [% PROCESS 'library_name_title' %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% BLOCK cssinclude %]
[% END %]
</head>

[% INCLUDE 'bodytag.inc' bodyid='opac-shareshelf' bodyclass='scrollto' %]
[% INCLUDE 'masthead.inc' %]
<main class="main">
 [% WRAPPER breadcrumbs %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/opac-user.pl">[% INCLUDE 'patron-title.inc' patron = logged_in_user %]</a>
 [% END %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/opac-shelves.pl">Danh sách</a>
 [% END %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Share a list</span>
 [% END %]
 [% END #/ WRAPPER breadcrumbs %]

 <div class="container-fluid">
 <div class="row">
 [% IF ( OpacNav ) %]
 <div class="col-lg-2">
 <div id="navigation"> [% INCLUDE 'navigation.inc' IsPatronPage=1 %] </div>
 </div>
 [% END %]

 <div class="col-10 order-first order-md-first order-lg-2">
 <div id="shareshelf" class="maincontent">
 [%# This section contains the essential code for error messages and operations: show, invited and accept. %]
 <h1>
 [% IF op == 'show' || op == 'invited' %]
 Share a list with another patron
 [% ELSIF op == 'accept' %]
 Accept a shared list from another patron
 [% END %]
 </h1>

 [% IF errcode %]
 [% IF errcode==1 && op %]
 <div class="alert alert-warning">Thao tác [% op | html %] không được hỗ trợ.</div>
 [% END %]
 [% IF errcode==1 && !op %]
 <div class="alert alert-warning">Không có thông số hoạt động nào được thông qua.</div>
 [% END %]
 [% IF errcode==2 %]
 <div class="alert alert-warning">Invalid shelf number.</div>
 [% END %]
 [% IF errcode==3 %]
 <div class="alert alert-warning">Tính năng chia sẻ giá sách ảo không được sử dụng trong thư viện này.</div>
 [% END %]
 [% IF errcode==4 %]
 <div class="alert alert-warning">Bạn chỉ có thể chia sẻ giá sách ảo nếu bạn là người tạo ra giá sách ảo.</div>
 [% END %]
 [% IF errcode==5 %]
 <div class="alert alert-warning">Bạn không thể chia sẻ một giá sách ảo cộng đồng.</div>
 [% END %]
 [% IF errcode==6 %]
 <div class="alert alert-warning">Xin lỗi, Thông tin thư điện tử của bạn không hợp lệ.</div>
 [% END %]
 [% IF errcode==7 %]
 <div class="alert alert-warning">Xin lỗi, chúng tôi không thể chấp nhận đáp ứng của bạn. Lời mời có thể đã hết hạn. Bạn vui lòng liên hệ với bạn đọc đã gửi lời mời cho bạn.</div>
 [% END %]
 [% IF errcode==8 %]
 <div class="alert alert-warning">Là chủ sở hữu giá sách ảo, bạn không thể chấp nhập lời mời chia sẻ giá sách ảo này.</div>
 [% END %]
 <p><a href="/cgi-bin/koha/opac-shelves.pl?op=list">Return to your lists</a></p>
 [% ELSIF op == 'show' %]
 <div id="invite">
 <form method="post" id="share_list">
 [% INCLUDE 'csrf-token.inc' %]
 <legend class="visually-hidden">Share list</legend>
 <fieldset class="rows">
 <input type="hidden" name="op" value="cud-invite" />
 <input type="hidden" name="shelfnumber" value="[% shelfnumber | html %]" />
 <ol>
 <li> <label for="name">Tên danh sách:</label> [% shelfname | html %] </li>
 <li>
 <label for="invite_address">Địa chỉ Email:</label>
 <input type="text" id="invite_address" name="invite_address" size="40" />
 </li>
 </ol>
 </fieldset>
 <fieldset class="action">
 <input class="btn btn-primary" type="submit" value="Gửi" />
 <a href="/cgi-bin/koha/opac-shelves.pl?op=list" class="cancel">Hủy bỏ</a>
 </fieldset>
 </form>
 <!-- /#share_list -->
 </div>
 <!-- /#invite -->
 [% ELSIF op == 'invited' %]
 <div id="conf_invite">
 [% IF approvedaddress %]
 <p>Lời mời chia sẻ giá sách ảo <em>[% shelfname | html %]</em> will be sent shortly to [% approvedaddress | html %].</p>
 [% END %]
 [% IF failaddress %]
 <p>Phát hiện lỗi khi hệ thống xử lý địa chỉ sau đây. Bạn vui lòng kiểm tra lại. Địa chỉ: [% failaddress | html %]</p>
 [% END %]
 [% IF approvedaddress %]
 <p>You will receive an email notification if someone accepts your share before it expires.</p>
 [% END %]
 <p><a href="/cgi-bin/koha/opac-shelves.pl?op=list">Return to your lists</a></p>
 </div>
 [% ELSIF op == 'accept' %]
 <div id="accept">
 <form method="post" id="accept_share">
 [% INCLUDE 'csrf-token.inc' %]
 <legend class="visually-hidden">Accept shared list</legend>
 <p>One of our patrons invited you to share their list [% shelfname | html %].</p>
 <input type="hidden" name="op" value="cud-accept" />
 <input type="hidden" name="shelfnumber" value="[% shelfnumber | html %]" />
 <input type="hidden" name="key" value="[% key | html %]" />
 <fieldset class="action">
 <input class="btn btn-primary" type="submit" value="Chấp nhận" />
 <a href="/cgi-bin/koha/opac-shelves.pl?op=list" class="cancel">Hủy bỏ</a>
 </fieldset>
 </form>
 <!-- /#accept_share -->
 </div>
 <!-- /#accept -->
 [% END %]
 [%# End of essential part %]
 </div>
 <!-- / #shareshelf.maincontent -->
 </div>
 <!-- / .span10 -->
 </div>
 <!-- / .row -->
 </div>
 <!-- / .container-fluid -->
</main>
<!-- / .main -->

[% INCLUDE 'opac-bottom.inc' %]
[% BLOCK jsinclude %]
 <script nonce="[% Koha.CSPNonce | $raw %]">
        $(document).ready(function () {
            $("#share_list").on("submit", function (e) {
                var address = $("#invite_address").val();
                if (address.length == 0) {
                    e.preventDefault();
                }
            });
        });
    </script>
[% END %]

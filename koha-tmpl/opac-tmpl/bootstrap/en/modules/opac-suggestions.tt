[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE Branches %]
[% USE AuthorisedValues %]
[% USE KohaDates %]
[% USE AdditionalContents %]
[% PROCESS 'i18n.inc' %]
[% PROCESS 'html_helpers.inc' %]
[% SET opacsuggestion = AdditionalContents.get( location => "OpacSuggestioninstructions", lang => lang, library => logged_in_user.branchcode || default_branch ) %]
[% SET OpacNav = AdditionalContents.get( location => "OpacNav", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% SET OpacNavBottom = AdditionalContents.get( location => "OpacNavBottom", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% SET AllPublicBranches = Branches.all( search_params => { public => 1 }, selected => logged_in_user.branchcode ) %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% IF ( op_add_form ) %]
 New purchase suggestion
 [% END %]
 [% IF ( op_else ) %]
 Purchase suggestions
 [% END %]
 &rsaquo; [% PROCESS 'library_name_title' %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% BLOCK cssinclude %]
<style>
    .ftu-sugg-wrapper { max-width: 1100px; margin: 0 auto; }
    .ftu-sugg-hero {
        background: linear-gradient(135deg, #FFF5F5 0%, #FFFFFF 65%, #F8FAFC 100%);
        border: 1px solid #F1F5F9;
        border-radius: 20px;
        box-shadow: 0 6px 24px rgba(0,0,0,0.03);
    }
    .ftu-card {
        border: 1px solid #E2E8F0;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 4px 16px rgba(0,0,0,0.03);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    .ftu-card-header {
        background: #F8FAFC;
        border-bottom: 1px solid #E2E8F0;
        padding: 1rem 1.4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .ftu-card-header h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1E293B;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .ftu-card-body {
        padding: 1.5rem;
    }
    .ftu-form-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #334155;
        margin-bottom: 0.4rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .ftu-form-label .required-star {
        color: #dc2626;
        font-weight: bold;
    }
    .ftu-input-group-text {
        background-color: #F8FAFC;
        border-color: #CBD5E1;
        color: #64748B;
    }
    .ftu-form-control, .ftu-form-select {
        border-radius: 10px;
        border: 1.5px solid #CBD5E1;
        padding: 0.65rem 0.9rem;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }
    .ftu-form-control:focus, .ftu-form-select:focus {
        border-color: #A31A24;
        box-shadow: 0 0 0 3px rgba(163, 26, 36, 0.12);
    }
    .ftu-chip-reason {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        background: #F1F5F9;
        color: #475569;
        border: 1px solid #E2E8F0;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }
    .ftu-chip-reason:hover {
        background: #FEE2E2;
        border-color: #FECACA;
        color: #A31A24;
    }
    .ftu-word-badge {
        font-size: 0.78rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 12px;
    }
    .ftu-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 600;
        font-size: 0.82rem;
        padding: 5px 10px;
        border-radius: 8px;
    }
</style>
[% END %]
</head>
[% IF ( loggedinusername ) %][% INCLUDE 'bodytag.inc' bodyid='opac-usersuggestions' bodyclass='scrollto' %][% ELSE %][% INCLUDE 'bodytag.inc' bodyid='opac-suggestions' bodyclass='scrollto' %][% END %]
[% INCLUDE 'masthead.inc' %]

<main class="main">
    [% WRAPPER breadcrumbs %]
        [% IF ( logged_in_user ) %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/opac-user.pl">[% INCLUDE 'patron-title.inc' patron = logged_in_user %]</a>
            [% END %]
        [% END %]
        [% IF ( op_add_form ) %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/opac-suggestions.pl">Purchase suggestions</a>
            [% END %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                <span>New suggestion</span>
            [% END %]
        [% ELSE %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                <span>Purchase suggestions</span>
            [% END %]
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]

    <div class="container-fluid">
        <div class="row">
            <div class="col col-lg-2 order-2 order-lg-1">
                <div id="navigation"> [% INCLUDE 'navigation.inc' IsPatronPage=1 %] </div>
            </div>
            <div class="col-md-12 col-lg-10 order-1">
                <div id="usersuggestions" class="maincontent ftu-sugg-wrapper">

                    <!-- Header Hero Card -->
                    <div class="ftu-sugg-hero p-4 p-md-5 mb-4">
                        <div class="row align-items-center">
                            <div class="col-lg-8">
                                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(163, 26, 36, 0.08); border: 1px solid rgba(163, 26, 36, 0.2);">
                                    <i class="fa fa-book-medical text-danger" style="font-size: 0.85rem;"></i>
                                    <span class="fw-bold text-danger text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Collection Development • FTU Library</span>
                                </div>
                                <h1 class="display-6 fw-bold text-dark mb-2" style="letter-spacing: -0.02em;">
                                    [% IF ( op_add_form ) %]
                                        Library Purchase Suggestions
                                    [% ELSE %]
                                        Your Purchase Suggestions
                                    [% END %]
                                </h1>
                                <p class="text-secondary mb-0 fs-6" style="line-height: 1.6;">
                                    Looking for learning materials, textbooks, or research publications that aren't available yet in the FTU Library? Submit your request below for evaluation and purchase.
                                </p>
                            </div>
                            <div class="col-lg-4 d-none d-lg-flex justify-content-end">
                                <div class="p-3 rounded-4 bg-white border" style="box-shadow: 0 10px 25px rgba(0,0,0,0.04); width: 280px;">
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px; background: #A31A24;">
                                            <i class="fa fa-bell"></i>
                                        </div>
                                        <div>
                                            <div class="small fw-bold text-dark">Prompt Evaluation</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">Status updates sent via email</div>
                                        </div>
                                    </div>
                                    <hr class="my-2 text-muted" />
                                    <div class="small text-muted" style="font-size: 0.8rem; line-height: 1.4;">
                                        <i class="fa fa-check-circle text-success me-1"></i> Academic &amp; course references
                                    </div>
                                    <div class="small text-muted" style="font-size: 0.8rem; line-height: 1.4; margin-top: 4px;">
                                        <i class="fa fa-check-circle text-success me-1"></i> Reference links appreciated
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    [% IF ( op_add_form ) %]
                        [% IF ( Koha.Preference('MaxTotalSuggestions') != '' && patrons_total_suggestions_count >= Koha.Preference('MaxTotalSuggestions') ) %]
                            <div class="alert alert-warning border-0 rounded-4 shadow-sm p-4 mb-4">
                                <h4 class="alert-heading fw-bold"><i class="fa fa-exclamation-triangle me-2"></i>Suggestion Limit Reached</h4>
                                <p class="mb-0">You may only submit up to [% Koha.Preference('MaxTotalSuggestions') | html %] suggestions in [% Koha.Preference('NumberOfSuggestionDays') | html %] days.</p>
                            </div>
                        [% ELSIF ( Koha.Preference('MaxOpenSuggestions') != '' && patrons_pending_suggestions_count >= Koha.Preference('MaxOpenSuggestions') ) %]
                            <div class="alert alert-warning border-0 rounded-4 shadow-sm p-4 mb-4">
                                <h4 class="alert-heading fw-bold"><i class="fa fa-clock me-2"></i>Pending Suggestions Limit Reached</h4>
                                <p class="mb-0">You have reached your limit for open suggestions ([% Koha.Preference('MaxOpenSuggestions') | html %]). Once the library processes those suggestions, you can submit more.</p>
                            </div>
                        [% ELSE %]

                            [% IF ( opacsuggestion ) %]
                                [% PROCESS koha_news_block news => opacsuggestion %]
                            [% END %]

                            [% FOR m IN messages %]
                                <div class="alert alert-[% m.type | html %] rounded-3 mb-4 shadow-sm">
                                    [% SWITCH m.code %]
                                        [% CASE 'biblio_exists' %]
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-info-circle fa-2x text-warning me-3"></i>
                                                <div>
                                                    <strong>A similar title already exists in the catalog:</strong>
                                                    <a href="/cgi-bin/koha/opac-detail.pl?biblionumber=[% m.id | uri %]" class="fw-bold text-primary">[% m.title | html %]</a>.
                                                    Click "Confirm submission" below if you still wish to submit this suggestion.
                                                </div>
                                            </div>
                                        [% CASE %]
                                            <span>[% m.code | html %]</span>
                                    [% END %]
                                </div>
                            [% END %]

                            <form action="/cgi-bin/koha/opac-suggestions.pl" method="post" id="add_suggestion_form" onsubmit="return validateFtuSuggestionForm();">
                                [% INCLUDE 'csrf-token.inc' %]

                                <!-- Card 1: Bibliographical Info -->
                                <div class="ftu-card">
                                    <div class="ftu-card-header">
                                        <h3><i class="fa fa-book text-danger"></i> 1. Document / Bibliographical Information</h3>
                                        <span class="badge bg-light text-secondary border">Fields marked with <span class="text-danger fw-bold">*</span> are required</span>
                                    </div>
                                    <div class="ftu-card-body">
                                        [% IF Koha.Preference( 'OPACSuggestionAutoFill' ) %]
                                            <div class="mb-3 p-3 rounded-3" style="background: #F8FAFC; border: 1px dashed #CBD5E1;">
                                                <label for="isbn" class="ftu-form-label"><i class="fa fa-barcode text-primary"></i> Fast lookup via ISBN / ISSN:</label>
                                                <div class="input-group">
                                                    <span class="input-group-text ftu-input-group-text"><i class="fa fa-search"></i></span>
                                                    <input type="text" id="isbn" name="isbn" maxlength="80" class="form-control ftu-form-control" placeholder="Enter ISBN (e.g. 9786041215481) to automatically fill details" />
                                                </div>
                                                <small class="text-muted mt-1 d-block"><i class="fa fa-magic me-1"></i>Automatic bibliographic metadata lookup from Google Books API.</small>
                                            </div>
                                        [% END %]

                                        <!-- Title -->
                                        <div class="mb-3">
                                            <label for="title" class="ftu-form-label">
                                                <i class="fa fa-heading text-danger"></i> Title <span class="required-star">*</span>
                                            </label>
                                            [% IF biblionumber %]
                                                <div class="p-2 px-3 bg-light rounded-3 border fw-bold text-dark fs-6">
                                                    <a id="title" href="/cgi-bin/koha/opac-detail.pl?biblionumber=[% biblionumber | uri %]" target="_blank" class="text-danger text-decoration-none">
                                                        <i class="fa fa-book-open me-2"></i>[% title | html %]
                                                    </a>
                                                    <input type="hidden" name="title" value="[% title | html %]" />
                                                </div>
                                            [% ELSE %]
                                                <input type="text" id="title" name="title" class="form-control ftu-form-control fs-6" maxlength="255" value="[% title | html %]" placeholder="Enter full or approximate book or document title" required="required" />
                                            [% END %]
                                        </div>

                                        <div class="row g-3">
                                            <!-- Author -->
                                            <div class="col-md-6">
                                                <label for="author" class="ftu-form-label">
                                                    <i class="fa fa-user-edit text-secondary"></i> Author / Editor:
                                                </label>
                                                [% IF biblionumber %]
                                                    <input type="text" id="author" name="author" class="form-control ftu-form-control bg-light" value="[% author | html %]" readonly="readonly" />
                                                [% ELSE %]
                                                    <input type="text" id="author" name="author" class="form-control ftu-form-control" maxlength="80" value="[% author | html %]" placeholder="Author, editor, or translator" />
                                                [% END %]
                                            </div>

                                            <!-- ISBN / ISSN (if autofill not enabled) -->
                                            [% UNLESS ( isbn_hidden or Koha.Preference('OPACSuggestionAutoFill') ) %]
                                                <div class="col-md-6">
                                                    <label for="isbn" class="ftu-form-label"><i class="fa fa-barcode text-secondary"></i> ISBN / ISSN:</label>
                                                    <input type="text" id="isbn" name="isbn" class="form-control ftu-form-control" maxlength="80" value="[% isbn | html %]" placeholder="e.g. 978-0-..." />
                                                </div>
                                            [% END %]

                                            <!-- Publisher -->
                                            [% UNLESS ( publishercode_hidden ) %]
                                                <div class="col-md-6">
                                                    <label for="publishercode" class="ftu-form-label"><i class="fa fa-building text-secondary"></i> Publisher:</label>
                                                    <input type="text" id="publishercode" name="publishercode" class="form-control ftu-form-control" maxlength="80" value="[% publishercode | html %]" placeholder="Publisher name" />
                                                </div>
                                            [% END %]

                                            <!-- Publication year -->
                                            [% UNLESS ( copyrightdate_hidden ) %]
                                                <div class="col-md-3">
                                                    <label for="copyrightdate" class="ftu-form-label"><i class="fa fa-calendar-alt text-secondary"></i> Publication year:</label>
                                                    <input type="text" id="copyrightdate" name="copyrightdate" pattern="[12]\d{3}" size="10" maxlength="4" class="form-control ftu-form-control" value="[% copyrightdate | html %]" placeholder="e.g. 2024" />
                                                </div>
                                            [% END %]

                                            <!-- Quantity -->
                                            [% UNLESS ( quantity_hidden ) %]
                                                <div class="col-md-3">
                                                    <label for="quantity" class="ftu-form-label"><i class="fa fa-layer-group text-secondary"></i> Quantity:</label>
                                                    <input type="number" id="quantity" name="quantity" min="1" max="50" class="form-control ftu-form-control" value="[% quantity || 1 | html %]" />
                                                </div>
                                            [% END %]

                                            <!-- Publication place -->
                                            [% UNLESS ( place_hidden ) %]
                                                <div class="col-md-6">
                                                    <label for="place" class="ftu-form-label"><i class="fa fa-map-marker-alt text-secondary"></i> Publication place:</label>
                                                    <input type="text" id="place" name="place" class="form-control ftu-form-control" maxlength="80" value="[% place | html %]" placeholder="e.g. Hanoi, Ho Chi Minh City, London, New York..." />
                                                </div>
                                            [% END %]

                                            <!-- Collection title -->
                                            [% UNLESS ( collectiontitle_hidden ) %]
                                                <div class="col-md-6">
                                                    <label for="collectiontitle" class="ftu-form-label"><i class="fa fa-folder-open text-secondary"></i> Collection / Series title:</label>
                                                    <input type="text" id="collectiontitle" name="collectiontitle" class="form-control ftu-form-control" maxlength="80" value="[% collectiontitle | html %]" placeholder="Series name if multi-volume" />
                                                </div>
                                            [% END %]

                                            <!-- Document format -->
                                            [% UNLESS ( itemtype_hidden ) %]
                                                <div class="col-md-6">
                                                    <label for="itemtype" class="ftu-form-label"><i class="fa fa-file-lines text-secondary"></i> Document type / Format:</label>
                                                    [% PROCESS 'av-build-dropbox.inc' name="itemtype", category="SUGGEST_FORMAT", size=20, default=itemtype, class="form-select ftu-form-select", empty=1 %]
                                                </div>
                                            [% END %]

                                            <!-- Library branch -->
                                            [% UNLESS ( branchcode_hidden ) %]
                                                <div class="col-md-6">
                                                    <label for="branch" class="ftu-form-label"><i class="fa fa-university text-secondary"></i> Campus library:</label>
                                                    <select name="branchcode" id="branch" class="form-select ftu-form-select">
                                                        [% PROCESS options_for_libraries libraries => AllPublicBranches %]
                                                    </select>
                                                </div>
                                            [% END %]
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 2: Suggestion Details & Link -->
                                <div class="ftu-card">
                                    <div class="ftu-card-header">
                                        <h3><i class="fa fa-clipboard-check text-danger"></i> 2. Suggestion Rationale &amp; Details</h3>
                                        <span class="badge bg-light text-secondary border">Review Support Info</span>
                                    </div>
                                    <div class="ftu-card-body">

                                        <!-- New Field: Document Reference Link -->
                                        <div class="mb-4">
                                            <label for="document_url" class="ftu-form-label">
                                                <i class="fa fa-link text-primary"></i> Reference Link / Document URL:
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text ftu-input-group-text"><i class="fa fa-globe"></i></span>
                                                <input type="url" name="document_url" id="document_url" class="form-control ftu-form-control" maxlength="500" value="[% document_url | html %]" placeholder="Paste link from Amazon, publisher site, book retailer, or journal..." oninput="updateLinkTestBtn(this.value);" />
                                                <button type="button" class="btn btn-outline-secondary" id="btnTestDocLink" onclick="testDocumentUrl();" title="Test open link in new tab" disabled="disabled">
                                                    <i class="fa fa-external-link me-1"></i> Preview Link
                                                </button>
                                            </div>
                                            <small class="text-muted mt-1 d-block"><i class="fa fa-info-circle me-1"></i>Helps acquisition librarians verify current edition, availability, and pricing.</small>
                                        </div>

                                        <!-- Custom Reason with Word Limit -->
                                        <div class="mb-4">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                                                <label for="patronreason" class="ftu-form-label mb-0">
                                                    <i class="fa fa-comment-dots text-danger"></i> Reason for Suggestion:
                                                </label>
                                                <span id="patronreason_counter_badge" class="ftu-word-badge bg-light text-secondary border">
                                                    Word count: <b id="reason_word_count">0</b> / 100 words
                                                </span>
                                            </div>

                                            <!-- Quick suggestion chips -->
                                            <div class="d-flex flex-wrap gap-2 mb-2">
                                                <span class="small text-muted align-self-center me-1"><i class="fa fa-lightbulb text-warning me-1"></i>Quick fill:</span>
                                                <span class="ftu-chip-reason" onclick="applyReasonSnippet('Required reading for coursework and academic curriculum.');">Coursework</span>
                                                <span class="ftu-chip-reason" onclick="applyReasonSnippet('Essential reference for academic research &amp; graduation thesis.');">Research &amp; Thesis</span>
                                                <span class="ftu-chip-reason" onclick="applyReasonSnippet('Newly published professional monograph in economics and business.');">New Release</span>
                                                <span class="ftu-chip-reason" onclick="applyReasonSnippet('Highly recommended reference book currently missing in FTU library.');">Missing Reference</span>
                                            </div>

                                            <textarea name="patronreason" id="patronreason" rows="3" class="form-control ftu-form-control" placeholder="Provide your rationale or academic need (max 100 words) to help library staff prioritize this purchase..." oninput="handleReasonWordCount(this);">[% patronreason | html %]</textarea>
                                            <div id="reason_word_warning" class="text-danger small mt-1" style="display: none;">
                                                <i class="fa fa-exclamation-circle me-1"></i> Word count exceeds the 100-word limit. Please shorten your text.
                                            </div>
                                        </div>

                                        <!-- Notes -->
                                        [% UNLESS ( note_hidden ) %]
                                            <div class="mb-2">
                                                <label for="note" class="ftu-form-label">
                                                    <i class="fa fa-sticky-note text-secondary"></i> Additional Notes for Library Staff:
                                                </label>
                                                <textarea name="note" id="note" rows="2" class="form-control ftu-form-control" placeholder="Any special instructions (e.g. required before specific date, prefer hardcover, etc.)">[% note | html %]</textarea>
                                            </div>
                                        [% END %]

                                        <!-- Hidden negcap field for bot protection -->
                                        <div style="display:none !important;" aria-hidden="true">
                                            <input type="text" name="negcap" tabindex="-1" autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex flex-wrap gap-3 align-items-center mb-5">
                                    <input type="hidden" name="suggested_by_anyone" value="[% suggested_by_anyone | html %]" />
                                    [% IF need_confirm %]
                                        <input type="hidden" name="op" value="cud-add_confirm" />
                                        <button type="submit" class="btn btn-danger btn-lg px-4 py-2 fw-bold shadow-sm" style="background: linear-gradient(135deg, #b91c1c 0%, #991b1b 100%); border: none;">
                                            <i class="fa fa-check me-2"></i> Confirm Purchase Suggestion
                                        </button>
                                    [% ELSIF biblionumber %]
                                        <input type="hidden" name="op" value="cud-add_confirm" />
                                        <input type="hidden" name="biblionumber" value="[% biblionumber | html %]" />
                                        <button type="submit" class="btn btn-danger btn-lg px-4 py-2 fw-bold shadow-sm" style="background: linear-gradient(135deg, #b91c1c 0%, #991b1b 100%); border: none;">
                                            <i class="fa fa-paper-plane me-2"></i> Submit Suggestion
                                        </button>
                                    [% ELSE %]
                                        <input type="hidden" name="op" value="cud-add_validate" />
                                        <button type="submit" class="btn btn-danger btn-lg px-4 py-2 fw-bold shadow-sm" style="background: linear-gradient(135deg, #b91c1c 0%, #991b1b 100%); border: none;">
                                            <i class="fa fa-paper-plane me-2"></i> Submit Suggestion
                                        </button>
                                    [% END %]
                                    <a href="/cgi-bin/koha/opac-suggestions.pl" class="btn btn-outline-secondary btn-lg px-4 py-2">
                                        <i class="fa fa-times me-2"></i> Cancel
                                    </a>
                                </div>
                            </form>
                        [% END %]
                    [% END # /IF op_add_form %]

                    [% IF ( op_else ) %]
                        [% FOR m IN messages %]
                            <div class="alert alert-[% m.type | html %] rounded-3 mb-4 shadow-sm">
                                [% SWITCH m.code %]
                                    [% CASE 'total_suggestions' %]
                                        <span>Suggestion not submitted: You reached your maximum allowed limit ([% Koha.Preference('MaxTotalSuggestions') | html %] suggestions in [% Koha.Preference('NumberOfSuggestionDays') | html %] days).</span>
                                    [% CASE 'too_many' %]
                                        <span>Suggestion not submitted: You have reached the open suggestions limit ([% Koha.Preference('MaxOpenSuggestions') | html %]). Please wait for existing ones to be processed.</span>
                                    [% CASE 'already_exists' %]
                                        <span>Suggestion not submitted: A suggestion for this title already exists.</span>
                                    [% CASE 'success_on_inserted' %]
                                        <div class="d-flex align-items-center">
                                            <i class="fa fa-check-circle fa-2x text-success me-3"></i>
                                            <div>
                                                <h5 class="alert-heading fw-bold mb-1">Suggestion Submitted Successfully!</h5>
                                                <span>Your book purchase request has been forwarded to the FTU Library Acquisition team.</span>
                                            </div>
                                        </div>
                                    [% CASE %]
                                        <span>[% m.code | html %]</span>
                                [% END %]
                            </div>
                        [% END %]

                        [% IF ( deleted ) %]
                            <div class="alert alert-info rounded-3 mb-4"><i class="fa fa-check me-2"></i>Selected suggestions have been deleted.</div>
                        [% END %]

                        <!-- Toolbar & Search -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 p-3 bg-white border rounded-4 shadow-sm">
                            <div>
                                [% IF ( loggedinusername || ( Koha.Preference( 'AnonSuggestions' ) == 1 ) ) %]
                                    <a class="btn btn-danger fw-semibold px-3 py-2 rounded-3 shadow-sm" href="/cgi-bin/koha/opac-suggestions.pl?op=add_form" style="background: linear-gradient(135deg, #b91c1c 0%, #991b1b 100%); border: none;">
                                        <i class="fa fa-plus me-1"></i> New Purchase Suggestion
                                    </a>
                                [% END %]
                            </div>

                            <form action="/cgi-bin/koha/opac-suggestions.pl" class="d-flex flex-wrap align-items-center gap-2 m-0" id="search_suggestions_form" method="get">
                                <div class="input-group input-group-sm" style="width: 280px;">
                                    <input type="text" name="title_filter" id="title_filter" value="[% title_filter | html %]" class="form-control" placeholder="Filter by title..." />
                                    <button type="submit" class="btn btn-danger"><i class="fa fa-search"></i> Filter</button>
                                </div>
                                [% IF Koha.Preference( 'OPACViewOthersSuggestions' ) && loggedinusername %]
                                    <select class="form-select form-select-sm" name="suggested_by_anyone" id="suggested_by_anyone" onchange="this.form.submit();" style="width: auto;">
                                        [% IF suggested_by_anyone %]
                                            <option value="0">Suggested by me</option>
                                            <option value="1" selected="selected">Suggested by anyone</option>
                                        [% ELSE %]
                                            <option value="0" selected="selected">Suggested by me</option>
                                            <option value="1">Suggested by anyone</option>
                                        [% END %]
                                    </select>
                                [% END %]
                            </form>
                        </div>

                        [% IF suggestions.size > 0 %]
                            <form action="/cgi-bin/koha/opac-suggestions.pl" method="post" id="delete_suggestions">
                                [% INCLUDE 'csrf-token.inc' %]
                                <input type="hidden" name="op" value="cud-delete" />

                                <div class="ftu-card">
                                    <div class="table-responsive">
                                        <table id="suggestt" class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    [% IF ( loggedinusername ) %]
                                                        <th style="width: 40px;" class="text-center"><span class="visually-hidden">Select</span></th>
                                                    [% END %]
                                                    <th>Document Information</th>
                                                    <th style="width: 130px;" class="text-center">Date</th>
                                                    <th>Reason &amp; Reference Link</th>
                                                    <th style="width: 160px;" class="text-center">Status</th>
                                                    <th style="width: 40px;"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                [% FOREACH suggestion IN suggestions %]
                                                    <tr>
                                                        [% IF logged_in_user %]
                                                            <td class="text-center selectcol">
                                                                [% IF logged_in_user.borrowernumber == suggestion.suggester.borrowernumber %]
                                                                    [% SET can_delete_suggestion = 1 %]
                                                                    <input type="checkbox" class="cb form-check-input" id="id[% suggestion.suggestionid | html %]" name="delete_field" data-title="[% suggestion.title | html %]" value="[% suggestion.suggestionid | html %]" />
                                                                [% END %]
                                                            </td>
                                                        [% END %]
                                                        <td>
                                                            <div class="fw-bold text-dark fs-6 mb-1">
                                                                [% IF suggestion.biblionumber %]
                                                                    <a href="/cgi-bin/koha/opac-detail.pl?biblionumber=[% suggestion.biblionumber | uri %]" class="text-danger text-decoration-none">
                                                                        <i class="fa fa-book-open me-1"></i>[% suggestion.title | html %]
                                                                    </a>
                                                                [% ELSE %]
                                                                    <i class="fa fa-book text-secondary me-1"></i>[% suggestion.title | html %]
                                                                [% END %]
                                                            </div>
                                                            <div class="small text-muted">
                                                                [% IF ( suggestion.author ) %]<span><i class="fa fa-user me-1"></i>[% suggestion.author | html %]</span> &bull; [% END %]
                                                                [% IF ( suggestion.copyrightdate ) %]<span>Year: [% suggestion.copyrightdate | html %]</span> &bull; [% END %]
                                                                [% IF ( suggestion.publishercode ) %]<span>Publisher: [% suggestion.publishercode | html %]</span>[% END %]
                                                                [% IF ( suggestion.isbn ) %] &bull; <span>ISBN: [% suggestion.isbn | html %]</span>[% END %]
                                                            </div>
                                                        </td>
                                                        <td class="text-center small text-muted" data-order="[% suggestion.suggesteddate | html %]">
                                                            [% IF ( suggestion.suggesteddate ) %][% suggestion.suggesteddate | $KohaDates %][% END %]
                                                        </td>
                                                        <td>
                                                            [% IF ( suggestion.patronreason ) %]
                                                                <div class="small text-dark mb-1">
                                                                    <strong>Reason:</strong> [% suggestion.patronreason | html %]
                                                                </div>
                                                            [% END %]
                                                            [% IF ( suggestion.document_url ) %]
                                                                <div class="mt-1">
                                                                    <a href="[% suggestion.document_url | url %]" target="_blank" rel="noopener noreferrer" class="badge bg-light text-primary border text-decoration-none px-2 py-1">
                                                                        <i class="fa fa-external-link me-1"></i> Reference Link
                                                                    </a>
                                                                </div>
                                                            [% END %]
                                                            [% IF ( suggestion.note ) %]
                                                                <div class="small text-muted mt-1 fst-italic">
                                                                    Notes: [% suggestion.note | html %]
                                                                </div>
                                                            [% END %]
                                                        </td>
                                                        <td class="text-center">
                                                            [% IF ( suggestion.STATUS == 'ASKED' ) %]
                                                                <span class="ftu-status-badge bg-warning text-dark"><i class="fa fa-clock"></i> Pending review</span>
                                                            [% ELSIF ( suggestion.STATUS == 'CHECKED' ) %]
                                                                <span class="ftu-status-badge bg-info text-dark"><i class="fa fa-search"></i> Under evaluation</span>
                                                            [% ELSIF ( suggestion.STATUS == 'ACCEPTED' ) %]
                                                                <span class="ftu-status-badge bg-success text-white"><i class="fa fa-check"></i> Accepted</span>
                                                            [% ELSIF ( suggestion.STATUS == 'ORDERED' ) %]
                                                                <span class="ftu-status-badge bg-primary text-white"><i class="fa fa-shopping-cart"></i> Ordered</span>
                                                            [% ELSIF ( suggestion.STATUS == 'REJECTED' ) %]
                                                                <span class="ftu-status-badge bg-danger text-white"><i class="fa fa-ban"></i> Declined</span>
                                                            [% ELSIF ( suggestion.STATUS == 'AVAILABLE' ) %]
                                                                <span class="ftu-status-badge bg-success text-white"><i class="fa fa-book-bookmark"></i> Available in Library</span>
                                                            [% ELSE %]
                                                                <span class="ftu-status-badge bg-secondary text-white">[% AuthorisedValues.GetByCode( 'SUGGEST_STATUS', suggestion.STATUS, 1 ) | html %]</span>
                                                            [% END %]
                                                            [% IF ( suggestion.reason ) %]
                                                                <div class="small text-muted mt-1" style="font-size: 0.75rem;">([% suggestion.reason | html %])</div>
                                                            [% END %]
                                                        </td>
                                                        <td></td>
                                                    </tr>
                                                [% END # / FOREACH suggestions %]
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                [% IF ( loggedinusername && can_delete_suggestion ) %]
                                    <div class="d-flex align-items-center gap-3 mt-3">
                                        <button type="submit" class="btn btn-outline-danger btn-sm px-3 removeitems">
                                            <i class="fa fa-trash-can me-1"></i> Delete selected suggestions
                                        </button>
                                        <button type="button" class="btn btn-link btn-sm text-secondary text-decoration-none" id="btnSelectAll">Select all</button>
                                        <button type="button" class="btn btn-link btn-sm text-secondary text-decoration-none" id="btnUnselectAll">Deselect all</button>
                                    </div>
                                [% END %]
                            </form>
                        [% ELSE %]
                            <div class="ftu-card p-5 text-center">
                                <div class="mb-3 text-muted">
                                    <i class="fa fa-folder-open fa-3x" style="color: #CBD5E1;"></i>
                                </div>
                                <h5 class="fw-bold text-dark">No purchase suggestions found</h5>
                                <p class="text-secondary small mb-4">You have not submitted any purchase suggestions or none match your filter criteria.</p>
                                <div>
                                    <a href="/cgi-bin/koha/opac-suggestions.pl?op=add_form" class="btn btn-danger fw-semibold px-4 py-2 rounded-3 shadow-sm" style="background: linear-gradient(135deg, #b91c1c 0%, #991b1b 100%); border: none;">
                                        <i class="fa fa-plus me-1"></i> Create purchase suggestion now
                                    </a>
                                </div>
                            </div>
                        [% END %]
                    [% END # /IF op_else %]

                </div>
            </div>
        </div>
    </div>
</main>

[% INCLUDE 'opac-bottom.inc' %]
[% BLOCK jsinclude %]
    [% IF Koha.Preference("OPACSuggestionAutoFill") %]
        [% Asset.js("js/autofill.js") | $raw %]
    [% END %]
    [% INCLUDE 'datatables.inc' %]
    <script nonce="[% Koha.CSPNonce | $raw %]">
        // Count words and enforce 100 words limit
        function countWords(str) {
            if (!str) return 0;
            var words = str.trim().split(/\s+/).filter(function(w) { return w.length > 0; });
            return words.length;
        }

        function handleReasonWordCount(textarea) {
            var maxWords = 100;
            var text = textarea.value;
            var words = text.trim().split(/\s+/).filter(function(w) { return w.length > 0; });
            var wordCount = words.length;

            var counterEl = document.getElementById('reason_word_count');
            var badgeEl = document.getElementById('patronreason_counter_badge');
            var warningEl = document.getElementById('reason_word_warning');

            if (counterEl) counterEl.textContent = wordCount;

            if (wordCount > maxWords) {
                if (badgeEl) {
                    badgeEl.className = 'ftu-word-badge bg-danger text-white border-0';
                }
                if (warningEl) warningEl.style.display = 'block';
            } else if (wordCount >= 85) {
                if (badgeEl) {
                    badgeEl.className = 'ftu-word-badge bg-warning text-dark border-0';
                }
                if (warningEl) warningEl.style.display = 'none';
            } else {
                if (badgeEl) {
                    badgeEl.className = 'ftu-word-badge bg-light text-secondary border';
                }
                if (warningEl) warningEl.style.display = 'none';
            }
        }

        function applyReasonSnippet(snippet) {
            var textarea = document.getElementById('patronreason');
            if (!textarea) return;
            var currentVal = textarea.value.trim();
            if (currentVal.length > 0) {
                textarea.value = currentVal + ' ' + snippet;
            } else {
                textarea.value = snippet;
            }
            handleReasonWordCount(textarea);
            textarea.focus();
        }

        function updateLinkTestBtn(url) {
            var btn = document.getElementById('btnTestDocLink');
            if (!btn) return;
            if (url && url.trim().length > 4) {
                btn.removeAttribute('disabled');
            } else {
                btn.setAttribute('disabled', 'disabled');
            }
        }

        function testDocumentUrl() {
            var input = document.getElementById('document_url');
            if (!input) return;
            var val = input.value.trim();
            if (!val) return;
            if (!/^https?:\/\//i.test(val)) {
                val = 'https://' + val;
            }
            window.open(val, '_blank', 'noopener,noreferrer');
        }

        function validateFtuSuggestionForm() {
            var title = document.getElementById('title');
            if (title && !title.value.trim()) {
                alert('Please enter a title for the requested document.');
                title.focus();
                return false;
            }

            var textarea = document.getElementById('patronreason');
            if (textarea) {
                var words = textarea.value.trim().split(/\s+/).filter(function(w) { return w.length > 0; });
                if (words.length > 100) {
                    alert('Your reason has ' + words.length + ' words, exceeding the 100-word limit. Please shorten it before submitting.');
                    textarea.focus();
                    return false;
                }
            }

            var docUrl = document.getElementById('document_url');
            if (docUrl && docUrl.value.trim()) {
                var url = docUrl.value.trim();
                if (!/^https?:\/\//i.test(url) && url.indexOf('.') > -1) {
                    docUrl.value = 'https://' + url;
                }
            }

            return true;
        }

        $(document).ready(function() {
            var reasonInput = document.getElementById('patronreason');
            if (reasonInput) {
                handleReasonWordCount(reasonInput);
            }
            var docUrlInput = document.getElementById('document_url');
            if (docUrlInput) {
                updateLinkTestBtn(docUrlInput.value);
            }

            if ($("#suggestt").length) {
                $("#suggestt").kohaTable({
                    order: [[1, "desc"]],
                    columnDefs: [
                        { targets: [0], orderable: false, searchable: false },
                        { className: "dtr-control", orderable: false, targets: -1 }
                    ],
                    responsive: true
                });
            }

            $("#btnSelectAll").on("click", function(e) {
                e.preventDefault();
                $(".cb").prop("checked", true);
            });
            $("#btnUnselectAll").on("click", function(e) {
                e.preventDefault();
                $(".cb").prop("checked", false);
            });
        });
    </script>
[% END %]

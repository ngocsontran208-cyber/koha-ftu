[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% PROCESS 'authorities-search-results.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [% IF op == 'list' %]
            Xác nhận lựa chọn
            &rsaquo;
        [% END %]
        [% IF op == 'enqueued' %]
            Tiến trình đã xếp hàng đợi
            &rsaquo;
        [% END %]
        Xóa biểu ghi hàng loạt
        &rsaquo; Biên mục &rsaquo; Koha
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="tools_batch_delete_records" class="tools">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'cat-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/cataloguing/cataloging-home.pl">Biên mục</a>
        [% END %]
        [% IF op == 'list' || op == 'enqueued' %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/tools/batch_delete_records.pl">Xóa biểu ghi hàng loạt</a>
            [% END %]
        [% END %]
        [% IF op == 'list' %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                <span>Xác nhận lựa chọn</span>
            [% END %]
        [% ELSIF op == 'enqueued' %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                <span>Tiến trình đã xếp hàng đợi</span>
            [% END %]
        [% ELSE %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                <span>Xóa biểu ghi hàng loạt</span>
            [% END %]
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' aside='cat-menu' %]
    <h1 class="ftu-clean-title"><i class="fa fa-trash-can"></i> Xóa biểu ghi hàng loạt</h1>
    [% FOREACH message IN messages %]
        [% SET message_class = "alert-info" %]
        [% IF message.type == 'success' %]
            [% message_class = "alert-info" %]
        [% ELSIF message.type == 'warning' %]
            [% message_class = "alert-warning" %]
        [% ELSIF message.type == 'error' %]
            [% message_class = "alert-warning" %]
        [% END %]
        <div class="alert [% message_class | html %]">
            [% IF message.code == 'biblio_not_exists' %]
                <span>Biểu ghi thư mục [% message.biblionumber | html %] không tồn tại trong cơ sở dữ liệu.</span>
            [% ELSIF message.code == 'authority_not_exists' %]
                <span>Biểu ghi chuẩn thẩm quyền [% message.authid | html %] không tồn tại trong cơ sở dữ liệu.</span>
            [% ELSIF message.code == 'cannot_enqueue_job' %]
                <span>Không thể đưa tác vụ này vào hàng đợi xử lý.</span>
            [% END %]

            [% IF message.error %]
                <span>(Chi tiết lỗi: [% message.error | html %]).</span>
            [% END %]
        </div>
    [% END %]
    [% IF op == 'form' %]
        <form method="post" enctype="multipart/form-data" action="/cgi-bin/koha/tools/batch_delete_records.pl" id="record_ids_selection">
            [% INCLUDE 'csrf-token.inc' %]
            <fieldset class="rows">
                <legend><i class="fa fa-list"></i> Loại biểu ghi</legend>
                <ol>
                    <li><label for="biblio_type">Biểu ghi thư mục: </label><input type="radio" name="recordtype" value="biblio" id="biblio_type" checked="checked" /></li>
                    <li><label for="authority_type">Biểu ghi chuẩn thẩm quyền: </label><input type="radio" name="recordtype" value="authority" id="authority_type" /></li>
                    <li class="skip_open_orders">
                        <input type="checkbox" name="skip_open_orders" id="skip_open_orders" checked />
                        <label for="skip_open_orders">Bỏ qua biểu ghi thư mục đang có đơn đặt hàng mở</label>
                    </li>
                </ol>
            </fieldset>

            <br class="clear" />

            [% WRAPPER tabs id= "batch_del_form" %]
                [% WRAPPER tabs_nav %]
                    [% WRAPPER tab_item tabname= "uploadfile_tab" bt_active= 1 %]<span><i class="fa fa-file-arrow-up"></i> Tải tệp danh sách</span>[% END %]
                    [% IF lists.count %]
                        [% WRAPPER tab_item tabname= "shelves_tab" %]<span><i class="fa fa-layer-group"></i> Chọn giá sách ảo / Danh sách</span>[% END %]
                    [% END %]
                    [% WRAPPER tab_item tabname= "enterlist_tab" %]<span><i class="fa fa-keyboard"></i> Nhập danh sách mã số</span>[% END %]
                [% END # /WRAPPER tabs_nav %]

                [% WRAPPER tab_panels %]
                    [% WRAPPER tab_panel tabname="uploadfile_tab" bt_active= 1 %]
                        <fieldset class="rows">
                            <ol>
                                <li><label for="uploadfile">Chọn tệp dữ liệu: </label> <input type="file" id="uploadfile" name="uploadfile" /></li>
                            </ol>
                        </fieldset>
                    [% END # /WRAPPER tab_panel %]

                    [% IF lists.count %]
                        [% WRAPPER tab_panel tabname="shelves_tab" %]
                            <fieldset class="rows">
                                <ol>
                                    <li>
                                        <label for="shelf_number">Chọn danh sách: </label>
                                        <select name="shelf_number" id="shelf_number">
                                            <option value="">-- Chọn một danh sách --</option>
                                            [% FOREACH list IN lists %]
                                                <option value="[% list.shelfnumber | html %]">[% list.shelfname | html %]</option>
                                            [% END %]
                                        </select>
                                    </li>
                                </ol>
                            </fieldset>
                        [% END # /WRAPPER tab_panel %]
                    [% END # /IF lists.count %]

                    [% WRAPPER tab_panel tabname="enterlist_tab" %]
                        <fieldset class="rows">
                            <ol>
                                <li>
                                    <label for="recordnumber_list">Mã số (IDs): </label>
                                    <textarea rows="10" cols="30" id="recordnumber_list" name="recordnumber_list" placeholder="Nhập mỗi mã số trên một dòng..."></textarea>
                                    <div class="hint">Nhập danh sách mã số biblionumber hoặc authid, mỗi mã trên một dòng.</div>
                                </li>
                            </ol>
                        </fieldset>
                    [% END # /WRAPPER tab_panel %]
                [% END # /WRAPPER tab_panels %]
            [% END # /WRAPPER tabs %]

            <fieldset class="action">
                <input type="hidden" name="op" value="cud-list" />
                <input type="submit" class="btn btn-primary" value="Tiếp tục xử lý" />
                <a class="cancel" href="/cgi-bin/koha/cataloguing/cataloging-home.pl">Hủy bỏ</a>
            </fieldset>
        </form>
    [% ELSIF op == 'list' %]
        [% IF records %]
            [% SET form_id = "selectauths" %]
            [% IF recordtype == 'biblio' %]
                [% SET form_id = "selectrecords" %]
            [% END %]
            <form action="/cgi-bin/koha/tools/batch_delete_records.pl" method="post" id="[% form_id | html %]">
                [% IF recordtype == 'biblio' %]
                    <div class="btn-toolbar selections-toolbar">
                        <a id="selectall" href="#" class="btn btn-sm btn-light"><i class="fa fa-check"></i> Chọn tất cả</a>
                        <a id="clearall" href="#" class="btn btn-sm btn-light"><i class="fa fa-times"></i> Bỏ chọn tất cả</a>
                        <a id="selectwithoutitems" href="#" class="btn btn-sm btn-light">Chọn bản ghi không có cuốn</a>
                        <a id="selectnotreserved" href="#" class="btn btn-sm btn-light">Chọn bản ghi không có đặt mượn</a>
                        <a id="selectwithoutsubscriptions" href="#" class="btn btn-sm btn-light">Chọn bản ghi không có ấn phẩm ĐK</a>
                    </div>

                    <div class="page-section">
                        <table id="biblios" class="records table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th class="no-sort"></th>
                                    <th>Mã biểu ghi</th>
                                    <th>Nhan đề tài liệu</th>
                                    <th>Số bản</th>
                                    <th>Đặt mượn</th>
                                    <th>Đang mượn</th>
                                    <th>Ấn phẩm ĐK</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOR biblio IN records %]
                                    <tr>
                                        <td
                                            ><input
                                                type="checkbox"
                                                name="record_id"
                                                id="record_id_[% biblio.biblionumber | html %]"
                                                value="[% biblio.biblionumber | html %]"
                                                data-items="[% biblio.itemnumbers.size | html %]"
                                                data-issues="[% biblio.issues_count | html %]"
                                                data-reserves="[% biblio.holds_count | html %]"
                                                data-subscriptions="[% biblio.subscriptions_count | html %]"
                                        /></td>
                                        <td><label for="record_id_[% biblio.biblionumber | html %]">[% biblio.biblionumber | html %]</label></td>
                                        <td>[% INCLUDE 'biblio-title.inc' link = 1 %]</td>
                                        <td><a href="/cgi-bin/koha/catalogue/moredetail.pl?biblionumber=[% biblio.biblionumber | uri %]">[% biblio.itemnumbers.size | html %]</a></td>
                                        <td><a href="/cgi-bin/koha/reserve/request.pl?biblionumber=[% biblio.biblionumber | uri %]">[% biblio.holds_count | html %]</a></td>
                                        <td><a href="/cgi-bin/koha/catalogue/issuehistory.pl?biblionumber=[% biblio.biblionumber | uri %]">[% biblio.issues_count | html %]</a></td>
                                        <td><a href="/cgi-bin/koha/serials/serials-search.pl?searched=1&biblionumber=[% biblio.biblionumber | uri %]">[% biblio.subscriptions_count | html %]</a></td>
                                    </tr>
                                [% END %]
                            </tbody>
                        </table>
                        <div class="alert alert-warning"><i class="fa fa-triangle-exclamation"></i> <strong>Lưu ý quan trọng:</strong> Thao tác này sẽ xóa vĩnh viễn tất cả các biểu ghi thư mục đã chọn cùng với các ấn phẩm định kỳ, yêu cầu đặt mượn và các bản tài liệu đính kèm!</div>
                    </div>
                [% ELSE %]
                    <div class="btn-toolbar selections-toolbar">
                        <a id="selectall" href="#" class="btn btn-sm btn-light"><i class="fa fa-check"></i> Chọn tất cả</a>
                        <a id="clearall" href="#" class="btn btn-sm btn-light"><i class="fa fa-times"></i> Bỏ chọn tất cả</a>
                        <a id="clearlinkedtobiblio" href="#" class="btn btn-sm btn-light">Chọn thẩm quyền chưa liên kết</a>
                    </div>
                    [% INCLUDE 'csrf-token.inc' %]
                    <table id="authorities" class="records table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th class="no-sort"></th>
                                <th>Mã thẩm quyền</th>
                                <th>Tóm tắt thông tin</th>
                                <th>Đang dùng trong</th>
                            </tr>
                        </thead>
                        <tbody>
                            [% FOR authority IN records %]
                                <tr>
                                    <td><input type="checkbox" name="record_id" value="[% authority.authid | html %]" data-usage="[% authority.count_usage | html %]" /></td>
                                    <td><a href="/cgi-bin/koha/authorities/detail.pl?authid=[% authority.authid | uri %]">[% authority.authid | html %]</a></td>
                                    <td>[% PROCESS authresult summary=authority.summary authid=authority.authid %]</td>
                                    <td><a href="/cgi-bin/koha/catalogue/search.pl?type=intranet&amp;op=do_search&amp;idx=an,phr&amp;q=[% authority.authid | uri %]">[% authority.count_usage | html %] biểu ghi</a></td>
                                </tr>
                            [% END %]
                        </tbody>
                    </table>
                    <div class="alert alert-warning"><i class="fa fa-triangle-exclamation"></i> <strong>Lưu ý quan trọng:</strong> Thao tác này sẽ xóa vĩnh viễn tất cả các biểu ghi chuẩn thẩm quyền đã chọn!</div>
                [% END %]
                <fieldset class="action">
                    [% INCLUDE 'csrf-token.inc' %]
                    <input type="hidden" name="op" value="cud-delete" />
                    <input type="hidden" name="recordtype" value="[% recordtype | html %]" />
                    <input type="submit" class="btn btn-danger" value="Xóa các biểu ghi đã chọn" />
                    <a class="cancel" href="/cgi-bin/koha/tools/batch_delete_records.pl">Hủy bỏ</a>
                </fieldset>
            </form>
        [% ELSE %]
            <div class="alert alert-info">Không có mã số biểu ghi nào được chỉ định.</div>
        [% END %]
    [% ELSIF op == 'enqueued' %]
        <div class="alert alert-info">
            <h2><i class="fa fa-check-circle"></i> Tiến trình đã được đưa vào hàng đợi!</h2>
            <p>Hệ thống sẽ thực hiện tác vụ xóa hàng loạt trong nền trong thời gian sớm nhất.</p>
            <p
                ><a href="/cgi-bin/koha/admin/background_jobs.pl?op=view&id=[% job_id | uri %]" title="Xem chi tiết tiến trình" class="btn btn-sm btn-primary">Xem chi tiết tiến trình</a>
                <a href="/cgi-bin/koha/tools/batch_delete_records.pl" title="Tạo phiên xóa biểu ghi hàng loạt mới" class="btn btn-sm btn-light">Tạo phiên xóa biểu ghi mới</a></p
            >
        </div>
    [% ELSE %]
        <div class="alert alert-warning">Không có thao tác nào được chỉ định cho trang này.</div>
    [% END %]
[% END %]

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'datatables.inc' %]
    <script nonce="[% Koha.CSPNonce | $raw %]" data-tt-allowed="true">
        const recordtype = "[% recordtype | html %]";
    </script>
    <script nonce="[% Koha.CSPNonce | $raw %]">
        var MSG_CANNOT_BE_DELETED = _("Biểu ghi này không thể xóa vì có ít nhất một bản tài liệu đang được bạn đọc mượn.");
        $(document).ready(function () {
            $("input[type='radio']").click(function () {
                if ($(this).attr("id") == "authority_type") {
                    $("a[href='#shelves_tab_panel']").parent().hide();
                    $("li.skip_open_orders").hide();
                } else if ($(this).attr("id") == "biblio_type") {
                    $("a[href='#shelves_tab_panel']").parent().show();
                    $("li.skip_open_orders").show();
                }
            });

            $("#selectall").click(function (e) {
                e.preventDefault();
                $(".records input[type='checkbox']:not(:disabled)").each(function () {
                    $(this).prop("checked", true);
                });
            });

            $("#clearall").click(function (e) {
                e.preventDefault();
                $(".records input[type='checkbox']:not(:disabled)").each(function () {
                    $(this).prop("checked", false);
                });
            });

            $("#selectwithoutitems").click(function (e) {
                e.preventDefault();
                $(".records input[type='checkbox']:not(:disabled)").each(function () {
                    if ($(this).data("items") == 0) {
                        $(this).prop("checked", true);
                    } else {
                        $(this).prop("checked", false);
                    }
                });
            });

            $("#selectnotreserved").click(function (e) {
                e.preventDefault();
                $(".records input[type='checkbox']:not(:disabled)").each(function () {
                    if ($(this).data("reserves") == 0) {
                        $(this).prop("checked", true);
                    } else {
                        $(this).prop("checked", false);
                    }
                });
            });

            $("#selectwithoutsubscriptions").click(function (e) {
                e.preventDefault();
                $(".records input[type='checkbox']:not(:disabled)").each(function () {
                    if ($(this).data("subscriptions") == 0) {
                        $(this).prop("checked", true);
                    } else {
                        $(this).prop("checked", false);
                    }
                });
            });

            $("#clearlinkedtobiblio").click(function (e) {
                e.preventDefault();
                $(".records input[type='checkbox']:not(:disabled)").each(function () {
                    if ($(this).data("usage") == 0) {
                        $(this).prop("checked", true);
                    } else {
                        $(this).prop("checked", false);
                    }
                });
            });

            $("#selectall").click();

            // Show a red cross if a biblio cannot be deleted
            if (recordtype == "biblio") {
                $(".records input:checkbox[data-issues!='0']").each(function () {
                    $(this).parents("tr").find("td").css("background-color", "#fef2f2");
                    $(this).replaceWith("<span class='text-danger' style='font-weight: bold;'><i class='fa fa-times fa-lg'></i></span>");
                    $(".records i").attr("title", MSG_CANNOT_BE_DELETED);
                });
            }

            $("#biblios").kohaTable({
                columnDefs: [{ targets: [3, 4], type: "num-html" }],
                dom: "t",
                order: [],
                paging: false,
            });

            $("#authorities").kohaTable({
                columnDefs: [{ targets: [3], type: "num-html" }],
                dom: "t",
                order: [],
                paging: false,
            });

            $("#selectrecords").on("submit", function () {
                var nb_checked = $("#selectrecords").find("input[type='checkbox'][name='record_id']:checked").size();
                if (nb_checked == 0) {
                    alert(_("Chưa có biểu ghi nào được chọn."));
                    return false;
                }
            });

            $("#selectauths").on("submit", function () {
                var checked = $("#selectauths").find("input[type='checkbox'][name='record_id']:checked").size();
                if (checked == 0) {
                    alert(_("Chưa có biểu ghi chuẩn thẩm quyền nào được chọn."));
                    return false;
                }
            });

            $("#record_ids_selection").on("submit", function (e) {
                var tab = $(this).find("#batch_del_form li a.active:first").attr("href");
                if (tab == "#uploadfile_tab_panel") {
                    $("#shelf_number").empty("");
                    $("#recordnumber_list").val("");
                } else if (tab == "#shelves_tab_panel") {
                    $("#uploadfile").val("");
                    $("#recordnumber_list").val("");
                } else {
                    // enterlist
                    $("#uploadfile").val("");
                    $("#shelf_number").empty("");
                }
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]

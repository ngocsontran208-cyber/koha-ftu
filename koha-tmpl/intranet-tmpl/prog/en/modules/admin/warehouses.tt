[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE KohaDates %]
[% USE Branches %]
[% USE Categories %]
[% USE ItemTypes %]
[% USE AuthorisedValues %]
[% USE CirculationRules %]
[% USE Price %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>
    [% FILTER collapse %]
        [% IF op == 'add_warehouse_form' %]
            New shelving location &rsaquo; Warehouses &amp; Circulation rules
        [% ELSIF op == 'edit_warehouse_form' %]
            Modify shelving location: [% warehouse.lib | html %] &rsaquo; Warehouses &amp; Circulation rules
        [% ELSIF op == 'add_rule_form' %]
            New circulation rule &rsaquo; Warehouses &amp; Circulation rules
        [% ELSIF op == 'edit_rule_form' %]
            Modify circulation rule &rsaquo; Warehouses &amp; Circulation rules
        [% ELSE %]
            Warehouses &amp; Circulation rules
        [% END %]
        &rsaquo; [% t("Administration") | html %] &rsaquo; Koha
    [% END %]
</title>
[% INCLUDE 'doc-head-close.inc' %]

<style>
.badge-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    background: #f1f5f9;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 600;
}
.badge-all {
    background: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
}
.nav-tabs .nav-link {
    font-weight: 600;
    color: #475569;
}
.nav-tabs .nav-link.active {
    color: #0284c7;
    border-bottom-color: #ffffff;
}
</style>
</head>

<body id="admin_warehouses" class="admin">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'prefs-admin-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/admin/admin-home.pl">[% t("Administration") | html %]</a>
        [% END %]

        [% IF op == 'add_warehouse_form' %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/admin/warehouses.pl">Warehouses &amp; Circulation rules</a>
            [% END %]
            [% WRAPPER breadcrumb_item bc_active = 1 %]
                <span>New shelving location</span>
            [% END %]
        [% ELSIF op == 'edit_warehouse_form' %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/admin/warehouses.pl">Warehouses &amp; Circulation rules</a>
            [% END %]
            [% WRAPPER breadcrumb_item bc_active = 1 %]
                <span>Modify shelving location: [% warehouse.lib | html %]</span>
            [% END %]
        [% ELSIF op == 'add_rule_form' %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/admin/warehouses.pl?tab=rules">Warehouses &amp; Circulation rules</a>
            [% END %]
            [% WRAPPER breadcrumb_item bc_active = 1 %]
                <span>New circulation rule</span>
            [% END %]
        [% ELSIF op == 'edit_rule_form' %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/admin/warehouses.pl?tab=rules">Warehouses &amp; Circulation rules</a>
            [% END %]
            [% WRAPPER breadcrumb_item bc_active = 1 %]
                <span>Modify circulation rule</span>
            [% END %]
        [% ELSE %]
            [% WRAPPER breadcrumb_item bc_active = 1 %]
                <span>Warehouses &amp; Circulation rules</span>
            [% END %]
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' aside='admin-menu' %]

    <!-- Messages Alerts -->
    [% FOR m IN messages %]
        <div class="alert alert-[% m.type | html %] alert-dismissible fade show" role="alert">
            [% IF m.type == 'success' %]
                <i class="fa fa-check-circle me-1"></i>
            [% ELSE %]
                <i class="fa fa-exclamation-triangle me-1"></i>
            [% END %]
            [% m.text | html %]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    [% END %]

    <!-- ================================================================= -->
    <!-- FORM 1: ADD / EDIT SHELVING LOCATION (Koha::AuthorisedValues - LOC) -->
    <!-- ================================================================= -->
    [% IF op == 'add_warehouse_form' || op == 'edit_warehouse_form' %]
        <h1>
            [% IF is_add %]
                <span>New shelving location (LOC)</span>
            [% ELSE %]
                <span>Modify shelving location: [% warehouse.lib | html %]</span>
            [% END %]
        </h1>

        <form action="/cgi-bin/koha/admin/warehouses.pl" method="post" id="warehouse-form" class="validated">
            [% INCLUDE 'csrf-token.inc' %]
            <input type="hidden" name="op" value="cud-save_warehouse" />
            [% IF !is_add %]
                <input type="hidden" name="id" value="[% warehouse.id | html %]" />
            [% END %]

            <div class="page-section">
                <fieldset class="rows">
                    <legend>Shelving location details</legend>
                    <ol>
                        <li>
                            <label for="authorised_value" class="required">Location code (LOC): </label>
                            [% IF is_add %]
                                <input type="text" name="authorised_value" id="authorised_value" value="[% warehouse.authorised_value | html %]" maxlength="80" required="required" placeholder="e.g. KHO_MUON" style="text-transform: uppercase;" />
                                <span class="required">Required</span>
                                <div class="hint">Alphanumeric code, corresponds to MARC 952$c and items.location.</div>
                            [% ELSE %]
                                <input type="text" name="authorised_value" id="authorised_value" value="[% warehouse.authorised_value | html %]" readonly="readonly" class="readonly" />
                                <span class="hint">Location code cannot be changed after creation.</span>
                            [% END %]
                        </li>
                        <li>
                            <label for="lib" class="required">Description (Staff): </label>
                            <input type="text" name="lib" id="lib" value="[% warehouse.lib | html %]" maxlength="200" required="required" placeholder="e.g. Main Lending Stacks" style="width: 50%;" />
                            <span class="required">Required</span>
                        </li>
                        <li>
                            <label for="lib_opac">OPAC description: </label>
                            <input type="text" name="lib_opac" id="lib_opac" value="[% warehouse.lib_opac | html %]" maxlength="200" placeholder="e.g. Lending Stacks - 2nd Floor" style="width: 50%;" />
                            <div class="hint">Description shown on OPAC. Leave empty to use staff description.</div>
                        </li>
                        <li>
                            <label for="branches">Library limitation: </label>
                            <select name="branches" id="branches" multiple="multiple" size="5" style="width: 50%;">
                                [% FOREACH b IN Branches.all( unfiltered => 1 ) %]
                                    [% SET selected = 0 %]
                                    [% FOREACH sb IN selected_branches %]
                                        [% IF sb.branchcode == b.branchcode %][% SET selected = 1 %][% END %]
                                    [% END %]
                                    <option value="[% b.branchcode | html %]" [% IF selected %]selected="selected"[% END %]>[% b.branchname | html %]</option>
                                [% END %]
                            </select>
                            <div class="hint">Select libraries that can use this location. Leave empty for all libraries.</div>
                        </li>
                    </ol>
                </fieldset>

                <fieldset class="action">
                    <input type="submit" value="Save location" class="btn btn-primary" />
                    <a class="cancel" href="/cgi-bin/koha/admin/warehouses.pl">Cancel</a>
                </fieldset>
            </div>
        </form>

    <!-- ================================================================= -->
    <!-- FORM 2: ADD / EDIT CIRCULATION RULE (Koha::CirculationRules)    -->
    <!-- ================================================================= -->
    [% ELSIF op == 'add_rule_form' || op == 'edit_rule_form' %]
        <h1>
            [% IF op == 'add_rule_form' %]
                <span>New circulation rule</span>
            [% ELSE %]
                <span>Modify circulation rule</span>
            [% END %]
        </h1>

        <form action="/cgi-bin/koha/admin/warehouses.pl" method="post" id="rule-form" class="validated">
            [% INCLUDE 'csrf-token.inc' %]
            <input type="hidden" name="op" value="cud-save_rule" />

            <div class="page-section">
                <fieldset class="rows">
                    <legend>Rule scope</legend>
                    <ol>
                        <li>
                            <label for="branchcode">Library / Branch: </label>
                            <select name="branchcode" id="branchcode">
                                <option value="*" [% IF branchcode == '*' %]selected="selected"[% END %]>* All libraries</option>
                                [% FOREACH b IN libraries %]
                                    <option value="[% b.branchcode | html %]" [% IF b.branchcode == branchcode %]selected="selected"[% END %]>[% b.branchname | html %]</option>
                                [% END %]
                            </select>
                        </li>
                        <li>
                            <label for="categorycode">Patron category: </label>
                            <select name="categorycode" id="categorycode">
                                <option value="*" [% IF categorycode == '*' %]selected="selected"[% END %]>* All patron categories</option>
                                [% FOREACH c IN patron_categories %]
                                    <option value="[% c.categorycode | html %]" [% IF c.categorycode == categorycode %]selected="selected"[% END %]>[% c.description | html %] ([% c.categorycode | html %])</option>
                                [% END %]
                            </select>
                        </li>
                        <li>
                            <label for="itemtype">Item type: </label>
                            <select name="itemtype" id="itemtype">
                                <option value="*" [% IF itemtype == '*' %]selected="selected"[% END %]>* All item types</option>
                                [% FOREACH it IN itemtypes %]
                                    <option value="[% it.itemtype | html %]" [% IF it.itemtype == itemtype %]selected="selected"[% END %]>[% it.description | html %] ([% it.itemtype | html %])</option>
                                [% END %]
                            </select>
                        </li>
                    </ol>
                </fieldset>

                <fieldset class="rows">
                    <legend>Circulation &amp; fine policies</legend>
                    <ol>
                        <li>
                            <label for="maxissueqty">Current checkouts allowed: </label>
                            <input type="number" min="0" max="100" name="maxissueqty" id="maxissueqty" value="[% rule.maxissueqty || 5 | html %]" />
                            <span class="hint">Maximum books a patron can check out (0 = no checkouts allowed).</span>
                        </li>
                        <li>
                            <label for="issuelength">Loan period: </label>
                            <input type="number" min="1" max="365" name="issuelength" id="issuelength" value="[% rule.issuelength || 14 | html %]" />
                            <select name="lengthunit" id="lengthunit">
                                <option value="days" [% IF rule.lengthunit == 'days' || !rule.lengthunit %]selected="selected"[% END %]>Days</option>
                                <option value="hours" [% IF rule.lengthunit == 'hours' %]selected="selected"[% END %]>Hours</option>
                            </select>
                        </li>
                        <li>
                            <label for="renewalsallowed">Renewals allowed: </label>
                            <input type="number" min="0" max="10" name="renewalsallowed" id="renewalsallowed" value="[% rule.renewalsallowed || 2 | html %]" />
                            <span class="hint">Maximum number of times a loan can be renewed.</span>
                        </li>
                        <li>
                            <label for="renewalperiod">Renewal period: </label>
                            <input type="number" min="0" max="90" name="renewalperiod" id="renewalperiod" value="[% rule.renewalperiod || 7 | html %]" />
                            <span class="hint">Number of days added per renewal.</span>
                        </li>
                        <li>
                            <label for="maxonsiteissueqty">Current on-site checkouts allowed: </label>
                            <input type="number" min="0" max="50" name="maxonsiteissueqty" id="maxonsiteissueqty" value="[% rule.maxonsiteissueqty || 5 | html %]" />
                            <span class="hint">For reading room / in-library loans only.</span>
                        </li>
                        <li>
                            <label for="fine">Overdue fine amount: </label>
                            <input type="number" min="0" step="500" name="fine" id="fine" value="[% rule.fine || 0 | html %]" />
                            <span class="hint">Fine charged per day overdue.</span>
                        </li>
                        <li>
                            <label for="reservesallowed">Holds allowed (total): </label>
                            <input type="number" min="0" max="10" name="reservesallowed" id="reservesallowed" value="[% rule.reservesallowed || 2 | html %]" />
                            <span class="hint">Maximum active holds a patron can place.</span>
                        </li>
                        <li>
                            <label for="note">Rule note: </label>
                            <textarea name="note" id="note" rows="2" style="width: 50%;">[% rule.note | html %]</textarea>
                        </li>
                    </ol>
                </fieldset>

                <fieldset class="action">
                    <input type="submit" value="Save rule" class="btn btn-primary" />
                    <a class="cancel" href="/cgi-bin/koha/admin/warehouses.pl?tab=rules">Cancel</a>
                </fieldset>
            </div>
        </form>

    <!-- ================================================================= -->
    <!-- DEFAULT: SHELVING LOCATIONS & CIRCULATION RULES LIST             -->
    <!-- ================================================================= -->
    [% ELSE %]
        <h1>Warehouses &amp; Circulation rules</h1>

        <!-- Toolbar -->
        <div id="toolbar" class="btn-toolbar">
            <a class="btn btn-default" id="new_warehouse" href="/cgi-bin/koha/admin/warehouses.pl?op=add_warehouse_form">
                <i class="fa fa-plus"></i> New shelving location
            </a>
            <a class="btn btn-default" id="new_rule" href="/cgi-bin/koha/admin/warehouses.pl?op=add_rule_form">
                <i class="fa fa-plus"></i> New circulation rule
            </a>
            <a class="btn btn-default" href="/cgi-bin/koha/admin/smart-rules.pl">
                <i class="fa fa-sliders"></i> Full circulation matrix (Koha Core)
            </a>
            <a class="btn btn-default" href="/cgi-bin/koha/admin/authorised_values.pl?searchfield=LOC">
                <i class="fa fa-list"></i> Authorized values for LOC
            </a>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs" id="warehouseTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link [% IF active_tab != 'rules' %]active[% END %]" id="warehouses-tab" data-bs-toggle="tab" data-bs-target="#warehouses-pane" type="button" role="tab">
                    <i class="fa fa-boxes"></i> Shelving locations (LOC) <span class="badge bg-secondary">[% total_warehouses | html %]</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link [% IF active_tab == 'rules' %]active[% END %]" id="rules-tab" data-bs-toggle="tab" data-bs-target="#rules-pane" type="button" role="tab">
                    <i class="fa fa-sliders"></i> Circulation &amp; fine rules <span class="badge bg-secondary">[% total_rules | html %]</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="warehouseTabsContent">
            <!-- TAB 1: SHELVING LOCATIONS -->
            <div class="tab-pane fade [% IF active_tab != 'rules' %]show active[% END %]" id="warehouses-pane" role="tabpanel">
                <div class="page-section">
                    <table id="table_warehouses" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Code (LOC)</th>
                                <th>Description (Staff)</th>
                                <th>OPAC description</th>
                                <th>Library limitation</th>
                                <th class="text-center">Items on shelf</th>
                                <th class="no-export">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            [% FOREACH w IN warehouses %]
                                <tr>
                                    <td>
                                        <span class="badge-code">[% w.authorised_value | html %]</span>
                                    </td>
                                    <td>
                                        <strong>[% w.lib | html %]</strong>
                                    </td>
                                    <td>
                                        [% IF w.lib_opac %]
                                            [% w.lib_opac | html %]
                                        [% ELSE %]
                                            <span class="text-muted"><em>Same as staff</em></span>
                                        [% END %]
                                    </td>
                                    <td>
                                        [% w.branches_display | html %]
                                    </td>
                                    <td class="text-center">
                                        <a href="/cgi-bin/koha/catalogue/search.pl?idx=loc&q=[% w.authorised_value | uri %]" title="Search items in this location">
                                            <i class="fa fa-book"></i> [% w.items_count | html %] items
                                        </a>
                                    </td>
                                    <td class="actions">
                                        <a class="btn btn-default btn-xs" href="/cgi-bin/koha/admin/warehouses.pl?op=edit_warehouse_form&amp;id=[% w.id | uri %]">
                                            <i class="fa fa-pencil"></i> Edit
                                        </a>
                                        <form action="/cgi-bin/koha/admin/warehouses.pl" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete shelving location \'[% w.lib | html %]\' ([% w.authorised_value | html %])?');">
                                            [% INCLUDE 'csrf-token.inc' %]
                                            <input type="hidden" name="op" value="cud-delete_warehouse" />
                                            <input type="hidden" name="id" value="[% w.id | html %]" />
                                            <button type="submit" class="btn btn-default btn-xs text-danger">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            [% END %]
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 2: CIRCULATION RULES -->
            <div class="tab-pane fade [% IF active_tab == 'rules' %]show active[% END %]" id="rules-pane" role="tabpanel">
                <div class="page-section">
                    <form method="get" action="/cgi-bin/koha/admin/warehouses.pl" class="mb-3" id="selectlibrary">
                        <input type="hidden" name="tab" value="rules" />
                        <label for="branch"><strong>Filter by library:</strong> </label>
                        <select name="branch" id="branch" onchange="this.form.submit()">
                            <option value="*" [% IF current_branch == '*' %]selected="selected"[% END %]>* All libraries</option>
                            [% FOREACH b IN Branches.all( unfiltered => 1 ) %]
                                <option value="[% b.branchcode | html %]" [% IF b.branchcode == current_branch %]selected="selected"[% END %]>[% b.branchname | html %]</option>
                            [% END %]
                        </select>
                    </form>

                    <table id="table_rules" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Library</th>
                                <th>Patron category</th>
                                <th>Item type</th>
                                <th class="text-center">Checkouts allowed</th>
                                <th class="text-center">Loan period</th>
                                <th class="text-center">Renewals</th>
                                <th class="text-center">On-site</th>
                                <th class="text-center">Fine</th>
                                <th class="text-center">Holds</th>
                                <th>Note</th>
                                <th class="no-export">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            [% FOREACH r IN circulation_rules %]
                                <tr>
                                    <td>
                                        [% IF r.branchcode %]
                                            [% Branches.GetName(r.branchcode) | html %]
                                        [% ELSE %]
                                            <span class="badge-all"><i class="fa fa-globe"></i> All libraries</span>
                                        [% END %]
                                    </td>
                                    <td>
                                        [% IF r.categorycode %]
                                            [% Categories.GetName(r.categorycode) | html %]
                                        [% ELSE %]
                                            <span class="badge-all"><i class="fa fa-users"></i> All patrons</span>
                                        [% END %]
                                    </td>
                                    <td>
                                        [% IF r.itemtype %]
                                            [% ItemTypes.GetDescription(r.itemtype, 1) | html %]
                                        [% ELSE %]
                                            <span class="badge-all"><i class="fa fa-layer-group"></i> All items</span>
                                        [% END %]
                                    </td>
                                    <td class="text-center">
                                        [% IF r.maxissueqty.defined %]
                                            <strong>[% r.maxissueqty | html %]</strong>
                                        [% ELSE %]
                                            <span class="text-muted">&mdash;</span>
                                        [% END %]
                                    </td>
                                    <td class="text-center">
                                        [% IF r.issuelength.defined %]
                                            [% r.issuelength | html %] [% r.lengthunit == 'hours' ? 'hours' : 'days' %]
                                        [% ELSE %]
                                            <span class="text-muted">&mdash;</span>
                                        [% END %]
                                    </td>
                                    <td class="text-center">
                                        [% IF r.renewalsallowed.defined %]
                                            [% r.renewalsallowed | html %] ([% r.renewalperiod | html %] days)
                                        [% ELSE %]
                                            <span class="text-muted">&mdash;</span>
                                        [% END %]
                                    </td>
                                    <td class="text-center">
                                        [% IF r.maxonsiteissueqty.defined %]
                                            [% r.maxonsiteissueqty | html %]
                                        [% ELSE %]
                                            <span class="text-muted">&mdash;</span>
                                        [% END %]
                                    </td>
                                    <td class="text-center">
                                        [% IF r.fine.defined && r.fine > 0 %]
                                            <strong class="text-danger">[% r.fine | $Price %]</strong>
                                        [% ELSE %]
                                            0
                                        [% END %]
                                    </td>
                                    <td class="text-center">
                                        [% r.reservesallowed.defined ? r.reservesallowed : '&mdash;' %]
                                    </td>
                                    <td>
                                        [% r.note | html %]
                                    </td>
                                    <td class="actions">
                                        <a class="btn btn-default btn-xs" href="/cgi-bin/koha/admin/warehouses.pl?op=edit_rule_form&amp;branchcode=[% r.branchcode || '*' | uri %]&amp;categorycode=[% r.categorycode || '*' | uri %]&amp;itemtype=[% r.itemtype || '*' | uri %]">
                                            <i class="fa fa-pencil"></i> Edit
                                        </a>
                                        [% IF r.branchcode || r.categorycode || r.itemtype %]
                                            <form action="/cgi-bin/koha/admin/warehouses.pl" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this circulation rule?');">
                                                [% INCLUDE 'csrf-token.inc' %]
                                                <input type="hidden" name="op" value="cud-delete_rule" />
                                                <input type="hidden" name="branchcode" value="[% r.branchcode | html %]" />
                                                <input type="hidden" name="categorycode" value="[% r.categorycode | html %]" />
                                                <input type="hidden" name="itemtype" value="[% r.itemtype | html %]" />
                                                <button type="submit" class="btn btn-default btn-xs text-danger">
                                                    <i class="fa fa-trash"></i> Delete
                                                </button>
                                            </form>
                                        [% END %]
                                    </td>
                                </tr>
                            [% END %]
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    [% END %]

[% END #/ WRAPPER main-container.inc %]

[% MACRO jsinclude BLOCK %]
[% Asset.js("js/admin-menu.js") | $raw %]
[% INCLUDE 'datatables.inc' %]
<script>
$(document).ready(function() {
    [% IF op == 'list' %]
        $("#table_warehouses").kohaTable({
            "order": [[ 0, "asc" ]],
            "paging": true
        });

        $("#table_rules").kohaTable({
            "order": [[ 0, "asc" ], [ 1, "asc" ]],
            "paging": true
        });

        // Tab state preservation
        $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function(e) {
            var target = $(e.target).attr("data-bs-target");
            var tabName = target === '#rules-pane' ? 'rules' : 'warehouses';
            var newUrl = window.location.pathname + '?tab=' + tabName;
            history.replaceState(null, '', newUrl);
        });
    [% END %]
});
</script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]

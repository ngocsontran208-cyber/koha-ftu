[% USE raw %]
[% USE To %]
[% USE Asset %]
[% USE Koha %]
[% USE HtmlTags %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [% IF( biblionumber ) %]
            Chỉnh sửa [% title | html %] (Số biểu ghi [% biblionumber | html %])
        [% ELSE %]
            Biên mục biểu ghi MARC 21 mới
        [% END %]
        &rsaquo; Thư viện Trường Đại học Ngoại thương
    [% END %]</title
>
<style nonce="[% Koha.CSPNonce | $raw %]">
/* ══ FTU Modern Cataloging Editor ══ */
body#cat_addbiblio {
    background-color: #f8fafc;
}

.ftu-clean-title {
    font-size: 1.35rem;
    font-weight: 600;
    color: #1e293b;
    margin: 0.75rem 0 0.75rem 0;
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
}
body#cat_addbiblio h1:not(.ftu-clean-title) {
    display: none !important;
}

/* ══ FTU Z39.50 Quick Bar Styling ══ */
.ftu-z3950-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin: 0.5rem 0 1rem 0;
}
.ftu-z3950-card .form-label {
    font-size: 0.8rem;
    font-weight: 500;
    color: #334155;
    margin-bottom: 3px;
}
.ftu-z3950-results {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #e2e8f0;
}
.ftu-z3950-table {
    width: 100%;
    margin-bottom: 0;
    font-size: 0.84rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
}
.ftu-z3950-table th {
    background: #f1f5f9;
    color: #334155;
    font-weight: 600;
    padding: 6px 10px;
    border-bottom: 1px solid #cbd5e1;
}
.ftu-z3950-table td {
    padding: 8px 10px;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
}
.ftu-z3950-status-msg {
    font-size: 0.84rem;
    padding: 8px 12px;
    border-radius: 4px;
    margin-top: 8px;
    line-height: 1.5;
}


/* Tab Navigation Styling */
.toolbar-tabs-container .nav-tabs {
    border-bottom: 2px solid #e2e8f0;
    gap: 0.35rem;
    flex-wrap: wrap;
    background: transparent;
    padding: 0.5rem 0 0 0;
}
.toolbar-tabs-container .nav-tabs .nav-link {
    border-radius: 8px 8px 0 0;
    font-size: 0.86rem;
    font-weight: 600;
    padding: 0.55rem 0.95rem;
    color: #475569;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-bottom: none;
    transition: all 0.15s ease;
}
.toolbar-tabs-container .nav-tabs .nav-link:hover {
    background: #fee2e2;
    color: #991b1b;
}
.toolbar-tabs-container .nav-tabs .nav-link.active {
    background: #ffffff !important;
    color: #b91c1c !important;
    border-top: 3px solid #b91c1c !important;
    border-color: #cbd5e1 #cbd5e1 #ffffff #cbd5e1 !important;
    font-weight: 700 !important;
    box-shadow: 0 -2px 6px rgba(0,0,0,0.04);
}

/* Tag & Subfield Styling */
.tag_title {
    font-weight: 700;
    color: #1e293b;
    font-size: 0.95rem;
    background: #f8fafc;
    padding: 0.55rem 0.85rem;
    border-radius: 6px;
    border-left: 3px solid #cbd5e1;
    margin-bottom: 0.5rem;
}
.tag_title .expandfield {
    color: #1e293b;
    text-decoration: none;
    font-weight: 600;
}
.tag_title .expandfield:hover {
    color: #b91c1c;
    text-decoration: underline;
}
.tagnum {
    font-weight: 800;
    color: #b91c1c;
    font-size: 0.98rem;
}
.labelsubfield {
    font-weight: 600;
    color: #334155;
    font-size: 0.88rem;
}
.subfield_mandatory .labelsubfield {
    color: #b91c1c !important;
}

/* Toolbar Buttons */
#toolbar.btn-toolbar.sticky {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.6rem 0.9rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    margin-bottom: 1rem;
    gap: 0.5rem;
}
#toolbar #saverecord {
    background-color: #b91c1c !important;
    border-color: #991b1b !important;
    font-weight: 700 !important;
    border-radius: 8px 0 0 8px !important;
}
#toolbar #saverecord + .dropdown-toggle {
    background-color: #991b1b !important;
    border-color: #7f1d1d !important;
    border-radius: 0 8px 8px 0 !important;
}
</style>
[% INCLUDE 'doc-head-close.inc' %]
[% INCLUDE 'calendar.inc' %]
[% Asset.js( "lib/sortable/Sortable.min.js" ) | $raw %]
[% INCLUDE 'select2.inc' %]
<script nonce="[% Koha.CSPNonce | $raw %]" data-tt-allowed="true">
    var auth_values_creation = [% IF Koha.Preference('CreateAVFromCataloguing') && CAN_user_parameters_manage_auth_values %]1[% ELSE %]0[% END %];
    $.fn.select2.defaults.set("width", "100%" );

    Koha.addPrefs({
        marcflavour: "[% marcflavour | html %]",
        hide_marc: [% Koha.Preference("hide_marc") ? 1 : 0 | html %],
        MarcFieldDocURL: "[% Koha.Preference('MarcFieldDocURL') | html %]",
    });
    Koha.addPermissions({
        CAN_user_editcatalogue_edit_items: [% CAN_user_editcatalogue_edit_items ? 1 : 0 | html %],
    });
    const lang = "[% lang | html %]";
    const logged_in_user_borrowernumber = "[% logged_in_user.borrowernumber | html %]";
    var breedingid = [% breedingid || "null" | html %];
    var biblionumber = "[% biblionumber | html %]";
    var title = "[% title | html %]";
    const bib_doesnt_exist = [% bib_doesnt_exist ? 1 : 0 | html %];
    const biblionumberdata = "[% biblionumberdata | html %]";

    var searchid = "[% searchid | html %]";
    [%# FIXME remove biblionumber or biblio_id %]
    var biblio_id = parseInt('[% biblionumber| html %]', 10);
    var tab = "[% tab | html %]";

    var mandatory_fields = [];
    var mandatory_subfields = [];
    var important_fields = [];
    var important_subfields = [];
    var z3950_mandatory_subfields = [];
    [% FOREACH BIG_LOO IN BIG_LOOP %]
        [% FOREACH innerloo IN BIG_LOO.innerloop %]
            [% IF innerloo.mandatory %]
                mandatory_fields.push({
                    tag: "[% innerloo.tag | html %]",
                    id: "[% innerloo.index | html %][% innerloo.random | html %]",
                    index: "[% innerloo.index | html %]",
                    tab: "[% BIG_LOO.number | html %]",
                });
            [% END %]
            [% IF innerloo.important %]
                important_fields.push({
                    tag: "[% innerloo.tag | html %]",
                    id: "[% innerloo.index | html %][% innerloo.random | html %]",
                    index: "[% innerloo.index | html %]",
                    tab: "[% BIG_LOO.number | html %]",
                });
            [% END %]
            [% FOREACH subfield_loo IN innerloo.subfield_loop %]
                [% IF subfield_loo.mandatory %]
                    mandatory_subfields.push({
                        id: "[% subfield_loo.id | html %]",
                        label: "[% subfield_loo.marc_lib | html %]",
                        tab: "[% BIG_LOO.number | html %]",
                    });
                [% END %]
                [% IF subfield_loo.important %]
                    important_subfields.push({
                        id: "[% subfield_loo.id | html %]",
                        label: "[% subfield_loo.marc_lib | html %]",
                        tab: "[% BIG_LOO.number | html %]",
                    });
                [% END %]
                [% IF subfield_loo.z3950_mandatory %]
                    z3950_mandatory_subfields.push({
                        id: "[% subfield_loo.id | html %]",
                        label: "[% subfield_loo.z3950_mandatory | html %]",
                        tab: "[% BIG_LOO.number | html %]",
                    });
                [% END %]
            [% END %]
        [% END %]
    [% END %]
</script>
[% Asset.js("js/cataloging.js") | $raw %]
[% Asset.js("js/browser.js") | $raw %]
<script nonce="[% Koha.CSPNonce | $raw %]">
    var browser = KOHA.browser(searchid, biblio_id);
    browser.show();

    $(window).load(function () {
        $("#loading").hide();
    });

    function changeEditor() {
        if (!confirm(breedingid ? _("Biểu ghi này không thể chuyển sang trình soạn thảo nâng cao. Tiếp tục?") : _("Các thay đổi sẽ không được lưu. Tiếp tục?"))) return false;

        Cookies.set(`catalogue_editor_${logged_in_user_borrowernumber}`, "advanced", { expires: 365, path: "/", sameSite: "Lax" });

        if (biblionumber) {
            window.location = "/cgi-bin/koha/cataloguing/editor.pl#catalog/" + biblionumber;
        } else {
            window.location = "/cgi-bin/koha/cataloguing/editor.pl";
        }

        return false;
    }

    $(document).ready(function () {
        /* FTU MARC Client-Side Localization & Helper */
        var ftu_marc_dict = {

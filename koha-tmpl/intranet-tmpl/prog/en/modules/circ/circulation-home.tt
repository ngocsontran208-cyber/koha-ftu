[% USE raw %]
[% USE Koha %]
[% USE Branches %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [% t("Circulation") | html %]
        &rsaquo; [% t("Koha") | html %]
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="circ_circulation-home" class="circ">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'circ-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Lưu thông</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' %]
    <h1>Lưu thông</h1>

    <div class="row">
        <div class="col-12 col-sm-4 circulation-actions">
            <h3>Lưu thông</h3>

            <ul class="buttons-list">
                <li>
                    <a class="circ-button checkout" href="/cgi-bin/koha/circ/circulation.pl"><i class="fa fa-upload"></i> Mượn sách</a>
                </li>
                <li>
                    <a class="circ-button checkin" href="/cgi-bin/koha/circ/returns.pl"><i class="fa fa-download"></i> Trả sách</a>
                </li>
                <li>
                    <a class="circ-button renew" href="/cgi-bin/koha/circ/renew.pl"><i class="fa fa-retweet"></i> Gia hạn</a>
                </li>
                [% IF ( CAN_user_superlibrarian || CAN_user_loggedinlibrary ) %]
                    <li>
                        [% IF Koha.Preference('UseCirculationDesks') %]
                            <a class="circ-button set-library-desk" href="/cgi-bin/koha/circ/set-library.pl"><i class="fa fa-home"></i> Đặt thư viện & quầy</a>
                        [% ELSE %]
                            <a class="circ-button set-library" href="/cgi-bin/koha/circ/set-library.pl"><i class="fa fa-home"></i> Đặt thư viện</a>
                        [% END %]
                    </li>
                [% ELSIF Koha.Preference('UseCirculationDesks') %]
                    <li>
                        <a class="circ-button set-desk" href="/cgi-bin/koha/circ/set-library.pl"><i class="fa fa-home"></i> Đặt quầy</a>
                    </li>
                [% END %]
                [% IF ( fast_cataloging ) %]
                    [% IF ( CAN_user_editcatalogue_fast_cataloging ) %]
                        <li>
                            <a class="circ-button fastadd" href="/cgi-bin/koha/cataloguing/addbiblio.pl?frameworkcode=FA"><i class="fa fa-plus"></i> Biên mục nhanh</a>
                        </li>
                    [% END %]
                [% END %]
                [% IF ( Koha.Preference('AllowCheckoutNotes') && CAN_user_circulate_manage_checkout_notes ) %]
                    <li>
                        <a class="circ-button checkout-notes" href="/cgi-bin/koha/circ/checkout-notes.pl"><i class="fa fa-sticky-note"></i> Ghi chú mượn</a>
                    </li>
                [% END %]
                [% IF Koha.Preference('OnSiteCheckouts') %]
                    <li>
                        <a class="circ-button pending-onsite" href="/cgi-bin/koha/circ/on-site_checkouts.pl"><i class="fa-solid fa-location-dot"></i> Mượn tại chỗ đang chờ</a>
                    </li>
                [% END %]
            </ul>
        </div>

        <div class="col-12 col-sm-4">
            <div class="holds-bookings">
                <h3>Holds [% IF Koha.Preference('EnableBooking') %]và đặt chỗ[% END %]</h3>

                <ul class="buttons-list">
                    <li>
                        [% IF Koha.Preference('UseHoldsQueueFilterOptions') %]
                            <a class="circ-button holds-queue" href="/cgi-bin/koha/circ/view_holdsqueue.pl?branchlimit=[% Branches.GetLoggedInBranchcode | uri %]"><i class="fa fa-tasks"></i> Hàng đợi đặt giữ</a>
                        [% ELSE %]
                            <a class="circ-button holds-queue" href="/cgi-bin/koha/circ/view_holdsqueue.pl?branchlimit=[% Branches.GetLoggedInBranchcode | uri %]&run_report=1"><i class="fa fa-tasks"></i> Hàng đợi đặt giữ</a>
                        [% END %]
                    </li>
                    <li>
                        <a class="circ-button holds-to-pull" href="/cgi-bin/koha/circ/pendingreserves.pl"><i class="fa-solid fa-hand-back-fist"></i> Đặt giữ cần lấy</a>
                    </li>
                    <li>
                        <a class="circ-button holds-awaiting" href="/cgi-bin/koha/circ/waitingreserves.pl"><i class="fa-solid fa-calendar-days"></i> Đặt giữ chờ nhận</a>
                    </li>
                    [% IF ( Koha.Preference('CurbsidePickup') && CAN_user_circulate_manage_curbside_pickups ) %]
                        <li>
                            <a class="circ-button curbside" href="/cgi-bin/koha/circ/curbside_pickups.pl"><i class="fa-solid fa-rotate"></i> Nhận tại quầy</a>
                        </li>
                    [% END %]
                    <li>
                        <a class="circ-button holds-ratio" href="/cgi-bin/koha/circ/reserveratios.pl"><i class="fa-solid fa-chart-line"></i> Tỷ lệ đặt giữ</a>
                    </li>
                    [% IF Koha.Preference('EnableBooking') %]
                        <li>
                            <a class="circ-button bookings-to-collect" href="/cgi-bin/koha/circ/pendingbookings.pl"><i class="fa-solid fa-calendar-days"></i> Đặt chỗ cần lấy</a>
                        </li>
                    [% END %]
                </ul>
            </div>

            [% IF Koha.Preference('UseRecalls') and CAN_user_recalls %]
                <div class="recalls">
                    <h3>Thu hồi</h3>

                    <ul class="buttons-list">
                        <li
                            ><a class="circ-button recalls-queue" href="/cgi-bin/koha/recalls/recalls_queue.pl" title="All active recalls"><i class="fa fa-tasks"></i> Hàng đợi thu hồi</a></li
                        >
                        <li
                            ><a class="circ-button recalls-to-pull" href="/cgi-bin/koha/recalls/recalls_to_pull.pl" title="Recalls that could be filled but have not been set waiting"
                                ><i class="fa-solid fa-hand-back-fist"></i> Recalls to pull</a
                            ></li
                        >
                        <li
                            ><a class="circ-button overdue-recalls" href="/cgi-bin/koha/recalls/recalls_overdue.pl" title="Recalled items that are overdue to be returned"><i class="fa-solid fa-clock"></i> Thu hồi quá hạn</a></li
                        >
                        <li
                            ><a class="circ-button recalls-awaiting" href="/cgi-bin/koha/recalls/recalls_waiting.pl" title="Recalled items awaiting pickup"><i class="fa-solid fa-calendar-days"></i> Thu hồi chờ nhận</a></li
                        >
                        <li
                            ><a class="circ-button old-recalls" href="/cgi-bin/koha/recalls/recalls_old_queue.pl" title="Inactive recalls"><i class="fa fa-tasks"></i> Thu hồi cũ</a></li
                        >
                    </ul>
                </div>
            [% END %]
        </div>

        <div class="col-12 col-sm-4">
            [% IF Koha.Preference('ArticleRequests') %]
                <div class="patron-request">
                    <h3>Yêu cầu bạn đọc</h3>
                    <ul class="buttons-list">
                        <li>
                            <a class="circ-button article-request" href="/cgi-bin/koha/circ/article-requests.pl" title="Article requests"><i class="fa-solid fa-newspaper"></i> Yêu cầu bài báo</a>
                        </li>
                    </ul>
                </div>
            [% END %]

            <div class="transfers">
                <h3>Chuyển kho</h3>

                <ul class="buttons-list">
                    [% IF !Koha.Preference('IndependentBranchesTransfers') || CAN_user_superlibrarian %]
                        <li>
                            <a class="circ-button transfer" href="/cgi-bin/koha/circ/branchtransfers.pl"><i class="fa-solid fa-right-left"></i> Chuyển kho</a>
                        </li>
                    [% END %]
                    [% IF Koha.Preference('StockRotation') %]
                        <li>
                            <a class="circ-button transfers-to-send" href="/cgi-bin/koha/circ/transfers_to_send.pl"><i class="fa-solid fa-right-from-bracket"></i> Chuyển đi</a>
                        </li>
                    [% END %]
                    <li>
                        <a class="circ-button transfers-to-receive" href="/cgi-bin/koha/circ/transferstoreceive.pl"><i class="fa-solid fa-right-to-bracket"></i> Nhận về</a>
                    </li>
                </ul>
            </div>

            [% IF ( CAN_user_circulate_overdues_report ) %]
                <div class="overdues">
                    <h3>Quá hạn</h3>

                    <ul class="buttons-list">
                        <li>
                            <a class="circ-button overdues-report" href="/cgi-bin/koha/circ/overdue.pl" title="Warning: This report is very resource intensive on systems with large numbers of overdue items."
                                ><i class="fa-solid fa-clock"></i> Quá hạn</a
                            >
                        </li>
                        <li>
                            <a class="circ-button overdues-fines" href="/cgi-bin/koha/circ/branchoverdues.pl" title="Limited to your library.  See report help for other details."><i class="fa-solid fa-clock"></i> Quá hạn có phạt</a>
                        </li>
                    </ul>
                </div>
            [% END %]
        </div>
    </div>
    <div class="row" id="intranet-circulation-home-html">
        <div class="col-md-12"> [% Koha.Preference('IntranetCirculationHomeHTML') | $raw %] </div>
    </div>
    <div class="row" id="offline-circulation">
        <div class="col-md-12">
            <h4>Lưu thông ngoại tuyến</h4>
            <div class="col-sm-5 col-md-3">
                <p><a href="/cgi-bin/koha/offline_circ/process_koc.pl" class="offline-circ-upload">Tải lên file ngoại tuyến (.koc)</a></p>
                <p><a href="/cgi-bin/koha/offline_circ/list.pl" class="offline-circ-pending">Hành động ngoại tuyến chờ</a></p>
            </div>
            <div class="col-sm-5 col-md-3">
                <p
                    ><a href="https://github.com/bywatersolutions/koha-offline-circulation/releases" class="offline-desktop-app"><i class="fa-solid fa-window-maximize"></i> Tải ứng dụng máy tính</a></p
                >
                <p
                    ><a href="https://addons.mozilla.org/[% lang | uri %]/firefox/addon/koct/" class="offline-firefox-addon"><i class="fa-brands fa-firefox"></i> Tải tiện ích Firefox</a></p
                >
            </div>
        </div>
    </div>
[% END %]
[% INCLUDE 'intranet-bottom.inc' %]

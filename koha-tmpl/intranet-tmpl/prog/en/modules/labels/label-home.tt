[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        Tạo nhãn gáy &amp; mã vạch
        &rsaquo; Biên mục &rsaquo; Koha
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="labels_label-home" class="tools labels">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'cat-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/cataloguing/cataloging-home.pl">Biên mục</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Tạo nhãn gáy &amp; mã vạch</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' aside='labels-menu' %]
    [% INCLUDE 'labels-toolbar.inc' %]
    <h1 class="ftu-clean-title"><i class="fa fa-tags"></i> Tạo nhãn gáy &amp; mã vạch</h1>

    <div class="row">
        <div class="col-md-6">
            <ul class="buttons-list">
                <li
                    ><a href="/cgi-bin/koha/labels/label-manage.pl?label_element=batch"><i class="fa-solid fa-list-ul"></i> Lô nhãn in (Batches)</a></li
                >
                <li
                    ><a href="/cgi-bin/koha/labels/label-manage.pl?label_element=layout"><i class="fa-solid fa-object-group"></i> Bố cục nhãn (Layouts)</a></li
                >
                <li
                    ><a href="/cgi-bin/koha/labels/label-manage.pl?label_element=template"><i class="fa-solid fa-table-cells"></i> Mẫu phôi nhãn (Templates)</a></li
                >
                <li
                    ><a href="/cgi-bin/koha/labels/label-manage.pl?label_element=profile"><i class="fa fa-print"></i> Cấu hình máy in (Profiles)</a></li
                >
                <li
                    ><a href="/cgi-bin/koha/labels/label-edit-range.pl"><i class="fa fa-barcode"></i> In dải mã vạch liên tục</a></li
                >
            </ul>
        </div>
    </div>
[% END %]
[% INCLUDE 'intranet-bottom.inc' %]

[% USE raw %]
[% USE Koha %]
[% USE Branches %]
[% USE AdditionalContents %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% FILTER collapse %]
    Báo cáo &rsaquo; FTU - HCM LIB
[% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
.ftu-rep-card {
    background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 20px; height: 100%; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
}
.ftu-rep-card h3 {
    font-size: 15px; font-weight: 700; color: #0f172a;
    margin: 0 0 14px 0; padding-bottom: 12px; border-bottom: 2px solid #f1f5f9;
}
.ftu-rep-group {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: #64748b; margin: 14px 0 6px 0;
}
.ftu-rep-group:first-of-type { margin-top: 0; }
.ftu-rep-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
.ftu-rep-list li { margin: 0; padding: 0; }
.ftu-rep-link {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;
    font-size: 13px; font-weight: 500; color: #334155; text-decoration: none;
    transition: all 0.15s ease;
}
.ftu-rep-link:hover {
    background: #fef2f2; border-color: #fecaca; color: #8B1E1E; text-decoration: none;
}
.ftu-rep-search {
    display: flex; gap: 8px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #f1f5f9;
}
.ftu-rep-search input[type="text"] {
    flex: 1; padding: 7px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13px;
}
.ftu-rep-search input[type="submit"] {
    background: #8B1E1E; color: #ffffff; border: 1px solid #8B1E1E; border-radius: 8px;
    padding: 7px 14px; font-size: 13px; font-weight: 600; cursor: pointer;
}
</style>
</head>
<body id="rep_reports-home" class="rep">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'circ-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Báo cáo</span>
        [% END %]
    [% END %]
[% END %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-12">
            [% INCLUDE 'messages.inc' %]
            <h1 class="h3 mb-3" style="font-weight: 700; color: #0f172a;">Báo cáo &amp; Thống kê</h1>

            [% WRAPPER tabs id= "reports_tabs" %]
                [% WRAPPER tabs_nav %]
                    [% WRAPPER tab_item tabname= "predefined" bt_active= (active_tab == 'predefined' || !active_tab) %]
                        <span>Báo cáo nghiệp vụ</span>
                    [% END %]
                    [% WRAPPER tab_item tabname= "standard" bt_active= (active_tab == 'standard') %]
                        <span>Báo cáo tùy chỉnh &amp; SQL</span>
                    [% END %]
                [% END %]

                [% WRAPPER tab_panels %]
                    [% WRAPPER tab_panel tabname="predefined" bt_active= (active_tab == 'predefined' || !active_tab) %]
                        [% PROCESS 'reports-predefined-body.inc' %]
                    [% END %]

                    [% WRAPPER tab_panel tabname="standard" bt_active= (active_tab == 'standard') %]
                        <div class="row g-4 pt-3">
                            <!-- CỘT 1: BÁO CÁO SQL & ĐÃ LƯU -->
                            <div class="col-12 col-lg-4 col-md-6">
                                <div class="ftu-rep-card">
                                    <h3>Báo cáo SQL &amp; Đã lưu</h3>
                                    [% IF ( CAN_user_reports_execute_reports || CAN_user_reports_create_reports || CAN_user_reports_delete_own_reports || CAN_user_reports_delete_all_reports ) %]
                                    <div class="ftu-rep-group">Khởi tạo &amp; Quản lý</div>
                                    <ul class="ftu-rep-list">
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/guided_reports.pl?op=list"><span>Danh sách báo cáo đã lưu</span></a></li>
                                        [% IF ( CAN_user_reports_create_reports ) %]
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/guided_reports.pl?op=add_form_sql"><span>Tạo báo cáo từ câu lệnh SQL</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/guided_reports.pl?op=add_form"><span>Trình thuật sĩ tạo báo cáo</span></a></li>
                                        [% END %]
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/dictionary.pl"><span>Từ điển định nghĩa báo cáo</span></a></li>
                                    </ul>
                                    <form action="/cgi-bin/koha/reports/guided_reports.pl" method="get" class="ftu-rep-search">
                                        <input name="op" value="list" type="hidden" />
                                        <input name="filter_set" value="1" type="hidden" />
                                        <input id="filter_keyword" name="filter_keyword" value="" type="text" placeholder="Tìm báo cáo đã lưu..." />
                                        <input type="submit" value="Tìm" />
                                    </form>
                                    [% END %]
                                </div>
                            </div>

                            <!-- CỘT 2: THỐNG KÊ THEO PHÂN HỆ -->
                            <div class="col-12 col-lg-4 col-md-6">
                                <div class="ftu-rep-card">
                                    <h3>Thống kê theo phân hệ</h3>
                                    <div class="ftu-rep-group">Số liệu tổng hợp</div>
                                    <ul class="ftu-rep-list">
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/issues_stats.pl"><span>Thống kê Lưu thông</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/borrowers_stats.pl"><span>Thống kê Bạn đọc</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/catalogue_stats.pl"><span>Thống kê Tài liệu &amp; Kho</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/acquisitions_stats.pl"><span>Thống kê Bổ sung</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/serials_stats.pl"><span>Thống kê Ấn phẩm định kỳ</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/reserves_stats.pl"><span>Thống kê Đặt giữ</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/cash_register_stats.pl"><span>Thống kê Thu ngân</span></a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- CỘT 3: XẾP HẠNG & KIỂM KÊ -->
                            <div class="col-12 col-lg-4 col-md-6">
                                <div class="ftu-rep-card">
                                    <h3>Xếp hạng &amp; Rà soát</h3>
                                    <div class="ftu-rep-group">Hoạt động lưu thông</div>
                                    <ul class="ftu-rep-list">
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/bor_issues_top.pl"><span>Bạn đọc mượn nhiều nhất</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/cat_issues_top.pl"><span>Tài liệu mượn nhiều nhất</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/borrowers_out.pl"><span>Bạn đọc chưa phát sinh lượt mượn</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/catalogue_out.pl"><span>Tài liệu chưa từng lưu thông</span></a></li>
                                    </ul>

                                    <div class="ftu-rep-group">Rà soát kho &amp; Quỹ</div>
                                    <ul class="ftu-rep-list">
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/catalog_by_itemtype.pl"><span>Số bản theo loại tài liệu</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/itemslost.pl"><span>Danh mục tài liệu báo mất</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/orders_by_fund.pl"><span>Đơn đặt mua theo quỹ</span></a></li>
                                        <li><a class="ftu-rep-link" href="/cgi-bin/koha/reports/issues_avg_stats.pl"><span>Thời gian mượn trung bình</span></a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    [% END %]
                [% END %]
            [% END %]
        </div>
    </div>
</div>
[% INCLUDE 'intranet-bottom.inc' %]

                                                        id="label[% serialslis.subscriptionid | html %][% serialslis.serialid | html %]"
                                                        class="btn btn-default btn-sm"
                                                        onclick="unHideItems('items[% serialslis.subscriptionid | html %][% serialslis.serialid | html %]','label[% serialslis.subscriptionid | html %][% serialslis.serialid | html %]',  '[% serialslis.serialid | html %]');setStatus([% serialslis.serialid | html %]);"
                                                    >
 Edit item</a
                                                    >
 [% ELSE %]
 <a
                                                        id="label[% serialslis.subscriptionid | html %][% serialslis.serialid | html %]"
                                                        class="btn btn-default btn-sm"
                                                        onclick="unHideItems('items[% serialslis.subscriptionid | html %][% serialslis.serialid | html %]','label[% serialslis.subscriptionid | html %][% serialslis.serialid | html %]',  '[% serialslis.serialid | html %]');setStatus([% serialslis.serialid | html %]);"
                                                    >
 Tạo bản tài liệu</a
                                                    >
 [% END %]

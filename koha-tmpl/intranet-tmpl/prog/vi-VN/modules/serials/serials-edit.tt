[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% USE AuthorisedValues %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% t("Serial edition") | html %]
 [% IF ( callnumber ) %]
 ([% callnumber | html %])
 [% END %]
 &rsaquo; [% bibliotitle | html %] &rsaquo; [% t("Serials") | html %] &rsaquo; [% t("Koha") | html %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% Asset.css("css/serials-edit.css") | $raw %]
[% Asset.js("js/cataloging.js") | $raw %]
[% INCLUDE 'calendar.inc' %]
<script nonce="[% Koha.CSPNonce | $raw %]">
    $(document).ready(function () {
        $("#multi_receiving").on("show", function () {
            $(this).find(".modal-body").html($(".serials_multi_receiving")[0].outerHTML);
        });
    });

    function popup(subscriptionid) {
        window.open("subscription-renew.pl?op=renew&subscriptionid=" + subscriptionid, "subscription_renewal", "width=700,height=400,toolbar=false,scrollbars=yes");
    }

    function unHideItems(index, labelindex, serialId) {
        subfield = document.getElementById(index);
        subfield.style.display = "block";
        label = document.getElementById(labelindex);
        label.style.display = "none";

        // Prefilling enumcron subfield with serial enumeration/issue number
        // Getting item div
        item_div = $("fieldset#" + index + " div.cataloguing_additem_itemlist div.items");
        // Getting subfield with enumcron mapping
        subfield_div = $(item_div).find("input[name='kohafield'][value='items.enumchron']").parent();
        // Setting text field if no saved default value
        if (!$(subfield_div).children("input[type='text'][name='field_value']").val()) {
            $(subfield_div)
                .children("input[type='text'][name='field_value']")
                .val($("#serialseq" + serialId).val());
        }
    }
    function HideItems(index, labelindex) {
        subfield = document.getElementById(index);
        subfield.style.display = "none";
        label = document.getElementById(labelindex);
        label.style.display = "block";
    }
    function setStatus(serialid) {
        $("#status" + serialid)
            .val("2")
            .attr("selected", "selected");
    }
    function changeDate(elem, adate) {
        $(elem).closest("tr").find("[name=planneddate]").val(adate);
    }

    $(document).ready(function () {
        $("form#serials_edit").submit(function () {
            var total_errors = 0;
            $(this)
                .find(".cataloguing_additem_itemlist:visible")
                .each(function () {
                    total_errors = total_errors + CheckMandatorySubfields(this);
                });
            if (total_errors > 0) {
                var mes = _("Phát hiện các lỗi sau đây, bạn vui lòng kiểm tra và chỉnh sửa lại:");
                mes += "\n------------------------------------------------------------------------------------\n";
                mes += "\n- " + _("%s Các trường bắt buộc chưa khai báo thông tin (được đánh dấu)").format(total_errors);
                alert(mes);
                return false;
            }
            return true;
        });

        $("#toggle_skip_issues").on("change", function () {
            if (this.checked) {
                $("#skip_issues").removeClass("collapse").prop("disabled", false);
            } else {
                $("#skip_issues").addClass("collapse").prop("disabled", true);
            }
        });
    });
</script>
<style nonce="[% Koha.CSPNonce | $raw %]">
    #serials_edit fieldset.rows label,
    #serials_edit fieldset.rows span.label {
        font-size: 100%;
        width: 25%;
    }
    #serials_edit fieldset.rows select {
        max-width: 15em;
    }
    #serials_edit fieldset.rows li {
        padding-bottom: 3px;
    }
    #serials_edit .input_marceditor {
        width: auto;
    }
</style>
</head>
<body id="ser_serials-edit" class="ser">
[% WRAPPER 'header.inc' %]
 [% INCLUDE 'serials-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
 [% WRAPPER breadcrumbs %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/serials/serials-home.pl">Ấn phẩm định kỳ</a>
 [% END %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/serials/subscription-detail.pl?subscriptionid=[% subscriptionid | uri %]"><em>[% bibliotitle | html %]</em></a>
 [% END %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Serial edition</span> [% IF ( callnumber ) %]<em>([% callnumber | html %]</em>)[% END %]
 [% END %]
 [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

<div class="main container-fluid">
 <div class="row">
 <div class="col-md-10 order-md-2 order-sm-1">
 <main>
 [% INCLUDE 'messages.inc' %]

 <div class="btn-group"><input class="btn btn-default btn-sm" data-bs-toggle="modal" href="#generate_next" type="button" value="Tạo kỳ tiếp theo" /></div>
 [% INCLUDE 'modals/generate_next.inc' referrer="serials-edit" %]

 <h1
                    >Kỳ phát hành của ÂPĐK <em>[% bibliotitle | html %]</em> [% IF location %]([% AuthorisedValues.GetByCode('LOC', location) | html %])[% END %]
 [% IF ( callnumber ) %]callnumber: [% callnumber | html %][% END %]</h1
                >

 [% INCLUDE 'modals/serials_multi_receiving.inc' %]

 [% IF internalnotes %]<p>Ghi chú nội bộ: [% internalnotes | html | html_line_break %]</p>[% END %]
 <form method="post" name="f" class="noEnterSubmit" action="serials-edit.pl" id="serials_edit">
 [% INCLUDE 'csrf-token.inc' %]

 [% IF ( Errors ) %]
 <div class="alert alert-warning">
 <ul>
 [% IF ( barcode_not_unique ) %]<li>Lỗi: Mã vạch bị trùng [% FOREACH errse IN errseq %] [% errse.serialseq | html %]<br />[% END %]</li>[% END %]
 </ul>
 </div>
 [% END %]

 <input type="hidden" name="op" value="cud-serialchangestatus" />
 [% FOREACH subscription IN subscriptions %]
 <input type="hidden" name="subscriptionid" value="[% subscription.subscriptionid | html %]" />
 [% END %]

 <div class="page-section">
 <table>
 <tr>
 <th>Kỳ phát hành</th>
 <th>Ngày phát hành</th>
 <th>Published on (text)</th>
 <th>Ngày nhận (Dự kiến)</th>
 <th>Trạng thái</th>
 <th>Ghi chú</th>
 </tr>
 [% FOREACH serialslis IN serialslist %]
 <tr>
 <td>
 <input type="hidden" name="serialid" value="[% serialslis.serialid | html %]" />
 <input type="hidden" name="biblionumber" value="[% serialslis.biblionumber | html %]" />
 <input type="hidden" name="itemcount" value="[% serialslis.issuesatonce | html %]" />
 <input type="hidden" name="user" value="[% serialslis.librarian | html %]" />
 Kỳ <input type="text" name="serialseq" id="serialseq[% serialslis.serialid | html %]" value="[% serialslis.serialseq | html %]" size="20" maxlength="100" />
 </td>
 <td>
 <input type="text" name="publisheddate" value="[% serialslis.publisheddate | html %]" size="10" maxlength="15" class="flatpickr" />
 </td>
 <td>
 <input type="text" name="publisheddatetext" value="[% serialslis.publisheddatetext | html %]" size="10" maxlength="100" />
 </td>
 <td>
 <input type="text" name="planneddate" value="[% serialslis.planneddate | html %]" size="10" maxlength="15" class="flatpickr" />
 </td>
 <td>
 [% BLOCK option_list %]
 [% IF ( serialslis.status1 ) %]
 <option value="1" selected="selected">Dự kiến</option>
 [% ELSE %]
 <option value="1">Dự kiến</option>
 [% END %]
 [% IF ( serialslis.status2 ) %]
 <option value="2" selected="selected">Đã về</option>
 [% ELSE %]
 <option value="2">Đã về</option>
 [% END %]
 [% IF ( serialslis.status21 ) %]
 <option value="21" selected="selected">Được cho mượn</option>
 [% ELSE %]
 [% IF ( !serialslis.status1 ) %]
 <option value="21">Được cho mượn</option>
 [% END %]
 [% END %]
 [% IF ( serialslis.status22 ) %]
 <option value="22" selected="selected">Tài liệu đang được gửi đi đóng bìa</option>
 [% ELSE %]
 [% IF ( !serialslis.status1 ) %]
 <option value="22">Tài liệu đang được gửi đi đóng bìa</option>
 [% END %]
 [% END %]
 [% IF ( serialslis.status23 ) %]
 <option value="23" selected="selected">Đã đóng bìa</option>
 [% ELSE %]
 [% IF ( !serialslis.status1 ) %]
 <option value="23">Đã đóng bìa</option>
 [% END %]
 [% END %]
 [% IF ( serialslis.status3 ) %]
 <option value="3" selected="selected">Chậm</option>
 [% ELSE %]
 <option value="3">Chậm</option>
 [% END %]
 [% IF ( serialslis.status4 ) %]
 <option value="4" selected="selected">Thất lạc</option>
 [% ELSE %]
 <option value="4">Thất lạc</option>
 [% END %]
 [% IF ( serialslis.status41 ) %]
 <option value="41" selected="selected">Thất lạc (chưa từng nhận được)</option>
 [% ELSE %]
 <option value="41">Thất lạc (chưa từng nhận được)</option>
 [% END %]
 [% IF ( serialslis.status42 ) %]
 <option value="42" selected="selected">Thất lạc (đã hết hàng)</option>
 [% ELSE %]
 <option value="42">Thất lạc (đã hết hàng)</option>
 [% END %]
 [% IF ( serialslis.status43 ) %]
 <option value="43" selected="selected">Thất lạc (hư hỏng)</option>
 [% ELSE %]
 <option value="43">Thất lạc (hư hỏng)</option>
 [% END %]
 [% IF ( serialslis.status44 ) %]
 <option value="44" selected="selected">Thất lạc (mất)</option>
 [% ELSE %]
 <option value="44">Thất lạc (mất)</option>
 [% END %]
 [% IF ( serialslis.status7 ) %]
 <option value="7" selected="selected">Đã khai báo</option>
 [% ELSE %]
 <option value="7">Đã khai báo</option>
 [% END %]
 [% IF ( serialslis.status5 ) %]
 <option value="5" selected="selected">Không có tài liệu nào sẵn có</option>
 [% ELSE %]
 <option value="5">Không có tài liệu nào sẵn có</option>
 [% END %]
 [% IF ( serialslis.status6 ) %]
 <option value="6" selected="selected">Xóa</option>
 [% ELSE %]
 <option value="6">Xóa</option>
 [% END %]
 [% IF serialslis.status8 %]
 <option value="8" selected="selected">Dừng phát hành</option>
 [% END %]
 [% END %]
 [% IF ( serialslis.editdisable ) %]
 <input type="hidden" name="status" id="status[% serialslis.serialid | html %]" value="[% serialslis.serstatus | html %]" />
 <select name="status" disabled="disabled">
 [% PROCESS option_list %]
 </select>
 [% ELSE %]
 [% IF ( serialslis.serialsadditems ) %]
 <select
                                                    name="status"
                                                    id="status[% serialslis.serialid | html %]"
                                                    onchange="if (this.value==2){unHideItems('items'+[% serialslis.subscriptionid | html %][% serialslis.serialid | html %],'label[% serialslis.subscriptionid | html %][% serialslis.serialid | html %]','[% serialslis.serialid | html %]'); changeDate(this, '[% serialslis.arriveddate | html %]')} else if (this.value==7){changeDate(this, '[% serialslis.arriveddate | html %]')} else { HideItems('items'+[% serialslis.subscriptionid | html %]+[% serialslis.serialid | html %],'label[% serialslis.subscriptionid | html %][% serialslis.serialid | html %]'); changeDate(this, '[% serialslis.planneddate | html %]')}"
                                                >
 [% PROCESS option_list %]
 </select>
 [% ELSE %]
 <select
                                                    name="status"
                                                    id="status[% serialslis.serialid | html %]"
                                                    onchange="if (this.value==2 || this.value==7){changeDate(this, '[% serialslis.arriveddate | html %]')} else {changeDate(this, '[% serialslis.planneddate | html %]')}"
                                                >
 [% PROCESS option_list %]
 </select>
 [% END %]
 [% END %]
 </td>
 <td>
 <input type="text" name="notes" value="[% serialslis.sernotes | html %]" size="20" maxlength="255" />
 </td>
 </tr>
 [% UNLESS ( serialslis.subscriptionexpired ) %]
 [% IF ( serialslis.serialsadditems ) %]
 <tr>
 <td colspan="6">
 [% SET item_count = 0 %]
 [% FOREACH item IN serialslis.items %]
 [% IF ( item.itemnumber ) %]
 [% item_count = item_count + 1 %]
 [% END %]
 [% END %]
 [% IF item_count > 0 %]

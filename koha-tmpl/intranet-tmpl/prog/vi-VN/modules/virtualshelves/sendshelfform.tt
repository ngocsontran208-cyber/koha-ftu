[% USE raw %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% t("Sending your list") | html %]
 &rsaquo; [% t("Lists") | html %] &rsaquo; [% t("Koha") | html %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="lists_sendshelfform" class="lists">
[% INCLUDE 'blocking_errors.inc' %]
<div class="container-fluid"
    >[% IF ( email ) %]

 [% IF ( SENT ) %]
 <h3>Gửi tin nhắn cho bạn đọc</h3>
 <p>Thông tin tài liệu trong giá sách ảo đã được gửi tới hòm thư: [% email | html %]</p>
 [% END %]
 [% IF ( error ) %]
 <p>Gặp lỗi khi gửi giá sách ảo...</p>
 [% END %]

 <nav class="navbar navbar-default fixed-bottom">
 <div class="container-fluid">
 <fieldset class="action">
 <button class="btn btn-default close_window focus">Đóng</button>
 </fieldset>
 </div>
 </nav>
 [% ELSE %]
 <form action="/cgi-bin/koha/virtualshelves/sendshelf.pl" method="post">
 [% INCLUDE 'csrf-token.inc' %]

 <h1>Gửi giá sách ảo của bạn</h1>
 <fieldset class="fg">
 <legend class="visually-hidden">Enter message details</legend>
 <div class="fg-row">
 <div class="fg-label">
 <label for="email">Địa chỉ Email:</label>
 </div>
 <div class="fg-input">
 <input type="text" id="email" name="email" class="focus" />
 </div>
 </div>
 <div class="fg-row">
 <div class="fg-label">
 <label for="comment">Bình luận:</label>
 </div>
 <div class="fg-input">
 <textarea id="comment" name="comment" rows="4" cols="40"></textarea>
 <input type="hidden" name="shelfid" value="[% shelfid | html %]" />
 </div>
 </div>
 </fieldset>
 <input type="hidden" name="op" value="cud-send" />

 <nav class="navbar navbar-default fixed-bottom">
 <div class="container-fluid">
 <fieldset class="action">
 <input class="btn btn-primary" type="submit" value="Gửi" />
 <button class="btn btn-default close_window">Hủy bỏ</button>
 </fieldset>
 </div>
 </nav>
 </form>
 [% END %]</div
>
</body>
<!-- prettier-ignore-start -->
</html>
<!-- prettier-ignore-end -->

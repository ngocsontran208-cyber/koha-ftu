[% USE raw %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% t("Download list") | html %]
 &rsaquo; [% t("Lists") | html %] &rsaquo; [% t("Koha") | html %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="lists_downloadshelf" class="lists" style="padding:1em;">

[% FOR m IN messages %]
 <div class="alert alert-[% m.type | html %]">
 [% SWITCH m.code %]
 [% CASE 'unauthorized' %]
 <span>You do not have permission to view this list.</span>
 [% CASE 'does_not_exist' %]
 <span>This list does not exist.</span>
 [% CASE %]
 <span>[% m.code | html %]</span>
 [% END %]
 </div>
[% END %]

[% IF ( format ) %]
 <p>Tệp của bạn sẽ tự động được tải xuống.</p>
[% ELSE %]
 <div id="export" class="detailtagcell">
 <form method="get" action="/cgi-bin/koha/virtualshelves/downloadshelf.pl">
 <h1>Tải giá sách ảo</h1>
 <fieldset class="fg">
 <legend>Select a download format</legend>
 <div class="fg-row">
 <div class="fg-label">
 <label for="format">Định dạng: </label>
 </div>
 <div class="fg-input">
 <select name="format" id="format">
 <option value="">-- Chọn định dạng --</option>
 <option value="iso2709">MARC</option>
 <option value="ris">RIS</option>
 <option value="bibtex">BibTeX</option>
 [% FOREACH csv_profile IN csv_profiles %]
 <option value="[% csv_profile.export_format_id | html %]">CSV - [% csv_profile.profile | html %]</option>
 [% END %]
 </select>
 </div>
 </div>
 </fieldset>
 <fieldset class="action"><input type="hidden" name="shelfid" value="[% shelfid | html %]" /> <input class="btn btn-primary" name="save" type="submit" value="Lưu" /> <a class="cancel close" href="#">Hủy bỏ</a> </fieldset>
 </form>
 </div>
 <!-- /#export -->
[% END %]
</body>
<!-- prettier-ignore-start -->
</html>
<!-- prettier-ignore-end -->

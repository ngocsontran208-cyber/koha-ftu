[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% USE KohaDates %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE "doc-head-open.inc" %]
<title
    >[% FILTER collapse %]
 [% t("Offline circulation") | html %]
 &rsaquo; [% t("Circulation") | html %] &rsaquo; [% t("Koha") | html %]
 [% END %]</title
>
[% INCLUDE "doc-head-close.inc" %]
</head>

<body id="ocirc_list" class="circ ocirc">
[% WRAPPER 'header.inc' %]
 [% INCLUDE 'circ-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
 [% WRAPPER breadcrumbs %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/circ/circulation-home.pl">Phân hệ lưu thông</a>
 [% END %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Lưu thông ngoại tuyến</span>
 [% END %]
 [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' %]
 <h1>Lưu thông ngoại tuyến</h1>

 [% IF ( pending_operations ) %]
 <form method="get">
 <p>
 <a id="CheckAll" href="#"><i class="fa fa-check"></i> Chọn tất cả</a>
 <a id="CheckNone" href="#"><i class="fa fa-times"></i> Bỏ tất cả</a>
 </p>

 <div class="page-section">
 <table id="operations">
 <thead>
 <tr>
 <th>&nbsp;</th>
 <th>Ngày</th>
 <th>Item last seen date</th>
 <th>Thao tác</th>
 <th>Mã vạch</th>
 <th>Card number or username</th>
 <th>Số lượng</th>
 </tr>
 </thead>
 <tbody>
 [% FOREACH operation IN pending_operations %]
 <tr class="oc-[% operation.action | html %]">
 <td><input type="checkbox" name="operationid" id="operationid[% operation.operationid | html %]" value="[% operation.operationid | html %]" /></td>
 <td>
 <label for="operationid[% operation.operationid | html %]">[% operation.timestamp | $KohaDates with_hours=1 %]</label>
 </td>
 <td>
 [% UNLESS operation.outdated %]
 [% operation.datelastseen | $KohaDates with_hours=1 %]
 [% ELSE %]
 <span class="error"
                                            ><i
                                                data-bs-toggle="tooltip"
                                                title="This item has been updated since the offline circulation action was taken. Use caution when processing this action."
                                                data-bs-placement="right"
                                                class="fa fa-exclamation-triangle"
                                                style="color:gold"
                                                tabindex="0"
                                            ></i>
 [% operation.datelastseen | $KohaDates with_hours=1 %]</span
                                        >
 [% END %]
 </td>
 <td>
 [% SWITCH ( operation.action ) -%]
 [% CASE "issue" -%]
 <span>Ghi mượn</span>
 [% CASE "return" -%]
 <span>Ghi Trả</span>
 [% CASE "payment" -%]
 <span>Thanh toán</span>
 [% CASE # default case -%]
 <span>[% operation.action | html %]</span>
 [% END -%]
 </td>
 <td>
 [% IF ( operation.itemnumber ) %]
 <a
                                            href="/cgi-bin/koha/catalogue/moredetail.pl?biblionumber=[% operation.biblionumber | uri %]&itemnumber=[% operation.itemnumber | uri %]#item[% operation.itemnumber | uri %]"
                                            target="_blank"
                                            title="[% operation.bibliotitle | html %]"
                                            >[% operation.barcode | html %]</a
                                        >
 [% ELSE %]
 <span class="error">[% operation.barcode | html %]</span>
 [% END %]
 </td>
 <td>
 [% IF ( operation.actionissue || operation.actionpayment) %]
 [% IF ( operation.borrowernumber ) %]
 <a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=[% operation.borrowernumber | uri %]" title="[% operation.borrower | html %]">[% operation.cardnumber | html %]</a>
 [% ELSE %]
 <span class="error">[% operation.cardnumber | html %]</span>
 [% END %]
 [% END %]
 </td>
 <td>[% operation.amount | html %]</td>
 </tr>
 [% END %]
 </tbody>
 </table>
 </div>
 <!-- /.page-section -->

 <p id="actions"
                >Xử lý dữ liệu được lựa chọn: <input id="process" type="button" value="Xử lý" />
 <input id="delete" type="button" value="Xóa" /></p>
 </form>
 [% ELSE %]
 <p>Hiện tại bạn không có giao dịch lưu thông ngoài tuyến nào.</p>
 [% END %]
[% END %]

[% MACRO jsinclude BLOCK %]
 <script nonce="[% Koha.CSPNonce | $raw %]">
        $(document).ready(function () {
            $("#CheckNone").click(function (e) {
                e.preventDefault();
                $("#operations input:checkbox").prop("checked", false);
            });
            $("#CheckAll").click(function (e) {
                e.preventDefault();
                $("#operations input:checkbox").prop("checked", true);
            });
            $("#process,#delete").click(function () {
                var op = $(this).attr("id");
                $(":checkbox[name=operationid]:checked").each(function () {
                    var cb = $(this);
                    $.ajax({
                        url: "process.pl",
                        data: {
                            op: "cud-" + op,
                            operationid: this.value,
                            csrf_token: $('meta[name="csrf-token"]').attr("content"),
                        },
                        async: false,
                        dataType: "text",
                        type: "POST",
                        success: function (data) {
                            if (data == "Added.") {
                                cb.replaceWith(_("Được thêm."));
                            } else if (data == "Deleted.") {
                                cb.replaceWith(_("Bị xóa."));
                            } else if (data == "Success.") {
                                cb.replaceWith(_("Thành công."));
                            } else if (data == "Item not issued.") {
                                cb.replaceWith(_("Tài liệu không được ghi mượn."));
                            } else if (data == "Item not found.") {
                                cb.replaceWith(_("Không tìm thấy tài liệu."));
                            } else if (data == "Barcode not found.") {
                                cb.replaceWith(_("Không tìm thấy tài liệu."));
                            } else if (data == "Borrower not found.") {
                                cb.replaceWith(_("Không tìm thấy bạn đọc."));
                            } else {
                                cb.replaceWith(data);
                            }
                        },
                    });
                });
                if ($("#operations tbody :checkbox").size() == 0) {
                    $("#actions").hide();
                }
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]

[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE Branches %]
[% USE KohaDates %]
[% USE Categories %]
[% USE TablesSettings %]
[% USE ItemTypes %]
[% USE Price %]
[% USE AuthorisedValues %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
[% SET destination = "circ" %]
<title
    >[% FILTER collapse %]
        [% IF patron %]
            [% patron_in_title = INCLUDE 'patron-title.inc' invert_name = 1 no_html = 1 %]
            [% tx("Checking out to {patron}", { patron = patron_in_title }) | html %]
            &rsaquo;
        [% END %]
        [% t("Circulation") | html %]
        &rsaquo; [% t("Koha") | html %]
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% FILTER collapse %]
    <style nonce="[% Koha.CSPNonce | $raw %]">
        /* ========================================================= */
        /* RESET & BASE                                              */
        /* ========================================================= */
        body#circ_circulation {
            background-color: #f4f6f9;
            color: #333333;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 12.5px;
            line-height: 1.4;
        }

        /* Ẩn các thanh Koha thừa */
        #circ_circulation #sidebar-container,
        #circ_circulation .patroninfo,
        #circ_circulation #members-toolbar,
        #circ_circulation h1,
        #circ_circulation #patron-detail-tabs,
        #circ_circulation #finesholdsissues {
            display: none !important;
        }

        /* Khung bao toàn màn hình 100% (Full-width, không co cụm vào giữa) */
        .ftu-circ-container {
            width: 100%;
            padding: 8px 16px 20px 16px;
            box-sizing: border-box;
        }

        /* Breadcrumb thanh mảnh */
        .ftu-breadcrumb {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 6px 14px;
            font-size: 12px;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .ftu-breadcrumb a {
            color: #0284c7;
            text-decoration: none;
        }
        .ftu-breadcrumb a:hover {
            text-decoration: underline;
        }

        /* Thẻ bao gọn gàng (Compact Card) */
        .ftu-panel {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 3px;
            margin-bottom: 8px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.03);
        }

        .ftu-panel-header {
            background: #eaf2f8;
            border-bottom: 1px solid #cbd5e1;
            padding: 5px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            font-weight: 700;
            color: #334155;
        }

        .ftu-panel-toggle {
            color: #64748b;
            font-size: 13px;
            text-decoration: none;
            padding: 1px 6px;
            cursor: pointer;
        }
        .ftu-panel-toggle:hover {
            color: #0f172a;
        }

        .ftu-panel-body {
            padding: 10px 14px;
        }

        /* ========================================================= */
        /* KHUNG TRÊN: 3 CỘT GỌN GÀNG (LEFT - MIDDLE - RIGHT)        */
        /* ========================================================= */
        .ftu-grid-top {
            display: flex;
            gap: 16px;
            align-items: stretch;
        }

        /* Cột 1: Thao tác mượn (Width 310px) */
        .ftu-col-form {
            width: 310px;
            flex-shrink: 0;
            border-right: 1px solid #e2e8f0;
            padding-right: 16px;
        }

        .ftu-form-row {
            display: flex;
            align-items: center;
            margin-bottom: 6px;
        }
        .ftu-form-lbl {
            width: 95px;
            flex-shrink: 0;
            font-size: 12px;
            color: #334155;
            margin: 0;
        }

        .ftu-field-box {
            flex: 1;
            display: flex;
            align-items: stretch;
        }

        .ftu-input-ctrl,
        .ftu-select-ctrl {
            width: 100%;
            height: 25px;
            border: 1px solid #cbd5e1;
            border-radius: 2px;
            padding: 2px 6px;
            font-size: 12px;
            color: #1e293b;
            background: #ffffff;
            box-sizing: border-box;
        }
        .ftu-input-ctrl:focus,
        .ftu-select-ctrl:focus {
            outline: none;
            border-color: #0284c7;
        }

        .ftu-barcode-input {
            border: 1px solid #f59e0b !important;
            font-weight: 600;
        }

        .ftu-addon-btn {
            width: 25px;
            height: 25px;
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            border-left: none;
            border-radius: 0 2px 2px 0;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 11px;
        }
        .ftu-addon-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        .ftu-checkbox-line {
            margin-left: 95px;
            margin-bottom: 8px;
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }
        .ftu-checkbox-line input {
            cursor: pointer;
            margin: 0;
        }

        .ftu-btn-group {
            display: flex;
            gap: 5px;
            margin-left: 95px;
        }

        .ftu-action-btn {
            border: none;
            border-radius: 2px;
            padding: 3px 10px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1.4;
        }
        .ftu-btn-amber {
            background: #f59e0b;
            color: #ffffff;
        }
        .ftu-btn-amber:hover {
            background: #d97706;
            color: #ffffff;
        }
        .ftu-btn-blue {
            background: #1e88e5;
            color: #ffffff;
        }
        .ftu-btn-blue:hover {
            background: #1565c0;
            color: #ffffff;
        }
        .ftu-btn-slate {
            background: #608b98;
            color: #ffffff;
        }
        .ftu-btn-slate:hover {
            background: #4b717d;
            color: #ffffff;
        }

        /* Cột 2: Thông tin bạn đọc (Dạng dòng văn bản tinh gọn, không rườm rà) */
        .ftu-col-patron-info {
            flex: 1;
            max-width: 720px;
            min-width: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .ftu-patron-line {
            display: flex;
            justify-content: space-between;
            font-size: 12.5px;
            line-height: 1.5;
            margin-bottom: 2px;
        }
        .ftu-name-lead {
            font-size: 13.5px;
            font-weight: 700;
            color: #15803d;
        }
        .ftu-kv {
            display: inline-flex;
            gap: 5px;
            align-items: baseline;
        }
        .ftu-k {
            font-weight: 700;
            color: #334155;
        }
        .ftu-v {
            color: #1e293b;
        }
        .ftu-danger-txt {
            color: #dc2626 !important;
            font-weight: 700;
        }

        /* Ghi chú và thông báo */
        .ftu-note-bar {
            position: relative;
            margin-top: 5px;
        }
        .ftu-note-input {
            width: 100%;
            height: 24px;
            border: 1px solid #cbd5e1;
            border-radius: 2px;
            padding: 2px 26px 2px 6px;
            font-size: 12px;
            box-sizing: border-box;
        }
        .ftu-note-icon {
            position: absolute;
            right: 8px;
            top: 5px;
            color: #0284c7;
            font-size: 12px;
        }

        .ftu-alert-bar {
            background: #e0f2fe;
            border: 1px solid #bae6fd;
            color: #0284c7;
            padding: 3px 8px;
            font-size: 12px;
            margin-top: 5px;
            border-radius: 2px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Cột 3: Avatar mặc định (Default Avatar Silhouette) */
        .ftu-col-avatar {
            width: 105px;
            flex-shrink: 0;
            margin-left: auto;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }
        .ftu-avatar-box {
            width: 100px;
            height: 120px;
            border: 1px solid #cbd5e1;
            background: #f8fafc;
            border-radius: 3px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            box-sizing: border-box;
        }
        .ftu-avatar-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .ftu-avatar-svg {
            width: 60px;
            height: 60px;
        }

        /* ========================================================= */
        /* KHUNG DƯỚI: BẢNG TÀI LIỆU ĐANG MƯỢN (COMPACT TABLE)       */
        /* ========================================================= */
        .ftu-panel-bottom {
            margin-top: 6px;
        }

        .ftu-summary-header {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 6px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .ftu-red-stat {
            color: #dc2626;
            font-weight: 700;
            font-size: 13px;
        }
        .ftu-top-links {
            display: flex;
            gap: 12px;
            align-items: center;
            font-size: 12px;
        }
        .ftu-top-links a {
            text-decoration: none;
            font-weight: 500;
        }
        .ftu-top-links a:hover {
            text-decoration: underline;
        }
        .ftu-lnk-fine { color: #0284c7; }
        .ftu-lnk-renew { color: #16a34a; }
        .ftu-lnk-return { color: #dc2626; }
        .ftu-lnk-print { color: #0284c7; }

        /* Bộ lọc & Tìm kiếm */
        .ftu-table-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0 8px 0;
            font-size: 12px;
            color: #64748b;
        }
        .ftu-select-len {
            height: 22px;
            border: 1px solid #cbd5e1;
            border-radius: 2px;
            padding: 1px 4px;
            font-size: 11.5px;
        }
        .ftu-search-input {
            height: 22px;
            width: 170px;
            border: 1px solid #cbd5e1;
            border-radius: 2px;
            padding: 2px 6px;
            font-size: 12px;
        }

        /* Bảng dữ liệu gọn gàng */
        .ftu-table-wrap {
            overflow-x: auto;
        }
        .ftu-tbl {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }
        .ftu-tbl th {
            background: #ffffff;
            border-top: 1px solid #cbd5e1;
            border-bottom: 2px solid #94a3b8;
            border-left: 1px solid #f1f5f9;
            border-right: 1px solid #f1f5f9;
            padding: 6px 8px;
            color: #334155;
            font-weight: 700;
            text-align: left;
            white-space: nowrap;
        }
        .ftu-tbl th.th-sort {
            cursor: pointer;
            user-select: none;
        }
        .ftu-tbl th.th-sort:hover {
            background: #f8fafc;
        }
        .ftu-tbl td {
            padding: 6px 8px;
            border: 1px solid #f1f5f9;
            color: #334155;
            vertical-align: middle;
        }
        .ftu-tbl tbody tr:hover td {
            background: #f8fafc;
        }

        .ftu-title-link {
            color: #0284c7;
            text-decoration: none;
            font-weight: 500;
        }
        .ftu-title-link:hover {
            text-decoration: underline;
        }

        /* Badge trạng thái */
        .ftu-badge-clean {
            padding: 2px 7px;
            border-radius: 2px;
            font-size: 11px;
            font-weight: 600;
            color: #ffffff;
            display: inline-block;
            white-space: nowrap;
        }
        .ftu-bg-borrow { background: #1e88e5; }
        .ftu-bg-overdue { background: #dc2626; }

        /* Icon thao tác (tối giản, nhỏ gọn) */
        .ftu-act-icon {
            background: none;
            border: none;
            cursor: pointer;
            padding: 1px 3px;
            font-size: 12px;
            color: inherit;
            text-decoration: none;
            display: inline-block;
            line-height: 1;
        }
        .ftu-act-icon:hover {
            opacity: 0.7;
        }

        /* Phân trang chân bảng */
        .ftu-footer-bar {
            padding: 6px 0 2px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: #64748b;
        }
        .ftu-pagination {
            display: flex;
            gap: 2px;
        }
        .ftu-pg-btn {
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #334155;
            padding: 1px 7px;
            font-size: 11px;
            border-radius: 2px;
            cursor: pointer;
        }
        .ftu-pg-btn.active {
            background: #1e88e5;
            color: #ffffff;
            border-color: #1e88e5;
        }
        .ftu-pg-btn:disabled {
            opacity: 0.5;
            cursor: default;
        }
    </style>
[% END %]
</head>

<body id="circ_circulation" class="circ">

[% WRAPPER 'header.inc' %]
    [% INCLUDE 'circ-search.inc' %]
[% END %]

<div class="ftu-breadcrumb">
    <a href="/cgi-bin/koha/mainpage.pl">Trang chủ</a>
    <span>&rsaquo;</span>
    <span>Lưu thông</span>
</div>

[% SET asides = [] %]
[% WRAPPER 'main-container.inc' wide_full=1 %]

<div class="ftu-circ-container">

    <!-- ========================================================= -->
    <!-- KHUNG 1: PHÒNG MƯỢN (THAO TÁC + BẠN ĐỌC)                  -->
    <!-- ========================================================= -->
    <div class="ftu-panel">
        <div class="ftu-panel-header">
            <div>Phòng Mượn</div>
            <div>
                <a href="#" class="ftu-panel-toggle" data-target="#ftu-top-body" title="Thu gọn / Mở rộng"><i class="fa fa-angle-up"></i></a>
            </div>
        </div>
        <div class="ftu-panel-body" id="ftu-top-body">
            <div class="ftu-grid-top">

                <!-- CỘT 1: THAO TÁC GHI MƯỢN -->
                <div class="ftu-col-form">
                    [% IF patron %]
                    <form method="post" action="/cgi-bin/koha/circ/circulation.pl" id="mainform" name="mainform" autocomplete="off">
                        [% INCLUDE 'csrf-token.inc' %]
                        <input type="hidden" name="op" value="cud-checkout" />
                        <input type="hidden" name="borrowernumber" id="borrowernumber" value="[% patron.borrowernumber | html %]" />
                        <input type="hidden" name="restoreduedatespec" />
                        <input type="hidden" name="debt_confirmed" value="[% debt_confirmed | html %]" />
                        [% IF (forceallow) %]<input type="hidden" name="forceallow" value="1" />[% END %]
                        [% IF ( CHARGES ) %]<input type="hidden" name="charges" value="yes" />[% END %]

                        <div class="ftu-form-row">
                            <label class="ftu-form-lbl" for="branch">Điểm lưu thông</label>
                            <div class="ftu-field-box">
                                <select name="branch" id="branch" class="ftu-select-ctrl">
                                    <option value="[% patron.branchcode | html %]" selected="selected">Phòng Mượn</option>
                                    [% FOREACH b IN Branches.all %]
                                        [% IF b.branchcode != patron.branchcode %]
                                            <option value="[% b.branchcode | html %]">[% b.branchname | html %]</option>
                                        [% END %]
                                    [% END %]
                                </select>
                            </div>
                        </div>

                        <div class="ftu-form-row">
                            <label class="ftu-form-lbl" for="ftu_cardnumber">Số thẻ</label>
                            <div class="ftu-field-box">
                                <input type="text" id="ftu_cardnumber" name="findborrower" value="[% patron.cardnumber | html %]" class="ftu-input-ctrl" autocomplete="off" />
                                <button type="button" class="ftu-addon-btn" id="btn-reload-patron" title="Làm mới"><i class="fa fa-refresh"></i></button>
                            </div>
                        </div>

                        <div class="ftu-form-row">
                            <label class="ftu-form-lbl" for="barcode">Số ĐKCB</label>
                            <div class="ftu-field-box">
                                <input type="text" name="barcode" id="barcode" class="ftu-input-ctrl ftu-barcode-input focus" autocomplete="off" placeholder="" />
                                <button type="button" class="ftu-addon-btn" id="btn-clear-barcode" title="Xóa"><i class="fa fa-refresh"></i></button>
                            </div>
                        </div>

                        <div class="ftu-checkbox-line">
                            <input type="checkbox" id="calc_turn" name="calc_turn" checked="checked" />
                            <label for="calc_turn" style="margin:0; font-weight:normal; cursor:pointer;">Tính lượt</label>
                        </div>

                        <div class="ftu-btn-group">
                            <a href="/cgi-bin/koha/circ/circulation.pl" class="ftu-action-btn ftu-btn-amber">Từ chối</a>
                            <button type="submit" class="ftu-action-btn ftu-btn-blue">Mượn</button>
                            <a href="/cgi-bin/koha/members/members-home.pl" class="ftu-action-btn ftu-btn-slate">Tìm tên</a>
                        </div>
                    </form>
                    [% ELSE %]
                    <form action="/cgi-bin/koha/circ/circulation.pl" id="mainform" method="get" autocomplete="off">
                        <div class="ftu-form-row">
                            <label class="ftu-form-lbl" for="branch">Điểm lưu thông</label>
                            <div class="ftu-field-box">
                                <select name="branch" id="branch" class="ftu-select-ctrl">
                                    <option value="CPL" selected="selected">Phòng Mượn</option>
                                    [% FOREACH b IN Branches.all %]
                                        <option value="[% b.branchcode | html %]">[% b.branchname | html %]</option>
                                    [% END %]
                                </select>
                            </div>
                        </div>

                        <div class="ftu-form-row">
                            <label class="ftu-form-lbl" for="findborrower_main">Số thẻ</label>
                            <div class="ftu-field-box">
                                <input type="text" id="findborrower_main" name="findborrower" class="ftu-input-ctrl ftu-barcode-input focus" autocomplete="off" placeholder="Nhập mã thẻ hoặc họ tên" />
                                <button type="submit" class="ftu-addon-btn" title="Tìm"><i class="fa fa-search"></i></button>
                            </div>
                        </div>

                        <div class="ftu-form-row">
                            <label class="ftu-form-lbl">Số ĐKCB</label>
                            <div class="ftu-field-box">
                                <input type="text" class="ftu-input-ctrl" disabled="disabled" placeholder="Vui lòng nhập thẻ trước" />
                            </div>
                        </div>

                        <div class="ftu-checkbox-line">
                            <input type="checkbox" id="calc_turn" name="calc_turn" checked="checked" />
                            <label for="calc_turn" style="margin:0; font-weight:normal; cursor:pointer;">Tính lượt</label>
                        </div>

                        <div class="ftu-btn-group">
                            <button type="submit" class="ftu-action-btn ftu-btn-blue">Tìm bạn đọc</button>
                            <a href="/cgi-bin/koha/members/members-home.pl" class="ftu-action-btn ftu-btn-slate">Tìm tên</a>
                        </div>
                    </form>
                    [% END %]
                </div>

                <!-- CỘT 2: THÔNG TIN BẠN ĐỌC (TINH GỌN, ÍT CHỮ) -->
                <div class="ftu-col-patron-info">
                    [% IF patron %]
                    [% SET overdue_count = 0 %]
                    [% FOREACH chk IN patron.checkouts %]
                        [% IF chk.is_overdue %][% SET overdue_count = overdue_count + 1 %][% END %]
                    [% END %]

                    <!-- Dòng 1: Họ tên + Ngày sinh -->
                    <div class="ftu-patron-line">
                        <div class="ftu-name-lead">[% patron.cardnumber | html %]/ [% patron.surname | html %] [% patron.firstname | html %]</div>
                        [% IF patron.dateofbirth %]
                        <div class="ftu-kv"><span class="ftu-k">N.sinh:</span> <span class="ftu-v">[% patron.dateofbirth | $KohaDates dateformat => 'metric' %]</span></div>
                        [% END %]
                    </div>

                    <!-- Dòng 2: Cấp thẻ + Hạn thẻ -->
                    <div class="ftu-patron-line">
                        <div class="ftu-kv">
                            <span class="ftu-k">Cấp thẻ:</span> 
                            <span class="ftu-v">[% IF patron.dateenrolled %][% patron.dateenrolled | $KohaDates dateformat => 'metric' %][% ELSE %]01/10/2026[% END %]</span>
                        </div>
                        <div class="ftu-kv">
                            <span class="ftu-k">Hạn thẻ:</span> 
                            <span class="ftu-v [% IF patron.is_expired %]ftu-danger-txt[% END %]">[% IF patron.dateexpiry %][% patron.dateexpiry | $KohaDates dateformat => 'metric' %][% ELSE %]01/10/2027[% END %]</span>
                        </div>
                    </div>

                    <!-- Dòng 3: Địa chỉ (chỉ hiển thị nếu có) -->
                    [% IF patron.address || patron.city %]
                    <div class="ftu-patron-line">
                        <div class="ftu-kv" style="width:100%;">
                            <span class="ftu-k">Địa chỉ:</span> 
                            <span class="ftu-v">[% patron.address | html %][% IF patron.city %], [% patron.city | html %][% END %]</span>
                        </div>
                    </div>
                    [% END %]

                    <!-- Dòng 4: Cấp thẻ lần + Quá hạn + Tiền cược -->
                    <div class="ftu-patron-line">
                        <div class="ftu-kv">
                            <span class="ftu-k">Cấp thẻ lần:</span> 1; 
                            <span class="[% IF overdue_count > 0 %]ftu-danger-txt[% ELSE %]ftu-v[% END %]">Quá hạn: [% overdue_count %] tài liệu</span>
                        </div>
                        <div class="ftu-kv">
                            <span class="ftu-k">Tiền cược:</span> 
                            <span class="ftu-v">[% IF patron.account.balance && (patron.account.balance + 0) > 0 %][% patron.account.balance | $Price %][% ELSE %]0[% END %] (VNĐ)</span>
                        </div>
                    </div>

                    <!-- Dòng 5: Thời hạn + Số lượng mượn -->
                    <div class="ftu-patron-line">
                        <div class="ftu-kv">
                            <span class="ftu-k">Ngày mượn/Gia hạn:</span> 
                            <span class="ftu-v">120/ 120</span>
                        </div>
                        <div class="ftu-kv">
                            <span class="ftu-k">Sách mượn/Gia hạn:</span> 
                            <span class="ftu-v">[% patron.checkouts.count || 0 %]/ 5</span>
                        </div>
                    </div>

                    <!-- Dòng 6: Ghi chú -->
                    <div class="ftu-note-bar">
                        <input type="text" id="ftu_patron_note" class="ftu-note-input" value="[% patron.borrowernotes | html %]" placeholder="" />
                        <i class="fa fa-comment-o ftu-note-icon"></i>
                    </div>

                    <!-- Dòng 7: Thanh trạng thái -->
                    <div class="ftu-alert-bar" id="ftu-feedback-bar">
                        <span id="ftu-feedback-text">
                            [% IF ( issue ) %]
                                Đã mượn thành công: [% issue.item.biblio.title | html %] ([% issue.item.barcode | html %]). Hạn trả: [% issue.date_due | $KohaDates as_due_date => 1 dateformat => 'metric' %]
                            [% ELSIF ( was_renewed ) %]
                                Đã gia hạn thành công.
                            [% ELSIF ( messages ) %]
                                [% messages | html %]
                            [% ELSE %]
                                .
                            [% END %]
                        </span>
                        <button type="button" style="background:none; border:none; color:#0284c7; cursor:pointer;" onclick="document.getElementById('ftu-feedback-bar').style.display='none';">&times;</button>
                    </div>

                    [% ELSE %]
                    <div style="padding:28px 10px; text-align:center; color:#64748b;">
                        Nhập số thẻ bạn đọc hoặc quét mã để bắt đầu phiên lưu thông.
                    </div>
                    [% END %]
                </div>

                <!-- CỘT 3: AVATAR MẶC ĐỊNH (DEFAULT AVATAR) -->
                <div class="ftu-col-avatar">
                    <div class="ftu-avatar-box">
                        [% IF Koha.Preference('patronimages') && patron.image %]
                            <img src="/cgi-bin/koha/members/patronimage.pl?borrowernumber=[% patron.borrowernumber | uri %]" alt="Ảnh bạn đọc" />
                        [% ELSE %]
                            <!-- Avatar Silhouette mặc định chuẩn vector -->
                            <svg viewBox="0 0 24 24" class="ftu-avatar-svg">
                                <circle cx="12" cy="8" r="4.2" fill="#cbd5e1" />
                                <path d="M4 19.5c0-3.5 3.5-6 8-6s8 2.5 8 6v1H4v-1z" fill="#cbd5e1" />
                            </svg>
                        [% END %]
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- KHỐI XÁC NHẬN NẾU CÓ TRỞ NGẠI LƯU THÔNG -->
    [% IF ( NEEDSCONFIRMATION ) %]
        <div id="circ_needsconfirmation" class="alert alert-warning" style="margin-bottom:8px; border-radius:2px; padding:8px 12px;">
            <strong style="display:block; margin-bottom:4px;">Vui lòng xác nhận cho mượn:</strong>
            <ul style="margin:0 0 8px 16px; padding:0;">
                [% IF ( RENEW_ISSUE ) %]<li>Tài liệu <em>[% getTitleMessageIteminfo | html %]</em> ([% getBarcodeMessageIteminfo | html %]) đang được mượn bởi bạn đọc này. Gia hạn?</li>[% END %]
                [% IF ( ISSUED_TO_ANOTHER ) %]<li>Tài liệu đang được mượn bởi [% issued_firstname | html %] [% issued_surname | html %] ([% issued_cardnumber | html %]). Ghi trả và mượn lại?</li>[% END %]
                [% IF ( RESERVE_WAITING ) %]<li>Tài liệu đang chờ bạn đọc khác đặt trước.</li>[% END %]
                [% IF ( DEBT ) %]<li>Bạn đọc đang nợ tiền phạt: [% DEBT | $Price %].</li>[% END %]
            </ul>
            <form method="post" action="/cgi-bin/koha/circ/circulation.pl" style="display:flex; gap:6px;">
                [% INCLUDE 'csrf-token.inc' %]
                <input type="hidden" name="op" value="cud-checkout" />
                <input type="hidden" name="borrowernumber" value="[% patron.borrowernumber | html %]" />
                <input type="hidden" name="barcode" value="[% barcode | html %]" />
                <input type="hidden" name="issueconfirmed" value="1" />
                <input type="hidden" name="debt_confirmed" value="1" />
                <button type="submit" class="ftu-action-btn ftu-btn-amber">Xác nhận</button>
                <a href="/cgi-bin/koha/circ/circulation.pl?findborrower=[% patron.cardnumber | uri %]" class="ftu-action-btn ftu-btn-slate">Hủy</a>
            </form>
        </div>
    [% END %]

    [% IF ( IMPOSSIBLE ) %]
        <div class="alert alert-danger" style="margin-bottom:8px; border-radius:2px; padding:8px 12px;">
            <strong style="display:block; margin-bottom:4px;">Không thể cho mượn:</strong>
            <ul style="margin:0 0 8px 16px; padding:0;">
                [% IF ( UNKNOWN_BARCODE ) %]<li>Không tìm thấy mã vạch: [% barcode | html %]</li>[% END %]
                [% IF ( NOT_FOR_LOAN ) %]<li>Tài liệu này không cho mượn về nhà.</li>[% END %]
                [% IF ( WTHDRAWN ) %]<li>Tài liệu đã rút khỏi lưu thông.</li>[% END %]
                [% IF ( RESTRICTED ) %]<li>Tài liệu bị hạn chế lưu thông.</li>[% END %]
            </ul>
            <a href="/cgi-bin/koha/circ/circulation.pl?findborrower=[% patron.cardnumber | uri %]" class="ftu-action-btn ftu-btn-slate">Quay lại</a>
        </div>
    [% END %]

    <!-- ========================================================= -->
    <!-- KHUNG 2: BẢNG TÀI LIỆU ĐANG MƯỢN (COMPACT TABLE)          -->
    <!-- ========================================================= -->
    [% IF patron %]
    <div class="ftu-panel ftu-panel-bottom">
        <div class="ftu-summary-header">
            <div class="ftu-red-stat">
                Tổng đang mượn : <span id="ftu-total-count">[% patron.checkouts.count || 0 %]</span> | PLV.Mượn : 0 | PLV.Trả: 0
            </div>
            <div class="ftu-top-links">
                <a href="/cgi-bin/koha/members/boraccount.pl?borrowernumber=[% patron.borrowernumber | uri %]" class="ftu-lnk-fine" target="_blank">Cập nhật phạt</a>
                <a href="#" id="ftu-btn-renew-all" class="ftu-lnk-renew">Gia hạn tất cả</a>
                <a href="#" id="ftu-btn-return-all" class="ftu-lnk-return">Trả tất cả</a>
                <a href="/cgi-bin/koha/members/printslip.pl?borrowernumber=[% patron.borrowernumber | uri %]&amp;print=issueslip" target="_blank" class="ftu-lnk-print">In danh sách</a>
                <a href="#" class="ftu-panel-toggle" data-target="#ftu-bottom-body" title="Thu gọn / Mở rộng"><i class="fa fa-angle-up"></i></a>
            </div>
        </div>
        <div class="ftu-panel-body" id="ftu-bottom-body" style="padding-top:6px;">

            <!-- Bộ lọc & Tìm kiếm nhanh -->
            <div class="ftu-table-bar">
                <div>
                    Hiển thị 
                    <select id="ftu-page-length" class="ftu-select-len">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                    bản ghi
                </div>
                <div>
                    <input type="text" id="ftu-search-table" class="ftu-search-input" placeholder="" />
                </div>
            </div>

            <!-- Bảng dữ liệu -->
            <div class="ftu-table-wrap">
                <table id="ftu-checkouts-table" class="ftu-tbl">
                    <thead>
                        <tr>
                            <th style="width: 28px; text-align: center;"><input type="checkbox" id="ftu-chk-all" /></th>
                            <th class="th-sort" data-col="1" style="width: 100px;">Số ĐKCB <i class="fa fa-sort"></i></th>
                            <th class="th-sort" data-col="2">Nhan đề tài liệu <i class="fa fa-sort"></i></th>
                            <th class="th-sort" data-col="3" style="width: 110px;">Môn loại <i class="fa fa-sort"></i></th>
                            <th class="th-sort" data-col="4" style="width: 180px;">Tác giả <i class="fa fa-sort"></i></th>
                            <th class="th-sort" data-col="5" style="width: 95px;">Ngày mượn <i class="fa fa-sort"></i></th>
                            <th class="th-sort" data-col="6" style="width: 95px;">Hạn trả <i class="fa fa-sort"></i></th>
                            <th style="text-align: center; width: 90px;">Trạng thái</th>
                            <th style="text-align: center; width: 115px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        [% IF patron.checkouts.count > 0 %]
                            [% FOREACH issue IN patron.checkouts %]
                            <tr data-issue-id="[% issue.issue_id | html %]" data-barcode="[% issue.item.barcode | html %]">
                                <td style="text-align: center;"><input type="checkbox" class="ftu-chk-item" value="[% issue.issue_id | html %]" data-barcode="[% issue.item.barcode | html %]" /></td>
                                <td style="font-weight: 600;">[% issue.item.barcode | html %]</td>
                                <td>
                                    <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% issue.item.biblio.biblionumber | uri %]" class="ftu-title-link" target="_blank">[% issue.item.biblio.title | html %]</a>
                                </td>
                                <td>[% issue.item.itemcallnumber | html %]</td>
                                <td>[% issue.item.biblio.author | html %]</td>
                                <td>[% issue.issuedate | $KohaDates dateformat => 'metric' %]</td>
                                <td class="ftu-duedate-cell">[% issue.date_due | $KohaDates dateformat => 'metric' %]</td>
                                <td style="text-align: center;">
                                    [% IF issue.is_overdue %]
                                        <span class="ftu-badge-clean ftu-bg-overdue">Quá hạn</span>
                                    [% ELSE %]
                                        <span class="ftu-badge-clean ftu-bg-borrow">Đang mượn</span>
                                    [% END %]
                                </td>
                                <td style="text-align: center; white-space: nowrap;">
                                    <button type="button" class="ftu-act-icon ftu-btn-renew-one" data-issue-id="[% issue.issue_id | html %]" title="Gia hạn"><i class="fa fa-calendar" style="color:#0284c7;"></i></button>
                                    <a href="/cgi-bin/koha/catalogue/moredetail.pl?itemnumber=[% issue.itemnumber | uri %]&amp;biblionumber=[% issue.item.biblio.biblionumber | uri %]" target="_blank" class="ftu-act-icon" title="Chi tiết bản sách"><i class="fa fa-pencil" style="color:#64748b;"></i></a>
                                    <button type="button" class="ftu-act-icon ftu-btn-return-one" data-barcode="[% issue.item.barcode | html %]" data-title="[% issue.item.biblio.title | html %]" title="Trả tài liệu"><i class="fa fa-ban" style="color:#dc2626;"></i></button>
                                    <button type="button" class="ftu-act-icon" title="Ghi chú"><i class="fa fa-comment-o" style="color:#0284c7;"></i></button>
                                    <a href="/cgi-bin/koha/members/printslip.pl?borrowernumber=[% patron.borrowernumber | uri %]&amp;print=issueslip" target="_blank" class="ftu-act-icon" title="In phiếu"><i class="fa fa-print" style="color:#ea580c;"></i></a>
                                </td>
                            </tr>
                            [% END %]
                        [% ELSE %]
                            <tr class="ftu-row-empty">
                                <td colspan="9" style="text-align: center; padding: 20px 8px; color: #64748b;">Không có tài liệu nào đang mượn</td>
                            </tr>
                        [% END %]
                    </tbody>
                </table>
            </div>

            <!-- Chân bảng: số lượng và phân trang -->
            <div class="ftu-footer-bar">
                <div id="ftu-footer-info">
                    Hiển thị 1 đến [% patron.checkouts.count || 0 %] trong [% patron.checkouts.count || 0 %] bản ghi
                </div>
                <div class="ftu-pagination">
                    <button type="button" class="ftu-pg-btn" disabled>&lt;</button>
                    <button type="button" class="ftu-pg-btn active">1</button>
                    <button type="button" class="ftu-pg-btn" disabled>&gt;</button>
                </div>
            </div>

        </div>
    </div>
    [% END %]

</div> <!-- /.ftu-circ-container -->

<!-- Hidden compatibility container for Koha scripts -->
<div style="display:none;">
    <table id="issues-table"></table>
</div>

[% END # /WRAPPER main-container.inc %]

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'datatables.inc' %]
    [% INCLUDE 'select2.inc' %]
    [% INCLUDE 'js-date-format.inc' %]
    <script nonce="[% Koha.CSPNonce | $raw %]">
        $(document).ready(function() {
            // 1. Focus barcode
            setTimeout(function() {
                var bc = $('#barcode');
                if (bc.length) { bc.focus(); }
                var fb = $('#findborrower_main');
                if (fb.length) { fb.focus(); }
            }, 100);

            // 2. Clear barcode input
            $('#btn-clear-barcode').on('click', function(e) {
                e.preventDefault();
                $('#barcode').val('').focus();
            });

            // 3. Clear/Reload patron screen
            $('#btn-reload-patron').on('click', function(e) {
                e.preventDefault();
                window.location.href = '/cgi-bin/koha/circ/circulation.pl';
            });

            // 4. Toggle Card Panels
            $('.ftu-panel-toggle').on('click', function(e) {
                e.preventDefault();
                var target = $(this).data('target');
                var icon = $(this).find('i');
                $(target).slideToggle(160, function() {
                    if ($(this).is(':visible')) {
                        icon.removeClass('fa-angle-down').addClass('fa-angle-up');
                    } else {
                        icon.removeClass('fa-angle-up').addClass('fa-angle-down');
                    }
                });
            });

            // 5. Select all checkboxes
            $('#ftu-chk-all').on('change', function() {
                var isChecked = $(this).prop('checked');
                $('.ftu-chk-item').prop('checked', isChecked);
            });

            // 6. Toast Notification
            function showToast(msg, type) {
                var container = document.getElementById('ftu-toast-container');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'ftu-toast-container';
                    container.style.cssText = 'position:fixed;top:60px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:6px;pointer-events:none;';
                    document.body.appendChild(container);
                }
                var colors = { success:'#16a34a', error:'#dc2626', info:'#0284c7' };
                var toast = document.createElement('div');
                toast.style.cssText = 'pointer-events:auto;background:#ffffff;border-left:4px solid '+(colors[type]||'#0284c7')+';border-radius:2px;padding:6px 12px;box-shadow:0 2px 8px rgba(0,0,0,0.12);font-size:12px;max-width:320px;';
                toast.innerHTML = '<span style="color:'+(colors[type]||'#0284c7')+';font-weight:bold;margin-right:6px;">'+(type==='success'?'✓':(type==='error'?'✗':'ℹ'))+'</span><span>'+msg+'</span>';
                container.appendChild(toast);
                setTimeout(function(){
                    toast.style.opacity='0';
                    toast.style.transition='opacity 0.25s';
                    setTimeout(function(){ if (toast.parentNode) toast.remove(); }, 250);
                }, 3000);
            }

            // 7. Update Table Counts
            function updateCounts() {
                var rows = $('#ftu-checkouts-table tbody tr[data-issue-id]');
                var count = rows.length;
                $('#ftu-total-count').text(count);
                if (count === 0) {
                    $('#ftu-checkouts-table tbody').html('<tr class="ftu-row-empty"><td colspan="9" style="text-align:center; padding:20px 8px; color:#64748b;">Không có tài liệu nào đang mượn</td></tr>');
                    $('#ftu-footer-info').text('Hiển thị 0 trong 0 bản ghi');
                } else {
                    $('#ftu-footer-info').text('Hiển thị 1 đến ' + count + ' trong ' + count + ' bản ghi');
                }
            }

            // 8. Single Item Renew
            $(document).on('click', '.ftu-btn-renew-one', async function(e) {
                e.preventDefault();
                var btn = $(this);
                var issueId = btn.data('issue-id');
                var row = btn.closest('tr');
                var dueCell = row.find('.ftu-duedate-cell');

                btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
                try {
                    var resp = await fetch('/api/v1/checkouts/' + issueId + '/renewals', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'x-koha-override': 'debt_limit' },
                        body: '{}',
                        credentials: 'same-origin'
                    });
                    if (resp.ok) {
                        var data = await resp.json();
                        if (data.due_date) {
                            var dt = new Date(data.due_date);
                            var day = String(dt.getDate()).padStart(2, '0');
                            var month = String(dt.getMonth() + 1).padStart(2, '0');
                            var year = dt.getFullYear();
                            dueCell.html('<span style="color:#16a34a; font-weight:700;">' + day + '/' + month + '/' + year + '</span>');
                        }
                        showToast('Đã gia hạn thành công', 'success');
                        btn.html('<i class="fa fa-check" style="color:#16a34a;"></i>');
                    } else {
                        var err = await resp.json().catch(function(){ return {}; });
                        showToast('Không thể gia hạn: ' + (err.error || resp.status), 'error');
                        btn.prop('disabled', false).html('<i class="fa fa-calendar" style="color:#0284c7;"></i>');
                    }
                } catch(ex) {
                    showToast('Lỗi kết nối khi gia hạn', 'error');
                    btn.prop('disabled', false).html('<i class="fa fa-calendar" style="color:#0284c7;"></i>');
                }
            });

            // 9. Single Item Return
            $(document).on('click', '.ftu-btn-return-one', async function(e) {
                e.preventDefault();
                var btn = $(this);
                var barcode = btn.data('barcode');
                var title = btn.data('title');
                var row = btn.closest('tr');

                if (!confirm('Xác nhận trả tài liệu: ' + (title || barcode) + '?')) return;

                btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
                var csrf = $('input[name="csrf_token"]').val() || '';
                var fd = new FormData();
                fd.append('op', 'cud-checkin');
                fd.append('barcode', barcode);
                fd.append('csrf_token', csrf);

                try {
                    await fetch('/cgi-bin/koha/circ/returns.pl', {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin'
                    });
                    row.css({ transition: 'opacity 0.25s', opacity: 0 });
                    setTimeout(function() {
                        row.remove();
                        updateCounts();
                    }, 260);
                    showToast('Đã trả thành công: ' + (title || barcode), 'success');
                } catch(ex) {
                    showToast('Lỗi khi trả sách', 'error');
                    btn.prop('disabled', false).html('<i class="fa fa-ban" style="color:#dc2626;"></i>');
                }
            });

            // 10. Renew All
            $('#ftu-btn-renew-all').on('click', async function(e) {
                e.preventDefault();
                var btns = $('.ftu-btn-renew-one:not(:disabled)');
                if (!btns.length) {
                    showToast('Không có tài liệu nào để gia hạn', 'info');
                    return;
                }
                if (!confirm('Xác nhận gia hạn tất cả ' + btns.length + ' tài liệu?')) return;
                $(this).css('opacity', 0.5);
                for (var i = 0; i < btns.length; i++) {
                    $(btns[i]).click();
                    await new Promise(r => setTimeout(r, 200));
                }
                $(this).css('opacity', 1);
                showToast('Đã gửi yêu cầu gia hạn tất cả', 'success');
            });

            // 11. Return All
            $('#ftu-btn-return-all').on('click', async function(e) {
                e.preventDefault();
                var rows = $('#ftu-checkouts-table tbody tr[data-barcode]');
                if (!rows.length) {
                    showToast('Không có tài liệu nào đang mượn', 'info');
                    return;
                }
                if (!confirm('Xác nhận trả tất cả ' + rows.length + ' tài liệu?')) return;
                $(this).css('opacity', 0.5);
                var csrf = $('input[name="csrf_token"]').val() || '';
                for (var i = 0; i < rows.length; i++) {
                    var row = $(rows[i]);
                    var bc = row.data('barcode');
                    var fd = new FormData();
                    fd.append('op', 'cud-checkin');
                    fd.append('barcode', bc);
                    fd.append('csrf_token', csrf);
                    try {
                        await fetch('/cgi-bin/koha/circ/returns.pl', { method: 'POST', body: fd, credentials: 'same-origin' });
                    } catch(e) {}
                    row.remove();
                    await new Promise(r => setTimeout(r, 120));
                }
                $(this).css('opacity', 1);
                updateCounts();
                showToast('Đã trả tất cả tài liệu', 'success');
            });

            // 12. Instant Table Search
            $('#ftu-search-table').on('keyup', function() {
                var term = $(this).val().toLowerCase().trim();
                var rows = $('#ftu-checkouts-table tbody tr[data-issue-id]');
                var visibleCount = 0;
                rows.each(function() {
                    var rowText = $(this).text().toLowerCase();
                    if (rowText.indexOf(term) > -1) {
                        $(this).show();
                        visibleCount++;
                    } else {
                        $(this).hide();
                    }
                });
                $('#ftu-footer-info').text('Hiển thị 1 đến ' + visibleCount + ' trong ' + rows.length + ' bản ghi');
            });

            // 13. Column Sorting
            $('.th-sort').on('click', function() {
                var colIdx = $(this).index();
                var table = $('#ftu-checkouts-table');
                var rows = table.find('tbody tr[data-issue-id]').toArray();
                var asc = !$(this).data('asc');
                $(this).data('asc', asc);
                $('.th-sort i').removeClass('fa-sort-asc fa-sort-desc').addClass('fa-sort');
                $(this).find('i').removeClass('fa-sort').addClass(asc ? 'fa-sort-asc' : 'fa-sort-desc');

                rows.sort(function(a, b) {
                    var aVal = $(a).find('td').eq(colIdx).text().trim();
                    var bVal = $(b).find('td').eq(colIdx).text().trim();
                    return asc ? aVal.localeCompare(bVal, 'vi', { numeric: true }) : bVal.localeCompare(aVal, 'vi', { numeric: true });
                });
                table.find('tbody').append(rows);
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]

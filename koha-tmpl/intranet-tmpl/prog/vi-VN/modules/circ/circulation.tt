[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE Branches %]
[% USE KohaDates %]
[% USE Categories %]
[% USE TablesSettings %]
[% USE ItemTypes %]
[% USE Price %]
[% USE AuthorisedValues %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
[% SET destination = "circ" %]
<title>[% FILTER collapse %]
    [% IF patron %]
        [% patron_in_title = INCLUDE 'patron-title.inc' invert_name = 1 no_html = 1 %]
        [% tx("Checking out to {patron}", { patron = patron_in_title }) | html %]
        &rsaquo;
    [% END %]
    [% t("Circulation") | html %]
    &rsaquo; [% t("Koha") | html %]
[% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
[% FILTER collapse %]
    <style nonce="[% Koha.CSPNonce | $raw %]">
        /* RESET & BASE */
        body#circ_circulation {
            background-color: #f1f5f9;
            color: #0f172a;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 13px;
            line-height: 1.5;
        }

        #circ_circulation #sidebar-container,
        #circ_circulation .patroninfo,
        #circ_circulation #members-toolbar,
        #circ_circulation h1,
        #circ_circulation #patron-detail-tabs,
        #circ_circulation #finesholdsissues {
            display: none !important;
        }

        #circ_circulation .main.container-fluid,
        #circ_circulation .col-md-10,
        #circ_circulation .col-lg-8,
        #circ_circulation .col-xl-12,
        #circ_circulation main {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 8px 16px 20px 16px !important;
            flex: 0 0 100% !important;
        }

        .ftu-circ-workspace {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* BREADCRUMB */
        .ftu-breadcrumb {
            font-size: 12px;
            color: #64748b;
            padding: 2px 4px 6px 4px;
        }
        .ftu-breadcrumb a {
            color: #0284c7;
            text-decoration: none;
        }
        .ftu-breadcrumb a:hover {
            text-decoration: underline;
        }

        /* 2-COLUMN SPLIT WORKSPACE */
        .ftu-split-desk {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            width: 100%;
        }

        /* THẺ TRẮNG BO TRÒN CHUẨN GIAO DIỆN MẪU */
        .ftu-card-box {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            overflow: hidden;
            box-sizing: border-box;
        }

        /* ========================================================================== */
        /* CỘT TRÁI: HỒ SƠ BẠN ĐỌC (TĂNG KÍCH THƯỚC RỘNG RÃI HƠN)                     */
        /* ========================================================================== */
        .ftu-left-patron-col {
            width: 420px;
            flex-shrink: 0;
            padding: 26px 24px 22px 24px;
        }

        /* Avatar Silhouette tròn lớn */
        .ftu-patron-avatar-circle {
            width: 86px;
            height: 86px;
            border-radius: 50%;
            background: #e2e8f0;
            margin: 0 auto 12px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        .ftu-patron-avatar-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .ftu-avatar-svg {
            width: 56px;
            height: 56px;
            fill: #94a3b8;
        }

        /* Tên bạn đọc & Số thẻ */
        .ftu-patron-center-name {
            text-align: center;
            font-size: 19px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 5px;
        }
        .ftu-patron-center-sub {
            text-align: center;
            font-size: 13px;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 14px;
        }
        .ftu-badge-active {
            background: #dcfce7;
            color: #15803d;
            font-size: 12px;
            font-weight: 600;
            padding: 2.5px 9px;
            border-radius: 12px;
        }
        .ftu-badge-inactive {
            background: #fee2e2;
            color: #b91c1c;
            font-size: 12px;
            font-weight: 600;
            padding: 2.5px 9px;
            border-radius: 12px;
        }

        /* Chỉ số nhanh ở giữa thẻ */
        .ftu-patron-stats-row {
            text-align: center;
            font-size: 13.5px;
            color: #334155;
            margin-bottom: 16px;
        }
        .ftu-patron-stats-row strong {
            color: #0f172a;
            font-weight: 700;
        }

        .ftu-card-divider {
            height: 1px;
            background: #f1f5f9;
            margin: 16px 0;
        }

        /* Lưới 2 cột thông tin chi tiết (Giống ảnh mẫu 100%) */
        .ftu-patron-2col-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 18px;
            margin-bottom: 18px;
        }
        .ftu-meta-block {
            display: flex;
            flex-direction: column;
            gap: 3px;
            min-width: 0;
        }
        .ftu-meta-label {
            font-size: 12px;
            color: #64748b;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .ftu-meta-label i {
            color: #94a3b8;
            font-size: 13px;
            width: 14px;
            text-align: center;
        }
        .ftu-meta-text {
            font-size: 13px;
            font-weight: 600;
            color: #0f172a;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            padding-left: 20px;
        }

        /* 3 Nút bấm dưới cùng (Hồ sơ chi tiết, Đổi bạn đọc, Tra cứu) */
        .ftu-left-actions-row {
            display: flex;
            gap: 8px;
        }
        .ftu-card-action-btn {
            flex: 1;
            height: 35px;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 12.5px;
            font-weight: 500;
            color: #334155;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.15s;
            white-space: nowrap;
        }
        .ftu-card-action-btn:hover {
            background: #f8fafc;
            color: #0f172a;
            border-color: #94a3b8;
        }

        /* Khi chưa quét thẻ bạn đọc */
        .ftu-no-patron-left {
            padding: 30px 10px;
            text-align: center;
        }

        /* ========================================================================== */
        /* CỘT PHẢI: QUÉT MÃ VẠCH (TRÊN) & TÀI LIỆU ĐANG MƯỢN (DƯỚI)                 */
        /* ========================================================================== */
        .ftu-right-col {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        /* THẺ TRÊN: MƯỢN TÀI LIỆU */
        .ftu-checkout-box {
            padding: 16px 20px;
        }
        .ftu-box-heading {
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 10px;
        }

        .ftu-barcode-input-container {
            position: relative;
            display: flex;
            align-items: center;
        }
        .ftu-hero-barcode-input {
            width: 100%;
            height: 38px;
            padding: 6px 40px 6px 12px;
            font-size: 14px;
            font-weight: 500;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            color: #0f172a;
            background: #ffffff;
            border: 1.5px solid #0284c7;
            border-radius: 6px;
            box-sizing: border-box;
            transition: all 0.15s ease;
        }
        .ftu-hero-barcode-input:focus {
            outline: none;
            border-color: #0369a1;
            box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.18);
        }
        .ftu-input-scan-icon {
            position: absolute;
            right: 12px;
            color: #0284c7;
            font-size: 18px;
            pointer-events: none;
        }

        .ftu-enter-hint {
            font-size: 11.5px;
            color: #64748b;
            margin-top: 4px;
            margin-bottom: 6px;
        }

        .ftu-checkout-options {
            margin-bottom: 10px;
        }
        .ftu-checkout-checkbox {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #475569;
            cursor: pointer;
            margin: 0;
            user-select: none;
        }

        .ftu-btn-hero-borrow {
            width: 100%;
            height: 36px;
            background: #0284c7;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: background 0.15s;
        }
        .ftu-btn-hero-borrow:hover {
            background: #0369a1;
        }

        /* THẺ DƯỚI: BẢNG TÀI LIỆU ĐANG MƯỢN */
        .ftu-checkouts-list-card {
            padding: 16px 20px;
        }

        .ftu-table-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 12px;
        }
        .ftu-checkouts-count-title {
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
        }

        /* Action Links ở góc phải (Gia hạn tất cả, Trả tất cả, In phiếu...) */
        .ftu-tbl-top-actions {
            display: flex;
            gap: 12px;
            align-items: center;
        }
        .ftu-tbl-action-link {
            font-size: 12px;
            color: #334155;
            text-decoration: none;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: color 0.15s;
        }
        .ftu-tbl-action-link:hover {
            color: #0284c7;
        }
        .ftu-tbl-action-link i {
            font-size: 13px;
            color: #64748b;
        }

        /* Toolbar: Số bản ghi & Tìm kiếm */
        .ftu-table-search-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            font-size: 12px;
            color: #64748b;
        }
        .ftu-page-len-select {
            height: 28px;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            padding: 2px 6px;
            font-size: 12px;
            background: #ffffff;
        }
        .ftu-filter-box {
            height: 28px;
            width: 230px;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            padding: 2px 10px;
            font-size: 12px;
            background: #ffffff;
        }
        .ftu-filter-box:focus {
            outline: none;
            border-color: #0284c7;
        }

        /* Bảng dữ liệu mượn trả */
        .ftu-data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
        }
        .ftu-data-table th {
            padding: 9px 10px;
            font-weight: 600;
            color: #475569;
            text-align: left;
            border-bottom: 1px solid #cbd5e1;
            font-size: 12px;
            white-space: nowrap;
        }
        .ftu-data-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #f1f5f9;
            color: #0f172a;
            vertical-align: middle;
        }
        .ftu-data-table tbody tr:hover td {
            background: #fafbfc;
        }

        .ftu-book-title-text {
            color: #0f172a;
            font-weight: 600;
            text-decoration: none;
            display: block;
            line-height: 1.35;
        }
        .ftu-book-title-text:hover {
            color: #0284c7;
            text-decoration: underline;
        }
        .ftu-book-author-text {
            font-size: 11.5px;
            color: #64748b;
            margin-top: 2px;
        }

        .ftu-status-tag-active {
            background: #f1f5f9;
            color: #334155;
            font-size: 11px;
            font-weight: 500;
            padding: 2px 7px;
            border-radius: 4px;
            display: inline-block;
        }
        .ftu-status-tag-overdue {
            background: #fee2e2;
            color: #b91c1c;
            font-size: 11px;
            font-weight: 600;
            padding: 2px 7px;
            border-radius: 4px;
            display: inline-block;
        }

        /* Nút thao tác trên từng dòng */
        .ftu-row-actions-group {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .ftu-row-btn-renew {
            width: 28px;
            height: 26px;
            background: #ffffff;
            border: 1px solid #bfdbfe;
            border-radius: 4px;
            color: #0284c7;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s;
            padding: 0;
        }
        .ftu-row-btn-renew:hover {
            background: #eff6ff;
            border-color: #0284c7;
            color: #0369a1;
        }
        .ftu-row-btn-renew svg {
            display: block;
        }
        .ftu-row-btn-return {
            height: 26px;
            padding: 0 8px;
            background: #ffffff;
            border: 1px solid #fecaca;
            border-radius: 4px;
            color: #b91c1c;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 11.5px;
            cursor: pointer;
            transition: all 0.15s;
        }
        .ftu-row-btn-return:hover {
            background: #fef2f2;
            border-color: #ef4444;
        }

        /* Phân trang chân bảng */
        .ftu-tbl-footer-bar {
            padding: 12px 0 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: #64748b;
        }
        .ftu-pag-btn {
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #334155;
            padding: 2px 8px;
            font-size: 11.5px;
            border-radius: 4px;
            cursor: pointer;
        }
        .ftu-pag-btn.active {
            background: #0284c7;
            color: #ffffff;
            border-color: #0284c7;
        }
        .ftu-pag-btn:disabled {
            opacity: 0.5;
            cursor: default;
        }

        /* Feedback Banner */
        .ftu-feedback-banner {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #15803d;
            padding: 8px 14px;
            font-size: 12.5px;
            border-radius: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }
        .ftu-feedback-close {
            background: none;
            border: none;
            color: #15803d;
            font-size: 16px;
            cursor: pointer;
            padding: 0 4px;
            line-height: 1;
        }
    </style>
[% END %]
</head>

<body id="circ_circulation" class="circ">

[% WRAPPER 'header.inc' %]
    [% INCLUDE 'circ-search.inc' %]
[% END %]

[% SET asides = [] %]
[% WRAPPER 'main-container.inc' wide_full=1 %]

<div class="ftu-circ-workspace">

    <!-- BREADCRUMB -->
    <div class="ftu-breadcrumb">
        <a href="/cgi-bin/koha/mainpage.pl">Trang chủ</a> / <span>Lưu thông &amp; Quầy Mượn Trả</span>
    </div>

    <!-- BÁO LỖI KHÔNG TÌM THẤY BẠN ĐỌC -->
    [% IF patron_not_found %]
        <div class="alert alert-danger" style="border-radius:8px; padding:12px 18px; margin:0 0 14px 0; display:flex; align-items:center; gap:12px; background:#fef2f2; border:1px solid #fecaca; color:#b91c1c;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            <div style="font-size:13px; line-height:1.4;">
                <strong style="font-size:14px; display:block; margin-bottom:2px;">Mã bạn đọc không tồn tại!</strong>
                Mã bạn đọc <strong>[% unknown_borrower | html %]</strong> không tồn tại trong hệ thống. Vui lòng kiểm tra lại mã thẻ hoặc thông tin bạn đọc.
            </div>
        </div>
    [% END %]

    <!-- KHỐI XÁC NHẬN NẾU CÓ TRỞ NGẠI LƯU THÔNG -->
    [% IF ( NEEDSCONFIRMATION ) %]
        <div id="circ_needsconfirmation" class="alert alert-warning" style="border-radius:8px; border:1px solid #f59e0b; border-left:4px solid #d97706; background:#fffbeb; color:#92400e; padding:14px 18px; margin:0 0 14px 0; box-shadow:0 2px 6px rgba(217,119,6,0.08);">
            <strong style="display:block; font-size:14px; color:#78350f; margin-bottom:6px;">
                Cảnh báo quy tắc lưu thông — Yêu cầu xác nhận cho mượn[% IF getTitleMessageIteminfo %]: <em>[% getTitleMessageIteminfo | html %]</em> ([% getBarcodeMessageIteminfo || barcode | html %])[% ELSIF barcode %] (Mã ĐKCB: [% barcode | html %])[% END %]
            </strong>
            <ul style="margin:0 0 12px 18px; padding:0; font-size:13px; line-height:1.6;">
                [% IF ( TOO_MANY ) %]
                    [% IF TOO_MANY == 'TOO_MANY_CHECKOUTS' %]
                        <li><strong>Vượt quá số lượng mượn tối đa theo quy tắc lưu thông:</strong> Bạn đọc hiện đang mượn <strong>[% current_loan_count | html %]</strong> tài liệu, hạn mức tối đa cho phép là <strong>[% max_loans_allowed | html %]</strong> tài liệu.</li>
                    [% ELSIF TOO_MANY == 'TOO_MANY_ONSITE_CHECKOUTS' %]
                        <li><strong>Vượt quá số lượng đọc tại chỗ tối đa:</strong> Hiện tại <strong>[% current_loan_count | html %]</strong> / Tối đa cho phép <strong>[% max_loans_allowed | html %]</strong> tài liệu.</li>
                    [% ELSIF TOO_MANY == 'NO_RULE_DEFINED' %]
                        <li><strong>Chưa có quy tắc lưu thông:</strong> Chưa cấu hình quy tắc cho kiểu bạn đọc và loại tài liệu này (tối đa = 0).</li>
                    [% ELSE %]
                        <li><strong>Vượt quá hạn mức mượn theo quy tắc lưu thông:</strong> Đang mượn <strong>[% current_loan_count | html %]</strong> / Tối đa <strong>[% max_loans_allowed | html %]</strong> tài liệu.</li>
                    [% END %]
                [% END %]
                [% IF ( PATRON_CANT ) %]
                    <li><strong>Quy tắc lưu thông không cho phép mượn:</strong> Kiểu bạn đọc này không được phép mượn loại tài liệu này (hạn mức tối đa = 0).</li>
                [% END %]
                [% IF ( NOT_FOR_LOAN_FORCING ) %]
                    <li><strong>Tài liệu hạn chế cho mượn:</strong> Tài liệu này được gắn trạng thái không cho mượn về nhà. Bạn có chắc chắn muốn ghi mượn ngoại lệ?</li>
                [% END %]
                [% IF ( RENEW_ISSUE ) %]
                    <li>Tài liệu <em>[% getTitleMessageIteminfo | html %]</em> ([% getBarcodeMessageIteminfo | html %]) đang được mượn bởi bạn đọc này. Xác nhận gia hạn?</li>
                [% END %]
                [% IF ( ISSUED_TO_ANOTHER ) %]
                    <li>Tài liệu đang được mượn bởi <strong>[% issued_firstname | html %] [% issued_surname | html %]</strong> ([% issued_cardnumber | html %]). Tự động ghi trả và cho bạn đọc này mượn?</li>
                [% END %]
                [% IF ( RESERVE_WAITING ) %]
                    <li>Tài liệu đang chờ bạn đọc <strong>[% resfirstname | html %] [% ressurname | html %]</strong> ([% rescardnumber | html %]) đến nhận đặt trước.</li>
                [% END %]
                [% IF ( RESERVED ) %]
                    <li>Tài liệu đã được bạn đọc <strong>[% resfirstname | html %] [% ressurname | html %]</strong> ([% rescardnumber | html %]) đặt trước.</li>
                [% END %]
                [% IF ( TRANSFERRED ) %]
                    <li>Tài liệu đang trong quá trình chuyển kho cho đặt trước của <strong>[% resfirstname | html %] [% ressurname | html %]</strong>.</li>
                [% END %]
                [% IF ( PROCESSING ) %]
                    <li>Tài liệu đang được xử lý cho đặt trước của <strong>[% resfirstname | html %] [% ressurname | html %]</strong>.</li>
                [% END %]
                [% IF ( USERBLOCKEDOVERDUE ) %]
                    <li>Bạn đọc đang có <strong>[% USERBLOCKEDOVERDUE | html %]</strong> tài liệu quá hạn chưa trả.</li>
                [% END %]
                [% IF ( DEBT ) %]
                    <li>Bạn đọc đang có tiền phạt chưa thanh toán vượt ngưỡng: <strong>[% DEBT | $Price %] đ</strong>.</li>
                [% END %]
                [% IF ( DEBT_GUARANTEES ) %]
                    <li>Người được bảo lãnh của bạn đọc này đang nợ phí phạt: <strong>[% DEBT_GUARANTEES | $Price %] đ</strong>.</li>
                [% END %]
                [% IF ( DEBT_GUARANTORS ) %]
                    <li>Người bảo lãnh của bạn đọc này đang nợ phí phạt: <strong>[% DEBT_GUARANTORS | $Price %] đ</strong>.</li>
                [% END %]
                [% IF ( HIGHHOLDS ) %]
                    <li>Tài liệu có nhiều lượt đặt trước (<strong>[% HIGHHOLDS.num_holds | html %]</strong> lượt), thời hạn mượn được rút ngắn còn <strong>[% HIGHHOLDS.duration | html %]</strong> ngày.</li>
                [% END %]
                [% IF ( PREVISSUE ) %]
                    <li>Bạn đọc này đã từng mượn tài liệu này trước đây.</li>
                [% END %]
                [% IF ( CURRENTISSUE ) %]
                    <li>Bạn đọc này hiện đang mượn một bản sao khác của tài liệu này.</li>
                [% END %]
                [% IF ( BIBLIO_ALREADY_ISSUED ) %]
                    <li>Bạn đọc đã mượn một bản sao khác thuộc cùng biểu ghi nhan đề này.</li>
                [% END %]
                [% IF ( AGE_RESTRICTION ) %]
                    <li>Tài liệu có giới hạn độ tuổi: <strong>[% AGE_RESTRICTION | html %]</strong>.</li>
                [% END %]
                [% IF ( ITEM_LOST ) %]
                    <li>Tài liệu này đang có trạng thái báo mất (<strong>[% ITEM_LOST | html %]</strong>).</li>
                [% END %]
                [% IF ( BORRNOTSAMEBRANCH ) %]
                    <li>Bạn đọc thuộc thư viện khác (<strong>[% BORRNOTSAMEBRANCH | html %]</strong>).</li>
                [% END %]
                [% IF ( RENTALCHARGE && RENTALCHARGE > 0 ) %]
                    <li>Phí thuê tài liệu phát sinh: <strong>[% RENTALCHARGE | $Price %] đ</strong>.</li>
                [% END %]
                [% IF ( ADDITIONAL_MATERIALS ) %]
                    <li>Kiểm tra tài liệu/phụ lục đi kèm: <strong>[% ADDITIONAL_MATERIALS | html %]</strong>.</li>
                [% END %]
                [% IF ( INVALID_DATE ) %]
                    <li>Ngày hẹn trả không hợp lệ hoặc nằm trong quá khứ.</li>
                [% END %]
                [% IF ( RECALLED ) %]
                    <li>Tài liệu này đã bị triệu hồi bởi một bạn đọc khác.</li>
                [% END %]
                [% IF ( BOOKED_TO_ANOTHER ) %]
                    <li>Tài liệu đã được đặt lịch mượn trước bởi bạn đọc khác.</li>
                [% END %]
                [% IF ( BOOKED_EARLY ) %]
                    <li>Bạn đọc nhận tài liệu sớm hơn thời gian đặt lịch mượn.</li>
                [% END %]
            </ul>
            <form method="post" action="/cgi-bin/koha/circ/circulation.pl" style="display:flex; gap:8px; align-items:center;">
                [% INCLUDE 'csrf-token.inc' %]
                <input type="hidden" name="op" value="cud-checkout" />
                <input type="hidden" name="borrowernumber" value="[% patron.borrowernumber | html %]" />
                <input type="hidden" name="barcode" value="[% barcode | html %]" />
                <input type="hidden" name="issueconfirmed" value="1" />
                <input type="hidden" name="debt_confirmed" value="1" />
                [% IF ( RESERVED || RESERVE_WAITING || TRANSFERRED || PROCESSING ) %]
                    <input type="hidden" name="cancelreserve" value="1" />
                [% END %]
                [% IF ( RECALLED ) %]
                    <input type="hidden" name=" recall_id" value="[% RECALLED.id | html %]" />
                    <input type="hidden" name="cancel_recall" value="1" />
                [% END %]
                <button type="submit" id="btn-confirm-checkout-override" class="btn btn-warning btn-sm fw-semibold" style="background:#d97706; border-color:#b45309; color:#fff; padding:6px 14px;">Xác nhận vẫn cho mượn</button>
                <a href="/cgi-bin/koha/circ/circulation.pl?borrowernumber=[% patron.borrowernumber | uri %]" class="btn btn-outline-secondary btn-sm" style="padding:6px 14px;">Hủy bỏ</a>
            </form>
        </div>
    [% END %]

    [% IF ( IMPOSSIBLE ) %]
        <div id="circ_impossible" class="alert alert-danger" style="border-radius:8px; border:1px solid #f87171; border-left:4px solid #dc2626; background:#fef2f2; color:#991b1b; padding:14px 18px; margin:0 0 14px 0; box-shadow:0 2px 6px rgba(220,38,38,0.08);">
            <strong style="display:block; font-size:14px; color:#7f1d1d; margin-bottom:6px;">
                Không thể cho mượn tài liệu — Vi phạm quy tắc lưu thông[% IF getTitleMessageIteminfo %]: <em>[% getTitleMessageIteminfo | html %]</em> ([% getBarcodeMessageIteminfo || barcode | html %])[% ELSIF barcode %] (Mã ĐKCB: [% barcode | html %])[% END %]
            </strong>
            <ul style="margin:0 0 12px 18px; padding:0; font-size:13px; line-height:1.6;">
                [% IF ( TOO_MANY ) %]
                    [% IF TOO_MANY == 'TOO_MANY_CHECKOUTS' %]
                        <li><strong>Vượt quá số lượng mượn tối đa theo quy tắc lưu thông:</strong> Bạn đọc đang mượn <strong>[% current_loan_count | html %]</strong> tài liệu, hạn mức tối đa cho phép là <strong>[% max_loans_allowed | html %]</strong> tài liệu (Không cho phép ghi đè).</li>
                    [% ELSIF TOO_MANY == 'TOO_MANY_ONSITE_CHECKOUTS' %]
                        <li><strong>Vượt quá số lượng đọc tại chỗ tối đa:</strong> Hiện tại <strong>[% current_loan_count | html %]</strong> / Tối đa <strong>[% max_loans_allowed | html %]</strong> tài liệu.</li>
                    [% ELSIF TOO_MANY == 'NO_RULE_DEFINED' %]
                        <li><strong>Chưa định nghĩa quy tắc lưu thông:</strong> Không tìm thấy hạn mức cho phép mượn đối với bạn đọc và loại tài liệu này.</li>
                    [% ELSE %]
                        <li><strong>Vượt quá hạn mức mượn theo quy tắc lưu thông:</strong> Đang mượn <strong>[% current_loan_count | html %]</strong> / Tối đa <strong>[% max_loans_allowed | html %]</strong> tài liệu.</li>
                    [% END %]
                [% END %]
                [% IF ( PATRON_CANT ) %]
                    <li><strong>Quy tắc lưu thông chặn mượn:</strong> Bạn đọc thuộc nhóm này không được phép mượn loại tài liệu này.</li>
                [% END %]
                [% IF ( UNKNOWN_BARCODE ) %]<li>Không tìm thấy mã vạch tài liệu: <strong>[% barcode | html %]</strong> trong cơ sở dữ liệu.</li>[% END %]
                [% IF ( NOT_FOR_LOAN ) %]<li><strong>Tài liệu không cho mượn:</strong> Tài liệu này chỉ phục vụ đọc tại chỗ hoặc không thuộc diện lưu thông.</li>[% END %]
                [% IF ( WTHDRAWN ) %]<li><strong>Tài liệu đã thanh lý/rút khỏi kho:</strong> Không thể thực hiện giao dịch mượn.</li>[% END %]
                [% IF ( RESTRICTED ) %]<li><strong>Tài liệu bị giới hạn lưu thông:</strong> Chỉ phục vụ đối tượng đặc biệt.</li>[% END %]
                [% IF ( EXPIRED ) %]<li><strong>Thẻ bạn đọc đã hết hạn sử dụng.</strong> Vui lòng gia hạn thẻ trước khi mượn.</li>[% END %]
                [% IF ( DEBARRED || USERBLOCKEDNOENDDATE || USERBLOCKEDWITHENDDATE ) %]<li><strong>Tài khoản bạn đọc đang bị khóa quyền mượn</strong>[% IF USERBLOCKEDWITHENDDATE %] (đến ngày [% USERBLOCKEDWITHENDDATE | $KohaDates %])[% END %].</li>[% END %]
                [% IF ( USERBLOCKEDOVERDUE ) %]<li><strong>Bạn đọc đang có [% USERBLOCKEDOVERDUE | html %] tài liệu quá hạn:</strong> Hệ thống chặn mượn mới cho đến khi trả sách quá hạn.</li>[% END %]
                [% IF ( CARD_LOST ) %]<li><strong>Thẻ bạn đọc đang được báo mất.</strong></li>[% END %]
                [% IF ( GNA ) %]<li><strong>Thông tin địa chỉ liên hệ của bạn đọc không xác thực.</strong></li>[% END %]
                [% IF ( DEBT ) %]<li><strong>Nợ phí phạt vượt mức cho phép:</strong> Bạn đọc đang nợ <strong>[% DEBT | $Price %] đ</strong>.</li>[% END %]
                [% IF ( DEBT_GUARANTEES ) %]<li><strong>Người được bảo lãnh nợ phí phạt vượt mức:</strong> [% DEBT_GUARANTEES | $Price %] đ.</li>[% END %]
                [% IF ( DEBT_GUARANTORS ) %]<li><strong>Người bảo lãnh nợ phí phạt vượt mức:</strong> [% DEBT_GUARANTORS | $Price %] đ.</li>[% END %]
                [% IF ( NO_MORE_RENEWALS ) %]<li><strong>Đã hết số lần gia hạn cho phép</strong> theo quy tắc lưu thông.</li>[% END %]
                [% IF ( NO_RENEWAL_FOR_ONSITE_CHECKOUTS ) %]<li><strong>Tài liệu mượn đọc tại chỗ không được phép gia hạn.</strong></li>[% END %]
                [% IF ( ITEMNOTSAMEBRANCH ) %]<li><strong>Tài liệu thuộc chi nhánh thư viện khác</strong> ([% itemhomebranch | html %]) và không cho phép mượn liên thư viện.</li>[% END %]
                [% IF ( RETURN_IMPOSSIBLE ) %]<li><strong>Không thể tự động ghi trả tài liệu:</strong> Phải trả tại chi nhánh [% branch_to_return | html %].</li>[% END %]
                [% IF ( AGE_RESTRICTION ) %]<li><strong>Vi phạm giới hạn độ tuổi:</strong> Yêu cầu [% AGE_RESTRICTION | html %].</li>[% END %]
                [% IF ( INVALID_DATE ) %]<li><strong>Ngày hẹn trả không hợp lệ.</strong></li>[% END %]
                [% IF ( NO_OPEN_DAYS ) %]<li><strong>Không tìm thấy ngày mở cửa hợp lệ</strong> trong lịch thư viện để tính hạn trả.</li>[% END %]
                [% IF ( RESERVED || RESERVE_WAITING || TRANSFERRED || PROCESSING ) %]<li><strong>Tài liệu đang được đặt trước</strong> bởi bạn đọc [% resfirstname | html %] [% ressurname | html %] ([% rescardnumber | html %]).</li>[% END %]
                [% IF ( BOOKED_TO_ANOTHER ) %]<li><strong>Tài liệu đã được đặt lịch mượn</strong> bởi một bạn đọc khác.</li>[% END %]
                [% IF ( RECALLED_INTRANSIT ) %]<li><strong>Tài liệu bị triệu hồi</strong> và đang vận chuyển.</li>[% END %]
            </ul>
            <a href="/cgi-bin/koha/circ/circulation.pl?borrowernumber=[% patron.borrowernumber | uri %]" class="btn btn-secondary btn-sm">Đóng thông báo</a>
        </div>
    [% END %]

    <!-- BỐ CỤC 2 CỘT CHUẨN MẪU THIẾT KẾ -->
    <div class="ftu-split-desk">

        <!-- ================================================================== -->
        <!-- 1. CỘT TRÁI: THẺ THÔNG TIN BẠN ĐỌC (350px)                         -->
        <!-- ================================================================== -->
        <div class="ftu-card-box ftu-left-patron-col">
            [% IF patron %]
            [% SET chk_count = patron.checkouts.count || 0 %]
            [% SET balance = patron.account.balance || 0 %]

            <!-- Avatar Silhouette tròn lớn -->
            <div class="ftu-patron-avatar-circle">
                [% IF Koha.Preference('patronimages') && patron.image %]
                    <img src="/cgi-bin/koha/members/patronimage.pl?borrowernumber=[% patron.borrowernumber | uri %]" alt="Ảnh bạn đọc" />
                [% ELSE %]
                    <svg viewBox="0 0 24 24" class="ftu-avatar-svg">
                        <circle cx="12" cy="8" r="4.2" />
                        <path d="M4 19.5c0-3.5 3.5-6 8-6s8 2.5 8 6v1H4v-1z" />
                    </svg>
                [% END %]
            </div>

            <!-- Tên & Số thẻ & Trạng thái -->
            <div class="ftu-patron-center-name">
                [% patron.surname | html %] [% patron.firstname | html %]
            </div>
            <div class="ftu-patron-center-sub">
                <span>[% patron.cardnumber | html %]</span>
                [% IF patron.is_debarred || patron.is_expired %]
                    <span class="ftu-badge-inactive">Đã khóa</span>
                [% ELSE %]
                    <span class="ftu-badge-active">Đang hoạt động</span>
                [% END %]
            </div>

            <!-- Thống kê nhanh: Sách đang mượn & Tiền phạt -->
            [% SET eff_max_loans = patron_maxissueqty.defined ? patron_maxissueqty : (max_loans_allowed.defined ? max_loans_allowed : 5) %]
            <div class="ftu-patron-stats-row">
                <span>Sách đang mượn: <strong [% IF eff_max_loans > 0 && chk_count >= eff_max_loans %]style="color:#dc2626;" title="Đã đạt/vượt hạn mức quy tắc lưu thông"[% END %]>[% chk_count %] / [% eff_max_loans %] cuốn</strong></span>
                &nbsp;&nbsp;&nbsp;&nbsp;
                <span>Tiền phạt: <strong>[% IF balance > 0 %][% balance | $Price %] đ[% ELSE %]0 đ[% END %]</strong></span>
            </div>

            <div class="ftu-card-divider"></div>

            <!-- Lưới 2 cột thông tin học vụ / cá nhân -->
            [% SET dept_val = '' %]
            [% IF patron.borrowernotes && patron.borrowernotes.match('Khoa:\s*([^|\n]+)') %]
                [% SET dept_m = patron.borrowernotes.match('Khoa:\s*([^|\n]+)') %]
                [% SET dept_val = dept_m.0 %]
            [% END %]
            [% SET cccd_val = patron.sort2 %]
            [% IF !cccd_val && patron.borrowernotes && patron.borrowernotes.match('CCCD:\s*([^|\n]+)') %]
                [% SET cccd_m = patron.borrowernotes.match('CCCD:\s*([^|\n]+)') %]
                [% SET cccd_val = cccd_m.0 %]
            [% END %]

            <div class="ftu-patron-2col-grid">
                <!-- Cột trái con -->
                <div class="ftu-meta-block">
                    <span class="ftu-meta-label"><i class="fa fa-user-o"></i> Khoa / Đơn vị</span>
                    <span class="ftu-meta-text" title="[% IF dept_val %][% dept_val | html %][% END %]">[% IF dept_val %][% dept_val | html %][% ELSE %]—[% END %]</span>
                </div>
                <!-- Cột phải con -->
                <div class="ftu-meta-block">
                    <span class="ftu-meta-label"><i class="fa fa-graduation-cap"></i> Lớp</span>
                    <span class="ftu-meta-text" title="[% IF patron.sort1 %][% patron.sort1 | html %][% END %]">[% IF patron.sort1 %][% patron.sort1 | html %][% ELSE %]—[% END %]</span>
                </div>

                <div class="ftu-meta-block">
                    <span class="ftu-meta-label"><i class="fa fa-envelope-o"></i> Email</span>
                    <span class="ftu-meta-text" title="[% patron.email | html %]">[% IF patron.email %][% patron.email | html %][% ELSE %]—[% END %]</span>
                </div>
                <div class="ftu-meta-block">
                    <span class="ftu-meta-label"><i class="fa fa-phone"></i> Điện thoại</span>
                    <span class="ftu-meta-text">[% IF patron.phone %][% patron.phone | html %][% ELSE %]—[% END %]</span>
                </div>

                <div class="ftu-meta-block">
                    <span class="ftu-meta-label"><i class="fa fa-calendar-o"></i> Ngày sinh</span>
                    <span class="ftu-meta-text">[% IF patron.dateofbirth %][% patron.dateofbirth | $KohaDates dateformat => 'metric' %][% ELSE %]—[% END %]</span>
                </div>
                <div class="ftu-meta-block">
                    <span class="ftu-meta-label"><i class="fa fa-credit-card"></i> Hạn dùng thẻ</span>
                    <span class="ftu-meta-text">[% IF patron.dateexpiry %][% patron.dateexpiry | $KohaDates dateformat => 'metric' %][% ELSE %]—[% END %]</span>
                </div>
            </div>

            <div class="ftu-card-divider"></div>

            <!-- 3 Nút thao tác dưới đáy thẻ bạn đọc -->
            <div class="ftu-left-actions-row">
                <a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=[% patron.borrowernumber | uri %]" target="_blank" class="ftu-card-action-btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg> Hồ sơ chi tiết
                </a>
                <a href="/cgi-bin/koha/circ/circulation.pl" class="ftu-card-action-btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg> Đổi bạn đọc
                </a>
                <a href="/cgi-bin/koha/members/members-home.pl" class="ftu-card-action-btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg> Tra cứu
                </a>
            </div>

            [% ELSE %]
            <!-- Khi chưa quét bạn đọc -->
            <div class="ftu-no-patron-left">
                <div class="ftu-patron-avatar-circle">
                    <svg viewBox="0 0 24 24" class="ftu-avatar-svg">
                        <circle cx="12" cy="8" r="4.2" />
                        <path d="M4 19.5c0-3.5 3.5-6 8-6s8 2.5 8 6v1H4v-1z" />
                    </svg>
                </div>
                <div class="ftu-patron-center-name" style="color:#64748b; font-size:15px;">
                    Chưa chọn bạn đọc
                </div>
                <p style="font-size:12px; color:#94a3b8; margin: 8px 0 16px 0;">
                    Vui lòng quét hoặc nhập mã thẻ bạn đọc để bắt đầu phiên lưu thông.
                </p>
                <form action="/cgi-bin/koha/circ/circulation.pl" method="get" autocomplete="off">
                    <input type="text" name="findborrower" class="ftu-hero-barcode-input" style="height:34px; margin-bottom:10px;" placeholder="Quét mã thẻ bạn đọc..." value="[% IF patron_not_found %][% unknown_borrower | html %][% END %]" autofocus />
                    <button type="submit" class="ftu-btn-hero-borrow" style="height:34px;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg> Bắt đầu
                    </button>
                </form>
            </div>
            [% END %]
        </div>

        <!-- ================================================================== -->
        <!-- 2. CỘT PHẢI: QUÉT MÃ VẠCH (TRÊN) & BẢNG SÁCH ĐANG MƯỢN (DƯỚI)     -->
        <!-- ================================================================== -->
        <div class="ftu-right-col">

            <!-- THẺ TRÊN: MƯỢN TÀI LIỆU -->
            <div class="ftu-card-box ftu-checkout-box">
                <div class="ftu-box-heading">Mượn Tài liệu</div>

                [% IF patron %]
                <form method="post" action="/cgi-bin/koha/circ/circulation.pl" id="mainform" name="mainform" autocomplete="off">
                    [% INCLUDE 'csrf-token.inc' %]
                    <input type="hidden" name="op" value="cud-checkout" />
                    <input type="hidden" name="borrowernumber" id="borrowernumber" value="[% patron.borrowernumber | html %]" />
                    <input type="hidden" name="restoreduedatespec" />
                    <input type="hidden" name="debt_confirmed" value="[% debt_confirmed | html %]" />
                    <input type="hidden" name="branch" value="[% patron.branchcode | html %]" />
                    [% IF (forceallow) %]<input type="hidden" name="forceallow" value="1" />[% END %]
                    [% IF ( CHARGES ) %]<input type="hidden" name="charges" value="yes" />[% END %]

                    <div class="ftu-barcode-input-container">
                        <input type="text" name="barcode" id="barcode" class="ftu-hero-barcode-input" autocomplete="off" placeholder="Mã vạch / Số ĐKCB" autofocus />
                        <i class="fa fa-qrcode ftu-input-scan-icon" title="Quét mã vạch"></i>
                    </div>

                    <div class="ftu-enter-hint">Nhấn Enter để ghi mượn</div>

                    <div class="ftu-checkout-options">
                        <label class="ftu-checkout-checkbox">
                            <input type="checkbox" id="calc_turn" name="calc_turn" checked="checked" />
                            <span>Tính lượt lưu thông</span>
                        </label>
                    </div>

                    <button type="submit" class="ftu-btn-hero-borrow" id="btn-submit-borrow">
                        <i class="fa fa-book"></i> Cho mượn tài liệu
                    </button>
                </form>
                [% ELSE %]
                <div style="padding:14px 0; color:#64748b; font-size:12.5px;">
                    Vui lòng nạp thông tin bạn đọc ở cột bên trái để kích hoạt ô quét mã vạch cho mượn tài liệu.
                </div>
                [% END %]
            </div>

            <!-- THẺ DƯỚI: TÀI LIỆU ĐANG MƯỢN -->
            <div class="ftu-card-box ftu-checkouts-list-card">
                <div class="ftu-table-header-row">
                    <div class="ftu-checkouts-count-title">
                        Tài liệu đang mượn ([% patron.checkouts.count || 0 %])
                    </div>

                    <div class="ftu-tbl-top-actions">
                        [% IF patron && patron.checkouts.count > 0 %]
                            <a href="#" id="ftu-btn-renew-all" class="ftu-tbl-action-link"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:2px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg> Gia hạn tất cả</a>
                            <a href="#" id="ftu-btn-return-all" class="ftu-tbl-action-link"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:2px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg> Trả tất cả</a>
                            <a href="/cgi-bin/koha/members/printslip.pl?borrowernumber=[% patron.borrowernumber | uri %]&amp;print=issueslip" target="_blank" class="ftu-tbl-action-link"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:2px;"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg> In phiếu mượn</a>
                        [% END %]
                        [% IF patron %]
                            <a href="/cgi-bin/koha/members/boraccount.pl?borrowernumber=[% patron.borrowernumber | uri %]" target="_blank" class="ftu-tbl-action-link"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:2px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> Lịch sử phí phạt</a>
                        [% END %]
                    </div>
                </div>

                [% IF patron && patron.checkouts.count > 0 %]
                    <!-- Toolbar: Hiển thị bản ghi & Tìm kiếm -->
                    <div class="ftu-table-search-bar">
                        <div>
                            Hiển thị 
                            <select id="ftu-page-length" class="ftu-page-len-select">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            bản ghi
                        </div>
                        <div>
                            <input type="text" id="ftu-search-table" class="ftu-filter-box" placeholder="Lọc nhanh nhan đề, mã vạch..." />
                        </div>
                    </div>

                    <table id="ftu-checkouts-table" class="ftu-data-table">
                        <thead>
                            <tr>
                                <th style="width: 24px; text-align: center;"><input type="checkbox" id="ftu-chk-all" /></th>
                                <th style="width: 40px;">STT</th>
                                <th class="th-sort" data-col="2" style="width: 100px;">Mã ĐKCB</th>
                                <th class="th-sort" data-col="3">Nhan đề &amp; Tác giả</th>
                                <th class="th-sort" data-col="4" style="width: 100px;">Môn loại</th>
                                <th class="th-sort" data-col="5" style="width: 95px;">Ngày mượn</th>
                                <th class="th-sort" data-col="6" style="width: 95px;">Hạn trả</th>
                                <th style="text-align: center; width: 85px;">Trạng thái</th>
                                <th style="text-align: center; width: 110px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            [% SET row_idx = 1 %]
                            [% FOREACH issue IN patron.checkouts %]
                            <tr data-issue-id="[% issue.issue_id | html %]" data-itemnumber="[% issue.itemnumber | html %]" data-borrowernumber="[% patron.borrowernumber | html %]" data-barcode="[% issue.item.barcode | html %]" data-title="[% issue.item.biblio.title | html %]">
                                <td style="text-align: center;"><input type="checkbox" class="ftu-chk-item" value="[% issue.issue_id | html %]" data-barcode="[% issue.item.barcode | html %]" /></td>
                                <td style="color:#64748b; font-size:12px;">[% row_idx %]</td>
                                <td style="font-weight:600; font-family:ui-monospace, monospace;">[% issue.item.barcode | html %]</td>
                                <td>
                                    <div>
                                        <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% issue.item.biblio.biblionumber | uri %]" target="_blank" class="ftu-book-title-text">[% issue.item.biblio.title | html %]</a>
                                        [% IF issue.item.biblio.author %]
                                            <div class="ftu-book-author-text">Tác giả: [% issue.item.biblio.author | html %]</div>
                                        [% END %]
                                    </div>
                                </td>
                                <td>[% issue.item.itemcallnumber || '—' | html %]</td>
                                <td>[% issue.issuedate | $KohaDates dateformat => 'metric' %]</td>
                                <td class="ftu-duedate-cell" style="font-weight:600;">
                                    <div>[% issue.date_due | $KohaDates dateformat => 'metric' %]</div>
                                    [% IF issue.renewals_count %]
                                        <div class="ftu-renew-badge" style="font-size:11px; color:#64748b; font-weight:500;">Đã GH: [% issue.renewals_count | html %] lần</div>
                                    [% END %]
                                </td>
                                <td class="ftu-status-cell" style="text-align: center;">
                                    [% IF issue.is_overdue %]
                                        <span class="ftu-status-tag-overdue">Quá hạn</span>
                                    [% ELSE %]
                                        <span class="ftu-status-tag-active">Đang mượn</span>
                                    [% END %]
                                </td>
                                <td style="text-align: center;">
                                    <div class="ftu-row-actions-group">
                                        <button type="button" class="ftu-row-btn-renew ftu-btn-renew-one" data-issue-id="[% issue.issue_id | html %]" data-itemnumber="[% issue.itemnumber | html %]" data-borrowernumber="[% patron.borrowernumber | html %]" data-title="[% issue.item.biblio.title | html %]" title="Gia hạn">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        </button>
                                        <button type="button" class="ftu-row-btn-return ftu-btn-return-one" data-barcode="[% issue.item.barcode | html %]" data-title="[% issue.item.biblio.title | html %]">
                                            Trả sách
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            [% SET row_idx = row_idx + 1 %]
                            [% END %]
                        </tbody>
                    </table>

                    <div class="ftu-tbl-footer-bar">
                        <div id="ftu-footer-info">
                            Hiển thị 1 đến [% patron.checkouts.count || 0 %] trong [% patron.checkouts.count || 0 %] bản ghi
                        </div>
                        <div>
                            <button type="button" class="ftu-pag-btn" disabled>&lt;</button>
                            <button type="button" class="ftu-pag-btn active">1</button>
                            <button type="button" class="ftu-pag-btn" disabled>&gt;</button>
                        </div>
                    </div>
                [% ELSE %]
                    <div style="padding:28px 10px; text-align:center; color:#64748b; font-size:13px;">
                        Không có tài liệu nào đang mượn
                    </div>
                [% END %]
            </div>

        </div>

    </div>

</div> <!-- /.ftu-circ-workspace -->

<!-- Hidden compatibility container for Koha scripts -->
<div style="display:none;">
    <table id="issues-table"></table>
</div>

[% END # /WRAPPER main-container.inc %]

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'datatables.inc' %]
    [% INCLUDE 'select2.inc' %]
    [% INCLUDE 'js-date-format.inc' %]
    <script nonce="[% Koha.CSPNonce | $raw %]">
        $(document).ready(function() {
            var kohaSessionId = '[% koha_session_id | html %]';
            var patronBorrowernumber = '[% patron.borrowernumber | html %]';
            var patronMaxIssueQty = '[% patron_maxissueqty || 5 | html %]';
            var defaultRenewSvg = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>';

            // 1. Autofocus barcode
            setTimeout(function() {
                var bc = $('#barcode');
                if (bc.length) { bc.focus(); }
            }, 80);

            // 2. Select all checkboxes
            $('#ftu-chk-all').on('change', function() {
                var isChecked = $(this).prop('checked');
                $('.ftu-chk-item').prop('checked', isChecked);
            });

            // 3. Toast Notification
            function showToast(msg, type) {
                var container = document.getElementById('ftu-toast-container');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'ftu-toast-container';
                    container.style.cssText = 'position:fixed;top:60px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:6px;pointer-events:none;';
                    document.body.appendChild(container);
                }
                var colors = { success:'#16a34a', error:'#dc2626', info:'#0284c7' };
                var toast = document.createElement('div');
                toast.style.cssText = 'pointer-events:auto;background:#ffffff;border-left:3px solid '+(colors[type]||'#0284c7')+';padding:8px 14px;box-shadow:0 2px 8px rgba(0,0,0,0.1);font-size:12.5px;max-width:360px;border-radius:4px;';
                toast.innerHTML = '<span>'+msg+'</span>';
                container.appendChild(toast);
                setTimeout(function(){
                    toast.style.opacity='0';
                    toast.style.transition='opacity 0.25s';
                    setTimeout(function(){ if (toast.parentNode) toast.remove(); }, 250);
                }, 3500);
            }

            // 4. Update Table Counts
            function updateCounts() {
                var rows = $('#ftu-checkouts-table tbody tr[data-issue-id]');
                var count = rows.length;
                if (count === 0) {
                    location.reload();
                } else {
                    $('#ftu-footer-info').text('Hiển thị 1 đến ' + count + ' trong ' + count + ' bản ghi');
                    $('.ftu-tbl-title').html(
                        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg> ' +
                        'Tài liệu đang mượn (' + count + ')'
                    );
                }
            }

            function formatRenewError(errCode, rCount) {
                var map = {
                    'too_many': 'Đã hết lượt gia hạn theo quy định (đã gia hạn ' + (rCount || 0) + ' lần)',
                    'too_soon': 'Chưa đến thời điểm được phép gia hạn',
                    'auto_too_soon': 'Chưa đến thời điểm được phép gia hạn',
                    'on_reserve': 'Tài liệu đang có bạn đọc khác đặt mượn (Hold)',
                    'overdue': 'Bạn đọc đang có tài liệu quá hạn',
                    'too_much_owing': 'Bạn đọc đang nợ phí phạt vượt mức quy định',
                    'auto_too_much_owing': 'Bạn đọc đang nợ phí phạt vượt mức quy định',
                    'restriction': 'Tài khoản bạn đọc đang bị khóa/hạn chế',
                    'item_denied_renewal': 'Loại tài liệu này không được phép gia hạn',
                    'onsite_checkout': 'Tài liệu mượn đọc tại chỗ không được gia hạn',
                    'no_checkout': 'Tài liệu không còn trong danh sách đang mượn',
                    'auth_failed': 'Phiên làm việc hết hạn, vui lòng tải lại trang'
                };
                return map[errCode] || ('Lỗi gia hạn (' + (errCode || 'không xác định') + ')');
            }

            function isOverridableRenewError(errCode) {
                return ['too_many', 'too_soon', 'auto_too_soon', 'on_reserve', 'overdue', 'too_much_owing', 'auto_too_much_owing', 'restriction'].indexOf(errCode) !== -1;
            }

            async function renewSingleRow(row, opts) {
                opts = opts || {};
                var btn = row.find('.ftu-btn-renew-one');
                var dueCell = row.find('.ftu-duedate-cell');
                var statusCell = row.find('.ftu-status-cell');
                var issueId = row.attr('data-issue-id') || btn.data('issue-id');
                var itemnumber = row.attr('data-itemnumber') || btn.data('itemnumber');
                var borrowernumber = row.attr('data-borrowernumber') || btn.data('borrowernumber') || patronBorrowernumber;
                var title = row.attr('data-title') || btn.data('title') || row.attr('data-barcode') || ('#' + issueId);

                btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
                try {
                    var bodyParams = new URLSearchParams();
                    if (issueId) bodyParams.append('issue_id', issueId);
                    if (itemnumber) bodyParams.append('itemnumber', itemnumber);
                    if (borrowernumber) bodyParams.append('borrowernumber', borrowernumber);
                    bodyParams.append('seen', '1');
                    bodyParams.append('override_debt', '1');
                    if (opts.overrideLimit) {
                        bodyParams.append('override_limit', '1');
                    }
                    if (kohaSessionId) {
                        bodyParams.append('koha_session_id', kohaSessionId);
                    }

                    var resp = await fetch('/cgi-bin/koha/svc/renew', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: bodyParams.toString(),
                        credentials: 'same-origin'
                    });

                    var data = await resp.json().catch(function() { return {}; });

                    if (data && data.renew_okay) {
                        var displayDue = data.date_due_iso || (data.date_due ? String(data.date_due).split(' ')[0] : '');
                        var rCount = data.renewals_count || 1;
                        dueCell.html(
                            '<div style="color:#16a34a; font-weight:700;">' + displayDue + '</div>' +
                            '<div class="ftu-renew-badge" style="font-size:11px; color:#15803d; font-weight:600;">Đã GH: ' + rCount + ' lần</div>'
                        );
                        if (statusCell.length) {
                            statusCell.html('<span class="ftu-status-tag-active">Đang mượn</span>');
                        }
                        btn.prop('disabled', false).html('<i class="fa fa-check" style="color:#16a34a;"></i>');
                        if (!opts.silent) {
                            showToast('Đã gia hạn "' + title + '" đến ' + displayDue, 'success');
                        }
                        return { ok: true, date_due: displayDue, renewals_count: rCount, title: title, row: row };
                    }

                    var errCode = (data && data.error) ? data.error : ('http_' + resp.status);
                    var errText = formatRenewError(errCode, data ? data.renewals_count : 0);

                    if (!opts.overrideLimit && opts.promptOverride !== false && isOverridableRenewError(errCode)) {
                        if (confirm('Tài liệu "' + title + '": ' + errText + '.\n\nBạn có muốn GHI ĐÈ quy tắc lưu thông để tiếp tục gia hạn không?')) {
                            return await renewSingleRow(row, { overrideLimit: true, silent: opts.silent, promptOverride: false });
                        }
                    }

                    btn.prop('disabled', false).html(defaultRenewSvg);
                    if (!opts.silent) {
                        showToast('Không thể gia hạn "' + title + '": ' + errText, 'error');
                    }
                    return {
                        ok: false,
                        error: errCode,
                        errorText: errText,
                        overridable: isOverridableRenewError(errCode),
                        title: title,
                        row: row
                    };
                } catch (ex) {
                    btn.prop('disabled', false).html(defaultRenewSvg);
                    if (!opts.silent) {
                        showToast('Lỗi kết nối khi gia hạn "' + title + '"', 'error');
                    }
                    return { ok: false, error: 'network_error', errorText: 'Lỗi kết nối máy chủ', overridable: false, title: title, row: row };
                }
            }

            // 5. Single Item Renew
            $(document).on('click', '.ftu-btn-renew-one', async function(e) {
                e.preventDefault();
                var row = $(this).closest('tr');
                await renewSingleRow(row, { silent: false, promptOverride: true });
            });

            // 6. Single Item Return
            $(document).on('click', '.ftu-btn-return-one', async function(e) {
                e.preventDefault();
                var btn = $(this);
                var barcode = btn.data('barcode');
                var title = btn.data('title');
                var row = btn.closest('tr');

                if (!confirm('Xác nhận ghi trả tài liệu: ' + (title || barcode) + '?')) return;

                btn.prop('disabled', true).text('Đang trả...');
                var csrf = $('input[name="csrf_token"]').val() || '';
                var fd = new FormData();
                fd.append('op', 'cud-checkin');
                fd.append('barcode', barcode);
                fd.append('csrf_token', csrf);

                try {
                    await fetch('/cgi-bin/koha/circ/returns.pl', {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin'
                    });
                    row.css({ transition: 'opacity 0.25s', opacity: 0 });
                    setTimeout(function() {
                        row.remove();
                        updateCounts();
                    }, 260);
                    showToast('Đã trả thành công: ' + (title || barcode), 'success');
                } catch(ex) {
                    showToast('Lỗi khi trả sách', 'error');
                    btn.prop('disabled', false).text('Trả sách');
                }
            });

            // 7. Renew All (hoặc gia hạn các mục đã tích chọn)
            $('#ftu-btn-renew-all').on('click', async function(e) {
                e.preventDefault();
                var linkBtn = $(this);
                if (linkBtn.data('busy')) return;

                var checkedBoxes = $('#ftu-checkouts-table tbody .ftu-chk-item:checked');
                var targetRows = [];
                if (checkedBoxes.length > 0) {
                    checkedBoxes.each(function() {
                        var r = $(this).closest('tr');
                        if (r.length) targetRows.push(r);
                    });
                } else {
                    $('#ftu-checkouts-table tbody tr[data-issue-id]').each(function() {
                        targetRows.push($(this));
                    });
                }

                if (!targetRows.length) {
                    showToast('Không có tài liệu nào để gia hạn', 'info');
                    return;
                }

                var scopeText = checkedBoxes.length > 0
                    ? (checkedBoxes.length + ' tài liệu đã chọn')
                    : ('tất cả ' + targetRows.length + ' tài liệu đang mượn');
                if (!confirm('Xác nhận gia hạn ' + scopeText + '?')) return;

                linkBtn.data('busy', true).css({ opacity: 0.5, pointerEvents: 'none' });

                var okCount = 0;
                var failedList = [];
                for (var i = 0; i < targetRows.length; i++) {
                    var res = await renewSingleRow(targetRows[i], { silent: true, promptOverride: false });
                    if (res.ok) {
                        okCount++;
                    } else {
                        failedList.push(res);
                    }
                }

                var overridableList = failedList.filter(function(item) { return item.overridable; });
                if (overridableList.length > 0) {
                    var detailLines = overridableList.map(function(item) {
                        return '• ' + item.title + ': ' + item.errorText;
                    }).join('\n');
                    if (confirm('Có ' + overridableList.length + ' tài liệu vượt giới hạn quy tắc lưu thông:\n\n' + detailLines + '\n\nBạn có muốn GHI ĐÈ quy tắc để gia hạn các tài liệu này không?')) {
                        var stillFailed = failedList.filter(function(item) { return !item.overridable; });
                        for (var j = 0; j < overridableList.length; j++) {
                            var retryRes = await renewSingleRow(overridableList[j].row, { silent: true, overrideLimit: true, promptOverride: false });
                            if (retryRes.ok) {
                                okCount++;
                            } else {
                                stillFailed.push(retryRes);
                            }
                        }
                        failedList = stillFailed;
                    }
                }

                linkBtn.data('busy', false).css({ opacity: 1, pointerEvents: 'auto' });
                $('#ftu-chk-all, .ftu-chk-item').prop('checked', false);

                if (okCount === targetRows.length) {
                    showToast('Đã gia hạn thành công ' + okCount + '/' + targetRows.length + ' tài liệu!', 'success');
                } else if (okCount > 0) {
                    showToast('Đã gia hạn ' + okCount + '/' + targetRows.length + ' tài liệu (' + failedList.length + ' tài liệu không gia hạn).', 'info');
                } else {
                    var reason = failedList.length ? failedList[0].errorText : 'Không thể gia hạn';
                    showToast('Gia hạn thất bại: ' + reason, 'error');
                }
            });

            // 8. Return All
            $('#ftu-btn-return-all').on('click', async function(e) {
                e.preventDefault();
                var checkedBoxes = $('#ftu-checkouts-table tbody .ftu-chk-item:checked');
                var rows = checkedBoxes.length > 0
                    ? checkedBoxes.closest('tr')
                    : $('#ftu-checkouts-table tbody tr[data-barcode]');
                if (!rows.length) {
                    showToast('Không có tài liệu nào đang mượn', 'info');
                    return;
                }
                var label = checkedBoxes.length > 0 ? (rows.length + ' tài liệu đã chọn') : ('tất cả ' + rows.length + ' tài liệu');
                if (!confirm('Xác nhận trả ' + label + '?')) return;
                $(this).css('opacity', 0.5);
                var csrf = $('input[name="csrf_token"]').val() || '';
                for (var i = 0; i < rows.length; i++) {
                    var row = $(rows[i]);
                    var bc = row.data('barcode');
                    var fd = new FormData();
                    fd.append('op', 'cud-checkin');
                    fd.append('barcode', bc);
                    fd.append('csrf_token', csrf);
                    try {
                        await fetch('/cgi-bin/koha/circ/returns.pl', { method: 'POST', body: fd, credentials: 'same-origin' });
                    } catch(e) {}
                    row.remove();
                    await new Promise(r => setTimeout(r, 120));
                }
                $(this).css('opacity', 1);
                updateCounts();
                showToast('Đã trả tài liệu thành công', 'success');
            });

            // 9. Instant Table Search
            $('#ftu-search-table').on('keyup', function() {
                var term = $(this).val().toLowerCase().trim();
                var rows = $('#ftu-checkouts-table tbody tr[data-issue-id]');
                var visibleCount = 0;
                rows.each(function() {
                    var rowText = $(this).text().toLowerCase();
                    if (rowText.indexOf(term) > -1) {
                        $(this).show();
                        visibleCount++;
                    } else {
                        $(this).hide();
                    }
                });
                $('#ftu-footer-info').text('Hiển thị 1 đến ' + visibleCount + ' trong ' + rows.length + ' bản ghi');
            });

            // 10. Column Sorting
            $('.th-sort').on('click', function() {
                var colIdx = $(this).index();
                var table = $('#ftu-checkouts-table');
                var rows = table.find('tbody tr[data-issue-id]').toArray();
                var asc = !$(this).data('asc');
                $(this).data('asc', asc);

                rows.sort(function(a, b) {
                    var aVal = $(a).find('td').eq(colIdx).text().trim();
                    var bVal = $(b).find('td').eq(colIdx).text().trim();
                    return asc ? aVal.localeCompare(bVal, 'vi', { numeric: true }) : bVal.localeCompare(aVal, 'vi', { numeric: true });
                });
                table.find('tbody').append(rows);
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]

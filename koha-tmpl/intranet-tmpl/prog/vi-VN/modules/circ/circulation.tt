[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE Branches %]
[% USE KohaDates %]
[% USE Categories %]
[% USE TablesSettings %]
[% USE ItemTypes %]
[% USE Price %]
[% USE AuthorisedValues %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
[% SET destination = "circ" %]
<title>[% FILTER collapse %]
    [% IF patron %]
        [% patron_in_title = INCLUDE 'patron-title.inc' invert_name = 1 no_html = 1 %]
        [% tx("Checking out to {patron}", { patron = patron_in_title }) | html %]
        &rsaquo;
    [% END %]
    [% t("Circulation") | html %]
    &rsaquo; [% t("Koha") | html %]
[% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
[% FILTER collapse %]
    <style nonce="[% Koha.CSPNonce | $raw %]">
        /* RESET & BASE - TRẮNG SÁNG, PHẲNG, KHÔNG KHUNG HỘP */
        body#circ_circulation {
            background-color: #ffffff;
            color: #0f172a;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 13px;
            line-height: 1.5;
        }

        #circ_circulation #sidebar-container,
        #circ_circulation .patroninfo,
        #circ_circulation #members-toolbar,
        #circ_circulation h1,
        #circ_circulation #patron-detail-tabs,
        #circ_circulation #finesholdsissues {
            display: none !important;
        }

        #circ_circulation .main.container-fluid,
        #circ_circulation .col-md-10,
        #circ_circulation .col-lg-8,
        #circ_circulation .col-xl-12,
        #circ_circulation main {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 10px 20px !important;
            flex: 0 0 100% !important;
        }

        .ftu-circ-workspace {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* TOP BREADCRUMB PHẲNG */
        .ftu-top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 8px;
            border-bottom: 1px solid #f1f5f9;
        }
        .ftu-breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12.5px;
            color: #64748b;
        }
        .ftu-breadcrumb a {
            color: #0284c7;
            text-decoration: none;
        }
        .ftu-breadcrumb a:hover {
            text-decoration: underline;
        }
        .ftu-breadcrumb-sep {
            color: #cbd5e1;
        }
        .ftu-breadcrumb-active {
            color: #0f172a;
            font-weight: 600;
        }
        .ftu-station-text {
            font-size: 12px;
            color: #64748b;
        }

        /* KHÔNG DÙNG BOX BAO NGOÀI - CHIA KHÔNG GIAN BẰNG VẠCH PHÂN CÁCH MỎNG */
        .ftu-desk-split {
            display: flex;
            align-items: stretch;
            gap: 28px;
            padding-bottom: 16px;
            border-bottom: 1px solid #e2e8f0;
        }

        /* CỘT TRÁI: Ô QUÉT MÃ VẠCH (300px) */
        .ftu-desk-left {
            width: 300px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-right: 1px solid #f1f5f9;
            padding-right: 28px;
        }

        .ftu-panel-title {
            font-size: 12px;
            font-weight: 700;
            color: #334155;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
        }

        .ftu-field-group {
            margin-bottom: 10px;
        }
        .ftu-field-label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 4px;
        }
        .ftu-field-hint {
            font-size: 11px;
            color: #94a3b8;
            margin-top: 3px;
        }

        .ftu-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }
        .ftu-barcode-input {
            width: 100%;
            height: 35px;
            padding: 6px 26px 6px 10px;
            font-size: 13.5px;
            font-weight: 600;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            color: #0f172a;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            box-sizing: border-box;
            transition: all 0.15s ease;
        }
        .ftu-barcode-input:focus {
            outline: none;
            border-color: #0284c7;
            box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.12);
        }
        .ftu-btn-clear {
            position: absolute;
            right: 6px;
            background: none;
            border: none;
            color: #94a3b8;
            font-size: 16px;
            cursor: pointer;
            padding: 2px 4px;
            line-height: 1;
        }
        .ftu-btn-clear:hover {
            color: #0f172a;
        }

        .ftu-checkbox-wrap {
            margin-bottom: 10px;
        }
        .ftu-checkbox-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #64748b;
            cursor: pointer;
            margin: 0;
            user-select: none;
        }

        .ftu-btn-primary {
            width: 100%;
            height: 34px;
            background: #0284c7;
            color: #ffffff;
            border: none;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s;
        }
        .ftu-btn-primary:hover {
            background: #0369a1;
        }

        .ftu-left-actions {
            display: flex;
            gap: 12px;
            margin-top: 12px;
            padding-top: 10px;
            border-top: 1px solid #f1f5f9;
        }
        .ftu-link-action {
            font-size: 12px;
            color: #0284c7;
            text-decoration: none;
            font-weight: 500;
        }
        .ftu-link-action:hover {
            text-decoration: underline;
        }
        .ftu-link-danger {
            color: #dc2626;
        }

        /* CỘT PHẢI: THÔNG TIN BẠN ĐỌC (HOÀN TOÀN KHÔNG BOX, KHÔNG KHUNG, THUẦN CHỮ) */
        .ftu-desk-right {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 12px;
        }

        /* Header bạn đọc thuần chữ */
        .ftu-patron-headline {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
            padding-bottom: 6px;
        }
        .ftu-patron-title-group {
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 8px;
        }
        .ftu-patron-fullname {
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
        }
        .ftu-patron-meta-inline {
            font-size: 12.5px;
            color: #64748b;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
        }
        .ftu-dot {
            color: #cbd5e1;
            font-size: 11px;
        }
        .ftu-text-id {
            font-family: ui-monospace, SFMono-Regular, monospace;
            font-weight: 600;
            color: #1e40af;
        }
        .ftu-text-success {
            color: #16a34a;
            font-weight: 600;
        }
        .ftu-text-danger {
            color: #dc2626;
            font-weight: 600;
        }

        /* THANH CHỈ SỐ LƯU THÔNG PHẲNG (KHÔNG DÙNG BOX, KHÔNG NỀN XÁM) */
        .ftu-stats-line {
            display: flex;
            align-items: baseline;
            gap: 24px;
            padding: 4px 0;
        }
        .ftu-stat-unit {
            display: flex;
            align-items: baseline;
            gap: 6px;
        }
        .ftu-stat-unit-label {
            font-size: 12px;
            color: #64748b;
        }
        .ftu-stat-unit-value {
            font-size: 13.5px;
            font-weight: 700;
            color: #0f172a;
        }
        .ftu-stat-unit-sep {
            color: #e2e8f0;
        }

        /* LƯỚI THÔNG TIN BẠN ĐỌC PHẲNG (KHÔNG KHUNG HỘP, KHÔNG ICON) */
        .ftu-details-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px 16px;
            padding-top: 6px;
            border-top: 1px solid #f1f5f9;
        }
        .ftu-detail-item {
            display: flex;
            flex-direction: column;
            gap: 1px;
            min-width: 0;
        }
        .ftu-detail-label {
            font-size: 11px;
            color: #94a3b8;
            font-weight: 500;
        }
        .ftu-detail-value {
            font-size: 12.5px;
            color: #1e293b;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .ftu-detail-wide {
            grid-column: 1 / -1;
            padding-top: 4px;
            border-top: 1px dashed #f1f5f9;
            margin-top: 2px;
        }

        /* THÔNG BÁO GIAO DỊCH */
        .ftu-feedback-banner {
            background: #f0fdf4;
            border-left: 3px solid #16a34a;
            color: #15803d;
            padding: 6px 12px;
            font-size: 12.5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .ftu-feedback-close {
            background: none;
            border: none;
            color: #15803d;
            font-size: 16px;
            cursor: pointer;
            padding: 0 4px;
            line-height: 1;
        }

        /* KHI CHƯA CHỌN BẠN ĐỌC */
        .ftu-empty-patron {
            padding: 30px 10px;
            color: #94a3b8;
            font-size: 13px;
        }

        /* ========================================================================== */
        /* KHUNG DƯỚI: BẢNG TÀI LIỆU ĐANG MƯỢN (KHÔNG KHUNG HỘP BAO NGOÀI)           */
        /* ========================================================================== */
        .ftu-table-section {
            width: 100%;
        }
        .ftu-table-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            padding-bottom: 8px;
            border-bottom: 1px solid #0f172a;
            margin-bottom: 6px;
        }
        .ftu-table-title {
            font-size: 14px;
            font-weight: 700;
            color: #0f172a;
        }
        .ftu-table-actions {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .ftu-table-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0 10px 0;
            font-size: 12px;
            color: #64748b;
        }
        .ftu-select-len {
            height: 26px;
            border: 1px solid #cbd5e1;
            border-radius: 3px;
            padding: 1px 4px;
            font-size: 12px;
        }
        .ftu-input-filter {
            height: 26px;
            width: 220px;
            border: 1px solid #cbd5e1;
            border-radius: 3px;
            padding: 2px 8px;
            font-size: 12px;
        }
        .ftu-input-filter:focus {
            outline: none;
            border-color: #0284c7;
        }

        /* BẢNG DỮ LIỆU PHẲNG (STRIPE / GITHUB STYLE) */
        .ftu-flat-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
        }
        .ftu-flat-table th {
            padding: 8px 10px;
            font-weight: 600;
            color: #64748b;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
            font-size: 12px;
            white-space: nowrap;
        }
        .ftu-flat-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #f1f5f9;
            color: #0f172a;
            vertical-align: middle;
        }
        .ftu-flat-table tbody tr:hover td {
            background: #fafbfc;
        }

        .ftu-code {
            font-family: ui-monospace, SFMono-Regular, monospace;
            font-weight: 600;
            color: #0f172a;
        }
        .ftu-title-link {
            color: #0284c7;
            text-decoration: none;
            font-weight: 600;
        }
        .ftu-title-link:hover {
            text-decoration: underline;
        }
        .ftu-author-sub {
            font-size: 11.5px;
            color: #64748b;
        }

        .ftu-status-overdue {
            color: #dc2626;
            font-weight: 600;
        }
        .ftu-status-ok {
            color: #0284c7;
        }

        /* EMPTY STATE SÁCH MƯỢN */
        .ftu-empty-books {
            padding: 32px 10px;
            text-align: center;
            color: #64748b;
        }
        .ftu-empty-books-title {
            font-size: 13.5px;
            font-weight: 600;
            color: #475569;
            margin-bottom: 2px;
        }
        .ftu-empty-books-sub {
            font-size: 12px;
            color: #94a3b8;
        }

        .ftu-table-footer {
            padding: 8px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: #64748b;
        }
        .ftu-btn-page {
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #334155;
            padding: 2px 8px;
            font-size: 11.5px;
            border-radius: 3px;
            cursor: pointer;
        }
        .ftu-btn-page.active {
            background: #0284c7;
            color: #ffffff;
            border-color: #0284c7;
        }
        .ftu-btn-page:disabled {
            opacity: 0.5;
            cursor: default;
        }
    </style>
[% END %]
</head>

<body id="circ_circulation" class="circ">

[% WRAPPER 'header.inc' %]
    [% INCLUDE 'circ-search.inc' %]
[% END %]

[% SET asides = [] %]
[% WRAPPER 'main-container.inc' wide_full=1 %]

<div class="ftu-circ-workspace">

    <!-- BREADCRUMB & TRẠM LÀM VIỆC (PHẲNG, KHÔNG KHUNG) -->
    <div class="ftu-top-bar">
        <div class="ftu-breadcrumb">
            <a href="/cgi-bin/koha/mainpage.pl">Trang chủ</a>
            <span class="ftu-breadcrumb-sep">/</span>
            <span class="ftu-breadcrumb-active">Lưu thông &amp; Quầy Mượn Trả</span>
        </div>
        <div class="ftu-station-text">
            [% Branches.GetName(patron.branchcode) || Branches.GetLoggedInBranchname || 'Thư viện ĐH Ngoại Thương' | html %]
        </div>
    </div>

    <!-- KHU VỰC THAO TÁC CÂN ĐỐI (HOÀN TOÀN KHÔNG BOX, KHÔNG KHUNG HỘP) -->
    <div class="ftu-desk-split">

        <!-- 1. CỘT TRÁI: Ô QUÉT MÃ VẠCH (300px) -->
        <div class="ftu-desk-left">
            <div>
                <div class="ftu-panel-title">Mượn tài liệu</div>

                [% IF patron %]
                <form method="post" action="/cgi-bin/koha/circ/circulation.pl" id="mainform" name="mainform" autocomplete="off">
                    [% INCLUDE 'csrf-token.inc' %]
                    <input type="hidden" name="op" value="cud-checkout" />
                    <input type="hidden" name="borrowernumber" id="borrowernumber" value="[% patron.borrowernumber | html %]" />
                    <input type="hidden" name="restoreduedatespec" />
                    <input type="hidden" name="debt_confirmed" value="[% debt_confirmed | html %]" />
                    <input type="hidden" name="branch" value="[% patron.branchcode | html %]" />
                    [% IF (forceallow) %]<input type="hidden" name="forceallow" value="1" />[% END %]
                    [% IF ( CHARGES ) %]<input type="hidden" name="charges" value="yes" />[% END %]

                    <div class="ftu-field-group">
                        <label class="ftu-field-label" for="barcode">Mã vạch / Số ĐKCB</label>
                        <div class="ftu-input-wrap">
                            <input type="text" name="barcode" id="barcode" class="ftu-barcode-input" autocomplete="off" placeholder="Nhập hoặc quét mã vạch..." autofocus />
                            <button type="button" class="ftu-btn-clear" id="btn-clear-barcode" title="Xóa">&times;</button>
                        </div>
                        <div class="ftu-field-hint">Nhấn Enter để ghi mượn</div>
                    </div>

                    <div class="ftu-checkbox-wrap">
                        <label class="ftu-checkbox-label">
                            <input type="checkbox" id="calc_turn" name="calc_turn" checked="checked" />
                            <span>Tính lượt lưu thông</span>
                        </label>
                    </div>

                    <button type="submit" class="ftu-btn-primary" id="btn-submit-borrow">Cho mượn tài liệu</button>
                </form>
                [% ELSE %]
                <form action="/cgi-bin/koha/circ/circulation.pl" id="mainform" method="get" autocomplete="off">
                    <div class="ftu-field-group">
                        <label class="ftu-field-label" for="findborrower_main">Số thẻ bạn đọc</label>
                        <div class="ftu-input-wrap">
                            <input type="text" id="findborrower_main" name="findborrower" class="ftu-barcode-input" autocomplete="off" placeholder="Quét hoặc nhập mã thẻ..." autofocus />
                        </div>
                        <div class="ftu-field-hint">Nhấn Enter để mở hồ sơ</div>
                    </div>

                    <button type="submit" class="ftu-btn-primary">Mở hồ sơ lưu thông</button>
                </form>
                [% END %]
            </div>

            <div class="ftu-left-actions">
                <a href="/cgi-bin/koha/circ/circulation.pl" class="ftu-link-action ftu-link-danger">Đổi bạn đọc</a>
                <span style="color:#e2e8f0;">|</span>
                <a href="/cgi-bin/koha/members/members-home.pl" class="ftu-link-action">Tra cứu</a>
            </div>
        </div>

        <!-- 2. CỘT PHẢI: THÔNG TIN BẠN ĐỌC (THUẦN TYPOGRAPHY, KHÔNG DÙNG BOX, KHÔNG KHUNG) -->
        <div class="ftu-desk-right">
            [% IF patron %]
            [% SET overdue_count = 0 %]
            [% FOREACH chk IN patron.checkouts %]
                [% IF chk.is_overdue %][% SET overdue_count = overdue_count + 1 %][% END %]
            [% END %]
            [% SET chk_count = patron.checkouts.count || 0 %]
            [% SET balance = patron.account.balance || 0 %]

            <!-- 2.1 Tiêu đề bạn đọc: thuần chữ, dấu chấm phân cách, không hộp pill-box -->
            <div class="ftu-patron-headline">
                <div class="ftu-patron-title-group">
                    <span class="ftu-patron-fullname">[% patron.surname | html %] [% patron.firstname | html %]</span>
                    <div class="ftu-patron-meta-inline">
                        <span class="ftu-text-id">[% patron.cardnumber | html %]</span>
                        <span class="ftu-dot">&bull;</span>
                        <span>[% patron.category.description || 'Bạn đọc' | html %]</span>
                        <span class="ftu-dot">&bull;</span>
                        [% IF patron.is_debarred || patron.is_expired %]
                            <span class="ftu-text-danger">Thẻ đã khóa</span>
                        [% ELSE %]
                            <span class="ftu-text-success">Đang hoạt động</span>
                        [% END %]
                        <span class="ftu-dot">&bull;</span>
                        <span>[% Branches.GetName(patron.branchcode) || patron.library.branchname || 'Trường ĐH Ngoại Thương' | html %]</span>
                    </div>
                </div>

                <div>
                    <a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=[% patron.borrowernumber | uri %]" target="_blank" class="ftu-link-action">
                        Xem hồ sơ chi tiết &rarr;
                    </a>
                </div>
            </div>

            <!-- 2.2 Thanh chỉ số lưu thông phẳng (KHÔNG DÙNG CÁC BOX) -->
            <div class="ftu-stats-line">
                <div class="ftu-stat-unit">
                    <span class="ftu-stat-unit-label">Sách đang mượn:</span>
                    <span class="ftu-stat-unit-value">[% chk_count %] / 5 cuốn</span>
                </div>
                <span class="ftu-stat-unit-sep">|</span>
                <div class="ftu-stat-unit">
                    <span class="ftu-stat-unit-label">Hạn trả:</span>
                    <span class="ftu-stat-unit-value [% IF overdue_count > 0 %]ftu-text-danger[% ELSE %]ftu-text-success[% END %]">
                        [% IF overdue_count > 0 %][% overdue_count %] sách quá hạn[% ELSE %]Không quá hạn[% END %]
                    </span>
                </div>
                <span class="ftu-stat-unit-sep">|</span>
                <div class="ftu-stat-unit">
                    <span class="ftu-stat-unit-label">Tiền phạt:</span>
                    <span class="ftu-stat-unit-value [% IF balance > 0 %]ftu-text-danger[% END %]">
                        [% IF balance > 0 %][% balance | $Price %] đ[% ELSE %]0 đ[% END %]
                    </span>
                </div>
            </div>

            <!-- 2.3 Lưới thông tin định danh & học vụ (THUẦN CHỮ, KHÔNG BOX, KHÔNG ICON) -->
            [% SET dept_val = '' %]
            [% IF patron.borrowernotes && patron.borrowernotes.match('Khoa:\s*([^|\n]+)') %]
                [% SET dept_m = patron.borrowernotes.match('Khoa:\s*([^|\n]+)') %]
                [% SET dept_val = dept_m.0 %]
            [% END %]
            [% SET cccd_val = patron.sort2 %]
            [% IF !cccd_val && patron.borrowernotes && patron.borrowernotes.match('CCCD:\s*([^|\n]+)') %]
                [% SET cccd_m = patron.borrowernotes.match('CCCD:\s*([^|\n]+)') %]
                [% SET cccd_val = cccd_m.0 %]
            [% END %]

            <div class="ftu-details-grid">
                <div class="ftu-detail-item">
                    <span class="ftu-detail-label">Khoa / Đơn vị</span>
                    <span class="ftu-detail-value">[% IF dept_val %][% dept_val | html %][% ELSE %]—[% END %]</span>
                </div>
                <div class="ftu-detail-item">
                    <span class="ftu-detail-label">Khóa &middot; Lớp</span>
                    <span class="ftu-detail-value">[% IF patron.sort1 %][% patron.sort1 | html %][% ELSE %]—[% END %]</span>
                </div>
                <div class="ftu-detail-item">
                    <span class="ftu-detail-label">Email</span>
                    <span class="ftu-detail-value">[% IF patron.email %][% patron.email | html %][% ELSE %]—[% END %]</span>
                </div>
                <div class="ftu-detail-item">
                    <span class="ftu-detail-label">Điện thoại</span>
                    <span class="ftu-detail-value">[% IF patron.phone %][% patron.phone | html %][% ELSE %]—[% END %]</span>
                </div>

                <div class="ftu-detail-item">
                    <span class="ftu-detail-label">Ngày sinh</span>
                    <span class="ftu-detail-value">[% IF patron.dateofbirth %][% patron.dateofbirth | $KohaDates dateformat => 'metric' %][% ELSE %]—[% END %]</span>
                </div>
                <div class="ftu-detail-item">
                    <span class="ftu-detail-label">Số CCCD</span>
                    <span class="ftu-detail-value">[% IF cccd_val %][% cccd_val | html %][% ELSE %]—[% END %]</span>
                </div>
                <div class="ftu-detail-item">
                    <span class="ftu-detail-label">Ngày cấp thẻ</span>
                    <span class="ftu-detail-value">[% IF patron.dateenrolled %][% patron.dateenrolled | $KohaDates dateformat => 'metric' %][% ELSE %]—[% END %]</span>
                </div>
                <div class="ftu-detail-item">
                    <span class="ftu-detail-label">Hạn dùng thẻ</span>
                    <span class="ftu-detail-value">[% IF patron.dateexpiry %][% patron.dateexpiry | $KohaDates dateformat => 'metric' %][% ELSE %]—[% END %]</span>
                </div>

                [% IF patron.address %]
                <div class="ftu-detail-item ftu-detail-wide">
                    <span class="ftu-detail-label">Địa chỉ liên hệ</span>
                    <span class="ftu-detail-value">[% patron.address | html %][% IF patron.city %], [% patron.city | html %][% END %]</span>
                </div>
                [% END %]
            </div>

            <!-- 2.4 Thông báo kết quả giao dịch -->
            [% IF issue || was_renewed || messages %]
            <div class="ftu-feedback-banner" id="ftu-feedback-bar">
                <span>
                    [% IF ( issue ) %]
                        Đã cho mượn thành công: <strong>[% issue.item.biblio.title | html %]</strong> ([% issue.item.barcode | html %]). Hạn trả: [% issue.date_due | $KohaDates as_due_date => 1 dateformat => 'metric' %]
                    [% ELSIF ( was_renewed ) %]
                        Đã gia hạn thành công.
                    [% ELSIF ( messages ) %]
                        [% messages | html %]
                    [% END %]
                </span>
                <button type="button" class="ftu-feedback-close" onclick="document.getElementById('ftu-feedback-bar').style.display='none';">&times;</button>
            </div>
            [% END %]

            [% ELSE %]
            <div class="ftu-empty-patron">
                Chưa có bạn đọc nào được chọn. Nhập mã thẻ ở cột bên trái để bắt đầu phiên lưu thông.
            </div>
            [% END %]
        </div>

    </div>

    <!-- KHỐI XÁC NHẬN NẾU CÓ TRỞ NGẠI LƯU THÔNG -->
    [% IF ( NEEDSCONFIRMATION ) %]
        <div id="circ_needsconfirmation" class="alert alert-warning" style="border-radius:4px; padding:10px 14px; margin:0;">
            <strong style="display:block; margin-bottom:4px;">Yêu cầu xác nhận cho mượn:</strong>
            <ul style="margin:0 0 8px 16px; padding:0; font-size:12.5px;">
                [% IF ( RENEW_ISSUE ) %]<li>Tài liệu <em>[% getTitleMessageIteminfo | html %]</em> ([% getBarcodeMessageIteminfo | html %]) đang được mượn bởi bạn đọc này. Xác nhận gia hạn?</li>[% END %]
                [% IF ( ISSUED_TO_ANOTHER ) %]<li>Tài liệu đang được mượn bởi [% issued_firstname | html %] [% issued_surname | html %] ([% issued_cardnumber | html %]). Tự động ghi trả và cho mượn lại?</li>[% END %]
                [% IF ( RESERVE_WAITING ) %]<li>Tài liệu đang chờ bạn đọc khác đặt trước.</li>[% END %]
                [% IF ( DEBT ) %]<li>Bạn đọc đang có tiền phạt chưa thanh toán: [% DEBT | $Price %].</li>[% END %]
            </ul>
            <form method="post" action="/cgi-bin/koha/circ/circulation.pl" style="display:flex; gap:6px;">
                [% INCLUDE 'csrf-token.inc' %]
                <input type="hidden" name="op" value="cud-checkout" />
                <input type="hidden" name="borrowernumber" value="[% patron.borrowernumber | html %]" />
                <input type="hidden" name="barcode" value="[% barcode | html %]" />
                <input type="hidden" name="issueconfirmed" value="1" />
                <input type="hidden" name="debt_confirmed" value="1" />
                <button type="submit" class="btn btn-warning btn-sm fw-semibold">Xác nhận cho mượn</button>
                <a href="/cgi-bin/koha/circ/circulation.pl?findborrower=[% patron.cardnumber | uri %]" class="btn btn-outline-secondary btn-sm">Hủy bỏ</a>
            </form>
        </div>
    [% END %]

    [% IF ( IMPOSSIBLE ) %]
        <div class="alert alert-danger" style="border-radius:4px; padding:10px 14px; margin:0;">
            <strong style="display:block; margin-bottom:4px;">Không thể cho mượn tài liệu:</strong>
            <ul style="margin:0 0 8px 16px; padding:0; font-size:12.5px;">
                [% IF ( UNKNOWN_BARCODE ) %]<li>Không tìm thấy mã vạch: <strong>[% barcode | html %]</strong></li>[% END %]
                [% IF ( NOT_FOR_LOAN ) %]<li>Tài liệu này không thuộc diện cho mượn về nhà.</li>[% END %]
                [% IF ( WTHDRAWN ) %]<li>Tài liệu đã được rút khỏi lưu thông.</li>[% END %]
                [% IF ( RESTRICTED ) %]<li>Tài liệu bị giới hạn lưu thông.</li>[% END %]
            </ul>
            <a href="/cgi-bin/koha/circ/circulation.pl?findborrower=[% patron.cardnumber | uri %]" class="btn btn-secondary btn-sm">Quay lại</a>
        </div>
    [% END %]

    <!-- KHUNG DƯỚI: BẢNG TÀI LIỆU ĐANG MƯỢN (PHẲNG, KHÔNG KHUNG HỘP) -->
    [% IF patron %]
    <div class="ftu-table-section" id="ftu-checkouts-card">
        <div class="ftu-table-header">
            <div class="ftu-table-title">
                Tài liệu đang mượn ([% patron.checkouts.count || 0 %])
            </div>

            <div class="ftu-table-actions">
                [% IF patron.checkouts.count > 0 %]
                    <a href="#" id="ftu-btn-renew-all" class="ftu-link-action">Gia hạn tất cả</a>
                    <span style="color:#e2e8f0;">|</span>
                    <a href="#" id="ftu-btn-return-all" class="ftu-link-action ftu-link-danger">Trả tất cả</a>
                    <span style="color:#e2e8f0;">|</span>
                    <a href="/cgi-bin/koha/members/printslip.pl?borrowernumber=[% patron.borrowernumber | uri %]&amp;print=issueslip" target="_blank" class="ftu-link-action">In phiếu mượn</a>
                    <span style="color:#e2e8f0;">|</span>
                [% END %]
                <a href="/cgi-bin/koha/members/boraccount.pl?borrowernumber=[% patron.borrowernumber | uri %]" class="ftu-link-action" target="_blank">Lịch sử phí phạt</a>
            </div>
        </div>

        [% IF patron.checkouts.count == 0 %]
            <div class="ftu-empty-books" id="ftu-empty-state">
                <div class="ftu-empty-books-title">Bạn đọc hiện không có tài liệu nào đang mượn</div>
                <div class="ftu-empty-books-sub">Nhập hoặc quét mã vạch ở cột bên trái để thực hiện cho mượn tài liệu.</div>
            </div>
        [% ELSE %]
            <div class="ftu-table-toolbar">
                <div>
                    Hiển thị 
                    <select id="ftu-page-length" class="ftu-select-len">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                    bản ghi
                </div>
                <div>
                    <input type="text" id="ftu-search-table" class="ftu-input-filter" placeholder="Lọc nhanh nhan đề, mã vạch..." />
                </div>
            </div>

            <table id="ftu-checkouts-table" class="ftu-flat-table">
                <thead>
                    <tr>
                        <th style="width: 24px; text-align: center;"><input type="checkbox" id="ftu-chk-all" /></th>
                        <th class="th-sort" data-col="1" style="width: 120px;">Số ĐKCB</th>
                        <th class="th-sort" data-col="2">Nhan đề &amp; Tác giả</th>
                        <th class="th-sort" data-col="3" style="width: 110px;">Môn loại</th>
                        <th class="th-sort" data-col="4" style="width: 100px;">Ngày mượn</th>
                        <th class="th-sort" data-col="5" style="width: 100px;">Hạn trả</th>
                        <th style="text-align: center; width: 90px;">Trạng thái</th>
                        <th style="text-align: center; width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    [% FOREACH issue IN patron.checkouts %]
                    <tr data-issue-id="[% issue.issue_id | html %]" data-barcode="[% issue.item.barcode | html %]">
                        <td style="text-align: center;"><input type="checkbox" class="ftu-chk-item" value="[% issue.issue_id | html %]" data-barcode="[% issue.item.barcode | html %]" /></td>
                        <td class="ftu-code">[% issue.item.barcode | html %]</td>
                        <td>
                            <div>
                                <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% issue.item.biblio.biblionumber | uri %]" target="_blank" class="ftu-title-link">[% issue.item.biblio.title | html %]</a>
                                [% IF issue.item.biblio.author %]
                                    <div class="ftu-author-sub">Tác giả: [% issue.item.biblio.author | html %]</div>
                                [% END %]
                            </div>
                        </td>
                        <td>[% issue.item.itemcallnumber || '—' | html %]</td>
                        <td>[% issue.issuedate | $KohaDates dateformat => 'metric' %]</td>
                        <td class="ftu-duedate-cell" style="font-weight:600;">[% issue.date_due | $KohaDates dateformat => 'metric' %]</td>
                        <td style="text-align: center;">
                            [% IF issue.is_overdue %]
                                <span class="ftu-status-overdue">Quá hạn</span>
                            [% ELSE %]
                                <span class="ftu-status-ok">Đang mượn</span>
                            [% END %]
                        </td>
                        <td style="text-align: center;">
                            <div style="display:flex; gap:8px; justify-content:center;">
                                <a href="#" class="ftu-link-action ftu-btn-renew-one" data-issue-id="[% issue.issue_id | html %]">Gia hạn</a>
                                <a href="#" class="ftu-link-action ftu-link-danger ftu-btn-return-one" data-barcode="[% issue.item.barcode | html %]" data-title="[% issue.item.biblio.title | html %]">Trả sách</a>
                            </div>
                        </td>
                    </tr>
                    [% END %]
                </tbody>
            </table>

            <div class="ftu-table-footer">
                <div id="ftu-footer-info">
                    Hiển thị 1 đến [% patron.checkouts.count || 0 %] trong [% patron.checkouts.count || 0 %] bản ghi
                </div>
                <div>
                    <button type="button" class="ftu-btn-page" disabled>&lt;</button>
                    <button type="button" class="ftu-btn-page active">1</button>
                    <button type="button" class="ftu-btn-page" disabled>&gt;</button>
                </div>
            </div>
        [% END %]

    </div>
    [% END %]

</div> <!-- /.ftu-circ-workspace -->

<!-- Hidden compatibility container for Koha scripts -->
<div style="display:none;">
    <table id="issues-table"></table>
</div>

[% END # /WRAPPER main-container.inc %]

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'datatables.inc' %]
    [% INCLUDE 'select2.inc' %]
    [% INCLUDE 'js-date-format.inc' %]
    <script nonce="[% Koha.CSPNonce | $raw %]">
        $(document).ready(function() {
            // 1. Autofocus barcode
            setTimeout(function() {
                var bc = $('#barcode');
                if (bc.length) { bc.focus(); }
                var fb = $('#findborrower_main');
                if (fb.length) { fb.focus(); }
            }, 80);

            // 2. Clear barcode input
            $('#btn-clear-barcode').on('click', function(e) {
                e.preventDefault();
                $('#barcode').val('').focus();
            });

            // 3. Select all checkboxes
            $('#ftu-chk-all').on('change', function() {
                var isChecked = $(this).prop('checked');
                $('.ftu-chk-item').prop('checked', isChecked);
            });

            // 4. Toast Notification
            function showToast(msg, type) {
                var container = document.getElementById('ftu-toast-container');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'ftu-toast-container';
                    container.style.cssText = 'position:fixed;top:60px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:6px;pointer-events:none;';
                    document.body.appendChild(container);
                }
                var colors = { success:'#16a34a', error:'#dc2626', info:'#0284c7' };
                var toast = document.createElement('div');
                toast.style.cssText = 'pointer-events:auto;background:#ffffff;border-left:3px solid '+(colors[type]||'#0284c7')+';padding:8px 14px;box-shadow:0 2px 8px rgba(0,0,0,0.1);font-size:12.5px;max-width:320px;';
                toast.innerHTML = '<span>'+msg+'</span>';
                container.appendChild(toast);
                setTimeout(function(){
                    toast.style.opacity='0';
                    toast.style.transition='opacity 0.25s';
                    setTimeout(function(){ if (toast.parentNode) toast.remove(); }, 250);
                }, 3000);
            }

            // 5. Update Table Counts
            function updateCounts() {
                var rows = $('#ftu-checkouts-table tbody tr[data-issue-id]');
                var count = rows.length;
                if (count === 0) {
                    location.reload();
                } else {
                    $('#ftu-footer-info').text('Hiển thị 1 đến ' + count + ' trong ' + count + ' bản ghi');
                }
            }

            // 6. Single Item Renew
            $(document).on('click', '.ftu-btn-renew-one', async function(e) {
                e.preventDefault();
                var btn = $(this);
                var issueId = btn.data('issue-id');
                var row = btn.closest('tr');
                var dueCell = row.find('.ftu-duedate-cell');

                btn.text('Đang xử lý...');
                try {
                    var resp = await fetch('/api/v1/checkouts/' + issueId + '/renewals', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'x-koha-override': 'debt_limit' },
                        body: '{}',
                        credentials: 'same-origin'
                    });
                    if (resp.ok) {
                        var data = await resp.json();
                        if (data.due_date) {
                            var dt = new Date(data.due_date);
                            var day = String(dt.getDate()).padStart(2, '0');
                            var month = String(dt.getMonth() + 1).padStart(2, '0');
                            var year = dt.getFullYear();
                            dueCell.html('<span style="color:#16a34a; font-weight:700;">' + day + '/' + month + '/' + year + '</span>');
                        }
                        showToast('Đã gia hạn thành công', 'success');
                        btn.text('Đã gia hạn');
                    } else {
                        var err = await resp.json().catch(function(){ return {}; });
                        showToast('Không thể gia hạn: ' + (err.error || resp.status), 'error');
                        btn.text('Gia hạn');
                    }
                } catch(ex) {
                    showToast('Lỗi kết nối khi gia hạn', 'error');
                    btn.text('Gia hạn');
                }
            });

            // 7. Single Item Return
            $(document).on('click', '.ftu-btn-return-one', async function(e) {
                e.preventDefault();
                var btn = $(this);
                var barcode = btn.data('barcode');
                var title = btn.data('title');
                var row = btn.closest('tr');

                if (!confirm('Xác nhận ghi trả tài liệu: ' + (title || barcode) + '?')) return;

                btn.text('Đang xử lý...');
                var csrf = $('input[name="csrf_token"]').val() || '';
                var fd = new FormData();
                fd.append('op', 'cud-checkin');
                fd.append('barcode', barcode);
                fd.append('csrf_token', csrf);

                try {
                    await fetch('/cgi-bin/koha/circ/returns.pl', {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin'
                    });
                    row.css({ transition: 'opacity 0.25s', opacity: 0 });
                    setTimeout(function() {
                        row.remove();
                        updateCounts();
                    }, 260);
                    showToast('Đã trả thành công: ' + (title || barcode), 'success');
                } catch(ex) {
                    showToast('Lỗi khi trả sách', 'error');
                    btn.text('Trả sách');
                }
            });

            // 8. Renew All
            $('#ftu-btn-renew-all').on('click', async function(e) {
                e.preventDefault();
                var btns = $('.ftu-btn-renew-one');
                if (!btns.length) {
                    showToast('Không có tài liệu nào để gia hạn', 'info');
                    return;
                }
                if (!confirm('Xác nhận gia hạn tất cả ' + btns.length + ' tài liệu?')) return;
                $(this).css('opacity', 0.5);
                for (var i = 0; i < btns.length; i++) {
                    $(btns[i]).click();
                    await new Promise(r => setTimeout(r, 200));
                }
                $(this).css('opacity', 1);
                showToast('Đã gửi yêu cầu gia hạn tất cả', 'success');
            });

            // 9. Return All
            $('#ftu-btn-return-all').on('click', async function(e) {
                e.preventDefault();
                var rows = $('#ftu-checkouts-table tbody tr[data-barcode]');
                if (!rows.length) {
                    showToast('Không có tài liệu nào đang mượn', 'info');
                    return;
                }
                if (!confirm('Xác nhận trả tất cả ' + rows.length + ' tài liệu?')) return;
                $(this).css('opacity', 0.5);
                var csrf = $('input[name="csrf_token"]').val() || '';
                for (var i = 0; i < rows.length; i++) {
                    var row = $(rows[i]);
                    var bc = row.data('barcode');
                    var fd = new FormData();
                    fd.append('op', 'cud-checkin');
                    fd.append('barcode', bc);
                    fd.append('csrf_token', csrf);
                    try {
                        await fetch('/cgi-bin/koha/circ/returns.pl', { method: 'POST', body: fd, credentials: 'same-origin' });
                    } catch(e) {}
                    row.remove();
                    await new Promise(r => setTimeout(r, 120));
                }
                $(this).css('opacity', 1);
                updateCounts();
                showToast('Đã trả tất cả tài liệu', 'success');
            });

            // 10. Instant Table Search
            $('#ftu-search-table').on('keyup', function() {
                var term = $(this).val().toLowerCase().trim();
                var rows = $('#ftu-checkouts-table tbody tr[data-issue-id]');
                var visibleCount = 0;
                rows.each(function() {
                    var rowText = $(this).text().toLowerCase();
                    if (rowText.indexOf(term) > -1) {
                        $(this).show();
                        visibleCount++;
                    } else {
                        $(this).hide();
                    }
                });
                $('#ftu-footer-info').text('Hiển thị 1 đến ' + visibleCount + ' trong ' + rows.length + ' bản ghi');
            });

            // 11. Column Sorting
            $('.th-sort').on('click', function() {
                var colIdx = $(this).index();
                var table = $('#ftu-checkouts-table');
                var rows = table.find('tbody tr[data-issue-id]').toArray();
                var asc = !$(this).data('asc');
                $(this).data('asc', asc);

                rows.sort(function(a, b) {
                    var aVal = $(a).find('td').eq(colIdx).text().trim();
                    var bVal = $(b).find('td').eq(colIdx).text().trim();
                    return asc ? aVal.localeCompare(bVal, 'vi', { numeric: true }) : bVal.localeCompare(aVal, 'vi', { numeric: true });
                });
                table.find('tbody').append(rows);
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]

[% USE raw %]
[% USE Koha %]
[% USE KohaDates %]
[% USE Branches %]
[% SET footerjs = 1 %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% tx("Circulation statistics for {title}", { title = title }) | html %]
 &rsaquo; [% t("Catalog") | html %] &rsaquo; [% t("Koha") | html %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="catalog_bookcount" class="catalog">
[% WRAPPER 'header.inc' %]
 [% INCLUDE 'cat-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
 [% WRAPPER breadcrumbs %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/circ/circulation-home.pl">Mục tra cứu</a>
 [% END %]
 [% IF blocking_error %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Lỗi</span>
 [% END %]
 [% ELSE %]
 [% WRAPPER breadcrumb_item %]
 [% INCLUDE 'biblio-title.inc' link = 1 %]
 [% END %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/catalogue/moredetail.pl?biblionumber=[% biblionumber | uri %]">Tài liệu</a>
 [% END %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Báo cáo phân hệ lưu thông</span>
 [% END %]
 [% END %]
 [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' aside='biblio-view-menu' %]
 <h1>
 [% IF ( author ) %]
 Circulation statistics for [% INCLUDE 'biblio-title.inc' %] by [% author |html %]
 [% ELSE %]
 Circulation statistics for [% INCLUDE 'biblio-title.inc' %]
 [% END %]
 </h1>

 <h3>Đăng ký cá biệt [% barcode | html %]</h3>
 <div class="page-section">
 <table>
 <tr
                ><th>Thư viện chủ quản</th><th>Thư viện hiện tại</th><th>Ngày nhận<br />thư viện hiện tại </th><th>Số lần cho mượn<br />từ lần chuyển cuối</th></tr
            >

 <tr
                ><td>[% Branches.GetName( homebranch ) | html %]</td>
 <td>[% Branches.GetName( holdingbranch ) | html %]</td>
 <td>[% IF ( lastdate ) %][% lastdate | $KohaDates %][% ELSE %]Tài liệu chưa được chuyển[% END %]</td>
 <td>[% count | html %]</td>
 </tr>
 </table>
 </div>
 <!-- /.page-section -->

 <div class="page-section">
 <table>
 <tr>
 <th>Thư viện</th>
 <th>Số lần mượn</th>
 <th>Cập nhật lần cuối</th>
 </tr>
 [% FOREACH library IN libraries %]
 [% SET tr_class = '' %]
 [% IF library.selected %]
 [% tr_class="mybranch" %]
 [% END %]
 <tr class="[% tr_class | html %]">
 <td>[% library.branchname | html %]</td>
 <td>[% library.issues | html %]</td>
 <td
                        >[% IF library.seen %]
 [% library.seen | $KohaDates  with_hours => 1 %]
 [% ELSE %]
 <span>Không lưu</span>
 [% END %]
 </td>
 </tr>
 [% END %]
 </table>
 </div>
 <!-- /.page-section -->
[% END %]

[% MACRO jsinclude BLOCK %]
 <script nonce="[% Koha.CSPNonce | $raw %]">
        $(document).ready(function () {
            $("tr.mybranch td").css("background-color", "#CFE7FF");
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]

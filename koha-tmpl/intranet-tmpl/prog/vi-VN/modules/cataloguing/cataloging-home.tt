[% USE raw %]
[% USE AdditionalContents %]
[% USE Koha %]
[% USE Branches %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% t("Cataloging") | html %]
 &rsaquo; [% t("Koha") | html %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="cat_cataloging-home" class="cat">
[% WRAPPER 'header.inc' %]
 [% INCLUDE 'cataloging-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
 [% WRAPPER breadcrumbs %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Phân hệ biên mục</span>
 [% END %]
 [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' %]
 [% IF ( CAN_user_editcatalogue_edit_catalogue ) %]
 <div id="toolbar" class="btn-toolbar">
 [% IF Koha.Preference( 'EnableAdvancedCatalogingEditor' ) == 1 && CAN_user_editcatalogue_advanced_editor %]
 <a id="useadvanced" href="/cgi-bin/koha/cataloguing/editor.pl" class="btn btn-default"><i class="fa-solid fa-pencil" aria-hidden="true"></i> Trình biên tập nâng cao</a>
 [% END %]
 <div class="btn-group">
 <button class="btn btn-default" id="newRecord"><i class="fa fa-plus"></i> Tạo biểu ghi</button>
 <button class="btn btn-default dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"></button>
 <ul class="dropdown-menu dropdown-menu-end">
 <li><a class="dropdown-item" id="newRecordDefault" href="/cgi-bin/koha/cataloguing/addbiblio.pl?frameworkcode=">Khung mẫu mặc định</a></li>
 [% FOREACH framework IN frameworks %]
 [% IF !framework.is_fast_add %]<li><a class="dropdown-item" href="/cgi-bin/koha/cataloguing/addbiblio.pl?frameworkcode=[% framework.frameworkcode | uri %]">[% framework.frameworktext | html %]</a></li>[% END %]
 [% END %]
 [% FOREACH framework IN frameworks %]
 [% IF loop.first %]<li><h6 class="dropdown-header">Khung mẫu biên mục nhanh</h6></li>[% END %]
 [% IF framework.is_fast_add %]<li><a class="dropdown-item" href="/cgi-bin/koha/cataloguing/addbiblio.pl?frameworkcode=[% framework.frameworkcode | uri %]">[% framework.frameworktext | html %]</a></li>[% END %]
 [% END %]
 </ul>
 </div>
 [% IF servers.count > 0 %]
 <div class="btn-group">
 <button class="btn btn-default" id="z3950search"><i class="fa fa-search"></i> Tạo từ máy chủ Z39.50/SRU</button>
 <button class="btn btn-default dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"></button>
 <ul class="dropdown-menu dropdown-menu-end">
 <li id="Default" class="z3950searchFw"><a class="dropdown-item" href="#">Khung mẫu mặc định</a></li>
 [% FOREACH framework IN frameworks %]
 [% IF !framework.is_fast_add %]<li id="[% framework.frameworkcode | html %]" class="z3950searchFw"><a class="dropdown-item" href="#">[% framework.frameworktext | html %]</a></li>[% END %]
 [% END %]
 [% FOREACH framework IN frameworks %]
 [% IF loop.first %]<li><h6 class="dropdown-header">Khung mẫu biên mục nhanh</h6></li>[% END %]
 [% IF framework.is_fast_add %]<li id="[% framework.frameworkcode | html %]" class="z3950searchFw"><a class="dropdown-item" href="#">[% framework.frameworktext | html %]</a></li>[% END %]
 [% END %]
 </ul>
 </div>
 [% END # /IF servers.count %]
 </div>
 <!-- /#toolbar -->
 [% END # /IF CAN_user_editcatalogue_edit_catalogue %]

 <h1>Phân hệ biên mục</h1>

 <div class="row">
 <div class="col-sm-4 col-md-4">
 [% IF ( CAN_user_tools_stage_marc_import || CAN_user_tools_manage_staged_marc ) %]
 <h3>Nhập dữ liệu</h3>
 <ul class="buttons-list">
 [% IF ( CAN_user_tools_stage_marc_import ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/stage-marc-import.pl"><i class="fa fa-download"></i> Chuẩn bị biểu ghi nhập liệu</a>
 </li>
 [% END %]

 [% IF ( CAN_user_tools_manage_staged_marc ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/manage-marc-import.pl"><i class="fa fa-tasks"></i> Quản lý biểu ghi MARC được duyệt</a>
 </li>
 [% END %]
 </ul>
 [% END %]

 [% IF ( CAN_user_tools_export_catalog ) %]
 <h3>Xuất dữ liệu</h3>
 <ul class="buttons-list">
 [% IF ( CAN_user_tools_export_catalog ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/export.pl"><i class="fa fa-upload"></i> Xuất dữ liệu biên mục</a>
 </li>
 [% END %]
 </ul>
 [% END %]

 [% IF ( CAN_user_tools_inventory || ( ( Koha.Preference('OpacCatalogConcerns') || Koha.Preference('CatalogConcerns') ) && CAN_user_editcatalogue_edit_catalogue ) ) %]
 <h3>Báo cáo</h3>
 <ul class="buttons-list">
 [% IF ( CAN_user_tools_inventory ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/inventory.pl"><i class="fa-solid fa-clipboard-check"></i> Kiểm kê kho</a>
 </li>
 [% END %]

 [% IF ( ( Koha.Preference('OpacCatalogConcerns') || Koha.Preference('CatalogConcerns') ) && CAN_user_editcatalogue_edit_catalogue ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/cataloguing/concerns.pl"><i class="fa fa-list-ul"></i> Báo cáo lỗi biên mục</a>
 </li>
 [% END %]
 </ul>
 [% END %]
 [% IF ( fast_cataloging && CAN_user_editcatalogue_fast_cataloging  ) %]
 <h3>Biên mục nhanh</h3>
 <ul class="buttons-list">
 [% IF ( CAN_user_editcatalogue_fast_cataloging ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/cataloguing/addbiblio.pl?frameworkcode=FA"><i class="fa fa-plus"></i> Biên mục nhanh</a>
 </li>
 [% END %]
 </ul>
 [% END %]
 </div>

 <div class="col-sm-4 col-md-4">
 [% IF ( CAN_user_tools_items_batchmod || CAN_user_tools_items_batchdel || CAN_user_tools_records_batchmod || CAN_user_tools_records_batchdel || CAN_user_editcatalogue_records_restore || CAN_user_tools_marc_modification_templates ) %]
 <h3>Chỉnh sửa hàng loạt</h3>
 <ul class="buttons-list">
 [% IF ( CAN_user_tools_items_batchmod ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/batchMod.pl"><i class="fa-solid fa-pencil" aria-hidden="true"></i> Chỉnh sửa bản tài liệu theo lô</a>
 </li>
 [% END %]
 [% IF ( CAN_user_tools_items_batchdel ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/batchMod.pl?del=1"><i class="fa fa-trash-can"></i> Xóa bản tài liệu theo lô</a>
 </li>
 [% END %]
 [% IF CAN_user_tools_records_batchmod %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/batch_record_modification.pl"><i class="fa-solid fa-pencil" aria-hidden="true"></i> Chỉnh sửa biểu ghi theo lô</a>
 </li>
 [% END %]
 [% IF CAN_user_tools_records_batchdel %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/batch_delete_records.pl"><i class="fa fa-trash-can"></i> Xóa biểu ghi theo lô</a>
 </li>
 [% END %]

 [% IF ( CAN_user_tools_marc_modification_templates ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/marc_modification_templates.pl"><i class="fa fa-gear"></i> Mẫu chỉnh sửa biểu ghi MARC</a>
 </li>
 [% END %]
 [% IF ( CAN_user_editcatalogue_records_restore ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/restore-records.pl"><i class="fa fa-undo"></i> Khôi phục biểu ghi đã xóa</a>
 </li>
 [% END %]
 </ul>
 [% END %]

 [% IF ( CAN_user_tools_items_batchmod || ( CAN_user_stockrotation_manage_rotas && Koha.Preference('StockRotation') ) ) %]
 <h3>Tự động hoá</h3>
 <ul class="buttons-list">
 [% IF ( CAN_user_tools_items_batchmod ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/automatic_item_modification_by_age.pl"><i class="fa-solid fa-calendar-days"></i> Chỉnh sửa tự động theo thời gian</a>
 </li>
 [% END %]
 [% IF ( CAN_user_stockrotation_manage_rotas && Koha.Preference('StockRotation') ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/stockrotation.pl"><i class="fa-solid fa-rotate"></i> Luân chuyển kho</a>
 </li>
 [% END %]
 </ul>
 [% END %]
 </div>

 <div class="col-sm-4 col-md-4">
 [% IF ( CAN_user_tools_label_creator || CAN_user_tools_upload_local_cover_images ) %]
 <h3>Công cụ bổ trợ</h3>
 <ul class="buttons-list">
 [% IF ( CAN_user_tools_label_creator ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/labels/label-home.pl"><i class="fa fa-hashtag"></i> Tạo nhãn gáy</a>
 </li>

 <li>
 <a class="circ-button" href="/cgi-bin/koha/labels/barcode-print.pl"><i class="fa fa-barcode"></i> Trình tạo mã vạch</a>
 </li>

 <li>
 <a class="circ-button" href="/cgi-bin/koha/labels/spinelabel-home.pl"><i class="fa fa-hashtag"></i> Tạo nhanh nhãn gáy</a>
 </li>
 [% END %]

 [% IF ( CAN_user_tools_upload_local_cover_images ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/tools/upload-cover-image.pl"><i class="fa fa-upload"></i> Thêm ảnh bìa cho biểu ghi</a>
 </li>
 [% END %]
 </ul>
 [% END %]

 [% IF ( CAN_user_parameters ) %]
 <h3>Quản trị hệ thống</h3>
 <ul class="buttons-list">
 [% IF ( CAN_user_parameters_manage_sysprefs ) %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/admin/preferences.pl?tab=cataloguing"><i class="fa fa-tasks"></i> Tuỳ chọn hệ thống</a>
 </li>
 [% END %]
 <li>
 <a class="circ-button" href="/cgi-bin/koha/admin/admin-home.pl"><i class="fa fa-cogs"></i> Cấu hình</a>
 </li>
 </ul>
 [% END %]
 </div>
 </div>

 [%- SET StaffCataloguingHome = AdditionalContents.get( location => "StaffCataloguingHome", lang => lang, library => Branches.GetLoggedInBranchcode ) -%]
 [%- FOREACH block IN StaffCataloguingHome.content -%]
 <div class="page-section"> [%- block.content | $raw -%] </div>
 [%- END -%]
[% END %]

[% MACRO jsinclude BLOCK %]
 <script nonce="[% Koha.CSPNonce | $raw %]" data-tt-allowed="true">
        $(document).ready(function() {

            $("#newRecord").click(function(){
                var url = $("a#newRecordDefault").prop("href");
                window.location.href = url;
                return false;
            });

            $("#z3950search").click(function(){
                PopupZ3950("Default");
                return false;
            });

            $(".z3950searchFw").click(function(){
                PopupZ3950($(this).prop('id'));
                return false;
            });

            $("#useadvanced").click(function(){
                Cookies.set( "catalogue_editor_[% logged_in_user.borrowernumber | html %]", "advanced", { expires: 365, path: '/', sameSite: 'Lax' } );
                return true;
            });
        });

        /* this function open a popup to search on z3950 server.  */
        function PopupZ3950(fw) {
            var strQuery = GetZ3950Terms(fw);
            if(strQuery){
                window.open("/cgi-bin/koha/cataloguing/z3950_search.pl?biblionumber=[% biblionumber | html %]"+strQuery,"z3950search",'width=800,height=500,location=yes,toolbar=no,scrollbars=yes,resize=yes');
            }
        }

        /* provide Z3950 search points */
        function GetZ3950Terms(fw){
            var strQuery="&frameworkcode=" + fw;
            return strQuery;
        }
    </script>
[% END %]
[% INCLUDE 'intranet-bottom.inc' %]

[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE Branches %]
[% USE KohaDates %]
[% USE Price %]
[% USE Item %]
[% USE TablesSettings %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% t("Items") | html %]
 &rsaquo;
 [% IF ( biblio.author ) %]
 [% tx("{title} by {author}", { title = biblio.title, author = biblio.author }) | html %]
 [% ELSE %]
 [% biblio.title | html %]
 [% END %]
 [% tx("(Record #{biblionumber})", { biblionumber = biblio.biblionumber }) | html %]
 &rsaquo; [% t("Cataloging") | html %] &rsaquo; [% t("Koha") | html %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% Asset.css("css/addbiblio.css") | $raw %]
[% INCLUDE 'datatables.inc' %]
<script nonce="[% Koha.CSPNonce | $raw %]" data-tt-allowed="true">
    var auth_values_creation = [% Koha.Preference('CreateAVFromCataloguing') && CAN_user_parameters_manage_auth_values ? 1 : 0 | html %];
    var has_item_groups = "[% item_groups.size | html %]";
</script>
[% INCLUDE 'select2.inc' %]
[% Asset.js("js/cataloging.js") | $raw %]
[% Asset.js("js/browser.js") | $raw %]
[% INCLUDE 'calendar.inc' %]
[% INCLUDE 'str/cataloging_additem.inc' %]
[% Asset.js("js/cataloging_additem.js") | $raw %]
<style nonce="[% Koha.CSPNonce | $raw %]">
    .flatpickr_wrapper input {
        width: 100%;
    }

    .flatpickr_wrapper {
        flex-basis: 60%;
    }
</style>
</head>

<body id="cat_additem" class="cat">
[% WRAPPER 'header.inc' %]
 [% INCLUDE 'cataloging-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
 [% WRAPPER breadcrumbs %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/cataloguing/cataloging-home.pl">Phân hệ biên mục</a>
 [% END %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/cataloguing/addbiblio.pl?biblionumber=[% biblio.biblionumber | uri %]">
 [% IF ( biblio.author ) %]
 Chỉnh sửa [% biblio.title | html %] - Tác giả [% biblio.author | html %]
 ([% tp('Bibliographic record number', 'Biểu ghi #') | html %] [% biblio.biblionumber | html %])
 [% ELSE %]
 Chỉnh sửa [% biblio.title | html %]
 ([% tp('Bibliographic record number', 'Biểu ghi #') | html %] [% biblio.biblionumber | html %])
 [% END %]
 </a>
 [% END %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 Bản tài liệu
 [% END %]
 [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' wide_full => 1 %]
 [% INCLUDE 'messages.inc' %]
 [% IF item_doesnt_exist %]
 <div class="alert alert-warning">
 <a href="/cgi-bin/koha/cataloguing/additem.pl?biblionumber=[% biblio.biblionumber | uri %]">Thêm bản tài liệu mới</a> hoặc <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% biblio.biblionumber | uri %]#holdings">chuyển tới danh mục lưu giữ biểu ghi</a>.
 </div>
 [% END %]
 <h1>Bản tài liệu của [% biblio.title | html %] [% IF ( biblio.author ) %]- Tác giả: [% biblio.author | html %][% END %] (Biểu ghi #[% biblio.biblionumber | html %])</h1>
 <a id="newitem_jump" href="#f"><i class="fa fa-arrow-down"></i> Chuyển tới biểu mẫu nhập</a>

 [% IF ( onloan_cannot_withdraw ) %]<div class="alert alert-warning"><strong>Lỗi lưu bản tài liệu</strong>: Bản tài liệu đang được mượn, không thể rút khỏi lưu thông.</div>[% END %]
 [% IF ( intransit_cannot_withdraw ) %]<div class="alert alert-warning"><strong>Lỗi lưu bản tài liệu</strong>: Bản tài liệu đang trung chuyển, không thể rút khỏi lưu thông.</div>[% END %]
 [% IF ( barcode_not_unique ) %]<div class="alert alert-warning"><strong>Lỗi lưu bản tài liệu</strong>: Đăng ký cá biệt trên đã tồn tại, bạn vui lòng nhập đăng ký cá biệt khác.</div>[% END %]
 [% IF ( no_next_barcode ) %]<div class="alert alert-warning"><strong>Lỗi lưu nhiều bản tài liệu</strong>: Không thể xác định giá trị của đăng ký cá biệt. Không có bản tài liệu nào được thêm vào.</div>[% END %]
 [% IF ( book_on_loan ) %]<div class="alert alert-warning"><strong>Không thể xóa</strong>: Bản tài liệu đã được ghi mượn.</div>[% END %]
 [% IF ( book_reserved ) %]<div class="alert alert-warning"><strong>Không thể xóa</strong>: Bản tài liệu đang chờ bạn đọc đặt mượn đến lấy.</div>[% END %]
 [% IF ( item_has_holds ) %]<div class="alert alert-warning"><strong>Không thể xóa</strong>: Bản tài liệu đang có bạn đọc đặt mượn.</div>[% END %]
 [% IF ( not_same_branch ) %]<div class="alert alert-warning"><strong>Không thể xóa</strong>: Bản tài liệu này thuộc về thư viện khác.</div>[% END %]
 [% IF ( linked_analytics ) %]
 <div class="alert alert-warning"><strong>Không thể xóa</strong>: Bản tài liệu đã được liên kết tới <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% biblio.biblionumber | uri %]&amp;analyze=1">tài liệu chủ.</a>.</div>
 [% END %]
 [% IF last_item_for_hold %]<div class="alert alert-warning"><strong>Không thể xóa</strong>: Đây là bản tài liệu cuối cùng của biểu ghi có đặt mượn.</div>[% END %]
 [% IF item_not_found %]<div class="alert alert-warning"><strong>Không thể xóa</strong>: Không tìm thấy bản tài liệu.</div>[% END %]

 <div id="cataloguing_additem_itemlist">
 [% IF items %]
 [% SET date_fields = [ 'dateaccessioned', 'onloan', 'datelastseen', 'datelastborrowed', 'replacementpricedate' ] %]
 <div class="page-section">
 <table id="itemst">
 <thead>
 <tr>
 <th class="no-sort">&nbsp;</th>
 [% FOREACH item_header IN item_header_loop %]
 <th data-colname="[% item_header.attribute | html %]"> [% item_header.header_value | html %] </th>
 [% END %]
 </tr>
 </thead>
 <tbody>
 [% FOREACH item IN items %]
 [% SET can_be_edited = ! ( Koha.Preference('IndependentBranches') && ! logged_in_user.is_superlibrarian && item.homebranch != Branches.GetLoggedInBranchname() ) %]
 [% SET tr_class = [] %]
 [% SET tr_title = "" %]
 [% IF item.itemnumber == itemnumber %]
 [% IF op == 'cud-saveitem' %]
 [% tr_class.push('active') %]
 [% tr_title = t("Currently editing") %]
 [% ELSE %]
 [% tr_class.push('previous') %]
 [% tr_title = t("Previously edited") %]
 [% END %]
 [% END %]
 [% IF can_be_edited %]
 [% tr_class.push('editable') %]
 [% END %]
 <tr id="row[% item.itemnumber | html %]" class="[% tr_class.join(' ') | html %]" title="[% tr_title | html %]">
 [% UNLESS can_be_edited %]
 <td>&nbsp;</td>
 [% ELSE %]
 <td>
 <div class="btn-group dropup">
 <a class="btn btn-default btn-xs dropdown-toggle" id="itemactions[% item.itemnumber | html %]" role="button" data-bs-toggle="dropdown" href="#"> Thao tác </a>
 <ul class="dropdown-menu" role="menu" aria-labelledby="itemactions[% item.itemnumber | html %]">
 [% IF item.biblionumber != biblio.biblionumber %]
 [%# Host item %]
 <li
                                                        ><a href="additem.pl?op=edititem&amp;biblionumber=[% item.biblionumber | uri %]&amp;itemnumber=[% item.itemnumber | uri %]#edititem">Sửa trong tài liệu chủ</a> &nbsp;
 <a
                                                            class="delete"
                                                            href="/cgi-bin/koha/cataloguing/additem.pl?op=delinkitem&amp;biblionumber=[% biblio.biblionumber | html %]&amp;hostitemnumber=[% item.itemnumber | html %]&amp;searchid=[% searchid | html %]"
                                                            >Unlink</a
                                                        ></li
                                                    >
 [% ELSE %]
 [% UNLESS item.nomod %]
 <li
                                                            ><a
                                                                class="dropdown-item"
                                                                href="additem.pl?op=edititem&amp;biblionumber=[% biblio.biblionumber | uri %]&amp;itemnumber=[% item.itemnumber | uri %]&amp;searchid=[% searchid | uri %]#edititem"
                                                                >Sửa</a
                                                            ></li
                                                        >
 [% END %]
 <li
                                                        ><a
                                                            class="dropdown-item"
                                                            href="additem.pl?op=dupeitem&amp;biblionumber=[% biblio.biblionumber | uri %]&amp;itemnumber=[% item.itemnumber | uri %]&amp;searchid=[% searchid | uri %]#additema"
                                                            >Sao chép</a
                                                        ></li
                                                    >
 <li class="print_label">
 <a
                                                            class="dropdown-item submit-form-link"
                                                            target="_blank"
                                                            href="#"
                                                            data-op="cud-add"
                                                            data-number_list="[% item.itemnumber | html %]"
                                                            data-number_type="itemnumber"
                                                            data-method="post"
                                                            data-action="/cgi-bin/koha/labels/label-edit-batch.pl"
                                                            data-new_tab="true"
                                                            >In nhãn gáy</a
                                                        >
 </li>
 [% UNLESS item.nomod %]
 <li>
 <form id="[% item.itemnumber | html %]-delete-item-form" action="/cgi-bin/koha/cataloguing/additem.pl" method="post">
 [% INCLUDE 'csrf-token.inc' %]
 <input type="hidden" name="op" value="cud-delitem" />
 <input type="hidden" name="biblionumber" value="[% item.biblionumber | html %]" />
 <input type="hidden" name="itemnumber" value="[% item.itemnumber | html %]" />
 <input type="hidden" name="searchid" value="[% searchid | html %]" />
 <input type="hidden" name="delete-serial-issues" id="[% item.itemnumber | html %]-delete-serial-issues" value="" />
 </form>
 <a class="dropdown-item delete" data-itemnumber="[% item.itemnumber | html %]" data-has-serial-item="[% Item.HasSerialItem(item.itemnumber) | html %]" href="#">Xóa</a>
 </li>
 [% END %]
 [% END %]
 [% IF ( OPACBaseURL ) %]
 <li class="view-in-opac"
                                                        ><a class="dropdown-item" target="_blank" href="[% Koha.Preference('OPACBaseURL') | url %]/cgi-bin/koha/opac-detail.pl?biblionumber=[% item.biblionumber | uri %]">OPAC view</a></li
                                                    >
 [% END %]
 </ul>
 </div>
 </td>
 [% END %]
 [% FOREACH header IN item_header_loop %]
 [% SET attribute = header.attribute %]
 [% SET can_mod = item.nomod ? "nomod" : "canmod" %]
 [% IF attribute AND date_fields.grep('^' _ attribute _ '$').size %]
 [% IF attribute == 'datelastseen' %]
 <td class="[% can_mod | html %]" data-order="[% item.$attribute | html %]">[% item.$attribute | $KohaDates with_hours => 1 %]</td>
 [% ELSE %]
 <td class="[% can_mod | html %]" data-order="[% item.$attribute | html %]">[% item.$attribute | $KohaDates %]</td>
 [% END %]
 [% ELSIF ( item.$attribute && ( attribute == 'price' || attribute == 'replacementprice' ) ) %]
 <td class="[% can_mod | html %]" data-order="[% item.$attribute | html %]">[% item.$attribute | $Price %]</td>
 [% ELSIF item.$attribute && attribute == 'itemcallnumber' %]
 <td class="[% can_mod | html %]" data-order="[% item.cn_sort | html %]">[% item.$attribute | html %]</td>
 [% ELSE %]
 <td class="[% can_mod | html %]">[% item.$attribute | html %]</td>
 [% END %]
 [% END %]
 </tr>
 [% END %]
 </tbody>
 </table>
 </div>
 <!-- /.page-section -->
 [% END %]

 <div class="row">
 <div class="col-md-2 order-sm-2 order-md-1"> [% INCLUDE 'biblio-view-menu.inc' %] </div>
 <div class="col-md-10 order-md-2 order-sm-1">
 <div id="cataloguing_additem_newitem" class="item_edit_form page-section marc_editor">
 <form id="f" method="post" action="/cgi-bin/koha/cataloguing/additem.pl?biblionumber=[% biblio.biblionumber | html %]" name="f">
 [% INCLUDE 'csrf-token.inc' %]
 <input type="hidden" name="op" value="[% op | html %]" />
 [% IF (popup) %]
 <input type="hidden" name="popup" value="1" />
 [% END %]
 <input type="hidden" name="biblionumber" value="[% biblio.biblionumber | html %]" />
 [% IF op != 'cud-saveitem' %]
 <h2 id="additema">Tạo bản tài liệu [% IF (circborrowernumber) %]<em>(biên mục nhanh)</em>[% END %]</h2>
 [% ELSE %]
 <h2 id="edititem">Chỉnh sửa bản tài liệu #[% itemnumber | html %][% IF ( barcode ) %] / Đăng ký cá biệt: [% barcode | html %][% END %]</h2>
 [% END %]

 [% IF item_templates.owned.count || item_templates.shared.count %]
 <div id="item-template-toolbar" class="btn-toolbar">
 <select name="template_id" id="template_id" class="select2" style="width: 20em">
 <option value="0" selected="selected">Không sử dụng mẫu</option>
 <optgroup label="Mẫu của tôi">
 [% FOREACH t IN item_templates.owned %]
 [% IF t.id == template_id %]
 <option data-editor="1" value="[% t.id | html %]" selected="selected">[% t.name | html %][% IF t.is_shared %](dùng chung)[% END %]</option>
 [% ELSE %]
 <option data-editor="1" value="[% t.id | html %]">[% t.name | html %][% IF t.is_shared %](dùng chung)[% END %]</option>
 [% END %]
 [% END %]
 </optgroup>
 <optgroup label="Mẫu dùng chung">
 [% FOREACH t IN item_templates.shared %]
 [% IF t.id == template_id %]
 [% IF CAN_user_editcatalogue_manage_item_editor_templates %]
 <option data-editor="1" value="[% t.id | html %]" selected="selected">[% t.name | html %]</option>
 [% ELSE %]
 <option data-editor="0" value="[% t.id | html %]" selected="selected">[% t.name | html %]</option>
 [% END %]
 [% ELSE %]
 [% IF CAN_user_editcatalogue_manage_item_editor_templates %]
 <option data-editor="1" value="[% t.id | html %]">[% t.name | html %]</option>
 [% ELSE %]
 <option data-editor="0" value="[% t.id | html %]">[% t.name | html %]</option>
 [% END %]
 [% END %]
 [% END %]
 </optgroup>
 </select>
 <button class="btn btn-default" type="submit" id="load_template_submit" name="load_template_submit" value="1"><i class="fa-solid fa-table-list"></i> Áp dụng mẫu</button>
 <div>
 <label for="use_template_for_session">
 [% IF use_template_for_session %]
 <input type="checkbox" id="use_template_for_session" name="use_template_for_session" checked="checked" />
 [% ELSE %]
 <input type="checkbox" id="use_template_for_session" name="use_template_for_session" />
 [% END %]
 Ghi nhớ cho phiên làm việc
 </label>
 </div>

 <button class="btn btn-default" ype="submit" id="unload_template_submit" name="unload_template_submit" value="1"><i class="fa fa-eraser"></i> Xóa mẫu</button>
 <button class="btn btn-default" type="submit" id="delete_template_submit" name="delete_template_submit" value="1" disabled><i class="fa fa-trash-can"></i> Xóa mẫu này</button>
 </div>
 [% END %]

 <fieldset class="rows"> [% PROCESS subfields_for_item subfields => subfields %] </fieldset>
 [% IF op != 'cud-additem' %]
 <input type="hidden" name="itemnumber" value="[% itemnumber | html %]" />
 [% END %]

 [% IF item_groups.size && op != 'cud-saveitem' && CAN_user_editcatalogue_manage_item_groups %]
 <fieldset class="rows">
 <legend><i class="fa fa-plus"></i> Thêm vào nhóm bản tài liệu</legend>
 [% FOREACH ig IN item_groups %]
 <input type="hidden" id="item-group-[% ig.id | html %]" value="[% ig.description | html %]" />
 [% END %]
 <ol>
 <li>
 <label for="select_item_group">Tùy chọn: </label>
 <select name="item_group" id="item-group-add-or-create-form-select">
 <optgroup label="Sử dụng nhóm có sẵn">
 [% FOREACH ig IN biblio.item_groups.search({}, {order_by => 'display_order'}) %]
 <option value="[% ig.id | html %]">[% ig.description | html %]</option>
 [% END %]
 </optgroup>
 <optgroup label="Tùy chọn khác">
 <option id="item-group-add-or-create-form-no-add" value="">Không thêm vào nhóm</option>
 <option value="create">Tạo nhóm bản tài liệu mới</option>
 </optgroup>
 </select>
 </li>
 <div id="item-group-add-or-create-form-description-block">
 <li>
 <label for="item_group_description" class="required">Tên nhóm: </label>
 <input name="item_group_description" id="item-group-add-or-create-form-description" type="text" size="30" class="required" />
 <span class="required">Bắt buộc</span>
 </li>
 <li>
 <label for="item_group_display_order">Thứ tự hiển thị: </label>
 <input name="item_group_display_order" id="item_group_display_order" type="text" pattern="\d*" size="30" />
 <div class="hint">Thứ tự hiển thị phải là số</div>
 </li>
 </div>
 </ol>
 </fieldset>
 [% END %]

 <fieldset class="action">
 [% IF op != 'cud-saveitem' %]
 <input type="submit" name="phony_submit" value="phony_submit" id="phony_submit" style="display:none;" onclick="return false;" />
 <!-- Note:
 We use here a false submit button because we have several submit buttons and we do not want the user to believe they validated the adding of multiple items
 when pressing the enter key, while in fact it is the first submit button that is validated, in our case the "add (single) item" button.
 It is a bit tricky, but necessary in the sake of UI correctness.
 -->
 <span id="addsingle">
 <input name="add_submit" onclick="return Check(this.form)" type="submit" value="Tạo bản tài liệu" />
 <input type="submit" name="add_duplicate_submit" value="Tạo bản và nhân bản" onclick="return Check(this.form)" />
 </span>
 <span id="addmultiple">
 <input type="button" name="add_multiple_copies" id="add_multiple_copies" value="Thêm nhiều bản sao của tài liệu này" />
 </span>
 <fieldset id="add_multiple_copies_span">
 <label for="number_of_copies">Số lượng bản sao cần thêm: </label>
 <input type="text" id="number_of_copies" name="number_of_copies" value="" size="2" maxlength="3" />
 <input id="add_multiple_copies_submit" name="add_multiple_copies_submit" onclick="javascript:return Check(this.form) && CheckMultipleAdd(this.form.number_of_copies.value);" type="submit" value="Thêm" />
 <a href="#" id="cancel_add_multiple" class="cancel">Hủy bỏ</a>
 <div class="hint"><p>Tối đa thêm 1000 bản. Đăng ký cá biệt (Mã vạch) bạn nhập sẽ tự động tăng dần cho các bản tài liệu tiếp theo.</p></div>
 </fieldset>

 <span id="savetemplate">
 <input type="button" name="save_as_template" id="save_as_template" value="Lưu thành mẫu (Template)" />
 </span>
 <fieldset id="save_as_template_span">
 <legend>Lưu mẫu nhập</legend>
 <div class="btn-group">
 <select name="replace_template_id" id="replace_template_id" class="select2" style="width: 20em">
 <option value="0" selected="selected">Lưu thành mẫu mới</option>
 <optgroup label="Cập nhật mẫu hiện có">
 [% FOREACH t IN item_templates.owned %]
 <option data-editor="1" data-shared="[% t.is_shared | html %]" value="[% t.id | html %]">[% t.name | html %][% IF t.is_shared %](dùng chung)[% END %]</option>
 [% END %]
 [% IF CAN_user_editcatalogue_manage_item_editor_templates && item_templates.shared.count %]
 <optgroup label="Cập nhật mẫu dùng chung">
 [% FOREACH t IN item_templates.shared %]
 <option data-editor="1" data-shared="1" value="[% t.id | html %]">[% t.name | html %][% IF t.is_shared %](dùng chung)[% END %]</option>
 [% END %]
 </optgroup>
 [% END %]
 </optgroup>
 </select>
 </div>

 <div class="btn-group">
 <span id="template_name_block">
 <label for="template_name" class="required">Tên mẫu: </label>
 <input type="text" id="template_name" name="template_name" class="required" />
 <span class="required">Bắt buộc</span>
 </span>
 </div>

 <div class="btn-group">
 <label for="template_is_shared">
 <input type="checkbox" id="template_is_shared" name="template_is_shared" />
 Chia sẻ mẫu này
 </label>
 </div>

 <div class="btn-group">
 <input id="save_as_template_submit" name="save_as_template_submit" onclick="javascript:return CheckTemplateForm(this.form);" type="submit" value="Lưu" />
 <a href="#" id="cancel_save_as_template" class="cancel">Hủy bỏ</a>
 </div>
 </fieldset>
 [% ELSE %]
 [% IF op != 'add_item' %]
 <input type="hidden" name="itemnumber" value="[% itemnumber | html %]" />
 [% END %]
 [% IF Item.HasSerialItem(itemnumber) == 0 %]
 <input onclick="return Check(this.form)" type="submit" value="Lưu thay đổi" />
 [% ELSE %]
 <input class="submit" onclick="return ShowSerialEditingConfirmation(this.form)" type="button" value="Lưu thay đổi" />
 <input type="hidden" name="edit-serial-issue" id="edit-serial-issue" value />
 [% END %]
 <input type="button" id="addnewitem" value="Thêm bản tài liệu mới" />
 <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% biblio.biblionumber | uri %]">Hủy bỏ</a>
 [% END %]</fieldset
                        >

 [%# Fields for fast cataloging %]
 <input type="hidden" name="circborrowernumber" value="[% circborrowernumber | html %]" />
 <input type="hidden" name="stickyduedate" value="[% stickyduedate | html %]" />
 <input type="hidden" name="barcode" value="[% barcode | html %]" />
 <input type="hidden" name="duedatespec" value="[% duedatespec | html %]" />
 [%# End fields for fast cataloging %]

 [% INCLUDE 'modals/edit_serial_issues.inc' %]
 </form>

 [% INCLUDE 'modals/cataloguing_create_av.inc' %]

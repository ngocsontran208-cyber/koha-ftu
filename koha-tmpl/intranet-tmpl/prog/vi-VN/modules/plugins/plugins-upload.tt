[% USE raw %]
[% USE Koha %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% t("Upload plugin") | html %]
 &rsaquo; [% t("Plugins") | html %] &rsaquo; [% t("Koha") | html %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="plugins_plugins_upload" class="plugins">
[% WRAPPER 'header.inc' %]
 [% INCLUDE 'prefs-admin-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
 [% WRAPPER breadcrumbs %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/plugins/plugins-home.pl">Tính năng bổ trợ</a>
 [% END %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Upload plugin</span>
 [% END %]
 [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' %]
 <h1>Upload plugin</h1>
 [% IF ( ERRORS ) %]
 <div class="alert alert-warning">
 [% FOREACH ERROR IN ERRORS %]
 [% IF ( ERROR.NOTKPZ ) %]
 <li><strong>The upload file does not appear to be a kpz file. The extension is not '.kpz'.</strong></li>
 [% ELSIF ( ERROR.NOWRITETEMP ) %]
 <li><strong>Bộ cài không thể khởi tạo/ghi dữ liệu cần thiết vào thư mục tạm thời.</strong></li>
 [% ELSIF ( ERROR.EMPTYUPLOAD ) %]
 <li><strong>Tệp tin tải lên không có dữ liệu.</strong></li>
 [% ELSIF ( ERROR.UZIPFAIL ) %]
 <li
                        ><strong>[% ERROR.UZIPFAIL | html %] có lỗi khi giải nén tệp tin.<br />Xin hãy kiểm tra lại tính đồng nhất của tệp tin nén và thử lại.</strong></li
                    >
 [% ELSIF ( ERROR.NOWRITEPLUGINS ) %]
 <li
                        ><strong>Không thể ghi dữ liệu vào thư mục bổ trợ.<br />Xin hãy kiểm tra và chắc chắn rằng người sử dụng Apache có quyền được ghi vào thư mục bổ trợ.</strong></li
                    >
 [% ELSIF ( ERROR.RESTRICTED ) %]
 <li
                        ><strong>Cannot install plugin from unknown source whilst plugins_restricted is enabled.<br /></strong
                    ></li>
 [% ELSE %]
 <li
                        ><strong>[% ERROR.CORERR | html %] Một lỗi không xác định đã xảy ra.<br />Bạn vui lòng kiểm tra lại nhật ký lỗi hệ thống để có thông tin chi tiết.</strong></li
                    >
 [% END %]
 [% END %]
 </div>
 [% END %]
 [% IF ( !plugins_restart ) %]
 <div class="alert alert-warning">
 <strong>Your system is not configured to automatically refresh on plugin upload, you may need to ask your administrator to complete the plugin installation.</strong>
 </div>
 [% END %]
 <form method="post" action="/cgi-bin/koha/plugins/plugins-upload.pl" enctype="multipart/form-data">
 [% INCLUDE 'csrf-token.inc' %]
 <fieldset class="brief">
 <div class="hint"><strong>Chú ý:</strong> Chỉ có file định dạng KPZ được hỗ trợ.</div>
 <ol>
 <li> <label for="uploadfile">Chọn tệp tin tải lên:  </label><input type="file" id="uploadfile" name="uploadfile" accept=".kpz" /> </li>
 </ol>
 </fieldset>
 <fieldset class="action">
 <input type="hidden" name="op" value="cud-Upload" />
 <input class="btn btn-primary" type="submit" value="Tải lên" />
 </fieldset>
 </form>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]

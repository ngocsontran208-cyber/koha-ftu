[% USE raw %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% t("Sending your cart") | html %]
 &rsaquo; [% t("Koha") | html %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="cart_sendbasketform" class="cart">
<div class="container"
    >[% IF ( email_add ) %]

 [% IF ( SENT ) %]
 <div class="alert alert-info">
 <h1>Gửi tin nhắn cho bạn đọc</h1>
 <p>Thông tin giỏ tài liệu của bạn được gửi tới hòm thư: [% email_add | html %]</p>
 </div>
 [% END %]
 [% IF ( error ) %]
 <div class="alert alert-warning">Quá trình gửi giỏ tài liệu của bạn bị lỗi...</div>
 [% END %]

 <nav class="navbar navbar-default fixed-bottom">
 <div class="container-fluid">
 <fieldset class="action">
 <button type="button" class="btn btn-default close_window focus">Đóng</button>
 </fieldset>
 </div>
 </nav>
 [% ELSE %]

 [% INCLUDE 'blocking_errors.inc' %]
 <form action="/cgi-bin/koha/basket/sendbasket.pl" method="post">
 <h1>Gửi giỏ tài liệu của bạn</h1>
 <fieldset class="rows">
 <legend class="visually-hidden">Enter message details</legend>
 <ol>
 <li>
 <label for="email_add">Địa chỉ Email:</label>
 <input type="text" id="email_add" name="email_add" size="43" class="focus" />
 </li>
 <li>
 <label for="comment">Bình luận:</label>
 <textarea id="comment" name="comment" rows="4" cols="40"></textarea>
 </li>
 </ol>
 </fieldset>
 <input type="hidden" name="bib_list" value="[% bib_list | html %]" />
 [% INCLUDE 'csrf-token.inc' %]

 <nav class="navbar navbar-default fixed-bottom">
 <div class="container-fluid">
 <fieldset class="action">
 <input type="hidden" name="op" value="cud-send" />
 <input class="btn btn-primary" type="submit" value="Gửi" />
 <button type="button" class="btn btn-default close_window">Hủy bỏ</button>
 </fieldset>
 </div>
 </nav>
 </form>
 [% END %]</div
>
</body>
<!-- prettier-ignore-start -->
</html>
<!--prettier-ignore-end -->

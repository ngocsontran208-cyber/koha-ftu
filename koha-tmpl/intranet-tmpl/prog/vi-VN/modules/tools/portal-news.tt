    var sortInput = document.getElementById('modal_banner_sort_order');
    if (sortInput) sortInput.value = '[% next_banner_order || 1 %]';
    var excerptInput = document.getElementById('modal_banner_excerpt');
    if (excerptInput) excerptInput.value = '';
    var imageInput = document.getElementById('modal_banner_image');
    if (imageInput) imageInput.value = '/opac-tmpl/bootstrap/images/ftu-library-hero.jpg';
    var linkInput = document.getElementById('modal_banner_link');
    if (linkInput) linkInput.value = '/cgi-bin/koha/opac-search.pl';
    var statusSelect = document.getElementById('modal_banner_status');
    if (statusSelect) statusSelect.value = 'published';
    var showTextCheckbox = document.getElementById('modal_banner_show_text');
    if (showTextCheckbox) showTextCheckbox.checked = false; // Mặc định không che chữ để tôn vinh banner thiết kế 1160x400
    
    updateBannerModalPreview('/opac-tmpl/bootstrap/images/ftu-library-hero.jpg');
    
    var label = document.getElementById('bannerModalLabel');
    if (label) label.innerHTML = '<i class="fa fa-picture-o"></i> Thêm Banner mới (Chuẩn 1160px × 400px)';
    
    showBannerModal();
}

function openEditBannerModal(btn, id) {
    if (!id && btn && btn.dataset && btn.dataset.id) {
        id = btn.dataset.id;
    }
    
    var data = null;
    if (btn && btn.dataset && btn.dataset.title) {
        data = {
            id: id,
            title: btn.dataset.title || '',
            sort_order: btn.dataset.order || 1,
            classification: btn.dataset.tag || '',
            excerpt: btn.dataset.excerpt || '',
            featured_image: btn.dataset.image || '',
            support_link: btn.dataset.link || '',
            content: btn.dataset.content || '',
            status: btn.dataset.status || 'published'
        };
    } else {
        var rowBtn = document.getElementById('btn-edit-banner-' + id);
        if (rowBtn && rowBtn.dataset && rowBtn.dataset.title) {
            data = {
                id: id,
                title: rowBtn.dataset.title || '',
                sort_order: rowBtn.dataset.order || 1,
                classification: rowBtn.dataset.tag || '',
                excerpt: rowBtn.dataset.excerpt || '',
                featured_image: rowBtn.dataset.image || '',
                support_link: rowBtn.dataset.link || '',
                content: rowBtn.dataset.content || '',
                status: rowBtn.dataset.status || 'published'
            };
        }
    }
    
    if (data && data.title) {
        fillAndShowBannerModal(data);
    } else {
        if (window.jQuery && jQuery.getJSON) {
            $.getJSON('/cgi-bin/koha/tools/portal-news.pl', { op: 'get_banner', id: id }, function(res) {
                if (res && res.id) {
                    fillAndShowBannerModal(res);
                } else {
                    window.location.href = '/cgi-bin/koha/tools/portal-news.pl?op=edit_form&id=' + id + '&section=banner';
                }
            }).fail(function() {
                window.location.href = '/cgi-bin/koha/tools/portal-news.pl?op=edit_form&id=' + id + '&section=banner';
            });
        } else {
            window.location.href = '/cgi-bin/koha/tools/portal-news.pl?op=edit_form&id=' + id + '&section=banner';
        }
    }
}

function fillAndShowBannerModal(data) {
    if (!data) return;
    var idInput = document.getElementById('modal_banner_id');
    if (idInput) idInput.value = data.id || '0';
    var titleInput = document.getElementById('modal_banner_title');
    if (titleInput) titleInput.value = data.title || '';
    var tagInput = document.getElementById('modal_banner_tag');
    if (tagInput) tagInput.value = data.classification || '';
    var sortInput = document.getElementById('modal_banner_sort_order');
    if (sortInput) sortInput.value = data.sort_order || 1;
    var excerptInput = document.getElementById('modal_banner_excerpt');
    if (excerptInput) excerptInput.value = data.excerpt || '';
    var imageInput = document.getElementById('modal_banner_image');
    if (imageInput) imageInput.value = data.featured_image || '';
    var linkInput = document.getElementById('modal_banner_link');
    if (linkInput) linkInput.value = data.support_link || data.event_reg_link || '';
    var statusSelect = document.getElementById('modal_banner_status');
    if (statusSelect) statusSelect.value = data.status || 'published';
    var showTextCheckbox = document.getElementById('modal_banner_show_text');
    if (showTextCheckbox) showTextCheckbox.checked = (data.content === 'show_text');
    
    updateBannerModalPreview(data.featured_image || '');
    
    var label = document.getElementById('bannerModalLabel');
    if (label) label.innerHTML = '<i class="fa fa-picture-o"></i> Chỉnh sửa Banner #' + data.id + ' - ' + (data.title || '');
    
    showBannerModal();
}

function updateBannerModalPreview(url) {
    var img = document.getElementById('modal_banner_preview_img');
    if (!img) return;
    if (url && url.trim()) {
        img.src = url.trim();
        img.style.display = 'block';
    } else {
        img.src = '/opac-tmpl/bootstrap/images/ftu-library-hero.jpg';
    }
}

function handleBannerFileUpload(input) {
    if (!input || !input.files || !input.files[0]) return;
    var file = input.files[0];
    if (!file.type.match(/^image\//)) {
        alert("Vui lòng chọn một tệp hình ảnh (JPG, PNG, WebP)!");
        return;
    }
    
    var spin = document.getElementById('modal_banner_uploading');
    if (spin) spin.style.display = 'inline-block';
    
    var reader = new FileReader();
    reader.onload = function(e) {
        var base64Raw = e.target.result;
        resizeImageCanvas(base64Raw, 1920, 0.88, function(optimizedBase64) {
            updateBannerModalPreview(optimizedBase64);
            var imageInput = document.getElementById('modal_banner_image');
            if (imageInput) imageInput.value = optimizedBase64;
            
            var csrf = $('input[name="csrf_token"]').val() || $('meta[name="csrf-token"]').attr('content') || '';
            $.ajax({
                url: '/cgi-bin/koha/tools/portal-news.pl',
                type: 'POST',
                data: {
                    op: 'cud-upload_image',
                    csrf_token: csrf,
                    base64_data: optimizedBase64,
                    file_name: file.name
                },
                dataType: 'json',
                success: function(res) {
                    if (spin) spin.style.display = 'none';
                    if (res && res.success && res.url) {
                        if (imageInput) imageInput.value = res.url;
                        updateBannerModalPreview(res.url);
                    }
                },
                error: function() {
                    if (spin) spin.style.display = 'none';
                }
            });
        });
    };
    reader.readAsDataURL(file);
}
</script>
[% END %]


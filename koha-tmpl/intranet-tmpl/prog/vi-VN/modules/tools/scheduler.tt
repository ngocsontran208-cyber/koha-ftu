[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
 [% t("Task scheduler") | html %]
 &rsaquo; [% t("Tools") | html %] &rsaquo; [% t("Koha") | html %]
 [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="tools_scheduler" class="tools">
[% WRAPPER 'header.inc' %]
 [% INCLUDE 'circ-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
 [% WRAPPER breadcrumbs %]
 [% WRAPPER breadcrumb_item %]
 <a href="/cgi-bin/koha/tools/tools-home.pl">Công cụ bổ trợ</a>
 [% END %]
 [% WRAPPER breadcrumb_item bc_active= 1 %]
 <span>Lập lịch báo cáo</span>
 [% END %]
 [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' asides=['tools-menu', 'guided-reports-view.inc'] %]
 <h1>Lập lịch báo cáo</h1>

 [% IF ( job_add_failed ) %]
 <div class="alert alert-info">Bị lỗi khi tạo lịch báo cáo</div>
 [% END %]

 <form name="form1" action="scheduler.pl" method="post" class="validated">
 [% INCLUDE 'csrf-token.inc' %]
 <input type="hidden" name="op" value="cud-add" />

 <fieldset class="rows">
 <legend>Lập lịch báo cáo</legend
            ><ol>
 <li><span class="label">Thời gian hiện tại:</span> [% time | html %]</li>
 <li
                    ><label for="starttime" class="required">Thời gian chạy báo cáo:</label>
 <input type="text" name="starttime" id="starttime" value="" maxlength="5" size="5" placeholder="HH:MM" class="required" required />
 <span class="required">Bắt buộc</span>
 <div class="hint">Enter time in 24 hour format: HH:MM</div>
 </li>
 <li>
 <label for="startdate" class="required">Ngày chạy báo cáo: </label>
 <input type="text" size="10" id="startdate" name="startdate" class="flatpickr" data-flatpickr-futuredate="true" value="" />
 <div class="hint">[% INCLUDE 'date-format.inc' %]</div>
 </li>
 <li
                    ><label for="report">Loại báo cáo:</label>
 <select name="report" id="report">
 [% FOREACH savedreport IN savedreports %]
 [% IF ( savedreport.selected ) %]
 <option value="[% savedreport.id | html %]" selected="selected">[% savedreport.report_name | html %]</option>
 [% ELSE %]
 <option value="[% savedreport.id | html %]">[% savedreport.report_name | html %]</option>
 [% END %]
 [% END %]
 </select>
 </li>
 <li>
 <label for="format">Đinh dạng báo cáo:</label>
 <select name="format" id="format">
 <option value="text">Text (TSV)</option>
 <option value="csv">CSV</option>
 <option value="html">HTML</option>
 </select>
 </li>
 <li
                    ><label for="email" class="required">Email:</label>

 <input type="email" class="required" name="email" id="email" size="50" />
 <span class="required">Bắt buộc</span>
 </li>
 </ol></fieldset
        >
 <fieldset class="action"><input class="btn btn-primary" type="submit" value="Lưu" /></fieldset>
 </form>

 [% IF ( JOBS ) %]
 <h2>Scheduled tasks</h2>
 <div class="page-section">
 <table>
 <thead>
 <tr>
 <th>Ngày/Giờ</th>
 <th>Thao tác</th>
 <th>&nbsp;</th>
 </tr>
 </thead>
 <tbody>
 [% FOREACH JOB IN JOBS %]
 <tr>
 <td>[% JOB.TIME | html %]</td>
 <td>[% JOB.TAG | html %]</td>
 <td>
 <form action="scheduler.pl" method="post">
 [% INCLUDE 'csrf-token.inc' %]
 <input type="hidden" name="op" value="cud-delete" />
 <input type="hidden" name="jobid" value="[% JOB.JOBID | html %]" />
 <button type="submit" name="delete" class="btn btn-xs btn-default"><i class="fa fa-trash-can"></i> Xóa</button>
 </form>
 </td>
 </tr>
 [% END %]
 </tbody>
 </table>
 </div>
 <!-- /.page-section -->
 [% END %]
[% END %]

[% MACRO jsinclude BLOCK %]
 [% Asset.js("js/tools-menu.js") | $raw %]
 [% INCLUDE 'calendar.inc' %]
 <script nonce="[% Koha.CSPNonce | $raw %]">
        $(document).ready(function () {
            $("#starttime").on("blur", function () {
                var time = $(this).val();
                if (/^\d:\d{2}$/.test(time)) {
                    $(this).val("0" + time);
                }
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]

[% USE raw %]
[% USE Koha %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% FILTER collapse %]
    Quản trị hệ thống &rsaquo; Koha
[% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
body#admin_admin-home { background-color: #f8fafc; }
body#admin_admin-home .main.container-fluid {
    width: 100% !important; max-width: 100% !important;
    margin: 0 !important; padding: 20px 32px 48px 32px !important;
    background-color: #f8fafc; box-sizing: border-box;
}
body#admin_admin-home .main.container-fluid > .row > div {
    width: 100% !important; max-width: 100% !important; flex: 0 0 100% !important; padding: 0 !important;
}
.ftu-adm-header {
    background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 14px 24px; margin-bottom: 20px;
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
}
.ftu-adm-header h1 { font-size: 20px; font-weight: 700; color: #0f172a; margin: 0; border: none !important; padding: 0 !important; }
.ftu-adm-controls { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.ftu-adm-pref-form { display: flex; align-items: center; gap: 6px; margin: 0; }
.ftu-adm-input {
    width: 220px; padding: 7px 12px; border: 1px solid #cbd5e1; border-radius: 8px;
    font-size: 13px; color: #1e293b; background: #f8fafc;
}
.ftu-adm-input:focus { outline: none; border-color: #8B1E1E; background: #ffffff; }
.ftu-adm-btn {
    background: #8B1E1E; color: #ffffff; border: 1px solid #8B1E1E; border-radius: 8px;
    padding: 7px 14px; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none;
}
.ftu-adm-btn:hover { background: #731818; color: #ffffff; text-decoration: none; }
.ftu-adm-card {
    background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 20px; height: 100%; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
}
.ftu-adm-card h3 {
    font-size: 15px; font-weight: 700; color: #0f172a;
    margin: 0 0 14px 0; padding-bottom: 12px; border-bottom: 2px solid #f1f5f9;
}
.ftu-adm-group {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: #64748b; margin: 14px 0 6px 0;
}
.ftu-adm-group:first-of-type { margin-top: 0; }
.ftu-adm-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
.ftu-adm-list li { margin: 0; padding: 0; }
.ftu-adm-link {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;
    font-size: 13px; font-weight: 500; color: #334155; text-decoration: none;
    transition: all 0.15s ease;
}
.ftu-adm-link:hover {
    background: #fef2f2; border-color: #fecaca; color: #8B1E1E; text-decoration: none;
}
</style>
</head>
<body id="admin_admin-home" class="admin">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'prefs-admin-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Quản trị hệ thống</span>
        [% END %]
    [% END %]
[% END %]

[% WRAPPER 'main-container.inc' wide_full => 1 %]
    <div class="ftu-adm-header">
        <h1>Quản trị hệ thống</h1>
        <div class="ftu-adm-controls">
            [% IF ( CAN_user_parameters_manage_sysprefs ) %]
            <form action="/cgi-bin/koha/admin/preferences.pl" method="get" class="ftu-adm-pref-form">
                <input type="hidden" name="op" value="search" />
                <input type="text" name="searchfield" class="ftu-adm-input" value="[% searchfield | html %]" placeholder="Tìm tùy chọn hệ thống (SysPref)..." />
                <input type="submit" name="ok" class="ftu-adm-btn" value="Tìm SysPref" />
            </form>
            [% END %]
            <input type="search" id="ftu-adm-filter" class="ftu-adm-input" placeholder="Lọc danh mục cấu hình..." autocomplete="off" />
        </div>
    </div>

    <div class="row g-4" id="ftu-adm-grid">
        <!-- CỘT 1: THAM SỐ CƠ BẢN & LƯU THÔNG -->
        <div class="col-12 col-lg-4 col-md-6">
            <div class="ftu-adm-card">
                <h3>Cơ bản &amp; Lưu thông</h3>

                [% IF ( CAN_user_parameters_manage_libraries || CAN_user_parameters_manage_itemtypes || CAN_user_parameters_manage_auth_values || CAN_user_parameters_manage_sysprefs ) %]
                <div class="ftu-adm-group">Tham số cơ bản</div>
                <ul class="ftu-adm-list">
                    [% IF ( CAN_user_parameters_manage_sysprefs ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/preferences.pl" title="Toàn bộ tùy chỉnh hệ thống Koha"><span>Tùy chỉnh hệ thống (SysPrefs)</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_libraries ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/branches.pl" title="Khai báo thư viện và chi nhánh"><span>Thư viện &amp; Chi nhánh</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/library_groups.pl" title="Nhóm thư viện phân cấp"><span>Nhóm thư viện</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_itemtypes ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/itemtypes.pl" title="Định nghĩa loại tài liệu"><span>Loại tài liệu</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_auth_values ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/collections.pl" title="Quản lý bộ sưu tập chuyên đề CCODE"><span>Bộ sưu tập (CCODE)</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/warehouses.pl" title="Quản lý kho vật lý LOC và quy tắc mượn"><span>Kho lưu trữ (LOC)</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/authorised_values.pl" title="Danh mục giá trị chuẩn"><span>Giá trị được phép</span></a></li>
                    [% END %]
                </ul>
                [% END %]

                [% IF ( CAN_user_parameters_manage_patron_categories || CAN_user_parameters_manage_circ_rules || CAN_user_parameters_manage_patron_attributes || CAN_user_parameters_manage_transfers || CAN_user_parameters_manage_item_circ_alerts || CAN_user_parameters_manage_cities || CAN_user_parameters_manage_curbside_pickups ) %]
                <div class="ftu-adm-group">Bạn đọc &amp; Mượn trả</div>
                <ul class="ftu-adm-list">
                    [% IF ( CAN_user_parameters_manage_patron_categories ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/categories.pl" title="Phân nhóm bạn đọc"><span>Nhóm bạn đọc</span></a></li>
                    [% END %]
                    [% IF CAN_user_parameters_manage_circ_rules %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/smart-rules.pl" title="Quy tắc mượn trả và phí phạt"><span>Quy tắc lưu thông &amp; Phạt</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_patron_attributes ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/patron-attr-types.pl" title="Thuộc tính mở rộng của bạn đọc (Khoa, Khóa...)"><span>Thuộc tính bạn đọc</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_patron_restrictions ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/restrictions.pl"><span>Loại hạn chế thẻ</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_item_circ_alerts ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/item_circulation_alerts.pl"><span>Cảnh báo mượn trả</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_transfers ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/branch_transfer_limits.pl"><span>Giới hạn luân chuyển kho</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/transport-cost-matrix.pl"><span>Ma trận chi phí vận chuyển</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/float_limits.pl"><span>Giới hạn lưu động</span></a></li>
                    [% END %]
                    [% IF ( Koha.Preference('UseCirculationDesks') && CAN_user_parameters_manage_libraries ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/desks.pl"><span>Quầy phục vụ</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_cities ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/cities.pl"><span>Tỉnh / Thành phố</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_curbside_pickups ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/curbside_pickup.pl"><span>Nhận sách tại điểm hẹn</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_sip2 ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/sip2/sip2.pl"><span>Tự phục vụ (SIP2)</span></a></li>
                    [% END %]
                </ul>
                [% END %]
            </div>
        </div>

        <!-- CỘT 2: BIÊN MỤC & TRA CỨU -->
        <div class="col-12 col-lg-4 col-md-6">
            <div class="ftu-adm-card">
                <h3>Biên mục &amp; Tra cứu</h3>

                [% IF ( CAN_user_parameters_manage_marc_frameworks || CAN_user_parameters_manage_classifications || CAN_user_parameters_manage_matching_rules || CAN_user_parameters_manage_oai_sets || CAN_user_parameters_manage_item_search_fields || CAN_user_parameters_manage_search_engine_config || CAN_user_parameters_manage_marc_overlay_rules || ( Koha.Preference('SavedSearchFilters') && ( CAN_user_parameters_manage_search_filters ) ) ) %]
                <div class="ftu-adm-group">Cấu trúc MARC21</div>
                <ul class="ftu-adm-list">
                    [% IF ( CAN_user_parameters_manage_marc_frameworks ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/biblio_framework.pl" title="Khung mẫu biên mục MARC21"><span>Khung biên mục MARC</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/koha2marclinks.pl" title="Ánh xạ cơ sở dữ liệu Koha sang MARC"><span>Ánh xạ Koha – MARC</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/checkmarc.pl" title="Kiểm tra lỗi cấu trúc khung MARC"><span>Kiểm tra khung MARC</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/authtypes.pl" title="Khung mẫu biểu ghi nhất quán (Authority)"><span>Khung từ chuẩn (Authority)</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_classifications ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/classsources.pl" title="Nguồn phân loại DDC/LCC và quy tắc xếp giá"><span>Khung phân loại &amp; Xếp giá</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_matching_rules ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/matching-rules.pl" title="Quy tắc kiểm tra trùng biểu ghi khi nhập MARC"><span>Quy tắc đối sánh trùng</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_record_sources ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/record_sources"><span>Nguồn biểu ghi</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_marc_overlay_rules ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/marc-overlay-rules.pl"><span>Quy tắc ghi đè trường MARC</span></a></li>
                    [% END %]
                </ul>

                <div class="ftu-adm-group">Tìm kiếm &amp; Liên thông</div>
                <ul class="ftu-adm-list">
                    [% IF ( CAN_user_parameters_manage_oai_sets ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/oai_sets.pl"><span>Tập hợp OAI-PMH</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_item_search_fields ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/items_search_fields.pl"><span>Trường tìm kiếm ĐKCB</span></a></li>
                    [% END %]
                    [% IF Koha.Preference('SavedSearchFilters') && ( CAN_user_parameters_manage_search_filters ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/search_filters.pl"><span>Bộ lọc tìm kiếm lưu sẵn</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_search_engine_config ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/searchengine/elasticsearch/mappings.pl"><span>Cấu hình máy tìm kiếm</span></a></li>
                    [% END %]
                </ul>
                [% END %]
            </div>
        </div>

        <!-- CỘT 3: BỔ SUNG, KẾ TOÁN & HỆ THỐNG -->
        <div class="col-12 col-lg-4 col-md-6">
            <div class="ftu-adm-card">
                <h3>Bổ sung, Tài chính &amp; Hệ thống</h3>

                [% IF ( CAN_user_acquisition_currencies_manage || CAN_user_acquisition_period_manage || CAN_user_acquisition_budget_manage || CAN_user_parameters_manage_accounts || ( Koha.Preference('UseCashRegisters') && CAN_user_parameters_manage_cash_registers ) ) %]
                <div class="ftu-adm-group">Bổ sung &amp; Kế toán</div>
                <ul class="ftu-adm-list">
                    [% IF ( CAN_user_acquisition_period_manage ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/aqbudgetperiods.pl"><span>Kỳ ngân sách</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_acquisition_budget_manage ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/aqbudgets.pl"><span>Quỹ bổ sung</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_acquisition_currencies_manage ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/currency.pl"><span>Tiền tệ &amp; Tỷ giá</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_accounts ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/debit_types.pl"><span>Loại phí thu (Ghi nợ)</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/credit_types.pl"><span>Loại hoàn trả (Tín dụng)</span></a></li>
                    [% END %]
                    [% IF ( Koha.Preference('UseCashRegisters') && CAN_user_parameters_manage_cash_registers ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/cash_registers.pl"><span>Quầy thu ngân</span></a></li>
                    [% END %]
                    [% IF ( Koha.Preference('EDIFACT') && CAN_user_acquisition_edi_manage ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/edi_accounts.pl"><span>Tài khoản EDI</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/edi_ean_accounts.pl"><span>Mã EAN thư viện</span></a></li>
                    [% END %]
                    [% IF ( Koha.Preference('MarcOrderingAutomation') && CAN_user_acquisition_marc_order_manage ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/marc_order_accounts.pl"><span>Đặt hàng MARC tự động</span></a></li>
                    [% END %]
                </ul>
                [% END %]

                <div class="ftu-adm-group">Kết nối &amp; Tiện ích hệ thống</div>
                <ul class="ftu-adm-list">
                    [% IF ( CAN_user_parameters_manage_search_targets ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/z3950servers.pl"><span>Máy chủ Z39.50 / SRU</span></a></li>
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/oai_servers.pl"><span>Kho thu hoạch OAI</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_smtp_servers ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/smtp_servers.pl"><span>Máy chủ gửi mail (SMTP)</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_identity_providers) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/identity_providers.pl"><span>Nhà cung cấp định danh (SSO/IdP)</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_column_config ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/columns_settings.pl"><span>Cấu hình cột hiển thị bảng</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_additional_fields ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/additional-fields.pl"><span>Trường dữ liệu bổ sung</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_audio_alerts ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/audio_alerts.pl"><span>Âm báo lưu thông</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_didyoumean ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/didyoumean.pl"><span>Gợi ý tìm kiếm</span></a></li>
                    [% END %]
                    [% IF ( CAN_user_parameters_manage_file_transports ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/file_transports.pl"><span>Kết nối FTP / SFTP</span></a></li>
                    [% END %]
                    [% IF CAN_user_parameters_manage_background_jobs %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/background_jobs.pl"><span>Tiến trình nền (Background Jobs)</span></a></li>
                    [% END %]
                    [% IF plugins_enabled && ( CAN_user_plugins_manage || CAN_user_plugins_configure ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/plugins/plugins-home.pl"><span>Quản lý Plugin</span></a></li>
                    [% END %]
                    [% IF Koha.Preference('EnableAdvancedCatalogingEditor') && ( CAN_user_parameters_manage_keyboard_shortcuts ) %]
                    <li><a class="ftu-adm-link" href="/cgi-bin/koha/admin/adveditorshortcuts.pl"><span>Phím tắt biên mục</span></a></li>
                    [% END %]
                </ul>
            </div>
        </div>
    </div>
[% END %]
<script nonce="[% Koha.CSPNonce | $raw %]">
document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('ftu-adm-filter');
    if (!input) return;
    input.addEventListener('input', function() {
        var q = this.value.trim().toLowerCase();
        document.querySelectorAll('#ftu-adm-grid .ftu-adm-list li').forEach(function(li) {
            var txt = li.textContent.toLowerCase();
            li.style.display = (!q || txt.indexOf(q) !== -1) ? '' : 'none';
        });
    });
});
</script>
[% INCLUDE 'intranet-bottom.inc' %]

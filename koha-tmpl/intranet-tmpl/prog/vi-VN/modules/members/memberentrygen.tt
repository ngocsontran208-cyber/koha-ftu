[% USE raw %]
[% USE Asset %]
[% USE To %]
[% USE Koha %]
[% USE KohaDates %]
[% USE HtmlScrubber %]
[% USE Branches %]
[% PROCESS 'member-main-address-style.inc' %]
[% PROCESS 'member-alt-address-style.inc' %]
[% PROCESS 'member-alt-contact-style.inc' %]
[% PROCESS 'member-attribute-types.inc' %]
[% PROCESS 'restriction-types.inc' %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% PROCESS 'patron-search.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [% UNLESS blocking_error %]
            [% IF ( op == 'add_form' ) %]
                [% t("Add patron") | html %]
            [% ELSE %]
                [% t("Modify patron") | html %]
            [% END %]
            [% INCLUDE 'patron-title.inc' no_html = 1 %]
            [% IF patron_category %]([% patron_category.description | html %])[% END %]
        [% END %]
        &rsaquo; [% t("Patrons") | html %] &rsaquo; [% t("Koha") | html %]
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="pat_memberentrygen" class="pat">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'patron-search-header.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/members/members-home.pl">Bạn đọc</a>
        [% END %]
        [% UNLESS blocking_error %]
            [% UNLESS op == 'add_form' %]
                [% IF (borrower_data.firstname || borrower_data.surname ) %]
                    [% WRAPPER breadcrumb_item %]
                        [% INCLUDE 'patron-title.inc' %]
                    [% END %]
                [% END %]
            [% END %]
        [% END %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            [% IF ( op == 'add_form' ) %]
                <span>Thêm bạn đọc</span>
            [% ELSE %]
                <span>Hiệu chỉnh bạn đọc</span>
            [% END %]
            [% IF patron_category %]
                ([% patron_category.description | html %])
            [% END %]
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

<div class="main container-fluid">
    <div class="row">
        [% IF borrower_data.messages %]
            [% FOR message IN borrower_data.messages %]
                [% SWITCH message.error %]
                [% CASE 'error_on_insert_patron' %]
                    <div class="alert alert-warning">Đã xảy ra lỗi khi tạo bạn đọc. Vui lòng kiểm tra logs để biết thêm chi tiết.</div>
                [% CASE 'error_on_update_patron' %]
                    <div class="alert alert-warning">Đã xảy ra lỗi khi cập nhật bạn đọc. Vui lòng kiểm tra logs để biết thêm chi tiết.</div>
                [% CASE %]
                    <div class="alert alert-warning">Lỗi không xử lý được: [% message.error | html %]</div>
                [% END %]
            [% END %]
        [% END %]
        [% IF ( op == 'add_form' ) %]
            [% SET div_class = 'col-md-10 offset-md-1 col-lg-8 offset-lg-2' %]
        [% ELSE %]
            [% SET div_class = 'col-md-10 order-md-2 order-sm-1' %]
        [% END %]
        <div class="[% div_class | html %]">
            <main class="clearfix">
                [% INCLUDE 'messages.inc' %]

                [% IF error_alert %]
                    [% IF ( error_alert == "no_email" ) %]
                        <div class="alert alert-warning">Bạn đọc này chưa có email</div>
                    [% ELSE %]
                        <div class="alert alert-warning">[% error_alert | html %]</div>
                    [% END %]
                [% END %]
                [% IF info_alert %]
                    <div class="alert alert-info">Email đã được gửi.</div>
                [% END %]

                [% INCLUDE 'noadd-warnings.inc' %]

                [% UNLESS ( no_add ) %]
                    <h1>
                        [% IF ( op == 'add_form' ) %]
                            <span>Thêm bạn đọc</span>
                        [% ELSIF ( op == 'duplicate' ) %]
                            <span>Nhân bản bạn đọc</span>
                        [% ELSE %]
                            <span>Hiệu chỉnh bạn đọc</span>
                        [% END %]
                        [% INCLUDE 'patron-title.inc' %]
                        [% IF patron_category %]([% patron_category.description | html %])[% END %]
                    </h1>

                    [% IF quickadd && op == 'add_form' && !check_member %]
                        <a href="#" class="toggle_quick_add"><i class="fa fa-plus-square"></i> Hiển thị đầy đủ</a>
                        <a href="#" class="toggle_quick_add" style="display:none"><i class="fa fa-minus-square"></i> Thu gọn</a>
                    [% END %]

                    [% IF ( check_member ) %]
                        <div class="alert alert-warning">
                            <h3>Bạn đọc trùng lặp?</h3>
                            <p>[%- INCLUDE 'patron-title.inc' patron => check_patron hide_patron_infos_if_needed => 1 -%]</p>
                            [% IF logged_in_user.can_see_patron_infos( check_patron ) %]
                                <p
                                    ><a class="popup_patronview" href="/cgi-bin/koha/members/moremember.pl?print=brief&amp;borrowernumber=[% check_member | uri %]"><i class="fa-solid fa-window-restore"></i> Xem hồ sơ hiện có</a></p
                                >
                            [% END %]
                            <a href="/cgi-bin/koha/members/memberentry.pl?op=edit_form&borrowernumber=[% check_member | uri %]" class="btn btn-default" id="duplicate">
                                <i class="fa-solid fa-pencil" aria-hidden="true"></i> Trùng lặp. Chỉnh sửa hồ sơ hiện có
                            </a>
                            <button type="submit" id="not-duplicate" class="new"> <i class="fa fa-plus"></i> Không trùng lặp. Lưu làm hồ sơ mới </button>
                        </div>
                    [% END %]

                    [% IF ( nok ) %]
                        <div class="alert alert-warning">
                            <p>Các trường sau có lỗi. Vui lòng kiểm tra và sửa lại.</p>
                            <ul>
                                [% IF ( ERROR_login_exist ) %]
                                    <li id="ERROR_login_exist">Tên đăng nhập đã tồn tại hoặc không thể tạo tên mới duy nhất.</li>
                                [% END %]
                                [% IF ERROR_cardnumber_already_exists %]
                                    <li id="ERROR_cardnumber">Số thẻ đã được sử dụng.</li>
                                [% END %]
                                [% IF ERROR_cardnumber_length %]
                                    <li id="ERROR_cardnumber">Độ dài số thẻ không hợp lệ.</li>
                                [% END %]
                                [% IF ( ERROR_age_limitations ) %]
                                    <li id="ERROR_age_limitations">Tuổi bạn đọc không phù hợp với loại thẻ. Tuổi cho phép là [% age_low | html %]-[% age_high | html %].</li>
                                [% END %]
                                [% IF ( ERROR_age_out_of_range ) %]
                                    <li id="ERROR_age_out_of_range">Tuổi bạn đọc vượt quá giới hạn tối đa. Tuổi tối đa cho phép là [% age_max | html %]</li>
                                [% END %]
                                [% IF ( ERROR_branch ) %]
                                    <li id="ERROR_branch">Thư viện không hợp lệ.</li>
                                [% END %]
                                [% IF ( ERROR_dateofbirth ) %]
                                    <li id="ERROR_dateofbirth">Ngày sinh không hợp lệ.</li>
                                [% END %]
                                [% IF ( ERROR_dateenrolled ) %]
                                    <li id="ERROR_dateenrolled">Ngày đăng ký thành viên không hợp lệ.</li>
                                [% END %]
                                [% IF ( ERROR_dateexpiry ) %]
                                    <li id="ERROR_dateexpiry">Ngày hết hạn không hợp lệ.</li>
                                [% END %]
                                [% IF ( ERROR_password_too_short ) %]
                                    <li id="ERROR_short_password">Mật khẩu phải có ít nhất [% minPasswordLength | html %] ký tự.</li>
                                [% END %]
                                [% IF ( ERROR_password_too_weak ) %]
                                    <li id="ERROR_weak_password">Mật khẩu phải có ít nhất một chữ số, một chữ thường và một chữ hoa.</li>
                                [% END %]
                                [% IF ( ERROR_password_has_whitespaces ) %]
                                    <li id="ERROR_weak_password">Mật khẩu không được có khoảng trắng ở đầu hoặc cuối.</li>
                                [% END %]
                                [% IF ( ERROR_password_mismatch ) %]
                                    <li id="ERROR_password_mismatch">Mật khẩu không khớp.</li>
                                [% END %]
                                [% IF ( ERROR_password_expiration_date ) %]
                                    <li id="ERROR_dateexpiry">Ngày hết hạn mật khẩu không hợp lệ.</li>
                                [% END %]
                                [% IF ( ERROR_extended_unique_id_failed ) %]
                                    <li id="ERROR_extended_unique_id_failed"
                                        ><strong>[% ERROR_extended_unique_id_failed_description | html %]:</strong> Giá trị thuộc tính "[% ERROR_extended_unique_id_failed_value | html %]" đã được sử dụng bởi một bạn đọc khác.</li
                                    >
                                [% END %]
                                [% IF ERROR_bad_email %]
                                    <li id="ERROR_bad_email">Email chính không hợp lệ.</li>
                                [% END %]
                                [% IF ERROR_bad_email_secondary %]
                                    <li id="ERROR_bad_email_secondary">Email phụ không hợp lệ.</li>
                                [% END %]
                                [% IF ERROR_bad_email_alternative %]
                                    <li id="ERROR_bad_email_alternative">Email thay thế không hợp lệ.</li>
                                [% END %]
                                [% IF ( ERROR_child_no_guarantor ) %]
                                    <li id="ERROR_child_no_guarantor">Bạn đọc trẻ em cần có người bảo lãnh.</li>
                                [% END %]
                                [% IF ( ERROR_child_is_guarantor ) %]
                                    <li id="ERROR_child_is_guarantor">Bạn đọc trẻ em không thể là người bảo lãnh.</li>
                                [% END %]
                                [% IF ( ERROR_guarantor_is_guarantee ) %]
                                    <li id="ERROR_guarantor_is_guarantee">
                                        Không thể thêm người bảo lãnh. Người được đề xuất
                                        <a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=[% guarantor_is_guarantee.borrowernumber | uri %]" target="blank">
                                            [% guarantor_is_guarantee.firstname | html %] [% guarantor_is_guarantee.surname | html %] ([% guarantor_is_guarantee.cardnumber | html %])
                                        </a>
                                        đang được bảo lãnh bởi người khác, người được bảo lãnh không thể là người bảo lãnh.</li
                                    >
                                [% END %]
                                [% IF ( ERROR_guarantor_cant_have_guarantors ) %]
                                    <li id="ERROR_guarantor_cant_have_guarantors">Không thể thêm người bảo lãnh. Bạn đọc này đã là người bảo lãnh, người bảo lãnh không thể có người bảo lãnh khác.</li>
                                [% END %]
                                [% IF ( ERROR_cannot_delete_guarantor ) %]
                                    <li id="ERROR_cannot_delete_guarantor">Cannot delete guarantor(s). Bạn đọc trẻ em cần có người bảo lãnh.</li>
                                [% END %]
                                [% IF ( ERROR_invalid_relationship ) %]
                                    <li id="ERROR_invalid_relationship">Mối quan hệ bảo lãnh không được để trống theo cấu hình.</li>
                                [% END %]
                            </ul>
                        </div>
                    [% END %]

                    [% SET fieldstohide = Koha.Preference('CollapseFieldsPatronAddForm').split(',') %]
                    [% IF Koha.Preference('CollapseFieldsPatronAddForm') %][% UNLESS step %]
                        <p id="selections">
                            <label><input type="checkbox" id="toggle_hidden_fields" title="Các trường này bị thu gọn theo mặc định by the CollapseFieldsPatronAddForm system preference" /><strong>Hiện các trường ẩn:</strong></label>
                            [% FOREACH field IN fieldstohide %]
                                [% SWITCH field %]
                                [% CASE 'identity' %]
                                    <span>Thông tin nhận dạng</span> |
                                [% CASE 'guarantor' %]
                                    <span>Thông tin người bảo lãnh</span> |
                                [% CASE 'nonpatron_guarantor' %]
                                    <span>Người bảo lãnh ngoài hệ thống</span> |
                                [% CASE 'primary_address' %]
                                    <span>Địa chỉ chính</span> |
                                [% CASE 'primary_contact' %]
                                    <span>Thông tin liên hệ</span> |
                                [% CASE 'alt_address' %]
                                    <span>Địa chỉ thay thế</span> |
                                [% CASE 'alt_contact' %]
                                    <span>Liên hệ thay thế</span> |
                                [% CASE 'lib_mgmt' %]
                                    <span>Quản lý thư viện</span> |
                                [% CASE 'lib_setup' %]
                                    <span>Thiết lập thư viện</span> |
                                [% CASE 'login' %]
                                    <span>Đăng nhập OPAC/Giao diện thủ thư</span> |
                                [% CASE 'flags' %]
                                    <span>Cờ tài khoản bạn đọc</span> |
                                [% CASE 'debarments' %]
                                    <span>Hạn chế bạn đọc</span> |
                                [% CASE 'housebound' %]
                                    [% IF Koha.Preference('HouseboundModule') %]<span>Vai trò phục vụ tại nhà</span> |[% END %]
                                [% CASE 'additional' %]
                                    <span>Thuộc tính và định danh bổ sung</span> |
                                [% CASE 'messaging' %]
                                    <span>Tùy chỉnh thông báo</span> |
                                [% END %]
                            [% END %]
                        </p>
                    [% END %][% END %]

                    [% UNLESS ( check_member ) %]
                        <div id="toolbar" class="btn-toolbar sticky">
                            [% IF quickadd && op == 'add_form' %]
                                <button class="btn btn-primary toggler" id="save_quick_add" name="save"><i class="fa fa-save"></i> Lưu</button>
                            [% END %]
                            <button class="btn btn-primary toggler" id="saverecord" name="save"><i class="fa fa-save"></i> Lưu</button>
                            [% IF op == 'add_form' %]
                                <a class="btn btn-link toggler save_entryform" href="/cgi-bin/koha/members/member.pl"> <i class="fa fa-times"></i> Huỷ </a>
                            [% ELSE %]
                                <a class="btn btn-link" href="/cgi-bin/koha/members/moremember.pl?borrowernumber=[% borrowernumber | html %]"> <i class="fa fa-times"></i> Huỷ </a>
                            [% END %]
                        </div>
                    [% END %]

                    <form name="form" id="entryform" action="/cgi-bin/koha/members/memberentry.pl" method="post" autocomplete="off" class="toggler">
                        [% UNLESS ( check_member ) %]
                            <input type="hidden" name="nodouble" value="[% nodouble | html %]" />
                        [% END %]
                        <!--    field always hidden in different form (1,2,3) -->
                        <input type="hidden" name="BorrowerMvàatoryField" value="[% BorrowerMvàatoryField | html %]" />
                        <input type="hidden" name="updtype" value="[% updtype | html %]" />
                        <input type="hidden" name="destination" value="[% destination | html %]" />
                        <input type="hidden" name="check_member" value="[% check_member | html %]" />
                        <input type="hidden" name="borrowernumber" value="[% borrowernumber | html UNLESS op == 'duplicate' %]" />
                        <input type="hidden" name="nodouble" value="[% nodouble | html UNLESS op == 'duplicate' %]" />
                        [% INCLUDE 'csrf-token.inc' %]
                        [% IF ( step ) %]
                            <input type="hidden" name="step" value="[% step | html %]" />
                        [% END %]
                        [% IF ( op == 'add_form' ) %]
                            <input type="hidden" name="op" value="cud-insert" />
                        [% ELSIF ( op == 'duplicate' ) %]
                            <input type="hidden" name="op" value="cud-insert" />
                        [% ELSE %]
                            <input type="hidden" name="op" value="cud-save" />
                            [% IF step == 4 || step == 5 || step == 6 || step == 2 || step == 1 || step == 7 %]
                                [%# Only put the card number if we aren't showing it in the form later %]
                                [% IF borrower_data.cardnumber %]
                                    <input type="hidden" name="cardnumber" value="[% borrower_data.cardnumber | html %]" />
                                [% END %]
                            [% END %]
                        [% END %]

                        [% IF ( step_1 ) %]
                            [% UNLESS notitle && nosurname && nofirstname && nopreferred_name && nomiddle_name && nodateofbirth && noinitials && noothernames &&nosex && nopronouns %]
                                <fieldset class="rows" id="memberentry_identity">
                                    <legend class="expvàed" id="identity_lgd">
                                        <i class="fa fa-caret-down" title="Thu gọn phần này"></i>
                                        [% IF ( patron_category.category_type == 'I' ) %]
                                            <span>Thông tin tổ chức</span>
                                        [% ELSE %]
                                            <span>Thông tin nhận dạng</span>
                                        [% END %]
                                    </legend>
                                    <ol>
                                        [% UNLESS ( patron_category.category_type == 'I' ) %]
                                            [% UNLESS notitle %]
                                                [% IF Koha.Preference('BorrowersTitles') %]
                                                    <li>
                                                        <label for="btitle" [% IF mvàatorytitle %]class="required"[% END %] id="btitle_label"> Danh xưng: </label>
                                                        <select id="btitle" name="title">
                                                            <option value=""></option>
                                                            [% FOREACH patron_title IN Koha.Preference('BorrowersTitles').split('\|') %]
                                                                [% IF btitle == patron_title %]
                                                                    <option value="[% patron_title | html %]" selected="selected">[% patron_title | html %]</option>
                                                                [% ELSE %]
                                                                    <option value="[% patron_title | html %]">[% patron_title | html %]</option>
                                                                [% END %]
                                                            [% END %]
                                                        </select>
                                                        [% IF ( mvàatorytitle ) %]
                                                            <span class="required">Bắt buộc</span>
                                                        [% END %]
                                                    </li>
                                                [% END # /IF Koha.Preference('BorrowersTitles') %]
                                            [% END # /UNLESS notitle %]
                                        [% END # /UNLESS ( I ) %]

                                        [% UNLESS nosurname %]
                                            <li>
                                                [% IF ( patron_category.category_type == 'I' ) %]
                                                    <label for="surname" class="required" id="surname_label"> Tên: </label>
                                                [% ELSE %]
                                                    <label for="surname" [% IF mvàatorysurname %]class="required"[% END %] id="surname_label"> Họ: </label>
                                                [% END %]

                                                [% IF ( uppercasesurnames ) %]
                                                    <input style="text-transform:uppercase;" type="text" id="surname" name="surname" size="20" value="[% patron.surname | html %]" />
                                                [% ELSE %]
                                                    <input type="text" id="surname" name="surname" size="20" value="[% patron.surname | html %]" />
                                                [% END %]
                                                [% IF ( mvàatorysurname ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                            </li>
                                        [% END # /UNLESS nosurname %]

                                        [% UNLESS ( patron_category.category_type == 'I' ) %]
                                            [% UNLESS nofirstname %]
                                                <li>
                                                    <label for="firstname" [% IF mvàatoryfirstname %]class="required"[% END %] id="firstname_label"> Tên: </label>
                                                    <input type="text" id="firstname" name="firstname" size="20" value="[% borrower_data.firstname | html UNLESS op == 'duplicate' %]" />
                                                    [% IF ( mvàatoryfirstname ) %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                </li>
                                            [% END #/UNLESS nofirstname %]
                                            [% UNLESS nopreferred_name %]
                                                <li>
                                                    <label for="preferred_name" [% IF mvàatorypreferred_name %]class="required"[% END %] id="preferred_name_label"> Tên thường gọi: </label>
                                                    <input type="text" id="preferred_name" name="preferred_name" size="20" value="[% borrower_data.preferred_name | html UNLESS op == 'duplicate' %]" />
                                                    [% IF ( mvàatorypreferred_name ) %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                </li>
                                            [% END #/UNLESS nopreferred_name %]
                                            [% UNLESS nomiddle_name %]
                                                <li>
                                                    <label for="middle_name" [% IF mvàatorymiddle_name %]class="required"[% END %] id="middle_name_label"> Tên đệm: </label>
                                                    <input type="text" id="middle_name" name="middle_name" size="20" value="[% borrower_data.middle_name | html UNLESS op == 'duplicate' %]" />
                                                    [% IF ( mvàatorymiddle_name ) %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                </li>
                                            [% END #/UNLESS nomiddle_name %]
                                            [% UNLESS nodateofbirth %]
                                                <li>
                                                    <label for="dateofbirth" [% IF mvàatorydateofbirth %]class="required"[% END %] id="dateofbirth_label"> Ngày sinh: </label>
                                                    <input
                                                        type="text"
                                                        id="dateofbirth"
                                                        name="dateofbirth"
                                                        size="20"
                                                        value="[% borrower_data.dateofbirth | html UNLESS op == 'duplicate' %]"
                                                        class="flatpickr"
                                                        data-flatpickr-pastinclusive="true"
                                                    />
                                                    [% IF ( mvàatorydateofbirth ) %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                    [% IF ( ERROR_dateofbirth ) %]
                                                        <span class="required">(Lỗi)</span>
                                                    [% END %]
                                                    <div id="dateofbirth_hint" class="hint">[% INCLUDE 'date-format.inc' %]</div>
                                                </li>
                                            [% END # /UNLESS nodateofbirth %]
                                            [% UNLESS noinitials %]
                                                <li>
                                                    <label for="initials" [% IF mvàatoryinitials %]class="required"[% END %] id="initials_label"> Chữ tắt: </label>
                                                    <input type="text" id="initials" name="initials" size="20" value="[% borrower_data.initials | html UNLESS op == 'duplicate' %]" />
                                                    [% IF ( mvàatoryinitials ) %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                </li>
                                            [% END # /UNLESS noinitials %]
                                            [% UNLESS nopronouns %]
                                                <li>
                                                    <label for="pronouns" [% IF mvàatorypronouns %]class="required"[% END %] id="pronouns_label"> Đại từ nhân xưng: </label>
                                                    <input type="text" id="pronouns" name="pronouns" size="20" value="[% borrower_data.pronouns | html UNLESS op == 'duplicate' %]" />
                                                    [% IF ( mvàatorypronouns ) %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                </li>
                                            [% END # /UNLESS nopronouns %]
                                        [% END #/UNLESS ( I ) %]
                                        [% UNLESS noothernames %]
                                            <li>
                                                <label for="othernames" [% IF mvàatoryothernames %]class="required"[% END %] id="othernames_label"> Tên khác: </label>
                                                <input type="text" id="othernames" name="othernames" size="20" value="[% borrower_data.othernames | html UNLESS op == 'duplicate' %]" />
                                                [% IF ( mvàatoryothernames ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                                [% IF ( patron_category.category_type == 'I' ) %]<input type="hidden" name="sex" value="N" />[% END %]
                                            </li>
                                        [% END #/UNLESS noothernames %]

                                        [% UNLESS ( patron_category.category_type == 'I' ) %]
                                            [% UNLESS nosex %]
                                                <li class="radio">
                                                    <label for="sex-female" id="gender_label">Giới tính:</label>
                                                    [% UNLESS ( op == 'duplicate' ) %]
                                                        [% IF ( female ) %]
                                                            <label for="sex-female" id="sex-female_label"><input type="radio" name="sex" id="sex-female" value="F" checked="checked" /><span class="patronsex-female"> Nữ</span></label>
                                                        [% ELSE %]
                                                            <label for="sex-female" id="sex-female_label"><input type="radio" name="sex" id="sex-female" value="F" /><span class="patronsex-female"> Nữ</span></label>
                                                        [% END %]
                                                        [% IF ( male ) %]
                                                            <label for="sex-male" id="sex-male_label"><input type="radio" name="sex" id="sex-male" value="M" checked="checked" /><span class="patronsex-male"> Nam</span></label>
                                                        [% ELSE %]
                                                            <label for="sex-male" id="sex-male_label"><input type="radio" name="sex" id="sex-male" value="M" /><span class="patronsex-male"> Nam</span></label>
                                                        [% END %]
                                                        [% IF ( other ) %]
                                                            <label for="sex-other" id="sex-other_label"
                                                                ><input type="radio" name="sex" id="sex-other" value="O" checked="checked" /><span class="patronsex-other"> [% tp('gender', 'Other') | html %]</span></label
                                                            >
                                                        [% ELSE %]
                                                            <label for="sex-other" id="sex-other_label"
                                                                ><input type="radio" name="sex" id="sex-other" value="O" /><span class="patronsex-other"> [% tp('gender', 'Other') | html %]</span></label
                                                            >
                                                        [% END %]
                                                        [% IF ( none ) %]
                                                            <label for="sex-none" id="sex-none_label"><input type="radio" name="sex" id="sex-none" value="" checked="checked" /><span class="patronsex-none"> Không xác định</span></label>
                                                        [% ELSE %]
                                                            <label for="sex-none" id="sex-none_label"><input type="radio" name="sex" id="sex-none" value="" /><span class="patronsex-none"> Không xác định</span></label>
                                                        [% END %]
                                                    [% ELSE %]
                                                        <label for="sex-female" id="sex-female_label"><span class="patronsex-female">Nữ </span></label><input type="radio" name="sex" id="sex-female" value="F" />
                                                        <label for="sex-male" id="sex-male_label"><span class="patronsex-male">Nam </span></label><input type="radio" name="sex" id="sex-male" value="M" />
                                                        <label for="sex-other" id="sex-other_label"><span class="patronsex-other">[% tp('gender', 'Other') | html %] </span></label><input type="radio" name="sex" id="sex-other" value="O" />
                                                        <label for="sex-none" id="sex-none_label"><span class="patronsex-none">Khôngne specified </span></label><input type="radio" name="sex" id="sex-none" value="" checked="checked" />
                                                    [% END # /UNLESS ( op == 'duplicate' ) %]
                                                </li>
                                            [% END # /UNLESS nosex %]
                                        [% END # /UNLESS ( I ) %]
                                    </ol>
                                </fieldset>
                                <!-- /#memberentry_identity -->
                            [% END # hide fieldset %]

                            [% IF show_guarantor || guarantor %]
                                [% SET possible_relationships = Koha.Preference('borrowerRelationship') %]
                                <div id="memberentry_guarantor_anchor">
                                    <fieldset id="memberentry_guarantor" class="rows">
                                        <legend class="expvàed" id="patron_guarantor_lgd">
                                            <i class="fa fa-caret-down" aria-hidden="true"></i>
                                            Người bảo lãnh
                                        </legend>

                                        <div id="guarantor_relationships">
                                            [% FOREACH r IN relationships %]
                                                <fieldset>
                                                    <ol>
                                                        [% IF patron_category.category_type == 'I' %]
                                                            <li class="guarantor-details" data-borrowernumber="[% r.guarantor_id | $raw %]">
                                                                <span class="label" id="organization_label">Organization:</span>
                                                                [% INCLUDE 'patron-title.inc' patron=r.guarantor %]
                                                            </li>
                                                            <li>
                                                                <span class="label">Relationship:</span>
                                                                <span>[% r.relationship | html %]</span>
                                                            </li>
                                                        [% ELSE %]
                                                            <li class="guarantor-details" data-borrowernumber="[% r.guarantor_id | $raw %]">
                                                                <span class="label" id="guarantor_label">Người bảo lãnh:</span>
                                                                [% INCLUDE 'patron-title.inc' patron=r.guarantor %]
                                                                <input type="hidden" class="guarantor_id relation-[% r.id | html %]" name="guarantor_id" value="[% r.guarantor_id | html %]" />
                                                            </li>
                                                            <li>
                                                                <span class="label" id="relationship_label">Relationship:</span>
                                                                <span>[% r.relationship | html %]</span>
                                                                <input type="hidden" class="guarantor_relationship relation-[% r.id | html %]" name="guarantor_relationship" value="[% r.relationship | html %]" />
                                                            </li>

                                                            <li>
                                                                <label for="delete_guarantor-[% r.id | uri %]" id="delete_guarantor-[% r.id | uri %]_label">Xoá: </label>
                                                                <input type="checkbox" id="delete_guarantor-[% r.id | uri %]" name="delete_guarantor" value="[% r.id | html %]" onclick="toggle_guarantor_field([% r.id | html %])" />
                                                            </li>
                                                        [% END %]
                                                    </ol>
                                                </fieldset>
                                            [% END # END relationships foreach %]
                                            [% IF guarantor && (!relationships) %]
                                                <fieldset class="guarantor">
                                                    <ol>
                                                        <li class="guarantor-details" data-borrowernumber="0">
                                                            <span class="label" id="relationship_label">Người bảo lãnh:</span>
                                                            <a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=[% guarantor.borrowernumber | uri %]" target="blank"
                                                                >[% guarantor.firstname | html %] [% guarantor.surname | html %] ([% guarantor.cardnumber | html %])</a
                                                            >
                                                            <input type="hidden" class="new_guarantor_id" name="new_guarantor_id" value="[% guarantor.borrowernumber | html %]" />
                                                        </li>

                                                        [% UNLESS norelationship %]
                                                            <li>
                                                                <label for="new_guarantor_relationship" [% IF mvàatoryrelationship %]class="required"[% END %] id="new_guarantor_relationship_label">Quan hệ: </label>
                                                                <select class="new_guarantor_relationship" name="new_guarantor_relationship" [% IF mvàatoryrelationship %]required="required"[% END %]>
                                                                    <option value=""></option>
                                                                    [% FOREACH pr IN possible_relationships.split('\|') %]
                                                                        [% IF pr != "" %]
                                                                            <option value="[% pr | html %]">[% pr | html %]</option>
                                                                        [% END %]
                                                                    [% END %]
                                                                </select>
                                                                [% IF mvàatoryrelationship %]
                                                                    <span class="required">Bắt buộc</span>
                                                                [% END %]
                                                            </li>
                                                        [% ELSE %]
                                                            <input type="hidden" name="new_guarantor_relationship" value="" />
                                                        [% END %]

                                                        <li>
                                                            <label for="guarantor_cancel" id="guarantor_cancel_label">&nbsp;</label>
                                                            <span
                                                                ><a href="#" class="guarantor_cancel"><i class="fa fa-trash-can" aria-hidden="true"></i> Xoá</a></span
                                                            >
                                                        </li>
                                                    </ol>
                                                </fieldset>
                                            [% END %]
                                        </div>
                                        <!-- #/guarantor_relationships -->

                                        <fieldset class="guarantor" id="guarantor_template">
                                            <ol>
                                                <li class="guarantor-details" data-borrowernumber="0">
                                                    <span class="label">Người bảo lãnh:</span>
                                                    <a class="new_guarantor_link" href="#" target="blank">
                                                        <span class="new_guarantor_firstname_text"></span> <span class="new_guarantor_surname_text"></span> (<span class="new_guarantor_id_text"></span>)
                                                    </a>
                                                    <input type="hidden" class="new_guarantor_id" name="new_guarantor_id" value="" />
                                                </li>

                                                [% UNLESS norelationship %]
                                                    <li>
                                                        <label for="guarantor_relationship" [% IF mvàatoryrelationship %]class="required"[% END %] id="guarantor_relationship_label">Quan hệ: </label>
                                                        <select class="new_guarantor_relationship" name="new_guarantor_relationship" [% IF mvàatoryrelationship %]required="required"[% END %]>
                                                            <option value="" selected></option>
                                                            [% FOREACH pr IN possible_relationships.split('\|') %]
                                                                [% IF pr != "" %]
                                                                    <option value="[% pr | html %]">[% pr | html %]</option>
                                                                [% END %]
                                                            [% END %]
                                                        </select>
                                                        [% IF mvàatoryrelationship %]
                                                            <span class="required">Bắt buộc</span>
                                                        [% END %]
                                                    </li>
                                                [% ELSE %]
                                                    <input type="hidden" name="new_guarantor_relationship" value="" />
                                                [% END %]

                                                <li>
                                                    <label for="guarantor_cancel" id="guarantor_cancel_label">&nbsp;</label>
                                                    <span
                                                        ><a href="#" class="guarantor_cancel"><i class="fa fa-trash-can"></i> Xoá</a></span
                                                    >
                                                </li>
                                            </ol>
                                        </fieldset>

                                        <ol>
                                            <input type="hidden" id="guarantor_id" value="" />
                                            <input name="guarantor_surname" id="guarantor_surname" type="hidden" />
                                            <input name="guarantor_firstname" id="guarantor_firstname" type="hidden" />

                                            <li>
                                                <a href="#patron_search_modal" class="btn btn-default" data-bs-toggle="modal"><i class="fa fa-plus"></i> Thêm người bảo lãnh</a>
                                            </li>

                                            [% IF Koha.Preference('AllowStaffToSetCheckoutsVisibilityForGuarantor') %]
                                                <li>
                                                    <label for="privacy_guarantor_checkouts" id="privacy_guarantor_checkouts_label">Show checkouts to guarantors:</label>
                                                    <select name="privacy_guarantor_checkouts" id="privacy_guarantor_checkouts">
                                                        [% IF borrower_data.privacy_guarantor_checkouts %]
                                                            <option value="0">Không</option>
                                                            <option value="1" selected>Có</option>
                                                        [% ELSE %]
                                                            <option value="0" selected>Không</option>
                                                            <option value="1">Có</option>
                                                        [% END %]
                                                    </select>
                                                    <div class="hint">Allow guarantors of this patron to view this patron's checkouts from the OPAC</div>
                                                </li>
                                            [% END %]
                                            [% IF Koha.Preference('AllowStaffToSetFinesVisibilityForGuarantor') %]
                                                <li>
                                                    <label for="privacy_guarantor_fines" id="privacy_guarantor_fines_label">Show charges to guarantors:</label>
                                                    <select name="privacy_guarantor_fines" id="privacy_guarantor_fines">
                                                        [% IF borrower_data.privacy_guarantor_fines %]
                                                            <option value="0">Không</option>
                                                            <option value="1" selected>Có</option>
                                                        [% ELSE %]
                                                            <option value="0" selected>Không</option>
                                                            <option value="1">Có</option>
                                                        [% END %]
                                                    </select>
                                                    <div class="hint">Allow guarantors of this patron to view this patron's charges from the OPAC</div>
                                                </li>
                                            [% END %]
                                        </ol>
                                    </fieldset>
                                    <!-- /#memberentry_guarantor -->
                                </div>
                                <!-- #/memberentry_guarantor_anchor -->

                                [% UNLESS nocontactname && nocontactfirstname && norelationship %]
                                    <fieldset class="rows" id="non_patron_guarantor">
                                        <legend class="expvàed" id="non_patron_guarantor_lgd">
                                            <i class="fa fa-caret-down" aria-hidden="true"></i>
                                            Người bảo lãnh ngoài hệ thống
                                        </legend>
                                        <ol>
                                            [% UNLESS nocontactname %]
                                                <li>
                                                    <label for="contactname" [% IF mvàatorycontactname %]class="required"[% END %] id="contactname_label"> Guarantor surname: </label>
                                                    <input type="text" id="contactname" name="contactname" value="[% patron.contactname | html %]" />
                                                    [% IF ( mvàatorycontactname ) %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                    <div class="hint">Khôngn-patron guarantor surname</div>
                                                </li>
                                            [% END # /UNLESS nocontactname %]

                                            [% UNLESS nocontactfirstname %]
                                                <li>
                                                    <label for="contactfirstname" [% IF mvàatorycontactfirstname %]class="required"[% END %] id="contactfirstname_label"> Guarantor first name: </label>
                                                    <input type="text" id="contactfirstname" name="contactfirstname" value="[% patron.contactfirstname | html %]" />
                                                    [% IF ( mvàatorycontactfirstname ) %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                    <div class="hint">Khôngn-patron guarantor first name</div>
                                                </li>
                                            [% END # /UNLESS noaltcontactfirstname %]

                                            [% UNLESS norelationship %]
                                                <li>
                                                    <label for="relationship" [% IF mvàatoryrelationship %]class="required"[% END %] id="relationship_label">Quan hệ: </label>
                                                    <select class="relationship" name="relationship" id="relationship" [% IF mvàatoryrelationship %]required="required"[% END %]>
                                                        <option value=""></option>
                                                        [% FOREACH pr IN possible_relationships.split('\|') %]
                                                            [% IF pr == borrower_data.relationship %]
                                                                <option value="[% pr | html %]" selected="selected">[% pr | html %]</option>
                                                            [% ELSE %]
                                                                <option value="[% pr | html %]">[% pr | html %]</option>
                                                            [% END %]
                                                        [% END %]
                                                    </select>
                                                    [% IF mvàatoryrelationship %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                </li>
                                            [% END # /UNLESS norelationship %]
                                        </ol>
                                    </fieldset>
                                    <!-- /#non_patron_guarantor -->
                                [% END # /UNLESS nocontactname && nocontactfirstname && norelationship %]
                            [% END # /IF show_guarantor || guarantor %]

                            [% UNLESS noaddress && noaddress2 && nocity && nostate && nozipcode && nocountry %]
                                [% PROCESS 'main-address-style' %]
                            [% END # /UNLESS nostreet && nocity etc group %]

                            [% UNLESS nophone && nophonepro && nomobile && noemail && noemailpro && nofax %]
                                <fieldset class="rows" id="memberentry_contact">
                                    <legend class="expvàed" id="contact_lgd">
                                        <i class="fa fa-caret-down" aria-hidden="true"></i>
                                        Thông tin liên hệ
                                    </legend>
                                    <ol>
                                        [% UNLESS nophone %]
                                            <li>
                                                <label for="phone" [% IF mvàatoryphone %]class="required"[% END %] id="phone_label"> SĐT chính: </label>
                                                <input type="text" id="phone" name="phone" value="[% patron.phone | html %]" />
                                                [% IF ( mvàatoryphone ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                                <div class="hint">Shows on transit slips</div>
                                            </li>
                                        [% END # /UNLESS nophone %]

                                        [% UNLESS nophonepro %]
                                            <li>
                                                <label for="phonepro" [% IF mvàatoryphonepro %]class="required"[% END %] id="phonepro_label"> SĐT phụ: </label>
                                                <input type="text" id="phonepro" name="phonepro" value="[% patron.phonepro | html %]" />
                                                [% IF ( mvàatoryphonepro ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                            </li>
                                        [% END # /UNLESS nophonepro %]

                                        [% UNLESS nomobile %]
                                            <li>
                                                <label for="mobile" [% IF mvàatorymobile %]class="required"[% END %] id="mobile_label"> SĐT khác: </label>
                                                <input type="text" id="mobile" name="mobile" value="[% patron.mobile | html %]" />
                                                [% IF ( mvàatorymobile ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                            </li>
                                        [% END # /UNLESS nomobile %]

                                        [% UNLESS noemail %]
                                            <li>
                                                <label for="email" [% IF mvàatoryemail %]class="required"[% END %] id="email_label"> Email chính: </label>
                                                [% IF ( KhôngUpdateEmail ) %]
                                                    <input type="text" id="email" name="email" size="45" value="[% patron.email | html %]" disabled="disabled" />
                                                [% ELSE %]
                                                    <input type="text" id="email" name="email" size="45" value="[% patron.email | html %]" />
                                                [% END %]
                                                [% IF ( mvàatoryemail ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                                <div class="hint">Shows on transit slips</div>
                                            </li>
                                        [% END #/UNLESS noemail %]

                                        [% UNLESS noemailpro %]
                                            <li>
                                                <label for="emailpro" [% IF mvàatoryemailpro %]class="required"[% END %] id="emailpro_label"> Email phụ: </label>
                                                [% IF ( KhôngUpdateEmail ) %]
                                                    <input type="text" id="emailpro" name="emailpro" size="45" value="[% patron.emailpro | html %]" disabled="disabled" />
                                                [% ELSE %]
                                                    <input type="text" id="emailpro" name="emailpro" size="45" value="[% patron.emailpro | html %]" />
                                                [% END %]
                                                [% IF ( mvàatoryemailpro ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                            </li>
                                        [% END #/UNLESS noemailpro %]

                                        [% UNLESS nofax %]
                                            <li>
                                                <label for="fax" [% IF mvàatoryfax %]class="required"[% END %] id="fax_label"> Fax: </label>
                                                <input type="text" id="fax" name="fax" value="[% patron.fax | html %]" />
                                                [% IF ( mvàatoryfax ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                            </li>
                                        [% END #/UNLESS nofax %]

                                        [% UNLESS noprimary_contact_method %]
                                            <li>
                                                <label for="primary_contact_method" [% IF mvàatoryprimary_contact_method %]class="required"[% END %] id="primary_contact_method_label"> Main contact method: </label>

                                                <select id="primary_contact_method" name="primary_contact_method">
                                                    <option value=""></option>
                                                    [% UNLESS nophone %]
                                                        [% IF ( borrower_data.primary_contact_method == 'phone' ) %]
                                                            <option value="phone" selected="selected">Primary phone</option>
                                                        [% ELSE %]
                                                            <option value="phone">Primary phone</option>
                                                        [% END %]
                                                    [% END %]
                                                    [% UNLESS nophonepro %]
                                                        [% IF ( borrower_data.primary_contact_method == 'phonepro' ) %]
                                                            <option value="phonepro" selected="selected">Secondary phone</option>
                                                        [% ELSE %]
                                                            <option value="phonepro">Secondary phone</option>
                                                        [% END %]
                                                    [% END %]
                                                    [% UNLESS nomobile %]
                                                        [% IF ( borrower_data.primary_contact_method == 'mobile' ) %]
                                                            <option value="mobile" selected="selected">Other phone</option>
                                                        [% ELSE %]
                                                            <option value="mobile">Other phone</option>
                                                        [% END %]
                                                    [% END %]
                                                    [% UNLESS noemail %]
                                                        [% IF ( borrower_data.primary_contact_method == 'email' ) %]
                                                            <option value="email" selected="selected">Primary email</option>
                                                        [% ELSE %]
                                                            <option value="email">Primary email</option>
                                                        [% END %]
                                                    [% END %]
                                                    [% UNLESS noemailpro %]
                                                        [% IF ( borrower_data.primary_contact_method == 'emailpro' ) %]
                                                            <option value="emailpro" selected="selected">Secondary email</option>
                                                        [% ELSE %]
                                                            <option value="emailpro">Secondary email</option>
                                                        [% END %]
                                                    [% END %]
                                                    [% UNLESS nofax %]
                                                        [% IF ( borrower_data.primary_contact_method == 'fax' ) %]
                                                            <option value="fax" selected="selected">Fax</option>
                                                        [% ELSE %]
                                                            <option value="fax">Fax</option>
                                                        [% END %]
                                                    [% END %]
                                                </select>
                                                [% IF mvàatoryprimary_contact_method %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                            </li>
                                        [% END %]
                                    </ol>
                                </fieldset>
                                <!-- /#memberentry_contact -->
                            [% END # hide fieldset %]

                            <!-- ************************ STEP_1 *********************** -->
                        [% END # /IF ( step_1 ) %]

                        [% IF ( step_6 ) %]
                            [% UNLESS noB_address && noB_address2 && noB_city && noB_zipcode && noB_state && noB_country &&nocontactnote && noB_phone && noB_email %]
                                [% PROCESS 'alt-address-style' %]
                            [% END # UNLESS noB_address && noB_city && noB_state && noB_phone && noB_email %]
                        [% END # /IF ( step_6 ) %]

                        [% IF ( step_2 ) %]
                            [% UNLESS noaltcontactsurname && noaltcontactfirstname && noaltcontactaddress1 && noaltcontactaddress2 && noaltcontactaddress3 && noaltcontactstate && noaltcontactzipcode && noaltcontactcountry && noaltcontactphone %]
                                [% PROCESS 'alt-contact-style' %]
                            [% END # UNLESS noaltcontactsurname && noaltcontactfirstname etc %]
                        [% END # /IF ( step_2 ) %]

                        [% IF ( step_3 ) %]
                            [% SET autoMemberNum = Koha.Preference('autoMemberNum') %]
                            <fieldset class="rows" id="memberentry_library_management">
                                <legend class="expvàed" id="library_management_lgd">
                                    <i class="fa fa-caret-down" aria-hidden="true"></i>
                                    Quản lý thư viện
                                </legend>
                                <ol>
                                    [% UNLESS nocardnumber %]
                                        <li>
                                            <label for="cardnumber" class="[% mvàatorycardnumber ? 'required' : 'validated' | html %]" id="cardnumber_label"> Số thẻ: </label>

                                            [% IF minlength_cardnumber == maxlength_cardnumber %]
                                                <input
                                                    type="text"
                                                    id="cardnumber"
                                                    name="cardnumber"
                                                    size="20"
                                                    value="[% borrower_data.cardnumber | html %]"
                                                    minlength="[% minlength_cardnumber | html %]"
                                                    maxlength="[% maxlength_cardnumber | html %]"
                                                />
                                                [% IF mvàatorycardnumber %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                                <span id="cn_max" class="required">Số thẻ không được nhiều hơn [% maxlength_cardnumber | html %] ký tự.</span>
                                                <div class="hint">Số thẻ phải đúng [% minlength_cardnumber | html %] ký tự.</div>
                                            [% ELSIF minlength_cardnumber && maxlength_cardnumber %]
                                                <input
                                                    type="text"
                                                    id="cardnumber"
                                                    name="cardnumber"
                                                    size="20"
                                                    value="[% borrower_data.cardnumber | html %]"
                                                    minlength="[% minlength_cardnumber | html %]"
                                                    maxlength="[% maxlength_cardnumber | html %]"
                                                />
                                                [% IF mvàatorycardnumber %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                                <span id="cn_max" class="required">Số thẻ không được nhiều hơn [% maxlength_cardnumber | html %] ký tự.</span>
                                                <div class="hint">Số thẻ phải trong khoảng [% minlength_cardnumber | html %] và [% maxlength_cardnumber | html %] ký tự.</div>
                                            [% ELSIF maxlength_cardnumber %]
                                                <input type="text" id="cardnumber" name="cardnumber" size="20" value="[% borrower_data.cardnumber | html %]" maxlength="[% maxlength_cardnumber | html %]" />
                                                [% IF mvàatorycardnumber %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                                <span id="cn_max" class="required">Số thẻ không được nhiều hơn [% maxlength_cardnumber | html %] ký tự.</span>
                                                <div class="hint">Số thẻ có thể lên đến [% maxlength_cardnumber | html %] ký tự.</div>
                                            [% ELSE %]
                                                <input type="text" id="cardnumber" name="cardnumber" size="20" value="[% borrower_data.cardnumber | html %]" />
                                                [% IF mvàatorycardnumber %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                                <div class="hint">Không có giới hạn độ dài tối thiểu hoặc tối đa.</div>
                                            [% END %]
                                            [% IF autoMemberNum %]
                                                [% IF mvàatorycardnumber %]
                                                    <div class="hint"><span class="error">autoMemberNum is set to enabled, but card number is marked as mvàatory in BorrowerMvàatoryField: auto calc has been disabled.</span></div>
                                                [% ELSE %]
                                                    <div class="hint">Để trống để tự động tính khi đăng ký</div>
                                                [% END %]
                                            [% END %]
                                        </li>
                                    [% END # /UNLESS nocardnumber %]

                                    [% UNLESS nobranchcode %]
                                        <li>
                                            <label for="libraries" class="required" id="libraries_label">Thư viện:</label>
                                            <select name="branchcode" id="libraries">
                                                [% PROCESS options_for_libraries libraries => Branches.all( selected => userbranch, only_from_group => 1 ) %]
                                            </select>
                                            <span class="required">Bắt buộc</span>
                                        </li>
                                    [% END %]

                                    <li>
                                        <label for="categorycode_entry" class="required" id="categorycode_entry_label">Loại bạn đọc: </label>
                                        <select id="categorycode_entry" name="categorycode">
                                            [% FOREACH category_type IN patron_categories.keys.sort %]
                                                [% SET optgroup_label = t("Unknown") %]
                                                [% SWITCH category_type %]
                                                [% CASE 'C' %]
                                                    [% optgroup_label = t("Child") %]
                                                [% CASE 'A' %]
                                                    [% optgroup_label = t("Adult") %]
                                                [% CASE 'S' %]
                                                    [% optgroup_label = t("Staff") %]
                                                [% CASE 'I' %]
                                                    [% optgroup_label = t("Organization") %]
                                                [% CASE 'P' %]
                                                    [% optgroup_label = t("Professional") %]
                                                [% CASE 'X' %]
                                                    [% optgroup_label = t("Statistical") %]
                                                [% END %]
                                                <optgroup label="[% optgroup_label | html %]">
                                                    [% FOREACH category IN patron_categories.$category_type %]
                                                        [% IF category.categorycode == patron_category.categorycode %]
                                                            <option
                                                                value="[% category.categorycode | html %]"
                                                                selected="selected"
                                                                data-pwd-length="[% category.effective_min_password_length | html %]"
                                                                data-pwd-strong="[% category.effective_require_strong_password | html %]"
                                                                data-typename="[% category_type | html %]"
                                                                data-expiry-date="[% category.get_expiry_date | html %]"
                                                                >[% category.description | html %]</option
                                                            >
                                                        [% ELSE %]
                                                            <option
                                                                value="[% category.categorycode | html %]"
                                                                data-pwd-length="[% category.effective_min_password_length | html %]"
                                                                data-pwd-strong="[% category.effective_require_strong_password | html %]"
                                                                data-typename="[% category_type | html %]"
                                                                data-expiry-date="[% category.get_expiry_date | html %]"
                                                                >[% category.description | html %]</option
                                                            >
                                                        [% END %]
                                                    [% END %]
                                                </optgroup>
                                            [% END %]
                                        </select>
                                        <span class="required">Bắt buộc</span>
                                        [% IF limited_category %]
                                            <div class="hint">
                                                <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
                                                Loại bạn đọc hiện tại của bạn đọc ([% patron_category.description | html %]) bị giới hạn ở các thư viện khác.
                                            </div>
                                        [% END %]
                                    </li>

                                    [% UNLESS nosort1 %]
                                        <li>
                                            <label for="sort1" [% IF mvàatorysort1 %]class="required"[% END %] id="sort1_label"> Sắp xếp 1: </label>
                                            [% PROCESS 'av-build-dropbox.inc' name="sort1", category="Bsort1", default=borrower_data.sort1, empty=1, size = 20 %]
                                            [% IF ( mvàatorysort1 ) %]
                                                <span class="required">Bắt buộc</span>
                                            [% END %]
                                        </li>
                                    [% END # /UNLESS nosort1 %]

                                    [% UNLESS nosort2 %]
                                        <li>
                                            <label for="sort2" [% IF mvàatorysort2 %]class="required"[% END %] id="sort2_label"> Sắp xếp 2: </label>
                                            [% PROCESS 'av-build-dropbox.inc' name="sort2", category="Bsort2", default=borrower_data.sort2, empty=1, size = 20 %]
                                            [% IF ( mvàatorysort2 ) %]
                                                <span class="required">Bắt buộc</span>
                                            [% END %]
                                        </li>
                                    [% END # /UNLESS nosort2 %]

                                    [% UNLESS noautorenew_checkouts %]
                                        <li class="radio">
                                            <label for="yes-autorenew_checkouts" id="autorenew_checkouts_label"> Cho phép gia hạn tự động: </label>
                                            [% IF ( borrower_data.autorenew_checkouts || op == 'add_form' ) %]
                                                <label for="yes-autorenew_checkouts" id="yes-autorenew_checkouts_label">
                                                    Có
                                                    <input type="radio" id="yes-autorenew_checkouts" name="autorenew_checkouts" value="1" checked="checked" />
                                                </label>
                                                <label for="no-autorenew_checkouts" id="no-autorenew_checkouts_label">
                                                    Không
                                                    <input type="radio" id="no-autorenew_checkouts" name="autorenew_checkouts" value="0" />
                                                </label>
                                            [% ELSE %]
                                                <label for="yes-autorenew_checkouts" id="yes-autorenew_checkouts_label">
                                                    Có
                                                    <input type="radio" id="yes-autorenew_checkouts" name="autorenew_checkouts" value="1" />
                                                </label>
                                                <label for="no-autorenew_checkouts" id="no-autorenew_checkouts_label">
                                                    Không
                                                    <input type="radio" id="no-autorenew_checkouts" name="autorenew_checkouts" value="0" checked="checked" />
                                                </label>
                                            [% END %]
                                        </li>
                                    [% END %]

                                    [% UNLESS noprotected || !CanUpdateProtectPatron %]
                                        <li class="radio">
                                            <label for="yes-protected" id="protected_label">Được bảo vệ:</label>
                                            [% IF ( patron.protected == 1 ) %]
                                                <label for="yes-protected" id="yes-protected_label">
                                                    Có
                                                    <input type="radio" id="yes-protected" name="protected" value="1" checked="checked" />
                                                </label>
                                                <label for="no-protected" id="no-protected_label">
                                                    Không
                                                    <input type="radio" id="no-protected" name="protected" value="0" />
                                                </label>
                                            [% ELSE %]
                                                <label for="yes-protected" id="yes-protected_label">
                                                    Có
                                                    <input type="radio" id="yes-protected" name="protected" value="1" />
                                                </label>
                                                <label for="no-protected" id="no-protected_label">
                                                    Không
                                                    <input type="radio" id="no-protected" name="protected" value="0" checked="checked" />
                                                </label>
                                            [% END %]
                                        </li>
                                    [% END %]

                                    [% IF ( Koha.Preference('CheckPrevCheckout') == 'softyes' || Koha.Preference('CheckPrevCheckout') == 'softno' ) %]
                                        <li>
                                            <label for="checkprevcheckout" id="checkprevcheckout_label">Kiểm tra lịch sử mượn trước: </label>
                                            <select name="checkprevcheckout" id="checkprevcheckout">
                                                [% IF ( borrower_data.checkprevcheckout == 'yes' ) %]
                                                    <option value="yes" selected="selected">Có nếu cài đặt cho phép</option>
                                                    <option value="no">Không nếu cài đặt cho phép</option>
                                                    <option value="inherit">Kế thừa từ cài đặt</option>
                                                [% ELSIF ( borrower_data.checkprevcheckout == 'no' ) %]
                                                    <option value="yes">Có nếu cài đặt cho phép</option>
                                                    <option value="no" selected="selected">Không nếu cài đặt cho phép</option>
                                                    <option value="inherit">Kế thừa từ cài đặt</option>
                                                [% ELSE %]
                                                    <option value="yes">Có nếu cài đặt cho phép</option>
                                                    <option value="no">Không nếu cài đặt cho phép</option>
                                                    <option value="inherit" selected="selected">Kế thừa từ cài đặt</option>
                                                [% END %]
                                            </select>
                                        </li>
                                    [% END # /IF ( Koha.Preference('CheckPrevCheckout') %]

                                    [% IF Koha.Preference('TranslateThông báos') %]
                                        <li>
                                            <label for="lang" id="lang_label">Ngôn ngữ ưu tiên cho thông báo: </label>
                                            <select id="lang" name="lang">
                                                <option value="default">Mặc định</option>
                                                [% FOR language IN languages %]
                                                    [% FOR sublanguage IN language.sublanguages_loop %]
                                                        [% IF language.plural %]
                                                            [% IF sublanguage.rfc4646_subtag == borrower_data.lang %]
                                                                <option value="[% sublanguage.rfc4646_subtag | html %]" selected="selected"
                                                                    >[% sublanguage.native_description | html %] [% sublanguage.region_description | html %] ([% sublanguage.rfc4646_subtag | html %])</option
                                                                >
                                                            [% ELSE %]
                                                                <option value="[% sublanguage.rfc4646_subtag | html %]"
                                                                    >[% sublanguage.native_description | html %] [% sublanguage.region_description | html %] ([% sublanguage.rfc4646_subtag | html %])</option
                                                                >
                                                            [% END %]
                                                        [% ELSE %]
                                                            [% IF sublanguage.rfc4646_subtag == borrower_data.lang %]
                                                                <option value="[% sublanguage.rfc4646_subtag | html %]" selected="selected">[% sublanguage.native_description | html %] ([% sublanguage.rfc4646_subtag | html %])</option>
                                                            [% ELSE %]
                                                                <option value="[% sublanguage.rfc4646_subtag | html %]">[% sublanguage.native_description | html %] ([% sublanguage.rfc4646_subtag | html %])</option>
                                                            [% END %]
                                                        [% END # /IF language.plural %]
                                                    [% END # /FOR sublanguage %]
                                                [% END #/FOR language %]
                                            </select>
                                            <!-- /#lang -->
                                        </li>
                                    [% END #/IF Koha.Preference('TranslateThông báos') %]
                                </ol>
                            </fieldset>
                            <!-- /#memberentry_library_management -->

                            [% UNLESS nodateenrolled &&  noopacnote && noborrowernotes %]
                                <fieldset class="rows" id="memberentry_subscription">
                                    <legend class="expvàed" id="library_setup_lgd">
                                        <i class="fa fa-caret-down" aria-hidden="true"></i>
                                        Thiết lập thư viện
                                    </legend>
                                    <ol>
                                        [% UNLESS nodateenrolled %]
                                            <li>
                                                <label for="from" [% IF mvàatorydateenrolled %]class="required"[% END %] id="from_label"> Ngày đăng ký: </label>
                                                <input type="text" id="from" name="dateenrolled" maxlength="10" size="10" value="[% borrower_data.dateenrolled | html %]" class="flatpickr" data-date_to="to" />
                                                [% IF ( mvàatorydateenrolled ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                                [% IF ( ERROR_dateenrolled ) %]
                                                    <span class="required">(Lỗi)</span>
                                                [% END %]
                                                <div class="hint">[% INCLUDE 'date-format.inc' %]</div>
                                            </li>
                                        [% END # /UNLESS nodateenrolled %]

                                        <li [% IF nodateexpiry %]style="display:none"[% END %]>
                                            <label for="to" [% IF mvàatorydateexpiry %]class="required"[% END %] id="to_label"> Ngày hết hạn (để trống để tự tính): </label>
                                            [% UNLESS ( op == 'add_form' ) %]
                                                <input type="text" id="to" name="dateexpiry" maxlength="10" size="10" value="[% borrower_data.dateexpiry | html UNLESS op == 'duplicate' %]" class="flatpickr" />
                                            [% ELSE %]
                                                <input type="text" id="to" name="dateexpiry" maxlength="10" size="10" value="[% borrower_data.dateexpiry | html %]" class="flatpickr" />
                                            [% END %]
                                            [% IF ( mvàatorydateexpiry ) %]
                                                <span class="required">Bắt buộc</span>
                                            [% END %]
                                            [% IF ( ERROR_dateexpiry ) %]
                                                <span class="required">(Lỗi)</span>
                                            [% END %]
                                            <div class="hint">[% INCLUDE 'date-format.inc' %]</div>
                                        </li>

                                        [% UNLESS noopacnote %]
                                            <li>
                                                <label for="opacnote" [% IF mvàatoryopacnote %]class="required"[% END %] id="opacnote_label"> Ghi chú OPAC: </label>
                                                <textarea id="opacnote" name="opacnote" cols="55" rows="5">[% borrower_data.opacnote | html UNLESS op == 'duplicate' %]</textarea>
                                                <div class="hint">Tin nhắn này xuất hiện trên trang của bạn đọc trong OPAC</div>
                                                [% IF ( mvàatoryopacnote ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                            </li>
                                        [% END # /UNLESS noopacnote %]

                                        [% UNLESS noborrowernotes %]
                                            <li>
                                                <label for="borrowernotes" [% IF mvàatoryborrowernotes %]class="required"[% END %] id="borrowernotes_label"> Ghi chú mượn trả: </label>
                                                <textarea id="borrowernotes" name="borrowernotes" cols="55" rows="5">[% borrower_data.borrowernotes | $raw UNLESS op == 'duplicate' %]</textarea>
                                                <div class="hint">Tin nhắn này hiển thị khi mượn sách cho bạn đọc này</div>
                                                [% IF ( mvàatoryborrowernotes ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                            </li>
                                        [% END # /UNLESS noborrowernotes %]
                                    </ol>
                                </fieldset>
                                <!-- /#memberentry_subscription -->
                            [% END # hide fieldset %]

                            [% UNLESS nouserid && nopassword && !CanUpdatePasswordExpiration %]
                                <fieldset class="rows" id="memberentry_userid">
                                    <legend class="expvàed" id="opac_staff_login_lgd">
                                        <i class="fa fa-caret-down" aria-hidden="true"></i>
                                        Đăng nhập OPAC/Giao diện thủ thư
                                    </legend>
                                    <ol>
                                        [% UNLESS nouserid %]
                                            <li>
                                                <label for="userid" [% IF mvàatoryuserid %]class="required"[% END %] id="userid_label"> Tên đăng nhập: </label>

                                                [%# Dummy input to avoid Firefox from using userid/password saved for authentication %]
                                                <input type="text" disabled="disabled" style="display:none" />

                                                [% IF ( KhôngUpdateLogin ) %]
                                                    [% IF ( op == 'duplicate' ) %]
                                                        <input type="text" id="userid" name="userid" size="20" disabled="disabled" />
                                                    [% ELSE %]
                                                        <input type="text" id="userid" name="userid" size="20" disabled="disabled" value="[% borrower_data.userid | html %]" />
                                                    [% END %]
                                                [% ELSE %]
                                                    [% IF ( op == 'duplicate' ) %]
                                                        <input type="text" id="userid" name="userid" size="20" value="" />
                                                    [% ELSE %]
                                                        <input type="text" id="userid" name="userid" size="20" value="[% borrower_data.userid | html %]" />
                                                    [% END %]
                                                [% END # /IF ( KhôngUpdateLogin ) %]

                                                [% IF ( mvàatoryuserid ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                            </li>
                                        [% END # /UNLESS nouserid %]

                                        [% UNLESS nopassword %]
                                            <li>
                                                <label for="password" [% IF mvàatorypassword %]class="required"[% END %] id="password_label"> Mật khẩu: </label>
                                                [% IF ( op == 'add_form' ) %]
                                                    [% IF ( KhôngUpdateLogin ) %]
                                                        [% IF ( op == 'duplicate' ) %]
                                                            <input type="password" id="password" name="password" size="20" disabled="disabled" />
                                                        [% ELSE %]
                                                            <input type="password" id="password" name="password" size="20" disabled="disabled" value="[% borrower_data.password | html %]" />
                                                        [% END %]
                                                    [% ELSE %]
                                                        [% IF ( op == 'duplicate' ) %]
                                                            <input type="password" id="password" name="password" size="20" autocomplete="new-password" />
                                                        [% ELSE %]
                                                            <input type="password" id="password" name="password" size="20" autocomplete="new-password" value="[% borrower_data.password | html %]" />
                                                        [% END %]
                                                    [% END # /IF ( KhôngUpdateLogin ) %]
                                                [% ELSE # IF ( op == 'add_form' ) %]

                                                    [% IF ( borrower_data.password ) %]
                                                        [% IF ( KhôngUpdateLogin ) %]
                                                            <input type="password" id="password" name="password" size="20" disabled="disabled" value="****" />
                                                        [% ELSE %]
                                                            [% IF ( op == 'duplicate' ) %]
                                                                <input type="password" id="password" name="password" autocomplete="new-password" size="20" />
                                                            [% ELSE %]
                                                                <input type="password" id="password" name="password" size="20" value="****" />
                                                            [% END %]
                                                        [% END %]
                                                    [% ELSE %]
                                                        [% IF ( KhôngUpdateLogin ) %]
                                                            <input type="password" id="password" name="password" size="20" disabled="disabled" value="" />
                                                        [% ELSE %]
                                                            <input type="password" id="password" name="password" size="20" autocomplete="new-password" value="" />
                                                        [% END %]
                                                    [% END # /IF ( password ) %]
                                                [% END # /IF ( op == 'add_form' ) %]
                                                [% IF ( mvàatorypassword ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                                [% IF ( ERROR_password_too_short ) %]
                                                    <span class="required">Mật khẩu quá ngắn</span>
                                                [% END %]
                                                [% IF ( ERROR_password_too_weak ) %]
                                                    <span class="required">Mật khẩu quá yếu</span>
                                                [% END %]
                                                [% IF ( ERROR_password_has_whitespaces ) %]
                                                    <span class="required">Mật khẩu có khoảng trắng ở đầu hoặc cuối</span>
                                                [% END %]
                                                <div class="hint">Độ dài mật khẩu tối thiểu: [% patron.category.effective_min_password_length | html %]</div>
                                            </li>

                                            <li>
                                                <label for="password2" [% IF mvàatorypassword %]class="required"[% END %] id="password2_label"> Xác nhận mật khẩu: </label>
                                                [% IF ( op == 'add_form' ) %]
                                                    [% IF ( KhôngUpdateLogin ) %]
                                                        [% IF ( op == 'duplicate' ) %]
                                                            <input type="password" id="password2" name="password2" size="20" disabled="disabled" />
                                                        [% ELSE %]
                                                            <input type="password" id="password2" name="password2" size="20" disabled="disabled" value="[% borrower_data.password | html %]" />
                                                        [% END %]
                                                    [% ELSE %]
                                                        [% IF ( op == 'duplicate' ) %]
                                                            <input type="password" id="password2" name="password2" size="20" />
                                                        [% ELSE %]
                                                            <input type="password" id="password2" name="password2" size="20" value="[% borrower_data.password | html %]" />
                                                        [% END %]
                                                    [% END %]
                                                [% ELSE # IF ( op == 'add_form' ) %]
                                                    [% IF ( borrower_data.password ) %]
                                                        [% IF ( KhôngUpdateLogin ) %]
                                                            <input type="password" id="password2" name="password2" size="20" disabled="disabled" value="****" />
                                                        [% ELSE %]
                                                            [% IF ( op == 'duplicate' ) %]
                                                                <input type="password" id="password2" name="password2" size="20" />
                                                            [% ELSE %]
                                                                <input type="password" id="password2" name="password2" size="20" value="****" />
                                                            [% END %]
                                                        [% END %]
                                                    [% ELSE %]
                                                        [% IF ( KhôngUpdateLogin ) %]
                                                            <input type="password" id="password2" name="password2" size="20" disabled="disabled" value="" />
                                                        [% ELSE %]
                                                            <input type="password" id="password2" name="password2" size="20" value="" />
                                                        [% END %]
                                                    [% END %]
                                                [% END # /IF ( op == 'add_form' ) %]

                                                [% IF ( mvàatorypassword ) %]
                                                    <span class="required">Bắt buộc</span>
                                                [% END %]
                                                [% IF ( ERROR_password_mismatch ) %]
                                                    <span class="required">Mật khẩu không khớp</span>
                                                [% END %]
                                            </li>
                                        [% END # /UNLESS nopassword %]
                                        [% UNLESS ( !CanUpdatePasswordExpiration ) %]
                                            <li>
                                                <label for="password_expiration_date" id="password_expiration_date_label">Ngày hết hạn mật khẩu:</label>
                                                <input type="text" id="password_expiration_date" name="password_expiration_date" maxlength="10" size="10" value="[% borrower_data.password_expiration_date | html %]" class="flatpickr" />
                                            </li>
                                        [% END %]
                                    </ol>
                                </fieldset>
                                <!-- /#memberentry_userid -->
                            [% END # UNLESS nouserid && nopassword && !CanUpdatePasswordExpiration %]

                            <!--this zones are not necessary in modif mode -->
                            [% UNLESS ( op == 'add_form' || op == 'duplicate' || ( nogonenoaddress && nolost ) ) %]
                                <fieldset class="rows" id="memberentry_account_flags">
                                    <legend class="expvàed" id="account_flags_lgd">
                                        <i class="fa fa-caret-down" aria-hidden="true"></i>
                                        Cờ tài khoản bạn đọc
                                    </legend>
                                    <div class="patron_account_flags">
                                        <p>Setting a value here will prevent patron from circulating materials và placing holds on the OPAC</p>
                                        <ol class="radio">
                                            [% UNLESS nogonenoaddress %]
                                                <li>
                                                    <label class="radio [% IF mvàatorygonenoaddress %]required[% END %]" for="yesgonenoaddress" id="gonenoaddress_label"> Cần sửa địa chỉ: </label>
                                                    [% IF CAN_user_circulate_manage_restrictions %]
                                                        <label for="yesgonenoaddress" id="yesgonenoaddress_label">
                                                            [% IF ( borrower_data.gonenoaddress ) %]
                                                                <input type="radio" id="yesgonenoaddress" name="gonenoaddress" value="1" checked="checked" />
                                                            [% ELSE %]
                                                                <input type="radio" id="yesgonenoaddress" name="gonenoaddress" value="1" />
                                                            [% END %]
                                                            Có
                                                        </label>
                                                        <label for="nogonenoaddress" id="nogonenoaddress_label">
                                                            [% IF ( borrower_data.gonenoaddress ) %]
                                                                <input type="radio" id="nogonenoaddress" name="gonenoaddress" value="0" />
                                                            [% ELSE %]
                                                                <input type="radio" id="nogonenoaddress" name="gonenoaddress" value="0" checked="checked" />
                                                            [% END %]
                                                            Không
                                                        </label>
                                                    [% ELSE %]
                                                        [% IF borrower_data.gonenoaddress %]<span>Có</span>[% ELSE %]<span>Không</span>[% END %]
                                                    [% END # /IF CAN_user_circulate_manage_restrictions %]
                                                    [% IF mvàatorygonenoaddress %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                </li>
                                            [% END # /UNLESS nogonenoaddress %]
                                            [% UNLESS nolost %]
                                                <li>
                                                    <label class="radio [% IF mvàatorylost %]required[% END %]" for="yeslost"> Mất thẻ: </label>
                                                    [% IF CAN_user_circulate_manage_restrictions %]
                                                        <label for="yeslost" id="yeslost_label">
                                                            [% IF ( borrower_data.lost ) %]
                                                                <input type="radio" id="yeslost" name="lost" value="1" checked="checked" />
                                                            [% ELSE %]
                                                                <input type="radio" id="yeslost" name="lost" value="1" />
                                                            [% END %]
                                                            Có
                                                        </label>
                                                        <label for="nolost" id="nolost_label">
                                                            [% IF ( borrower_data.lost ) %]
                                                                <input type="radio" id="nolost" name="lost" value="0" />
                                                            [% ELSE %]
                                                                <input type="radio" id="nolost" name="lost" value="0" checked="checked" />
                                                            [% END %]
                                                            Không
                                                        </label>
                                                    [% ELSE %]
                                                        [% IF borrower_data.lost %]<span>Có</span>[% ELSE %]<span>Không</span>[% END %]
                                                    [% END # /IF CAN_user_circulate_manage_restrictions %]
                                                    [% IF mvàatorylost %]
                                                        <span class="required">Bắt buộc</span>
                                                    [% END %]
                                                </li>
                                            [% END # /UNLESS nogonenoaddress %]
                                        </ol>
                                    </div>
                                    <!-- /.patron_account_flags -->
                                </fieldset>
                                <!-- /#memberentry_account_flags -->
                            [% END %]
                            <fieldset class="rows" id="memberentry_restrictions">
                                <legend class="expvàed" id="restrictions_lgd">
                                    <i class="fa fa-caret-down" aria-hidden="true"></i>
                                    Hạn chế bạn đọc
                                </legend>
                                <div class="patron_restrictions">
                                    [% IF ( patron.restrictions.count ) %]
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>Loại</th>
                                                    <th>Ghi chú</th>
                                                    <th>Ngày hết hạn</th>
                                                    <th>[% tp('patron restriction created on', 'Created') | html %]</th>
                                                    [% IF CAN_user_borrowers_edit_borrowers && CAN_user_circulate_manage_restrictions %]
                                                        <th>Xoá?</th>
                                                    [% END %]
                                                </tr>
                                            </thead>
                                            <tbody>
                                                [% FOREACH restriction IN patron.restrictions %]
                                                    <tr>
                                                        <td>[% PROCESS restriction_type_description restriction_type=restriction.type %]</td>
                                                        <td>
                                                            [% IF restriction.comment.search('OVERDUES_PROCESS') %]
                                                                Hạn chế thêm bởi quy trình quá hạn [% restriction.comment.remove('OVERDUES_PROCESS ') | scrub_html type => 'comment' | $raw %]
                                                            [% ELSE %]
                                                                [% restriction.comment | scrub_html type => 'comment' | $raw %]
                                                            [% END %]
                                                        </td>
                                                        <td>
                                                            [% IF restriction.expiration %]
                                                                [% restriction.expiration | $KohaDates %]
                                                            [% ELSE %]
                                                                <em>Vô thời hạn</em>
                                                            [% END %]
                                                        </td>
                                                        <td>[% restriction.created | $KohaDates %]</td>
                                                        [% IF CAN_user_borrowers_edit_borrowers && CAN_user_circulate_manage_restrictions %]
                                                            <td>
                                                                <input type="checkbox" id="debarment_[% restriction.borrower_debarment_id | html %]" name="remove_debarment" value="[% restriction.borrower_debarment_id | html %]" />
                                                            </td>
                                                        [% END %]
                                                    </tr>
                                                [% END # /FOREACH d %]
                                            </tbody>
                                        </table>
                                    [% ELSE %]
                                        <p>Bạn đọc hiện không bị hạn chế.</p>
                                    [% END # /IF ( patron.restrictions.count ) %]

                                    [% IF CAN_user_borrowers_edit_borrowers && CAN_user_circulate_manage_restrictions %]
                                        <p
                                            ><a href="#" id="add_manual_restriction"><i class="fa fa-plus"></i> Thêm hạn chế thủ công</a></p
                                        >
                                        <fieldset id="manual_restriction_form">
                                            <legend id="manual_restriction_lgd">Thêm hạn chế thủ công</legend>
                                            <input type="hidden" id="add_debarment" name="add_debarment" value="0" />
                                            <ol>
                                                [% IF Koha.Preference('PatronRestrictionTypes') %]
                                                    <li>
                                                        <label for="debarred_type" id="debarred_type_label">Loại:</label>
                                                        <select name="debarred_type" id="debarred_type">
                                                            [% FOREACH restriction_type IN restriction_types %]
                                                                [% IF !restriction_type.is_system %]
                                                                    [% IF restriction_type.is_default %]
                                                                        <option value="[% restriction_type.code | html %]" selected>[% PROCESS restriction_type_description %]</option>
                                                                    [% ELSE %]
                                                                        <option value="[% restriction_type.code | html %]">[% PROCESS restriction_type_description %]</option>
                                                                    [% END %]
                                                                [% END %]
                                                            [% END %]
                                                        </select>
                                                    </li>
                                                [% END %]
                                                <li>
                                                    <label for="debarred_comment" id="debarred_comment_label">Ghi chú: </label>
                                                    <input type="text" id="debarred_comment" name="debarred_comment" />
                                                </li>
                                                <li>
                                                    <label for="debarred_expiration" id="debarred_expiration_label">Ngày hết hạn: </label>
                                                    <input name="debarred_expiration" id="debarred_expiration" size="10" value="" class="flatpickr" type="text" />
                                                    <a href="#" id="clear_debarred_expiration">Xoá ngày</a>
                                                </li>
                                            </ol>
                                            <p>
                                                <a class="cancel" id="cancel_manual_restriction" href="#">Huỷ</a>
                                            </p>
                                        </fieldset>
                                        <!-- /#manual_restriction_form -->
                                    [% END # /IF CAN_user_borrowers_edit_borrowers %]
                                </div>
                            </fieldset>
                            <!-- /#memberentry_restrictions -->
                        [% END # /IF ( step_3 ) %]

                        [% IF ( step_7 ) %]
                            [% IF Koha.Preference('HouseboundModule') %]
                                <fieldset class="rows" id="memberentry_housebound_roles">
                                    <legend class="expvàed" id="housebound_roles">
                                        <i class="fa fa-caret-down" aria-hidden="true"></i>
                                        Vai trò phục vụ tại nhà
                                    </legend>
                                    <ol class="radio">
                                        <li>
                                            <label class="radio" for="yes_housebound_chooser" id="housebound_chooser_label"> Người chọn: </label>
                                            [% IF ( housebound_role.housebound_chooser == 1 ) %]
                                                <label for="yes_housebound_chooser" id="yes_housebound_chooser_label">Có </label>
                                                <input type="radio" id="yes_housebound_chooser" name="housebound_chooser" value="1" checked="checked" />
                                                <label for="no_housebound_chooser" id="no_housebound_chooser_label">Không </label>
                                                <input type="radio" id="no_housebound_chooser" name="housebound_chooser" value="0" />
                                            [% ELSE %]
                                                <label for="yes_housebound_chooser" id="yes_housebound_chooser_label">Có </label>
                                                <input type="radio" id="yes_housebound_chooser" name="housebound_chooser" value="1" />
                                                <label for="no_housebound_chooser" id="no_housebound_chooser_label">Không </label>
                                                <input type="radio" id="no_housebound_chooser" name="housebound_chooser" value="0" checked="checked" />
                                            [% END %]
                                        </li>
                                        <li>
                                            <label class="radio" for="yes_housebound_deliverer" id="housebound_deliverer_label">Người giao: </label>
                                            [% IF ( housebound_role.housebound_deliverer == 1 ) %]
                                                <label for="yes_housebound_deliverer" id="yes_housebound_deliverer_label">Có </label>
                                                <input type="radio" id="yes_housebound_deliverer" name="housebound_deliverer" value="1" checked="checked" />
                                                <label for="no_housebound_deliverer" id="no_housebound_deliverer_label">Không </label>
                                                <input type="radio" id="no_housebound_deliverer" name="housebound_deliverer" value="0" />
                                            [% ELSE %]
                                                <label for="yes_housebound_deliverer" id="yes_housebound_deliverer_label">Có </label>
                                                <input type="radio" id="yes_housebound_deliverer" name="housebound_deliverer" value="1" />
                                                <label for="no_housebound_deliverer" id="no_housebound_deliverer_label">Không </label>
                                                <input type="radio" id="no_housebound_deliverer" name="housebound_deliverer" value="0" checked="checked" />
                                            [% END %]
                                        </li>
                                    </ol>
                                    <!-- /ol.radio -->
                                </fieldset>
                                <!-- /#memberentry_housebound_roles -->
                            [% END # hide fieldset %]
                        [% END # IF step_7 %]

                        [% IF ( step_4 ) %]
                            [% IF Koha.Preference('ExtendedPatronAttributes') %]
                                [% PROCESS 'memberentry_patron_attributes_form' patron_attributes=patron_attributes %]
                            [% END # IF Koha.Preference('ExtendedPatronAttributes') %]
                        [% END # IF ( step_4 ) %]

                        [% IF ( step_5 ) %]
                            [% IF ( EnhancedMessagingPreferences ) %]
                                <fieldset class="rows" id="memberentry_messaging_prefs">
                                    <legend class="expvàed" id="patron_messaging_prefs_lgd">
                                        <i class="fa fa-caret-down" aria-hidden="true"></i>
                                        Tùy chỉnh thông báo
                                    </legend>
                                    <div class="messaging_prefs">
                                        <div id="messaging_prefs_loading" class="form-message" style="display:none"> <img src="[% interface | html %]/[% theme | html %]/img/spinner-small.gif" alt="" /> Đang tải cài đặt thông báo mới </div>
                                        <input type="hidden" name="setting_messaging_prefs" value="1" />
                                        [% INCLUDE 'messaging-preference-form.inc' %]
                                        [% IF ( SMSSendDriver ) %]
                                            [% IF !nosmsalertnumber %]
                                                <p>
                                                    <label for="SMSnumber" id="SMSnumber_label">Số SMS:</label>
                                                    <input type="text" id="SMSnumber" name="SMSnumber" value="[% SMSnumber | html %]" />
                                                    <span class="hint sms_number_help">Vui lòng nhập số điện thoại. Thêm + hoặc 00 nếu bao gồm mã quốc gia.</span>
                                                </p>
                                            [% END %]
                                            [% IF SMSSendDriver == 'Email' && !nosms_provider_id %]
                                                <p>
                                                    <label for="sms_provider_id" id="sms_provider_id_label">Nhà cung cấp SMS:</label>
                                                    <select id="sms_provider_id" name="sms_provider_id">
                                                        <option value="">Không xác định</option>
                                                        [% FOREACH s IN sms_providers %]
                                                            [% IF s.id == borrower_data.sms_provider_id %]
                                                                <option value="[% s.id | html %]" selected="selected">[% s.name | html %]</option>
                                                            [% ELSE %]
                                                                <option value="[% s.id | html %]">[% s.name | html %]</option>
                                                            [% END %]
                                                        [% END %]
                                                    </select>
                                                </p>
                                            [% END # /UNLESS nosms_provider_id %]
                                        [% END # IF ( SMSSendDriver ) %]
                                    </div>
                                    <!-- /.messaging_prefs -->
                                </fieldset>
                            [% END # IF ( EnhancedMessagingPreferences ) %]
                        [% END # /IF step_5 %]
                    </form>
                    <!-- /#entryform -->

                    [% IF quickadd && op == 'add_form'  && !check_member %]
                        <form method="get" id="quick_add_form" class="toggler">
                            <fieldset class="rows quick_add"
                                ><legend>Thêm nhanh</legend>
                                <ol id="quick_add_list"> </ol>
                            </fieldset>
                        </form>
                    [% END %]
                [% END # /UNLESS ( no_add ) %]
            </main>
        </div>
        <!-- /.col-md-10.order-md-2 -->

        [% UNLESS ( op == 'add_form' ) %]
            <div class="col-md-2 order-sm-2 order-md-1">
                <aside> [% INCLUDE 'circ-menu.inc' %] </aside>
            </div>
            <!-- /.col-md-2.order-md-1 -->
        [% END %]
    </div>
    <!-- /.row -->
</div>
<!-- /.main.container-fluid -->

<div id="categoryChangeModal" class="modal" tabindex="-1" role="dialog" aria-labelledby="categoryChangeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title" id="categoryChangeModalLabel">Đổi loại bạn đọc</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có muốn áp dụng cài đặt mặc định cho loại bạn đọc mới không?</p>
                [% IF Koha.Preference('UpdateMessagingPrefsOnCategoryChange') == 'softyes' %]
                    <div class="form-check">
                        <input type="checkbox" id="categoryChangeUpdateMessaging" checked />
                        <label class="form-check-label" for="categoryChangeUpdateMessaging"> Đặt lại tùy chỉnh thông báo về mặc định của loại </label>
                    </div>
                [% ELSIF Koha.Preference('UpdateMessagingPrefsOnCategoryChange') == 'softno' %]
                    <div class="form-check">
                        <input type="checkbox" id="categoryChangeUpdateMessaging" />
                        <label class="form-check-label" for="categoryChangeUpdateMessaging"> Đặt lại tùy chỉnh thông báo về mặc định của loại </label>
                    </div>
                [% END %]
                [% IF Koha.Preference('UpdateExpiryDateOnCategoryChange') == 'softno' || Koha.Preference('UpdateExpiryDateOnCategoryChange') == 'softyes' %]
                    [% IF Koha.Preference('UpdateExpiryDateOnCategoryChange') == 'softyes' %]
                        <div class="form-check">
                            <input type="checkbox" id="categoryChangeUpdateExpiry" checked />
                            <label class="form-check-label" for="categoryChangeUpdateExpiry"> Đặt lại ngày hết hạn về mặc định của loại </label>
                        </div>
                    [% ELSIF Koha.Preference('UpdateExpiryDateOnCategoryChange') == 'softno' %]
                        <div class="form-check">
                            <input type="checkbox" id="categoryChangeUpdateExpiry" />
                            <label class="form-check-label" for="categoryChangeUpdateExpiry"> Đặt lại ngày hết hạn về mặc định của loại </label>
                        </div>
                    [% END %]
                [% END %]
            </div>
            <div class="modal-footer">
                <button id="categoryChangeConfirmBtn" class="btn btn-primary"><i class="fa fa-check" aria-hidden="true"></i> Xác nhận</button>
                <button id="categoryChangeCancelBtn" data-bs-dismiss="modal" class="btn btn-secondary"><i class="fa fa-times" aria-hidden="true"></i> Huỷ</button>
            </div>
        </div>
    </div>
</div>
[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'calendar.inc' %]
    [% INCLUDE 'str/members-menu.inc' %]
    [% Asset.js("js/members-menu.js") | $raw %]
    <script nonce="[% Koha.CSPKhôngnce | $raw %]" data-tt-allowed="true">
        function update_cardnumber_warning(size){
            var max_len = [% maxlength_cardnumber | html %];
            if ( size >= max_len ) {
                $("#cn_max").show();
            } else {
                $("#cn_max").hide();
            }
        }

        function toggle_guarantor_field(rel_number){
            $(".relation-"+rel_number).prop('disabled', (i, v) => !v);
        }

        function showHideFields(){
            $("#messaging_prefs_loading, #guarantor_template").hide();
            [% UNLESS step == 1 %]
                [% IF fieldstohide.grep('^identity$').size %]
                    togglePanel( $("#identity_lgd") );
                [% END %]
                [% IF show_guarantor || guarantor %]
                    [% IF fieldstohide.grep('^guarantor$').size %]
                        togglePanel( $("#patron_guarantor_lgd") );
                    [% END %]
                    [% IF fieldstohide.grep('^nonpatron_guarantor$').size %]
                        togglePanel( $("#non_patron_guarantor_lgd") );
                    [% END %]
                [% END %]
                [% IF fieldstohide.grep('^primary_address$').size %]
                    togglePanel( $("#main_address_lgd") );
                [% END %]
                [% IF fieldstohide.grep('^primary_contact$').size %]
                    togglePanel( $("#contact_lgd") );
                [% END %]
            [% END %]
            [% UNLESS step == 6 %]
                [% IF fieldstohide.grep('^alt_address$').size %]
                    togglePanel( $("#alt_address_lgd") );
                [% END %]
            [% END %]
            [% UNLESS step == 2 %]
                [% IF fieldstohide.grep('^alt_contact$').size %]
                    togglePanel( $("#alt_contact_lgd") );
                [% END %]
            [% END %]
            [% UNLESS step == 3 %]
                [% IF fieldstohide.grep('^lib_mgmt$').size %]
                    togglePanel( $("#library_management_lgd") );
                [% END %]
                [% UNLESS nodateenrolled && noopacnote && noborrowernotes %]
                    [% IF fieldstohide.grep('^lib_setup$').size %]
                        togglePanel( $("#library_setup_lgd") );
                    [% END %]
                [% END %]
                [% UNLESS nouserid && nopassword %]
                    [% IF fieldstohide.grep('^login$').size %]
                        togglePanel( $("#opac_staff_login_lgd") );
                    [% END %]
                [% END %]
                [% UNLESS ( op == 'add_form' || op == 'duplicate' ) %]
                    [% IF fieldstohide.grep('^flags$').size %]
                        togglePanel( $("#account_flags_lgd") );
                    [% END %]
                [% END %]
                [% IF fieldstohide.grep('^debarments$').size %]
                    togglePanel( $("#restrictions_lgd") );
                [% END %]
            [% END %]
            [% UNLESS step == 7 %]
                [% IF Koha.Preference('HouseboundModule') %]
                    [% IF fieldstohide.grep('^housebound$').size %]
                        togglePanel( $("#housebound_roles") );
                    [% END %]
                [% END %]
            [% END %]
            [% UNLESS step == 4 %]
                [% IF Koha.Preference('ExtendedPatronAttributes') %]
                    [% IF fieldstohide.grep('^additional$').size %]
                        togglePanel( $("#patron_attributes_lgd") );
                    [% END %]
                [% END %]
            [% END %]
            [% UNLESS step == 5 %]
                [% IF Koha.Preference('EnhancedMessagingPreferences') %]
                    [% IF fieldstohide.grep('^messaging$').size %]
                        togglePanel( $("#patron_messaging_prefs_lgd") );
                        $("#messaging_prefs_loading").toggle();
                    [% END %]
                [% END %]
            [% END %]
        }

        $(document).ready(function() {
            showHideFields();
            $("#toggle_hidden_fields").change(function(){
                showHideFields();
            });

            $(".collapsed,.expvàed").on("click",function(){
                $("#messaging_prefs_loading").hide();
                $("#guarantor_template").hide();
            });

            $("#saverecord").css({ 'margin-left': 0 });

            [% IF borrower_data.categorycode %]
                update_category_code( "[% borrower_data.categorycode | html %]" );
            [% ELSE %]
                if ( $("#categorycode_entry").length > 0 ){
                    var category_code = $("#categorycode_entry").find("option:selected").val();
                    update_category_code( category_code );
                }
            [% END %]

            [% IF new_guarantors %]
                [% FOREACH g IN new_guarantors %]
                    select_user( '[% g.patron.borrowernumber | html %]', [% To.json( g.patron.unblessed ) | $raw %], '[% g.relationship | html %]' );
                [% END %]
            [% END %]

            $("#cn_max").hide();
            var content;
            $("#cardnumber").on("keydown", function(e){
                content = $(this).val();
            });
            $("#cardnumber").on("keyup", function(e){
                // .val() will return the value of the input after the key has been released
                var l = $(this).val().length;
                if ( l == content.length + 1 ) { l--; }
                update_cardnumber_warning(l);
            });
            $("#cardnumber").bind("paste", function(e){
                var pastedData = e.originalEvent.clipboardData.getData('text');
                update_cardnumber_warning(pastedData.length - 1);
            } );
            var toggle_quick_add = $(".toggle_quick_add");
            $(toggle_quick_add).click(function(e){
                toggle_quick_add.toggle();
                e.preventDefault();
                var toggle_to = '';
                var toggle_from = '';
                if( $("#entryform:visible").length ) {
                    toggle_to = "#quick_add_form label";
                    toggle_from = "#entryform label";
                    $("#memberentry_guarantor").appendTo("#quick_add_form");
                } else {
                    toggle_to="#entryform label";
                    toggle_from = "#quick_add_form label";
                    $("#memberentry_guarantor").appendTo("#memberentry_guarantor_anchor");
                }
                $(toggle_from).each(function() {
                    var input_label = $(this).attr('for');
                    if ( input_label == 'sex-male' || input_label == 'sex-none' || input_label == 'sex-female' || input_label == 'sex-other' ) {
                        $(toggle_to+"[for='"+input_label+"']").next().prop('checked', $(this).next().prop('checked') );
                        return;
                    }
                    var source_input = $(this).nextAll(":input[name]").first();
                    var target_input = $(toggle_to+"[for='"+input_label+"']").nextAll(":input[name]").first();
                    target_input.val( source_input.val() );
                });

                $(".toggler").toggle();
            });

            $("#save_quick_add").click(function(){
                $("#quick_add_form").validate();
                if( $("#quick_add_form").valid()){
                    $('.toggle_quick_add').click();
                    $("#memberentry_guarantor").appendTo("#memberentry_guarantor_anchor");
                    $('#saverecord').click();
                }
                else {return false;}
            });

            $("#saverecord").click(function(){
                if( check_form_borrowers() ){
                    $("#entryform").submit();
                }
            });

            $('#not-duplicate').on('click', function() {
                $("input[name='nodouble']").val('1');
                $('#entryform').submit();
            });

            $(".popup_patronview").on("click", function(e){
                e.preventDefault();
                var url = $(this).attr("href");
                openWindow( url, "patronview" );
            });

            $("#dateofbirth").on("change", function(){
                 write_age();
            });

            $("#debarred_comment, #debarred_expiration").on("change", function(){
                $("#add_debarment").val(1);
            });

            $("#clear_debarred_expiration").on("click", function(e){
                e.preventDefault();
                $('#debarred_expiration').val("");
            });

            $("#memberentry_patron_attributes").on("click", ".clear_attribute", function(e){
                e.preventDefault();
                clear_entry( this );
            });

            $("#memberentry_patron_attributes").on("click", ".clone_attribute", function(e){
                e.preventDefault();
                clone_entry( this );
            });

            $("#categorycode_entry").on("change", function(){
                update_category_code(this);
            });

            [% IF logged_in_user.borrowernumber == borrowernumber %]
                $("#userid").on("change", function(){
                    $(this).parent().find("div.hint").remove();
                    if ( "[% borrower_data.userid | html %]" != $(this).val() ) {
                        $(this).parent().append('<div class="hint">%s</div>'.format(_("You will be logged out if you modify your username")));
                    }
                });
            [% END %]

        });

        [% IF quickadd && op == 'add_form' && !check_member %]
            $(document).ready(function () {

                $("#entryform,#saverecord").hide();
                [% q_add_f = Koha.Preference('PatronQuickAddFields').split('\|') %]
                var qaddfields = [[% FOREACH field IN q_add_f.unique %]"[% field | html %]",[% END %]];
                $("#entryform label").each(function () {
                    var input_label = $(this).attr('for');
                    if ( input_label == 'sex-female' ) {
                        input_label='sex';
                    }
                    else if ( input_label == 'btitle' ) {
                        input_label='title';
                    }
                    if( qaddfields.indexOf( input_label ) != -1 || $(this).attr('class') == 'required' ){
                       let orig_li = $(this).parent();
                       if( orig_li.attr('class') == 'radio' ){
                           let new_field = orig_li.clone();
                           new_field.children('label').each(function(){
                                let child_input = $(this).children('input');
                                child_input.attr("id",child_input.attr("id") + "_quick_add");
                            });
                           new_field.appendTo("#quick_add_list");
                       } else {
                           let orig_input_id = orig_li.children("input,textarea,select").last().attr("id");
                           if ( orig_input_id ) {
                               let new_field = orig_li.clone();
                               new_field.children("#"+orig_input_id).attr("id",orig_input_id + "_quick_add");
                               new_field.appendTo("#quick_add_list");
                           }
                           [% UNLESS mvàatorypassword %]
                                 if( input_label == 'password' ){
                                     let orig_p2 = $("#entryform label[for='password2']").parent();
                                     let new_p2  = orig_p2.clone();
                                     new_p2.find('input[id="password2"]').attr("id","password2_quick_add");
                                     new_p2.appendTo("#quick_add_list");
                                 }
                           [% END %]
                       }
                    }
                });
                if ( $("#memberentry_guarantor").length ) {
                    $("#memberentry_guarantor").appendTo("#quick_add_form");
                }
                $("#quick_add_form").show();
                $("#quick_add_form").find(".flatpickr:hidden").each( (i, input) => {
                    $(input).siblings(".flatpickr_wrapper").remove(); // Remove leftover from the previous flatpickr that has been cloned
                    apply_flatpickr(input);
                } );
            });
        [% END %]
        $("#guarantor_template").hide();
        var prefill_fields;
        var to_api_mapping;
        [% IF prefill_fields %]
            prefill_fields = [% To.json(prefill_fields)  | $raw %];
        [% END %]
        [% IF to_api_mapping %]
            to_api_mapping = [% To.json(to_api_mapping) | $raw %];
        [% END %]

        var TalkingTechItivaPhoneKhôngtification = [% Koha.Preference('TalkingTechItivaPhoneKhôngtification') || 0 | html %];
        var PhoneKhôngtification = [% Koha.Preference('PhoneKhôngtification') || 0 | html %];

        var UpdateExpiryDateOnCategoryChange =  "[% Koha.Preference('UpdateExpiryDateOnCategoryChange') | html %]";
        var UpdateMessagingPrefsOnCategoryChange =  "[% Koha.Preference('UpdateMessagingPrefsOnCategoryChange') | html %]";
    </script>
    [% Asset.js("js/messaging-preference-form.js") | $raw %]
    [% Asset.js("js/members.js") | $raw %]
    [% PROCESS 'password_check.inc' new_password => 'password', category_selector => '#categorycode_entry', minPasswordLength => patron.category.effective_min_password_length, RequireStrongPassword => patron.category.effective_require_strong_password %]

    [% INCLUDE 'select2.inc' %]
    [% SET columns = ['cardnumber','name','category','branch','dateofbirth','address-library','action'] %]
    [% PROCESS patron_search_modal columns => columns, modal_title => t("Thêm người bảo lãnh") %]
    [% PROCESS patron_search_js columns => columns, actions => ["select"], preview_on_name_click => 1 %]
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
